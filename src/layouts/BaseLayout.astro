// All rights reserved. See LICENSE in the project root.
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ImageLayout from "../components/ImageLayout.astro";
import CallFab from "../components/CallFab.astro";
import { currentLocale } from "../lib/i18n";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  fontAwesome?: boolean;
  heroPreload?: { srcset: string; sizes: string; type?: string };
}

const { title, description, image, noindex, fontAwesome, heroPreload } = Astro.props;
const locale = currentLocale(Astro);
const dir = locale === "ar" ? "rtl" : "ltr";

// Show a "BETA" ribbon on any non-production build (matches the noindex
// signal in BaseHead). Default to PRODUCTION so a missing env var never
// shows a stray ribbon on the live site. Only known non-prod branches flip.
const cfBranch = process.env.CF_PAGES_BRANCH || "";
const NON_PROD_BRANCHES = new Set(["beta", "staging", "preview", "dev"]);
const isProduction = !NON_PROD_BRANCHES.has(cfBranch);
---

<html lang={locale} dir={dir}>
  <head>
    <BaseHead title={title} description={description} image={image} noindex={noindex} fontAwesome={fontAwesome} heroPreload={heroPreload} />
    <ClientRouter />
  </head>
  <body class="paper">
    <canvas id="starfield" aria-hidden="true"></canvas>
    {!isProduction && (
      <div class="beta-ribbon" aria-label="Beta environment">
        {locale === "ar" ? "بيتا — بيئة اختبار" : "BETA — testing environment"}
      </div>
    )}
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CallFab />
    <ImageLayout />

    <!-- Starfield canvas: twinkling stars moving slowly toward 4 o'clock -->
    <script is:inline>
      (function() {
        const canvas = document.getElementById('starfield');
        const ctx = canvas.getContext('2d');
        let stars = [];
        let animationId;

        // Colors - darker/more saturated for visibility
        const colors = ['#f8c9b8', '#bfe6d6', '#d9ccf0', '#f7e7b0', '#c6ddf0', '#f9d2ae', '#1f1f1f', '#4a4a4a'];

        // Star shapes
        const shapes = ['circle', 'plus', 'diamond', 'fourpoint'];

        function Star() {
          this.x = Math.random() * canvas.width;
          this.y = Math.random() * canvas.height;
          this.size = 2 + Math.random() * 1.5; // bigger and more visible
          this.color = colors[Math.floor(Math.random() * colors.length)];
          this.shape = shapes[Math.floor(Math.random() * shapes.length)];
          this.twinkleSpeed = 0.008 + Math.random() * 0.008;
          this.twinkleOffset = Math.random() * Math.PI * 2;
          this.opacity = 0.6; // more opaque, easier to see

          // Slow movement toward 4 o'clock (120 degrees: right and down)
          this.vx = 0.005; // move right slowly
          this.vy = 0.008; // move down slowly
        }

        function drawStar(star) {
          ctx.save();
          ctx.fillStyle = star.color;
          ctx.strokeStyle = star.color;
          ctx.globalAlpha = star.opacity;
          ctx.translate(star.x, star.y);

          if (star.shape === 'circle') {
            ctx.fillRect(-star.size/2, -star.size/2, star.size, star.size);
          } else if (star.shape === 'plus') {
            ctx.lineWidth = 0.4;
            ctx.beginPath();
            ctx.moveTo(-star.size, 0);
            ctx.lineTo(star.size, 0);
            ctx.moveTo(0, -star.size);
            ctx.lineTo(0, star.size);
            ctx.stroke();
          } else if (star.shape === 'diamond') {
            ctx.beginPath();
            ctx.moveTo(0, -star.size);
            ctx.lineTo(star.size, 0);
            ctx.lineTo(0, star.size);
            ctx.lineTo(-star.size, 0);
            ctx.closePath();
            ctx.fill();
          } else if (star.shape === 'fourpoint') {
            ctx.lineWidth = 0.5;
            ctx.beginPath();
            ctx.moveTo(0, -star.size * 1.2);
            ctx.lineTo(0, star.size * 1.2);
            ctx.moveTo(-star.size * 1.2, 0);
            ctx.lineTo(star.size * 1.2, 0);
            ctx.stroke();
          }
          ctx.restore();
        }

        function resizeCanvas() {
          canvas.width = window.innerWidth;
          canvas.height = window.innerHeight;
        }

        function initStars() {
          stars = [];
          const starCount = Math.max(50, Math.floor((canvas.width * canvas.height) / 25000));
          for (let i = 0; i < starCount; i++) {
            stars.push(new Star());
          }
        }

        function animate(time) {
          ctx.clearRect(0, 0, canvas.width, canvas.height);

          for (let star of stars) {
            // Twinkling: slow oscillation between 0.5 and 1.0 opacity
            star.opacity = 0.5 + 0.5 * (0.5 + 0.5 * Math.sin(star.twinkleOffset + time * star.twinkleSpeed));

            // Movement toward 4 o'clock
            star.x += star.vx;
            star.y += star.vy;

            // Wrap around edges
            if (star.x > canvas.width) star.x = -5;
            if (star.y > canvas.height) star.y = -5;
            if (star.x < -5) star.x = canvas.width;
            if (star.y < -5) star.y = canvas.height;

            drawStar(star);
          }

          animationId = requestAnimationFrame(animate);
        }

        function init() {
          resizeCanvas();
          initStars();
          animate(0);
        }

        window.addEventListener('resize', () => {
          resizeCanvas();
          initStars();
        });

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>

    <!-- Progressive HD-image swap. Any <img data-hires="…"> gets its source
         upgraded to the higher-quality version once the page finishes loading
         and the browser is idle. Preloads the file with `new Image()` so the
         visible swap is instant and never causes a layout shift (dimensions
         match the srcset variant that's already on screen). -->
    <script is:inline>
      (function () {
        function upgrade() {
          var imgs = document.querySelectorAll("img[data-hires]");
          if (!imgs.length) return;
          imgs.forEach(function (img) {
            var hi = img.getAttribute("data-hires");
            if (!hi) return;
            img.removeAttribute("data-hires");
            var pre = new Image();
            pre.onload = function () {
              img.removeAttribute("srcset");
              img.removeAttribute("sizes");
              img.src = hi;
            };
            pre.src = hi;
          });
        }
        function schedule() {
          if ("requestIdleCallback" in window) {
            requestIdleCallback(upgrade, { timeout: 4000 });
          } else {
            setTimeout(upgrade, 2000);
          }
        }
        if (document.readyState === "complete") schedule();
        else addEventListener("load", schedule, { once: true });
      })();
    </script>

    <!-- Toast shown when a user clicks a "not yet redesigned" article link.
         The message comes from the button's data-soon-message attribute. -->
    <div id="soon-toast" class="soon-toast" role="status" aria-live="polite"></div>
    <script is:inline>
      (function () {
        if (window.__soonToastBound) return;
        window.__soonToastBound = true;
        let hideT = 0;
        function show(msg) {
          const el = document.getElementById("soon-toast");
          if (!el) return;
          el.textContent = msg;
          el.classList.add("show");
          clearTimeout(hideT);
          hideT = setTimeout(() => el.classList.remove("show"), 3200);
        }
        document.addEventListener("click", (e) => {
          const el = e.target && e.target.closest && e.target.closest("[data-soon-message]");
          if (!el) return;
          e.preventDefault();
          show(el.getAttribute("data-soon-message") || "Not yet available.");
        });
      })();
    </script>

    <style is:global>
      #starfield {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        pointer-events: none;
      }
      .soon-toast {
        position: fixed;
        left: 50%;
        bottom: 24px;
        transform: translateX(-50%) translateY(20px);
        z-index: 1200;
        background: var(--footer-bg);
        color: var(--footer-text);
        font-family: "IBM Plex Sans", system-ui, sans-serif;
        font-size: 14px;
        line-height: 1.4;
        padding: 14px 20px;
        max-width: min(90vw, 420px);
        text-align: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity 200ms ease, transform 200ms ease;
      }
      .soon-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
    </style>
    {!isProduction && (
      <style is:global>
        .beta-ribbon {
          position: fixed;
          top: 12px;
          inset-inline-end: 12px;
          z-index: 1000;
          padding: 0.4em 0.85em;
          background: #dc2626;
          color: #fff;
          font-size: 0.75rem;
          font-weight: 700;
          letter-spacing: 0.06em;
          text-transform: uppercase;
          border-radius: 999px;
          box-shadow: 0 4px 12px rgba(220, 38, 38, 0.35);
          pointer-events: none;
          user-select: none;
        }
        @media (max-width: 480px) {
          .beta-ribbon { top: 8px; inset-inline-end: 8px; font-size: 0.65rem; padding: 0.3em 0.65em; }
        }
      </style>
    )}
  </body>
</html>

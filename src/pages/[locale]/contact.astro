---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CONTACT } from "../../consts";
import { currentLocale, localizedHref } from "../../lib/i18n";

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const isAr = locale === "ar";
const L = (href: string) => localizedHref(href, locale);

const T = isAr ? {
  title:       "اتصل بنا — كليم",
  description: "تواصل مع فريق كليم في البصرة. اتصل، راسل، أو احجز تدقيقاً مجانياً لأنظمتك.",
  eyebrow:     "تواصل",
  h1:          "أخبرنا ما مغلق.",
  h1b:         "سنظهر لك الطريق للخروج.",
  lede:        "نجيب خلال ساعات العمل. للحالات العاجلة، اتصل مباشرة.",
  callLabel:   "اتصل",
  emailLabel:  "البريد",
  locHead:     "الموقع",
  followHead:  "تابعنا",
  bookAudit:   "احجز تدقيقاً مجانياً",
  auditNote:   "أسئلة قليلة عن أنظمتك الحالية، ثم ملخص واحد يوضح ما هو مغلق وكيف نحرره.",
} : {
  title:       "Contact — Kaleem",
  description: "Get in touch with the Kaleem team in Basra. Call, message, or book a free audit of your systems.",
  eyebrow:     "Get in touch",
  h1:          "Tell us what's locked.",
  h1b:         "We'll show you the way out.",
  lede:        "We answer during business hours. For urgent matters, please call directly.",
  callLabel:   "Call",
  emailLabel:  "Email",
  locHead:     "Location",
  followHead:  "Follow us",
  bookAudit:   "Book a free audit",
  auditNote:   "A few questions about your current systems, then one summary of what's locked and how we free it.",
};

const socials = [
  { label: "Facebook",  href: CONTACT.social.facebook,  icon: "F" },
  { label: "Instagram", href: CONTACT.social.instagram, icon: "I" },
  { label: "YouTube",   href: CONTACT.social.youtube,   icon: "Y" },
  { label: "Telegram",  href: CONTACT.social.telegram,  icon: "T" },
  { label: "TikTok",    href: CONTACT.social.tiktok,    icon: "K" },
];
---

<BaseLayout title={T.title} description={T.description}>
  <section class="contact-hero bg-lilac">
    <div class="container">
      <span class="eyebrow">{T.eyebrow}</span>
      <h1 class="contact-h1">{T.h1}<br />{T.h1b}</h1>
      <p class="contact-lede">{T.lede}</p>
    </div>
  </section>

  <section class="contact-actions">
    <div class="container">
      <div class="actions-grid">
        {CONTACT.phones.map((p) => (
          <a class="sk action bg-mint" href={`tel:${p.replace(/\s/g, "")}`}>
            <span class="action-label">{T.callLabel}</span>
            <span class="action-value"><bdi>{p}</bdi></span>
          </a>
        ))}
        <a class="sk action bg-butter" href={`mailto:${CONTACT.email}`}>
          <span class="action-label">{T.emailLabel}</span>
          <span class="action-value">{CONTACT.email}</span>
        </a>
        <a class="sk action bg-peach" href={CONTACT.mapsUrl} target="_blank" rel="noopener">
          <span class="action-label">{T.locHead}</span>
          <span class="action-value">{isAr ? CONTACT.addresses.ar : CONTACT.addresses.en}</span>
        </a>
      </div>
    </div>
  </section>

  <section class="contact-cta">
    <div class="container">
      <div class="sk audit-card bg-paper">
        <h2>{T.bookAudit}</h2>
        <p>{T.auditNote}</p>
        <a class="skb skb-mint" href={`mailto:${CONTACT.email}?subject=${encodeURIComponent(isAr ? "طلب تدقيق مجاني" : "Free audit request")}`}>
          {T.bookAudit}
        </a>
      </div>
    </div>
  </section>

  <section class="contact-social bg-paper-2">
    <div class="container">
      <h2>{T.followHead}</h2>
      <ul class="social-list">
        {socials.map((s) => (
          <li>
            <a class="sk social-btn bg-sky" href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
              {s.icon}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: var(--k-max);
    margin: 0 auto;
    padding: 0 var(--k-gutter-desktop);
  }

  .contact-hero {
    padding: var(--k-space-10) 0 var(--k-space-11);
    text-align: center;
  }

  .eyebrow {
    display: inline-block;
    font-family: var(--k-font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--k-ink-muted);
    margin-bottom: var(--k-space-4);
  }

  .contact-h1 {
    margin: 0 auto var(--k-space-5);
    max-width: 20ch;
    font-size: clamp(36px, 6vw, 64px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--k-ink);
    font-weight: 700;
  }

  .contact-lede {
    margin: 0 auto;
    max-width: 52ch;
    font-size: 19px;
    line-height: 1.6;
    color: var(--k-ink-muted);
  }

  .contact-actions {
    padding: var(--k-space-10) 0;
  }

  .actions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--k-space-6);
  }

  .action {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
    color: var(--k-ink);
    padding: var(--k-space-6);
  }

  .action-label {
    font-family: var(--k-font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--k-ink-muted);
  }

  .action-value {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--k-ink);
    word-break: break-word;
  }

  .contact-cta {
    padding: 0 0 var(--k-space-11);
  }

  .audit-card {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }

  .audit-card h2 {
    margin: 0;
    font-size: clamp(24px, 3.4vw, 34px);
    color: var(--k-ink);
  }

  .audit-card p {
    color: var(--k-ink-muted);
    font-size: 17px;
    line-height: 1.6;
    max-width: 44ch;
    margin-inline: auto;
  }

  .contact-social {
    padding: var(--k-space-10) 0;
    border-top: 2px solid var(--k-ink);
    border-bottom: 2px solid var(--k-ink);
    text-align: center;
  }

  .contact-social h2 {
    margin: 0 0 var(--k-space-7);
    font-size: clamp(24px, 3.4vw, 34px);
    color: var(--k-ink);
  }

  .social-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--k-space-4);
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    text-decoration: none;
    font-family: var(--k-font-mono);
    font-weight: 700;
    font-size: 18px;
    color: var(--k-ink);
    padding: 0;
  }

  @media (max-width: 672px) {
    .container { padding: 0 var(--k-gutter-mobile); }
    .contact-hero { padding: var(--k-space-8) 0 var(--k-space-9); }
    .contact-actions { padding: var(--k-space-8) 0; }
  }
</style>

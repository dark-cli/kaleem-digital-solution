---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CONTACT } from "../../consts";
import { currentLocale, localizedHref } from "../../lib/i18n";

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const isAr = locale === "ar";
const L = (href: string) => localizedHref(href, locale);

const T = isAr ? {
  title:       "اتصل بنا — كليم",
  description: "تواصل مع فريق كليم في البصرة أو بغداد: اتصل بنا، أو راسلنا على واتساب، أو احجز تقييماً مجانياً لنظامك.",
  eyebrow:     "تواصل معنا",
  h1:          "حدّثنا عن النظام",
  h1b:         "الذي يقيّدك.",
  lede:        `نردّ خلال ساعات العمل: ${CONTACT.hours.ar}. للأمور العاجلة، اتصل بنا مباشرة أو راسلنا على واتساب.`,
  callLabel:   "اتصل",
  whatsappLabel: "واتساب",
  emailLabel:  "البريد الإلكتروني",
  salesLabel:  "المبيعات والمشاريع",
  supportLabel:"الدعم الفني",
  partnersLabel:"الشراكات",
  locHead:     "المكاتب",
  followHead:  "تابعنا",
  bookAudit:   "احجز تقييماً مجانياً",
  auditNote:   "جلسة قصيرة نتعرّف فيها على أنظمتك الحالية وأين تقع بياناتك، ثم نقدّم لك خطة واضحة لاستخراجها وتحديثها — دون أي التزام.",
} : {
  title:       "Contact — Kaleem",
  description: "Get in touch with the Kaleem team in Basra or Baghdad. Call, WhatsApp, or book a free audit of your systems.",
  eyebrow:     "Get in touch",
  h1:          "Tell us about the system",
  h1b:         "that's holding you back.",
  lede:        `We answer during business hours: ${CONTACT.hours.en}. For urgent matters, please call or WhatsApp us directly.`,
  callLabel:   "Call",
  whatsappLabel: "WhatsApp",
  emailLabel:  "Email",
  salesLabel:  "Sales & projects",
  supportLabel:"Technical support",
  partnersLabel:"Partnerships",
  locHead:     "Offices",
  followHead:  "Follow us",
  bookAudit:   "Book a free audit",
  auditNote:   "A short session to understand your current systems and where your data lives, followed by a clear plan to extract and modernize it — no commitment.",
};

const socials = [
  { label: "Facebook",  href: CONTACT.social.facebook,  icon: "F" },
  { label: "Instagram", href: CONTACT.social.instagram, icon: "I" },
  { label: "YouTube",   href: CONTACT.social.youtube,   icon: "Y" },
  { label: "Telegram",  href: CONTACT.social.telegram,  icon: "T" },
  { label: "TikTok",    href: CONTACT.social.tiktok,    icon: "K" },
];
---

<BaseLayout title={T.title} description={T.description}>
  <section class="contact-hero bg-lilac">
    <div class="container">
      <span class="eyebrow">{T.eyebrow}</span>
      <h1 class="contact-h1">{T.h1}<br />{T.h1b}</h1>
      <p class="contact-lede">{T.lede}</p>
    </div>
  </section>

  <section class="contact-actions">
    <div class="container">
      <div class="actions-grid">
        <a class="sk action bg-mint" href={`tel:${CONTACT.phones[0].replace(/\s/g, "")}`}>
          <span class="action-label">{T.callLabel}</span>
          <span class="action-value"><bdi>{CONTACT.phones[0]}</bdi></span>
        </a>
        <a class="sk action bg-butter" href={CONTACT.whatsapp} target="_blank" rel="noopener">
          <span class="action-label">{T.whatsappLabel}</span>
          <span class="action-value"><bdi>{CONTACT.phones[0]}</bdi></span>
        </a>
        <a class="sk action bg-peach" href={CONTACT.mapsUrl} target="_blank" rel="noopener">
          <span class="action-label">{T.locHead}</span>
          <span class="action-value">{(isAr ? CONTACT.offices.ar : CONTACT.offices.en).join(" · ")}</span>
        </a>
      </div>
      <div class="actions-grid emails-grid">
        <a class="sk action bg-sky" href={`mailto:${CONTACT.emails.sales}`}>
          <span class="action-label">{T.salesLabel}</span>
          <span class="action-value">{CONTACT.emails.sales}</span>
        </a>
        <a class="sk action bg-lilac" href={`mailto:${CONTACT.emails.support}`}>
          <span class="action-label">{T.supportLabel}</span>
          <span class="action-value">{CONTACT.emails.support}</span>
        </a>
        <a class="sk action bg-apricot" href={`mailto:${CONTACT.emails.partners}`}>
          <span class="action-label">{T.partnersLabel}</span>
          <span class="action-value">{CONTACT.emails.partners}</span>
        </a>
      </div>
    </div>
  </section>

  <section class="contact-cta">
    <div class="container">
      <div class="sk audit-card bg-paper">
        <h2>{T.bookAudit}</h2>
        <p>{T.auditNote}</p>
        <a class="skb skb-mint" href={L("/audit/")}>
          {T.bookAudit}
        </a>
      </div>
    </div>
  </section>

  <section class="contact-social bg-paper-2">
    <div class="container">
      <h2>{T.followHead}</h2>
      <ul class="social-list">
        {socials.map((s) => (
          <li>
            <a class="sk social-btn bg-sky" href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
              {s.icon}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: var(--k-max);
    margin: 0 auto;
    padding: 0 var(--k-gutter-desktop);
  }

  .contact-hero {
    padding: var(--k-space-10) 0 var(--k-space-11);
    text-align: center;
  }

  .eyebrow {
    display: inline-block;
    font-family: var(--k-font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--k-ink-muted);
    margin-bottom: var(--k-space-4);
  }

  .contact-h1 {
    margin: 0 auto var(--k-space-5);
    max-width: 20ch;
    font-size: clamp(36px, 6vw, 64px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--k-ink);
    font-weight: 700;
  }

  .contact-lede {
    margin: 0 auto;
    max-width: 52ch;
    font-size: 19px;
    line-height: 1.6;
    color: var(--k-ink-muted);
  }

  .contact-actions {
    padding: var(--k-space-10) 0;
  }

  .actions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--k-space-6);
  }
  .emails-grid { margin-top: var(--k-space-6); }

  .action {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
    color: var(--k-ink);
    padding: var(--k-space-6);
  }

  .action-label {
    font-family: var(--k-font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--k-ink-muted);
  }

  .action-value {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--k-ink);
    word-break: break-word;
  }

  .contact-cta {
    padding: 0 0 var(--k-space-11);
  }

  .audit-card {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }

  .audit-card h2 {
    margin: 0;
    font-size: clamp(24px, 3.4vw, 34px);
    color: var(--k-ink);
  }

  .audit-card p {
    color: var(--k-ink-muted);
    font-size: 17px;
    line-height: 1.6;
    max-width: 44ch;
    margin-inline: auto;
  }

  .contact-social {
    padding: var(--k-space-10) 0;
    border-top: 2px solid var(--k-ink);
    border-bottom: 2px solid var(--k-ink);
    text-align: center;
  }

  .contact-social h2 {
    margin: 0 0 var(--k-space-7);
    font-size: clamp(24px, 3.4vw, 34px);
    color: var(--k-ink);
  }

  .social-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--k-space-4);
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    text-decoration: none;
    font-family: var(--k-font-mono);
    font-weight: 700;
    font-size: 18px;
    color: var(--k-ink);
    padding: 0;
  }

  @media (max-width: 672px) {
    .container { padding: 0 var(--k-gutter-mobile); }
    .contact-hero { padding: var(--k-space-8) 0 var(--k-space-9); }
    .contact-actions { padding: var(--k-space-8) 0; }
  }
</style>

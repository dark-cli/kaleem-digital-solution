  .receive li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--k-ink);
  }
  .receive .ico { flex-shrink: 0; }

  /* ─── Terms timeline ─── */
  .terms {
    padding: 80px 0;
    border-top: 2px solid var(--k-ink);
    border-bottom: 2px solid var(--k-ink);
  }
  .timeline {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 24px;
  }
  .timeline::before {
    content: "";
    position: absolute;
    top: 44px;
    inset-inline: 10%;
    border-top: 3px solid var(--k-ink);
  }

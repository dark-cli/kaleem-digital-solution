          <div class="art art-network" aria-hidden="true">
            <svg class="net" viewBox="0 0 440 256">
              <g fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="0.5 8">
                <path d="M220 131L72 34"></path>
                <path d="M220 131L60 196"></path>
                <path d="M220 131V34"></path>
                <path d="M220 131L380 40"></path>
                <path d="M220 131L380 196"></path>

                <rect x="6" y="60" width="56" height="52" fill="#f9d2ae" class="draw"></rect><path d="M34 60v16" class="draw" stroke-width="2.5"></path>
                <rect x="66" y="60" width="56" height="52" fill="#f9d2ae" class="draw"></rect><path d="M94 60v16" class="draw" stroke-width="2.5"></path>

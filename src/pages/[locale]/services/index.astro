  .timeline .badge { width: 88px; height: 88px; margin-bottom: 4px; }
  .timeline strong { font-size: 19px; color: var(--k-ink); }
  .timeline li > span:last-child { font-size: 15px; line-height: 22px; color: var(--k-ink-muted); max-width: 200px; }
  .big { font-size: 16px; font-weight: 600; }
  .num { font-size: 28px; line-height: 30px; font-weight: 600; }
  .unit { font-size: 12px; font-weight: 600; }
  .terms-note { margin: 44px 0 0; font-size: 16px; line-height: 26px; color: var(--k-ink-muted); max-width: 900px; }

  /* ─── CTA ─── */
  .cta { padding: 88px 0; }
  .cta-grid { display: flex; align-items: center; justify-content: space-between; gap: 48px; }
  .cta-text { display: flex; flex-direction: column; align-items: flex-start; gap: 28px; }
  .cta h2 {
    margin: 0;
    max-width: 760px;
    font-family: var(--k-font-serif);
    font-size: 50px;
    line-height: 1.16;
    font-weight: 700;
    color: var(--k-ink);

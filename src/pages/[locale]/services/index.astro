---
/**
 * Services — visual layout from the "Services · visual proposal" artboard
 * on the Kaleem Website design canvas: a clickable index of the six
 * services, the shared five-step method, one illustrated card per
 * service, a shared "you receive" strip and the terms as a timeline.
 *
 * Illustrations are built as rows of small drawings with HTML captions
 * so they reflow on narrow screens and read right-to-left in Arabic
 * (arrows carry .flip-rtl).
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { currentLocale, localizedHref } from "../../../lib/i18n";

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const isAr = locale === "ar";
const L = (href: string) => localizedHref(href, locale);

const T = isAr ? {
  title:       "الخدمات — كليم",
  description: "تحرير الأنظمة، والمواقع وتطبيقات الويب، وتطبيقات الهاتف، وأنظمة الإدارة، والشبكات والأمن، والاستشارات — ست خدمات بطريقة واحدة، وتنتهي كلها بتسليمك المفاتيح.",
  h1a: "ست خدمات.",
  h1b: "وطريقة واحدة.",
  lede: "كل مشروع ينتهي بالطريقة نفسها: بياناتك والكود والحسابات كلها باسمك.",
  navLabel: "الخدمات",
  methodHead: "الخطوات الخمس نفسها، في كل مرة",
  steps: [
    { t: "التقييم", d: "نحدّد أين توجد بياناتك وأنظمتك فعلاً" },
    { t: "الاستخراج والتنظيف", d: "نُخرجها، ونصلحها، ونجعلها مفتوحة" },
    { t: "البناء", d: "بالتقنيات الأنسب للمهمة" },
    { t: "التسليم", d: "كل المفاتيح باسمك" },
    { t: "الدعم", d: "ثم لك حرية البقاء أو المغادرة" },
  ],
  signature: "خدمتنا المميّزة",
  s1: { name: "تحرير الأنظمة", line: "نُخرج بياناتك من الأنظمة المغلقة إلى صيغ مفتوحة — ونعيد المفاتيح إلى يديك.",
        tags: ["المحتوى والوسائط", "سجلات العملاء والمنتجات", "النطاقات القديمة", "ملفك التجاري على Google", "صفحات التواصل الاجتماعي"],
        from: "نظام مقفل", to: "صيغ مفتوحة" },
  s2: { name: "المواقع وتطبيقات الويب", line: "بأي حجم. بالتقنيات الأنسب. وبأقل تكلفة تشغيل ممكنة.",
        scale: ["موقع تعريفي", "متجر إلكتروني", "منصة إدارة"],
        tags: ["العربية والإنجليزية", "مصمّم للهاتف أولاً", "تهيئة لمحركات البحث", "لوحة تحرير لفريقك", "الدفع الإلكتروني"] },
  s3: { name: "تطبيقات الهاتف", line: "أندرويد و iOS، من تطبيق بسيط إلى منصة كاملة — منشورة باسمك.",
        scale: ["تطبيق مرافق", "طلبات وحجوزات", "آلاف المستخدمين"],
        buildHead: "البناء الأنسب لكل تطبيق", buildA: "كود واحد مشترك", buildOr: "أو", buildB: "تطبيق أصلي بالكامل",
        tags: ["الطلبات", "الحجوزات", "برامج الولاء", "التوصيل", "إعادة بناء التطبيقات القديمة"] },
  s4: { name: "أنظمة الإدارة والمتاجر", line: "من نقطة بيع لمتجر واحد إلى منصة متعددة الفروع.",
        scale: ["متجر واحد", "فروع متعددة", "نظام واحد"],
        tags: ["المخزون", "نقاط البيع", "سجلات العملاء", "برامج سطح المكتب", "الانتقال من الورق والجداول"] },
  s5: { name: "الشبكات والأمن", line: "كاميرات، وشبكات منظّمة، وواي فاي للزوار — وكل كلمات المرور بين يديك.",
        cams: "الكاميرات", router: "شبكتك", staff: "الموظفون", guests: "الزوار",
        tags: ["كاميرات المراقبة", "التحكم بالدخول", "واي فاي للموظفين والزوار", "بوابة زوار تعرض موقعك"] },
  s6: { name: "الاستشارات والتدريب", line: "لست متأكداً ماذا تفعل بأنظمتك؟ نساعدك على القرار — ثم ندرّب فريقك على إدارتها.",
        choices: ["نبني", "نشتري", "نُبقي", "نستبدل"],
        tags: ["التخطيط التقني", "تحليل البحث والسوق", "تدريب الموظفين", "تنسيق الحملات"] },
  hostHead: "استضافة على قدر الحاجة",
  hostWeb: ["بلا خوادم، مجاناً", "خادم مخصّص", "خادم فعلي خاص"],
  hostSys: ["سحابة مجانية", "خادم مخصّص", "داخل مقرّك"],
  receiveHead: "مهما بنينا، ستستلم",
  receive: ["كل الحسابات وكلمات المرور", "الكود في حسابك", "النطاق باسمك", "توثيق كامل", "تدريب لفريقك"],
  termsHead: "واضح من البداية",
  terms: [
    { t: "أمر عمل", d: "النطاق، والسعر أو سقف الساعات، والمدة — مكتوبة" },
    { t: "دفعة مقدّمة", d: "والباقي عند التسليم" },
    { t: "التسليم", d: "كل المفاتيح بين يديك" },
    { t: "إصلاحات مجانية", d: "وتعديلات صغيرة" },
    { t: "استشارات مجانية", d: "تشمل جلسة تدريب" },
  ],
  days: "يوماً",
  termsNote: "بالساعة أو بسعر ثابت، مع اشتراك شهري اختياري. الاستضافة والنطاقات والأجهزة تدفعها للمزوّد مباشرة — دون أي زيادة منّا.",
  ctaHead: "لست متأكداً أي خدمة تحتاج؟ ابدأ بتقييم مجاني.",
  ctaLabel: "احجز تقييماً مجانياً",
} : {
  title:       "Services — Kaleem",
  description: "The Jailbreak, websites and web apps, mobile apps, management systems, networks and security, and consulting — six services, one method, and every key handed to you.",
  h1a: "Six services.",
  h1b: "One method.",
  lede: "Every project ends the same way: your data, code and accounts in your name.",
  navLabel: "Services",
  methodHead: "The same five steps, every time",
  steps: [
    { t: "Audit", d: "Find where your data and systems really are" },
    { t: "Extract & clean", d: "Get it out, fix it, make it open" },
    { t: "Build", d: "On the right stack for the job" },
    { t: "Hand over", d: "Every key, in your name" },
    { t: "Support", d: "Then you're free to stay or go" },
  ],
  signature: "Our signature",
  s1: { name: "The Jailbreak", line: "Your data out of locked systems, into open formats — and the keys back in your hands.",
        tags: ["Content & media", "Customer & product records", "Old domains", "Google Business", "Social pages"],
        from: "Locked system", to: "Open formats" },
  s2: { name: "Websites & web apps", line: "Any size. The right stack. The leanest way to run it.",
        scale: ["Portfolio", "Online shop", "Management platform"],
        tags: ["Arabic + English", "Mobile-first", "SEO", "Editor for your team", "Payments"] },
  s3: { name: "Mobile apps", line: "Android and iOS, from a simple app to a full platform — published in your name.",
        scale: ["Companion app", "Ordering & booking", "Thousands of users"],
        buildHead: "The right build for each app", buildA: "One shared codebase", buildOr: "or", buildB: "Fully native",
        tags: ["Ordering", "Booking", "Loyalty", "Delivery", "Old app rebuilds"] },
  s4: { name: "Management & store systems", line: "From one shop's point of sale to a multi-branch platform.",
        scale: ["One shop", "Many branches", "One system"],
        tags: ["Inventory", "Point of sale", "Customer records", "Desktop apps", "From paper & spreadsheets"] },
  s5: { name: "Networks & security", line: "Cameras, organised networks and guest Wi-Fi — with every password in your hands.",
        cams: "Cameras", router: "Your network", staff: "Staff", guests: "Guests",
        tags: ["Surveillance cameras", "Access control", "Staff & guest Wi-Fi", "Guest portal with your website"] },
  s6: { name: "Consulting & training", line: "Not sure what to do with your systems? We help you decide — then train your team to run them.",
        choices: ["Build", "Buy", "Keep", "Replace"],
        tags: ["Technology planning", "Search & market analysis", "Staff training", "Campaign coordination"] },
  hostHead: "Hosting sized to the job",
  hostWeb: ["Free serverless", "Dedicated server", "Bare metal"],
  hostSys: ["Free cloud", "Dedicated server", "On your premises"],
  receiveHead: "Whatever we build, you receive",
  receive: ["Every account & password", "The code, in your account", "Domain in your name", "Full documentation", "Training for your team"],
  termsHead: "Clear from the start",
  terms: [
    { t: "Work order", d: "Scope, price or hour cap, and timeline — in writing" },
    { t: "Up front", d: "The rest on delivery" },
    { t: "Handover", d: "Every key in your hands" },
    { t: "Free fixes", d: "And small edits" },
    { t: "Free advice", d: "Including a training session" },
  ],
  days: "days",
  termsNote: "By the hour or fixed price, with an optional monthly plan. Hosting, domains and hardware are paid to the provider directly — never marked up.",
  ctaHead: "Not sure which one you need? Start with a free audit.",
  ctaLabel: "Book a free audit",
};

// 32×32 line icons, shared with the homepage service cards.
const ICON = {
  jailbreak: `<path d="M18 6H6V26H26V14"></path><rect x="20" y="3" width="9" height="9" fill="#faf6ee"></rect>`,
  web:       `<rect x="4" y="6" width="24" height="20" rx="2"></rect><path d="M4 11h24"></path><path d="M8 8.5h1M11 8.5h1"></path>`,
  mobile:    `<rect x="10" y="3" width="12" height="26" rx="3"></rect><path d="M14 25h4"></path>`,
  systems:   `<ellipse cx="16" cy="8" rx="10" ry="4"></ellipse><path d="M6 8v16c0 2.2 4.5 4 10 4s10-1.8 10-4V8"></path><path d="M6 16c0 2.2 4.5 4 10 4s10-1.8 10-4"></path>`,
  networks:  `<path d="M4 9l18-4l2 9l-18 4z"></path><path d="M14 16v8H6"></path><circle cx="20" cy="10" r="1.5"></circle>`,
  consulting:`<path d="M5 6h22v14H14l-6 5v-5H5z"></path><path d="M10 11h12M10 15h8"></path>`,
  search:    `<circle cx="14" cy="14" r="8"></circle><path d="M20 20l7 7"></path>`,
  extract:   `<path d="M18 6H6V26H26V14"></path><path d="M16 16l11-11M20 5h7v7"></path>`,
  build:     `<rect x="4" y="18" width="10" height="10"></rect><rect x="18" y="18" width="10" height="10"></rect><rect x="11" y="4" width="10" height="10"></rect>`,
  key:       `<circle cx="10" cy="16" r="6"></circle><path d="M16 16h13M24 16v5M28 16v3"></path>`,
  heart:     `<path d="M16 27s-10-6-10-13a6 6 0 0 1 10-4a6 6 0 0 1 10 4c0 7-10 13-10 13z"></path>`,
  code:      `<path d="M11 9l-7 7l7 7M21 9l7 7l-7 7"></path>`,
  globe:     `<circle cx="16" cy="16" r="12"></circle><path d="M4 16h24M16 4c-5 6-5 18 0 24M16 4c5 6 5 18 0 24"></path>`,
  doc:       `<path d="M8 4h12l6 6v18H8z"></path><path d="M20 4v6h6M12 16h10M12 21h8"></path>`,
  team:      `<circle cx="12" cy="10" r="4"></circle><circle cx="23" cy="12" r="3"></circle><path d="M4 26c0-5 4-8 8-8s8 3 8 8M19 20c4 0 9 2 9 6"></path>`,
};

const TILES = [
  { id: "jailbreak",  icon: ICON.jailbreak,  bg: "bg-butter",  name: T.s1.name },
  { id: "websites",   icon: ICON.web,        bg: "bg-paper",   name: T.s2.name },
  { id: "mobile",     icon: ICON.mobile,     bg: "bg-peach",   name: T.s3.name },
  { id: "systems",    icon: ICON.systems,    bg: "bg-mint",    name: T.s4.name },
  { id: "networks",   icon: ICON.networks,   bg: "bg-apricot", name: T.s5.name },
  { id: "consulting", icon: ICON.consulting, bg: "bg-lilac",   name: T.s6.name },
];

const STEP_STYLE = [
  { icon: ICON.search,  bg: "bg-sky" },
  { icon: ICON.extract, bg: "bg-butter" },
  { icon: ICON.build,   bg: "bg-mint" },
  { icon: ICON.key,     bg: "bg-lilac" },
  { icon: ICON.heart,   bg: "bg-peach" },
];

const RECEIVE_ICONS = [ICON.key, ICON.code, ICON.globe, ICON.doc, ICON.team];

const TERM_BADGES = [
  { icon: ICON.doc, bg: "bg-paper" },
  { text: "30–50%", bg: "bg-butter" },
  { icon: ICON.key, bg: "bg-mint" },
  { num: "14", bg: "bg-sky" },
  { num: "60", bg: "bg-lilac" },
];

const ARROW = `<path d="M4 12h52M48 5l8 7l-8 7" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="1 7"></path>`;
---

<BaseLayout title={T.title} description={T.description}>
  <!-- ─── HERO: headline + clickable index of the six services ─── -->
  <section class="svc-hero bg-sky">
    <div class="container hero-grid">
      <div class="hero-text">
        <h1>{T.h1a}<br />{T.h1b}</h1>
        <p class="hero-lede">{T.lede}</p>
      </div>
      <nav class="tiles" aria-label={T.navLabel}>
        {TILES.map((t) => (
          <a class={`tile lift ${t.bg}`} href={`#${t.id}`}>
            <svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true" set:html={t.icon}></svg>
            <span>{t.name}</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- ─── ONE METHOD: five steps ─── -->
  <section class="method">
    <div class="container">
      <h2 class="sec-h2">{T.methodHead}</h2>
      <ol class="steps">
        {T.steps.map((s, i) => (
          <li class="step">
            <div class="step-row">
              <span class={`badge card ${STEP_STYLE[i].bg}`}>
                <svg class="ico" width="44" height="44" viewBox="0 0 32 32" aria-hidden="true" set:html={STEP_STYLE[i].icon}></svg>
              </span>
              {i < T.steps.length - 1 && (
                <svg class="step-arrow flip-rtl" viewBox="0 0 60 24" aria-hidden="true" set:html={ARROW}></svg>
              )}
            </div>
            <span class="step-num">0{i + 1}</span>
            <strong class="step-title">{s.t}</strong>
            <span class="step-desc">{s.d}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ─── SERVICES ─── -->
  <section class="services">
    <div class="container services-stack">

      <!-- The Jailbreak — full width, signature -->
      <article id="jailbreak" class="card svc svc-wide bg-butter">
        <div class="svc-body">
          <span class="k-tag bg-paper signature">{T.signature}</span>
          <h2>{T.s1.name}</h2>
          <p class="svc-line">{T.s1.line}</p>
          <ul class="chips">{T.s1.tags.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="art art-jailbreak" aria-hidden="true">
          <figure>
            <svg viewBox="0 0 160 170" width="150">
              <path d="M45 62v-22a35 35 0 0 1 70 0v22" class="draw"></path>
              <rect x="10" y="62" width="140" height="100" rx="6" fill="#d9ccf0" class="draw"></rect>
              <path d="M30 100c18-26 36 26 54 0s28 18 44-8M34 136c22-18 40 18 62-4s22 8 32 0" class="draw" stroke-width="2.5"></path>
            </svg>
            <figcaption>{T.s1.from}</figcaption>
          </figure>
          <svg class="art-arrow flip-rtl" viewBox="0 0 60 24" set:html={ARROW}></svg>
          <figure>
            <ul class="files">
              <li>.md</li><li>.csv</li><li>.json</li><li>.sql</li>
            </ul>
            <figcaption>{T.s1.to}</figcaption>
          </figure>
        </div>
      </article>

      <div class="svc-grid">
        <!-- Websites -->
        <article id="websites" class="card svc bg-sky">
          <div class="art art-scale" aria-hidden="true">
            <figure>
              <svg viewBox="0 0 124 84" width="100"><rect x="2" y="2" width="120" height="80" fill="#faf6ee" class="draw"></rect><path d="M2 18h120" class="draw" stroke-width="2"></path><path d="M20 42h60M20 58h40" class="draw" stroke-width="2"></path></svg>
              <figcaption>{T.s2.scale[0]}</figcaption>
            </figure>
            <figure>
              <svg viewBox="0 0 164 120" width="132"><rect x="2" y="2" width="160" height="116" fill="#faf6ee" class="draw"></rect><path d="M2 18h160" class="draw" stroke-width="2"></path><rect x="18" y="32" width="40" height="36" fill="#f8c9b8" class="draw" stroke-width="2"></rect><rect x="66" y="32" width="40" height="36" fill="#bfe6d6" class="draw" stroke-width="2"></rect><rect x="114" y="32" width="36" height="36" fill="#f7e7b0" class="draw" stroke-width="2"></rect><path d="M18 90h80" class="draw" stroke-width="2"></path></svg>
              <figcaption>{T.s2.scale[1]}</figcaption>
            </figure>
            <figure>
              <svg viewBox="0 0 184 164" width="150"><rect x="2" y="2" width="180" height="160" fill="#faf6ee" class="draw"></rect><path d="M2 18h180" class="draw" stroke-width="2"></path><rect x="16" y="32" width="44" height="116" fill="#d9ccf0" class="draw" stroke-width="2"></rect><path d="M72 42h94M72 62h70" class="draw" stroke-width="2"></path><path d="M74 138l20-30l18 16l24-36l22 20" class="draw" stroke-width="2.5"></path></svg>
              <figcaption>{T.s2.scale[2]}</figcaption>
            </figure>
          </div>
          <h2>{T.s2.name}</h2>
          <p class="svc-line">{T.s2.line}</p>
          <div class="panel">
            <span class="panel-head">{T.hostHead}</span>
            <div class="meter" aria-hidden="true"><span class="bg-mint"></span><span class="bg-butter"></span><span class="bg-peach"></span></div>
            <ul class="meter-labels">{T.hostWeb.map((h) => <li>{h}</li>)}</ul>
          </div>
          <ul class="chips">{T.s2.tags.map((t) => <li>{t}</li>)}</ul>
        </article>

        <!-- Mobile apps -->
        <article id="mobile" class="card svc bg-peach">
          <div class="art art-scale" aria-hidden="true">
            <figure>
              <svg viewBox="0 0 54 88" width="46"><rect x="2" y="2" width="50" height="84" rx="8" fill="#faf6ee" class="draw"></rect><path d="M20 76h14" class="draw" stroke-width="2"></path><circle cx="27" cy="34" r="10" fill="#f7e7b0" class="draw" stroke-width="2"></circle></svg>
              <figcaption>{T.s3.scale[0]}</figcaption>
            </figure>
            <figure>
              <svg viewBox="0 0 76 132" width="66"><rect x="2" y="2" width="72" height="128" rx="10" fill="#faf6ee" class="draw"></rect><path d="M30 118h16" class="draw" stroke-width="2"></path><rect x="14" y="18" width="48" height="20" fill="#bfe6d6" class="draw" stroke-width="2"></rect><rect x="14" y="46" width="48" height="20" fill="#bfe6d6" class="draw" stroke-width="2"></rect><rect x="14" y="74" width="48" height="20" fill="#bfe6d6" class="draw" stroke-width="2"></rect></svg>
              <figcaption>{T.s3.scale[1]}</figcaption>
            </figure>
            <figure>
              <svg viewBox="0 0 96 174" width="86"><rect x="2" y="2" width="92" height="170" rx="12" fill="#faf6ee" class="draw"></rect><path d="M38 158h20" class="draw" stroke-width="2"></path><rect x="14" y="18" width="68" height="44" fill="#d9ccf0" class="draw" stroke-width="2"></rect><path d="M16 82h64M16 100h48M16 118h60M16 136h40" class="draw" stroke-width="2"></path></svg>
              <figcaption>{T.s3.scale[2]}</figcaption>
            </figure>
          </div>
          <h2>{T.s3.name}</h2>
          <p class="svc-line">{T.s3.line}</p>
          <div class="panel">
            <span class="panel-head">{T.s3.buildHead}</span>
            <div class="either">
              <span class="bg-butter">{T.s3.buildA}</span>
              <em>{T.s3.buildOr}</em>
              <span class="bg-lilac">{T.s3.buildB}</span>
            </div>
          </div>
          <ul class="chips">{T.s3.tags.map((t) => <li>{t}</li>)}</ul>
        </article>

        <!-- Management & store systems -->
        <article id="systems" class="card svc bg-mint">
          <div class="art art-scale" aria-hidden="true">
            <figure>
              <svg viewBox="0 0 104 90" width="96"><path d="M2 30l14-26h72l14 26z" fill="#f8c9b8" class="draw"></path><rect x="10" y="30" width="84" height="56" fill="#faf6ee" class="draw"></rect><rect x="38" y="52" width="28" height="34" fill="#f7e7b0" class="draw" stroke-width="2"></rect></svg>
              <figcaption>{T.s4.scale[0]}</figcaption>
            </figure>
            <figure>
              <svg viewBox="0 0 64 140" width="56">
                <path d="M4 22l8-16h40l8 16z" fill="#f8c9b8" class="draw" stroke-width="2.5"></path><rect x="8" y="22" width="48" height="24" fill="#faf6ee" class="draw" stroke-width="2.5"></rect>
                <path d="M4 70l8-16h40l8 16z" fill="#f8c9b8" class="draw" stroke-width="2.5"></path><rect x="8" y="70" width="48" height="24" fill="#faf6ee" class="draw" stroke-width="2.5"></rect>
                <path d="M4 118l8-16h40l8 16z" fill="#f8c9b8" class="draw" stroke-width="2.5"></path><rect x="8" y="118" width="48" height="20" fill="#faf6ee" class="draw" stroke-width="2.5"></rect>

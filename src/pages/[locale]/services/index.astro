              <!-- Cameras: wall-mounted bullet + ceiling dome -->
              <rect x="16" y="12" width="8" height="28" rx="2" fill="#faf6ee" class="draw" stroke-width="2.5"></rect>
              <rect x="28" y="16" width="36" height="18" rx="3" fill="#d9ccf0" class="draw" stroke-width="2.5"></rect>
              <path d="M24 30l6-4M26 11h44v5" class="draw" stroke-width="2.5"></path>
              <circle cx="66" cy="25" r="7" fill="#faf6ee" class="draw" stroke-width="2.5"></circle><circle cx="66" cy="25" r="2.5" fill="#1f1f1f"></circle>
              <rect x="84" y="14" width="42" height="6" rx="2" fill="#faf6ee" class="draw" stroke-width="2.5"></rect>
              <path d="M90 20a15 15 0 0 0 30 0" fill="#c6ddf0" class="draw" stroke-width="2.5"></path><circle cx="105" cy="28" r="3" fill="#1f1f1f"></circle>
              <text class="net-label" x="72" y="70" text-anchor="middle">{T.s5.cams}</text>
              <!-- Recorder: screen with four feeds -->
              <rect x="22" y="168" width="76" height="50" rx="3" fill="#faf6ee" class="draw" stroke-width="2.5"></rect>
              <rect x="28" y="174" width="31" height="18" fill="#c6ddf0" class="draw" stroke-width="2"></rect><rect x="62" y="174" width="30" height="18" fill="#bfe6d6" class="draw" stroke-width="2"></rect>
              <rect x="28" y="195" width="31" height="17" fill="#bfe6d6" class="draw" stroke-width="2"></rect><rect x="62" y="195" width="30" height="17" fill="#c6ddf0" class="draw" stroke-width="2"></rect>
              <path d="M60 218v8M48 227h24" class="draw" stroke-width="2.5"></path>
              <text class="net-label" x="60" y="250" text-anchor="middle">{T.s5.recorder}</text>
              <!-- Server: three rack units -->
              <rect x="188" y="4" width="64" height="16" rx="2" fill="#bfe6d6" class="draw" stroke-width="2.5"></rect>
              <rect x="188" y="22" width="64" height="16" rx="2" fill="#bfe6d6" class="draw" stroke-width="2.5"></rect>
              <rect x="188" y="40" width="64" height="16" rx="2" fill="#bfe6d6" class="draw" stroke-width="2.5"></rect>
              <path d="M196 12h22M196 30h22M196 48h22" class="draw" stroke-width="2"></path>
              <circle cx="242" cy="12" r="2.5" fill="#1f1f1f"></circle><circle cx="242" cy="30" r="2.5" fill="#1f1f1f"></circle><circle cx="242" cy="48" r="2.5" fill="#1f1f1f"></circle>
              <text class="net-label" x="220" y="78" text-anchor="middle">{T.s5.server}</text>
              <!-- Router with Wi-Fi, at the centre -->
              <path d="M209 106a15 15 0 0 1 22 0M201 98a26 26 0 0 1 38 0" class="draw" stroke-width="2.5"></path>
              <path d="M198 120l-6-16M242 120l6-16" class="draw" stroke-width="2.5"></path>
              <rect x="182" y="118" width="76" height="26" rx="6" fill="#faf6ee" class="draw"></rect>
              <circle cx="198" cy="131" r="3" fill="#bfe6d6" stroke="#1f1f1f" stroke-width="2"></circle><circle cx="210" cy="131" r="3" fill="#bfe6d6" stroke="#1f1f1f" stroke-width="2"></circle><circle cx="222" cy="131" r="3" fill="#f7e7b0" stroke="#1f1f1f" stroke-width="2"></circle>
              <text class="net-label" x="220" y="166" text-anchor="middle">{T.s5.router}</text>
              <!-- Staff network: laptop -->
              <rect x="352" y="14" width="56" height="34" rx="3" fill="#c6ddf0" class="draw" stroke-width="2.5"></rect>
              <path d="M342 48h76l-6 10h-64z" fill="#faf6ee" class="draw" stroke-width="2.5"></path>
              <text class="net-label" x="380" y="80" text-anchor="middle">{T.s5.staff}</text>
              <!-- Guest Wi-Fi: phone -->
              <rect x="366" y="170" width="28" height="46" rx="5" fill="#bfe6d6" class="draw" stroke-width="2.5"></rect>
              <path d="M376 209h8" class="draw" stroke-width="2.5"></path>
              <path d="M402 184a9 9 0 0 1 12 0M398 177a16 16 0 0 1 20 0" class="draw" stroke-width="2"></path>
              <text class="net-label" x="380" y="240" text-anchor="middle">{T.s5.guests}</text>
            </svg>
          </div>
          <h2>{T.s5.name}</h2>
          <p class="svc-line">{T.s5.line}</p>
          <ul class="chips">{T.s5.tags.map((t) => <li>{t}</li>)}</ul>
        </article>
      </div>

      <!-- Consulting — full width -->
      <article id="consulting" class={`card svc svc-wide ${SERVICE_BG.consulting}`}>
        <div class="svc-body">
          <h2>{T.s6.name}</h2>
          <p class="svc-line">{T.s6.line}</p>
          <ul class="chips">{T.s6.tags.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="art art-decide" aria-hidden="true">
          <div class="question" data-sky role="img" aria-label="?"></div>
          <svg class="branches flip-rtl" viewBox="0 0 120 200" preserveAspectRatio="none">
            <path d="M0 100c50 0 60-76 112-80M0 100c50 0 60-24 112-28M0 100c50 0 60 24 112 28M0 100c50 0 60 76 112 80" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round"></path>
            <path d="M104 13l10 7l-10 7M104 65l10 7l-10 7M104 121l10 7l-10 7M104 173l10 7l-10 7" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <ul class="choices">
            <li class="bg-butter">{T.s6.choices[0]}</li>
            <li class="bg-sky">{T.s6.choices[1]}</li>
            <li class="bg-mint">{T.s6.choices[2]}</li>
            <li class="bg-peach">{T.s6.choices[3]}</li>
          </ul>
        </div>
      </article>

      <!-- You receive — one strip for every service -->
      <div class="receive">
        <h2 class="sec-h3">{T.receiveHead}</h2>
        <ul>
          {T.receive.map((r, i) => (
            <li>
              <svg class="ico" width="36" height="36" viewBox="0 0 32 32" aria-hidden="true" set:html={RECEIVE_ICONS[i]}></svg>
              {r}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>


</BaseLayout>

<style>
  .container {
    max-width: var(--k-max);
    margin: 0 auto;
    padding: 0 var(--k-gutter-desktop);
  }

  /* Sketch card without the global .sk child margins/padding, so grid
     and flex gaps stay in control. */
  .card {
    border: var(--k-line) solid var(--k-ink);
    border-radius: var(--k-radius-sketch);
    box-shadow: 4px 4px 0 -2px var(--k-paper), 4px 4px 0 0 var(--k-ink);
    color: var(--k-ink);
  }

  /* Stroke style for the drawings. Shapes with their own fill attribute
     keep it; CSS fill would otherwise override the presentation attribute. */
  .draw { stroke: var(--k-ink); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .draw:not([fill]) { fill: none; }
  .mono { font-family: var(--k-font-mono); }
  :global(html[dir="rtl"]) .flip-rtl { transform: scaleX(-1); }

  .sec-h2 {
    margin: 0 0 40px;
    font-family: var(--k-font-serif);
    font-size: 40px;
    line-height: 1.2;
    font-weight: 700;
    color: var(--k-ink);
  }
  .sec-h3 {
    margin: 0;
    font-family: var(--k-font-serif);
    font-size: 30px;
    line-height: 1.2;
    font-weight: 700;
    color: var(--k-ink);
  }

  /* ─── Hero ─── */
  .svc-hero { padding: 80px 0 88px; border-bottom: 2px solid var(--k-ink); }
  .hero-grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 64px;
    align-items: center;
  }
  .hero-text { display: flex; flex-direction: column; gap: 22px; }
  .hero-text h1 {
    margin: 0;
    font-family: var(--k-font-serif);
    font-size: 68px;
    line-height: 1.06;
    font-weight: 700;
    letter-spacing: -1px;
    color: var(--k-ink);
  }
  .hero-lede { margin: 0; font-size: 21px; line-height: 34px; max-width: 460px; color: var(--k-ink); }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .tile {
    min-height: 132px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 19px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--k-ink);
    text-decoration: none;
  }

  /* Elevated behaviour, matching the .skb buttons: lift on hover/focus,
     press on click. */
  .lift {
    border: var(--k-line) solid var(--k-ink);
    border-radius: var(--k-radius-sketch);
    box-shadow: 4px 4px 0 -2px var(--k-paper), 4px 4px 0 0 var(--k-ink);
    transition: transform 140ms cubic-bezier(0.2, 0.9, 0.3, 1.2),
                box-shadow 140ms cubic-bezier(0.2, 0.9, 0.3, 1.2);
  }
  .lift:hover, .lift:focus-visible {
    color: var(--k-ink);
    text-decoration: none;
    transform: translate(-4px, -4px);
    box-shadow: 8px 8px 0 -2px var(--k-paper), 8px 8px 0 0 var(--k-ink);
  }
  .lift:active {
    transform: translate(-1px, -1px);
    box-shadow: 5px 5px 0 -2px var(--k-paper), 5px 5px 0 0 var(--k-ink);
  }
  @media (prefers-reduced-motion: reduce) { .lift { transition: none; } }

  /* ─── Method ─── */
  .method { padding: 72px 0 80px; }
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  /* Each step is centered in its column; the arrow sits in the gap
     between this badge and the next one. */
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }
  .step-row { display: flex; justify-content: center; width: 100%; margin-bottom: 6px; }
  .badge {
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .step-arrow {
    position: absolute;
    top: 36px;
    inset-inline-start: calc(50% + 60px);
    width: calc(100% - 120px);
    height: 24px;
  }
  .step-num { font-family: var(--k-font-mono); font-size: 14px; color: var(--k-ink-muted); }
  .step-title { font-size: 20px; color: var(--k-ink); }
  .step-desc { font-size: 15px; line-height: 22px; color: var(--k-ink-muted); max-width: 200px; }

  /* ─── Services ─── */
  .services { padding: 16px 0 96px; }
  .services-stack { display: flex; flex-direction: column; gap: 40px; }
  .svc-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; }
  .svc {
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    scroll-margin-top: 120px;
  }
  .svc-wide {
    padding: 44px 48px;
    display: grid;
    grid-template-columns: 6fr 5fr;
    gap: 56px;
    align-items: center;
  }
  .svc-body { display: flex; flex-direction: column; gap: 18px; }
  .signature { align-self: flex-start; }
  .sky-tag { color: var(--k-butter); }
  .svc h2 {
    margin: 0;
    font-family: var(--k-font-serif);
    font-size: 34px;
    line-height: 1.2;
    font-weight: 700;
    color: var(--k-ink);
  }
  .svc-wide h2 { font-size: 44px; }
  .svc-line { margin: 0; font-size: 18px; line-height: 29px; color: var(--k-ink); max-width: 560px; }
  .svc-wide .svc-line { font-size: 20px; line-height: 32px; }

  .chips {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips li {
    min-height: 30px;
    padding: 2px 12px;
    display: inline-flex;
    align-items: center;
    border: 1.5px solid var(--k-ink);
    border-radius: var(--k-radius-pill);
    background: var(--k-paper);
    font-size: 13px;
    font-weight: 600;
    color: var(--k-ink);
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 18px;
    background: var(--k-paper);
    border: 2px dashed var(--k-ink);
  }
  .panel-head { font-size: 13px; font-weight: 700; color: var(--k-ink); }

  /* Hosting scale: a line with three stops, labels under each end/middle. */
  .meter {
    position: relative;
    display: flex;
    justify-content: space-between;
    margin: 4px 0;
  }
  .meter::before {
    content: "";
    position: absolute;
    inset-inline: 8px;
    top: 50%;
    border-top: 2.5px solid var(--k-ink);
  }
  .meter span {
    position: relative;
    width: 16px;
    height: 16px;
    border: 2.5px solid var(--k-ink);
    border-radius: 50%;
  }
  .meter-labels {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
    color: var(--k-ink-muted);
  }
  .meter-labels li:nth-child(2) { text-align: center; }
  .meter-labels li:last-child { text-align: end; }

  .either { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; }
  .either span {
    min-height: 34px;
    padding: 4px 14px;
    display: inline-flex;
    align-items: center;
    border: 1.5px solid var(--k-ink);
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--k-ink);
  }
  .either em { font-style: normal; font-family: var(--k-font-mono); font-size: 13px; color: var(--k-ink-muted); }

  /* Illustrations: rows of drawings with captions. */
  .art { display: flex; align-items: flex-end; gap: 16px; }
  .art figure {
    min-width: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .art figcaption { font-size: 13px; font-weight: 600; color: var(--k-ink); text-align: center; }
  .art svg { max-width: 100%; height: auto; }
  .art-scale { justify-content: space-between; min-height: 200px; }
  .art-arrow { width: 56px; height: 24px; flex-shrink: 0; align-self: center; }

  .art-jailbreak { justify-content: center; align-items: center; gap: 28px; }
  .files {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .files-sky {
    padding: 16px;
    border: var(--k-line) solid var(--k-ink);
    border-radius: var(--k-radius-sketch);
    box-shadow: 4px 4px 0 -2px var(--k-paper), 4px 4px 0 0 var(--k-ink);
  }
  .files li {
    width: 150px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2.5px solid var(--k-chalk);
    border-radius: 3px;
    background: rgba(29, 35, 32, 0.55);
    color: var(--k-chalk);
    font-family: var(--k-font-mono);
    font-size: 17px;
    font-weight: 600;
    direction: ltr;
  }

  .art-network { justify-content: center; }
  .net { width: 100%; max-width: 440px; height: auto; }
  .net-label {
    font-size: 14px;
    font-weight: 700;
    fill: var(--k-ink);
    stroke: var(--k-apricot);
    stroke-width: 6px;
    stroke-linejoin: round;
    paint-order: stroke;
  }

  .art-decide { justify-content: center; align-items: center; gap: 0; }
  .question {
    width: 160px;
    height: 160px;
    flex-shrink: 0;
    margin-inline: auto;
    -webkit-mask-image: url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 160 160' preserveAspectRatio='xMidYMid meet'%3E%3Ctext x='80' y='80' font-family='Georgia, serif' font-size='140' font-weight='700' text-anchor='middle' dominant-baseline='central' fill='black'%3E?%3C/text%3E%3C/svg%3E");
    mask-image: url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 160 160' preserveAspectRatio='xMidYMid meet'%3E%3Ctext x='80' y='80' font-family='Georgia, serif' font-size='140' font-weight='700' text-anchor='middle' dominant-baseline='central' fill='black'%3E?%3C/text%3E%3C/svg%3E");
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    background-color: transparent !important;
  }
  .branches { width: 110px; height: 200px; flex-shrink: 0; }
  .choices {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .choices li {
    width: 150px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2.5px solid var(--k-ink);
    font-size: 16px;
    font-weight: 700;
    color: var(--k-ink);
  }

  /* You receive */
  .receive {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 32px 36px;
    border: 2px dashed var(--k-ink);
    background: var(--k-paper);
  }
  .receive ul {

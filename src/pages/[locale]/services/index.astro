  .cta-key { flex-shrink: 0; }

  /* ─── Responsive ─── */
  @media (max-width: 1055px) {
    .hero-grid { grid-template-columns: 1fr; gap: 40px; }
    .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 40px; }
    .step:nth-child(3) .step-arrow { visibility: hidden; }
    .svc-grid { grid-template-columns: minmax(0, 1fr); }
    .svc-wide { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .receive ul { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .timeline { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 40px; }
    .timeline::before { display: none; }
    .cta-key { display: none; }
  }

  @media (max-width: 671px) {
    .container { padding: 0 var(--k-gutter-mobile); }
    .svc-hero { padding: 56px 0 64px; }
    .hero-text h1 { font-size: 44px; }
    .hero-lede { font-size: 18px; line-height: 30px; }
    .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .tile { min-height: 112px; padding: 16px; font-size: 16px; }
    .method { padding: 56px 0; }
    .sec-h2 { font-size: 32px; margin-bottom: 28px; }
    .steps { grid-template-columns: 1fr; row-gap: 24px; }
    .step { display: grid; grid-template-columns: 72px 1fr; column-gap: 16px; row-gap: 2px; align-items: start; }
    .step-row { grid-row: 1 / span 3; margin: 0; }
    .step .badge { width: 72px; height: 72px; }
    .step-arrow { display: none; }
    .step-desc { max-width: none; }
    .services { padding: 8px 0 56px; }
    .services-stack, .svc-grid { gap: 28px; }
    .svc, .svc-wide { padding: 24px; }
    .svc h2, .svc-wide h2 { font-size: 28px; }
    .art-scale, .art-network { min-height: 0; }
    /* Figures shrink in proportion to their drawn size (flex-shrink is
       weighted by basis), so small → large stays readable. */
    .art-scale { gap: 10px; }
    .art-arrow { width: 32px; }
    .art-jailbreak svg:first-child { width: 110px; }
    .files li { width: 110px; height: 36px; font-size: 15px; }
    .nets span { width: 80px; height: 44px; font-size: 13px; }
    .cams svg { width: 44px; }
    .art-network > figure > svg { width: 72px; }
    .branches { width: 64px; }
    .choices li { width: 116px; }
    .receive { padding: 24px; }
    .receive ul { grid-template-columns: 1fr; gap: 14px; }
    .terms { padding: 56px 0; }
    .timeline { grid-template-columns: 1fr; gap: 20px; }
    .timeline li { display: grid; grid-template-columns: 72px 1fr; column-gap: 16px; text-align: start; align-items: center; }
    .timeline .badge { width: 72px; height: 72px; grid-row: 1 / span 2; margin: 0; }
    .timeline li > span:last-child { max-width: none; }
    .num { font-size: 24px; line-height: 26px; }
    .big { font-size: 14px; }
    .cta { padding: 56px 0; }
    .cta h2 { font-size: 34px; }
  }
</style>

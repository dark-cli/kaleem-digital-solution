        <!-- Networks & security -->
        <article id="networks" class="card svc bg-apricot">
          <div class="art art-network" aria-hidden="true">
            <figure>
              <div class="cams">
                <svg viewBox="0 0 64 56" width="58"><path d="M4 16l48-12l6 24l-48 12z" fill="#d9ccf0" class="draw"></path><path d="M30 34v18H14" class="draw" stroke-width="2.5"></path></svg>
                <svg viewBox="0 0 64 56" width="58"><path d="M4 16l48-12l6 24l-48 12z" fill="#d9ccf0" class="draw"></path><path d="M30 34v18H14" class="draw" stroke-width="2.5"></path></svg>
              </div>
              <figcaption>{T.s5.cams}</figcaption>
            </figure>
            <svg class="art-arrow flip-rtl" viewBox="0 0 60 24" set:html={ARROW}></svg>
            <figure>
              <svg viewBox="0 0 104 76" width="96"><path d="M24 30l-10-26M80 30l10-26" class="draw" stroke-width="2.5"></path><rect x="2" y="30" width="100" height="44" rx="6" fill="#faf6ee" class="draw"></rect><circle cx="26" cy="52" r="5" fill="#bfe6d6" stroke="#1f1f1f" stroke-width="2"></circle><circle cx="46" cy="52" r="5" fill="#bfe6d6" stroke="#1f1f1f" stroke-width="2"></circle></svg>
              <figcaption>{T.s5.router}</figcaption>
            </figure>
            <svg class="art-arrow flip-rtl" viewBox="0 0 60 24" set:html={ARROW}></svg>
            <div class="nets">
              <span class="bg-sky">{T.s5.staff}</span>
              <span class="bg-mint">{T.s5.guests}</span>
            </div>
          </div>
          <h2>{T.s5.name}</h2>
          <p class="svc-line">{T.s5.line}</p>
          <ul class="chips">{T.s5.tags.map((t) => <li>{t}</li>)}</ul>
        </article>
      </div>

      <!-- Consulting — full width -->
      <article id="consulting" class="card svc svc-wide bg-lilac">
        <div class="svc-body">
          <h2>{T.s6.name}</h2>
          <p class="svc-line">{T.s6.line}</p>
          <ul class="chips">{T.s6.tags.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="art art-decide" aria-hidden="true">
          <span class="question">?</span>
          <svg class="branches flip-rtl" viewBox="0 0 120 200" preserveAspectRatio="none">
            <path d="M0 100c50 0 60-76 120-80M0 100c50 0 60-24 120-28M0 100c50 0 60 24 120 28M0 100c50 0 60 76 120 80" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="1 7"></path>
          </svg>
          <ul class="choices">
            <li class="bg-butter">{T.s6.choices[0]}</li>
            <li class="bg-sky">{T.s6.choices[1]}</li>
            <li class="bg-mint">{T.s6.choices[2]}</li>
            <li class="bg-peach">{T.s6.choices[3]}</li>
          </ul>
        </div>
      </article>

      <!-- You receive — one strip for every service -->
      <div class="receive">
        <h2 class="sec-h3">{T.receiveHead}</h2>
        <ul>
          {T.receive.map((r, i) => (
            <li>
              <svg class="ico" width="36" height="36" viewBox="0 0 32 32" aria-hidden="true" set:html={RECEIVE_ICONS[i]}></svg>
              {r}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ─── TERMS as a timeline ─── -->
  <section class="terms bg-paper-2">
    <div class="container">
      <h2 class="sec-h2">{T.termsHead}</h2>
      <ol class="timeline">
        {T.terms.map((t, i) => {
          const b = TERM_BADGES[i];
          return (
            <li>
              <span class={`badge card ${b.bg}`}>
                {b.icon && <svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true" set:html={b.icon}></svg>}
                {b.text && <bdi class="mono big">{b.text}</bdi>}
                {b.num && <><span class="mono num">{b.num}</span><span class="unit">{T.days}</span></>}
              </span>
              <strong>{t.t}</strong>
              <span>{t.d}</span>
            </li>
          );
        })}
      </ol>
      <p class="terms-note">{T.termsNote}</p>
    </div>
  </section>

  <!-- ─── CTA ─── -->
  <section class="cta bg-mint">
    <div class="container cta-grid">
      <div class="cta-text">
        <h2>{T.ctaHead}</h2>
        <a class="skb skb-butter" href={L("/contact/")}>{T.ctaLabel}</a>
      </div>
      <svg class="cta-key flip-rtl" width="220" height="160" viewBox="0 0 220 180" aria-hidden="true"><g fill="none" stroke="#1f1f1f" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="70" cy="90" r="36" fill="#f7e7b0"></circle><circle cx="70" cy="90" r="12" fill="#faf6ee"></circle><path d="M106 90h90M170 90v24M190 90v16"></path></g></svg>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: var(--k-max);
    margin: 0 auto;
    padding: 0 var(--k-gutter-desktop);
  }

  /* Sketch card without the global .sk child margins/padding, so grid
     and flex gaps stay in control. */
  .card {
    border: var(--k-line) solid var(--k-ink);
    border-radius: var(--k-radius-sketch);
    box-shadow: 4px 4px 0 -2px var(--k-paper), 4px 4px 0 0 var(--k-ink);
    color: var(--k-ink);
  }

  /* Stroke style for the drawings. Shapes with their own fill attribute
     keep it; CSS fill would otherwise override the presentation attribute. */
  .draw { stroke: var(--k-ink); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .draw:not([fill]) { fill: none; }
  .mono { font-family: var(--k-font-mono); }
  :global(html[dir="rtl"]) .flip-rtl { transform: scaleX(-1); }

  .sec-h2 {
    margin: 0 0 40px;
    font-family: var(--k-font-serif);
    font-size: 40px;
    line-height: 1.2;
    font-weight: 700;
    color: var(--k-ink);
  }
  .sec-h3 {
    margin: 0;
    font-family: var(--k-font-serif);
    font-size: 30px;
    line-height: 1.2;
    font-weight: 700;
    color: var(--k-ink);
  }

  /* ─── Hero ─── */
  .svc-hero { padding: 80px 0 88px; border-bottom: 2px solid var(--k-ink); }
  .hero-grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 64px;
    align-items: center;
  }
  .hero-text { display: flex; flex-direction: column; gap: 22px; }
  .hero-text h1 {
    margin: 0;
    font-family: var(--k-font-serif);
    font-size: 68px;
    line-height: 1.06;
    font-weight: 700;
    letter-spacing: -1px;
    color: var(--k-ink);
  }
  .hero-lede { margin: 0; font-size: 21px; line-height: 34px; max-width: 460px; color: var(--k-ink); }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .tile {
    min-height: 132px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 19px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--k-ink);
    text-decoration: none;
  }

  /* Elevated behaviour, matching the .skb buttons: lift on hover/focus,
     press on click. */
  .lift {
    border: var(--k-line) solid var(--k-ink);
    border-radius: var(--k-radius-sketch);
    box-shadow: 4px 4px 0 -2px var(--k-paper), 4px 4px 0 0 var(--k-ink);
    transition: transform 140ms cubic-bezier(0.2, 0.9, 0.3, 1.2),
                box-shadow 140ms cubic-bezier(0.2, 0.9, 0.3, 1.2);
  }
  .lift:hover, .lift:focus-visible {
    color: var(--k-ink);
    text-decoration: none;
    transform: translate(-4px, -4px);
    box-shadow: 8px 8px 0 -2px var(--k-paper), 8px 8px 0 0 var(--k-ink);
  }
  .lift:active {
    transform: translate(-1px, -1px);
    box-shadow: 5px 5px 0 -2px var(--k-paper), 5px 5px 0 0 var(--k-ink);
  }
  @media (prefers-reduced-motion: reduce) { .lift { transition: none; } }

  /* ─── Method ─── */
  .method { padding: 72px 0 80px; }
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .step-row { display: flex; align-items: center; width: 100%; margin-bottom: 6px; }
  .badge {
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .step-arrow { flex-grow: 1; height: 24px; min-width: 24px; margin: 0 12px; }
  .step-num { font-family: var(--k-font-mono); font-size: 14px; color: var(--k-ink-muted); }
  .step-title { font-size: 20px; color: var(--k-ink); }
  .step-desc { font-size: 15px; line-height: 22px; color: var(--k-ink-muted); max-width: 200px; }

  /* ─── Services ─── */
  .services { padding: 16px 0 96px; }
  .services-stack { display: flex; flex-direction: column; gap: 40px; }
  .svc-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; }
  .svc {
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    scroll-margin-top: 120px;
  }
  .svc-wide {
    padding: 44px 48px;
    display: grid;
    grid-template-columns: 6fr 5fr;
    gap: 56px;
    align-items: center;
  }
  .svc-body { display: flex; flex-direction: column; gap: 18px; }
  .signature { align-self: flex-start; }
  .svc h2 {
    margin: 0;
    font-family: var(--k-font-serif);
    font-size: 34px;
    line-height: 1.2;
    font-weight: 700;
    color: var(--k-ink);
  }
  .svc-wide h2 { font-size: 44px; }
  .svc-line { margin: 0; font-size: 18px; line-height: 29px; color: var(--k-ink); max-width: 560px; }
  .svc-wide .svc-line { font-size: 20px; line-height: 32px; }

  .chips {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips li {
    min-height: 30px;
    padding: 2px 12px;
    display: inline-flex;
    align-items: center;
    border: 1.5px solid var(--k-ink);
    border-radius: var(--k-radius-pill);
    background: var(--k-paper);
    font-size: 13px;
    font-weight: 600;
    color: var(--k-ink);
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 18px;
    background: var(--k-paper);
    border: 2px dashed var(--k-ink);
  }
  .panel-head { font-size: 13px; font-weight: 700; color: var(--k-ink); }

  /* Hosting scale: a line with three stops, labels under each end/middle. */
  .meter {
    position: relative;
    display: flex;
    justify-content: space-between;
    margin: 4px 0;
  }
  .meter::before {
    content: "";
    position: absolute;
    inset-inline: 8px;
    top: 50%;
    border-top: 2.5px solid var(--k-ink);
  }
  .meter span {
    position: relative;
    width: 16px;
    height: 16px;
    border: 2.5px solid var(--k-ink);
    border-radius: 50%;
  }
  .meter-labels {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
    color: var(--k-ink-muted);
  }
  .meter-labels li:nth-child(2) { text-align: center; }
  .meter-labels li:last-child { text-align: end; }

  .either { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; }
  .either span {
    min-height: 34px;
    padding: 4px 14px;
    display: inline-flex;
    align-items: center;
    border: 1.5px solid var(--k-ink);
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--k-ink);
  }
  .either em { font-style: normal; font-family: var(--k-font-mono); font-size: 13px; color: var(--k-ink-muted); }

  /* Illustrations: rows of drawings with captions. */
  .art { display: flex; align-items: flex-end; gap: 16px; }
  .art figure {
    min-width: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .art figcaption { font-size: 13px; font-weight: 600; color: var(--k-ink); text-align: center; }
  .art svg { max-width: 100%; height: auto; }
  .art-scale { justify-content: space-between; min-height: 200px; }
  .art-arrow { width: 56px; height: 24px; flex-shrink: 0; align-self: center; }

  .art-jailbreak { justify-content: center; align-items: center; gap: 28px; }
  .files {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .files li {
    width: 150px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 3px solid var(--k-ink);
    background: var(--k-paper);
    font-family: var(--k-font-mono);
    font-size: 17px;
    font-weight: 600;
    direction: ltr;
  }

  .art-network { justify-content: space-between; align-items: center; min-height: 200px; }
  .cams { display: flex; flex-direction: column; gap: 14px; }
  .nets { display: flex; flex-direction: column; gap: 16px; }
  .nets span {
    width: 110px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 3px solid var(--k-ink);
    font-size: 15px;
    font-weight: 700;
    color: var(--k-ink);
  }

  .art-decide { justify-content: center; align-items: center; gap: 0; }
  .question {
    width: 84px;
    height: 84px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 3px solid var(--k-ink);
    border-radius: 50%;
    background: var(--k-paper);
    font-family: var(--k-font-serif);
    font-size: 40px;
    font-weight: 700;
    color: var(--k-ink);
  }
  .branches { width: 110px; height: 200px; flex-shrink: 0; }
  .choices {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .choices li {
    width: 150px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2.5px solid var(--k-ink);
    font-size: 16px;
    font-weight: 700;
    color: var(--k-ink);
  }

  /* You receive */
  .receive {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 32px 36px;
    border: 2px dashed var(--k-ink);

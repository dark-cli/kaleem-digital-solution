                <path d="M67 128l6-10h24l6 10z" fill="#f8c9b8" class="draw" stroke-width="2.5"></path><rect x="70" y="128" width="30" height="16" fill="#faf6ee" class="draw" stroke-width="2.5"></rect>
                <path d="M126 128l6-10h24l6 10z" fill="#f8c9b8" class="draw" stroke-width="2.5"></path><rect x="129" y="128" width="30" height="16" fill="#faf6ee" class="draw" stroke-width="2.5"></rect>
              </svg>
              <figcaption>{T.s4.scale[2]}</figcaption>

---
/**
 * Book a free audit — a short form. The site is static (no server to
 * receive submissions), so the form hands the answers over directly:
 * "Send via WhatsApp" opens a pre-filled WhatsApp message to Kaleem, and
 * "Send by email" opens the visitor's mail app addressed to sales@.
 * Nothing is stored on the site.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CONTACT } from "../../consts";
import { currentLocale } from "../../lib/i18n";
import { SERVICE_BG, type ServiceId } from "../../data/services";

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const isAr = locale === "ar";

const T = isAr ? {
  title: "احجز تقييماً مجانياً — كليم",
  description: "نموذج قصير عن عملك وأنظمتك الحالية. نراجعه ونتواصل معك لنرتّب جلسة قصيرة وخطة واضحة — مجاناً ودون أي التزام.",
  eyebrow: "تقييم مجاني",
  h1: "احجز تقييماً مجانياً",
  lede: "دقيقتان لتعريفنا بعملك. بعدها نتواصل معك لنرى أنظمتك ونقدّم لك خطة واضحة — مجاناً ودون أي التزام.",
  business: "عن عملك",
  bizName: "اسم العمل",
  bizType: "نوع العمل",
  choose: "اختر…",
  types: ["متجر أو محل تجاري", "مطعم أو مقهى", "عيادة أو مركز طبي", "مدرسة أو معهد", "شركة أو مكتب", "مؤسسة أو منظمة", "أخرى"],
  city: "المدينة",
  cityPh: "مثلاً البصرة",
  servicesQ: "ما الذي تحتاجه؟",
  servicesHint: "اختر كل ما يناسب — أو اتركه إن لم تكن متأكداً.",
  services: { jailbreak: "تحرير الأنظمة", websites: "المواقع وتطبيقات الويب", mobile: "تطبيقات الهاتف", systems: "أنظمة الإدارة والمتاجر", networks: "الشبكات والأمن", consulting: "الاستشارات والتدريب" },
  current: "حدّثنا عن نظامك الحالي",
  currentPh: "ما الذي تستخدمه اليوم، وما الذي يزعجك فيه؟",
  you: "كيف نتواصل معك",
  name: "اسمك",
  phone: "رقم الهاتف أو واتساب",
  email: "البريد الإلكتروني",
  optional: "اختياري",
  sendWa: "أرسل عبر واتساب",
  sendMail: "أرسل بالبريد",
  privacy: "لا نحفظ أي بيانات على الموقع — تصلنا رسالتك مباشرة عبر واتساب أو البريد.",
  missing: "يرجى تعبئة الحقول المطلوبة.",
  nextHead: "ماذا يحدث بعدها",
  next: [
    { t: "نقرأ طلبك", d: `ونردّ خلال ساعات العمل: ${CONTACT.hours.ar}.` },
    { t: "نتعرّف على أنظمتك", d: "في مكالمة أو زيارة قصيرة: ما الذي تستخدمه وأين توجد بياناتك." },
    { t: "تستلم خطة مكتوبة", d: "خطوات واضحة وتكلفة تقديرية — والقرار لك." },
  ],
  msgTitle: "طلب تقييم مجاني",
  labels: { bizName: "اسم العمل", bizType: "النوع", city: "المدينة", services: "الخدمات", current: "النظام الحالي", name: "الاسم", phone: "الهاتف", email: "البريد" },
} : {
  title: "Book a free audit — Kaleem",
  description: "A short form about your business and your current systems. We review it, get in touch, and give you a clear plan — free, with no commitment.",
  eyebrow: "Free audit",
  h1: "Book a free audit",
  lede: "Two minutes to tell us about your business. We'll get in touch, look at your systems and give you a clear plan — free, with no commitment.",
  business: "Your business",
  bizName: "Business name",
  bizType: "Type of business",
  choose: "Choose…",
  types: ["Shop or retail", "Restaurant or café", "Clinic or medical center", "School or institute", "Company or office", "Institution or NGO", "Other"],
  city: "City",
  cityPh: "e.g. Basra",
  servicesQ: "What do you need?",
  servicesHint: "Pick all that apply — or leave it if you're not sure.",
  services: { jailbreak: "The Jailbreak", websites: "Websites & web apps", mobile: "Mobile apps", systems: "Management & store systems", networks: "Networks & security", consulting: "Consulting & training" },
  current: "Tell us about your current system",
  currentPh: "What do you use today, and what's bothering you about it?",
  you: "How we reach you",
  name: "Your name",
  phone: "Phone or WhatsApp",
  email: "Email",
  optional: "optional",
  sendWa: "Send via WhatsApp",
  sendMail: "Send by email",
  privacy: "Nothing is stored on this site — your message comes straight to us on WhatsApp or email.",
  missing: "Please fill in the required fields.",
  nextHead: "What happens next",
  next: [
    { t: "We read your request", d: `And reply during business hours: ${CONTACT.hours.en}.` },
    { t: "We look at your systems", d: "On a short call or visit: what you use and where your data lives." },
    { t: "You get a written plan", d: "Clear steps and an estimated cost — the decision is yours." },
  ],
  msgTitle: "Free audit request",
  labels: { bizName: "Business", bizType: "Type", city: "City", services: "Services", current: "Current system", name: "Name", phone: "Phone", email: "Email" },
};

const SERVICE_IDS = Object.keys(T.services) as ServiceId[];
const WA_NUMBER = CONTACT.whatsapp.replace(/\D/g, "");
---

<BaseLayout title={T.title} description={T.description}>
  <section class="audit-hero bg-mint">
    <div class="container">
      <span class="eyebrow-k">{T.eyebrow}</span>
      <h1>{T.h1}</h1>
      <p>{T.lede}</p>
    </div>
  </section>

  <section class="audit">
    <div class="container audit-grid">
      <form id="audit-form" class="audit-form" novalidate
        data-wa={WA_NUMBER} data-mail={CONTACT.emails.sales}
        data-title={T.msgTitle} data-labels={JSON.stringify(T.labels)}>

        <fieldset>
          <legend>{T.business}</legend>
          <div class="field">
            <label for="f-biz">{T.bizName} <span class="req" aria-hidden="true">*</span></label>
            <input id="f-biz" name="bizName" type="text" required autocomplete="organization" />
          </div>
          <div class="row-2">
            <div class="field">
              <label for="f-type">{T.bizType} <span class="req" aria-hidden="true">*</span></label>
              <select id="f-type" name="bizType" required>
                <option value="">{T.choose}</option>
                {T.types.map((t) => <option>{t}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="f-city">{T.city} <span class="req" aria-hidden="true">*</span></label>
              <input id="f-city" name="city" type="text" required placeholder={T.cityPh} autocomplete="address-level2" />
            </div>
          </div>
        </fieldset>

        <fieldset>
          <legend>{T.servicesQ}</legend>
          <p class="hint">{T.servicesHint}</p>
          <div class="svc-picks">
            {SERVICE_IDS.map((id) => (
              <label class={`pick ${SERVICE_BG[id]}`}>
                <input type="checkbox" name="services" value={T.services[id]} />
                <span>{T.services[id]}</span>
              </label>
            ))}
          </div>
          <div class="field">
            <label for="f-current">{T.current} <span class="opt">({T.optional})</span></label>
            <textarea id="f-current" name="current" rows="4" placeholder={T.currentPh}></textarea>
          </div>
        </fieldset>

        <fieldset>
          <legend>{T.you}</legend>
          <div class="field">
            <label for="f-name">{T.name} <span class="req" aria-hidden="true">*</span></label>
            <input id="f-name" name="name" type="text" required autocomplete="name" />
          </div>
          <div class="row-2">
            <div class="field">
              <label for="f-phone">{T.phone} <span class="req" aria-hidden="true">*</span></label>
              <input id="f-phone" name="phone" type="tel" required autocomplete="tel" dir="ltr" />
            </div>
            <div class="field">
              <label for="f-email">{T.email} <span class="opt">({T.optional})</span></label>
              <input id="f-email" name="email" type="email" autocomplete="email" dir="ltr" />
            </div>
          </div>
        </fieldset>

        <p class="form-error" role="alert" hidden>{T.missing}</p>
        <div class="send">
          <button type="submit" class="skb skb-mint" data-via="wa">{T.sendWa}</button>
          <button type="submit" class="skb skb-paper" data-via="mail">{T.sendMail}</button>
        </div>
        <p class="privacy">{T.privacy}</p>
      </form>

      <aside class="next">
        <h2>{T.nextHead}</h2>
        <ol>
          {T.next.map((n, i) => (
            <li>
              <span class="num">{i + 1}</span>
              <div>
                <strong>{n.t}</strong>
                <span>{n.d}</span>
              </div>
            </li>
          ))}
        </ol>
      </aside>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Build a message from the answers and hand it to WhatsApp or email.
  (function () {
    function init() {
      var form = document.getElementById("audit-form");
      if (!form || form.__bound) return;
      form.__bound = true;
      var err = form.querySelector(".form-error");
      var via = "wa";
      form.querySelectorAll("button[data-via]").forEach(function (b) {
        b.addEventListener("click", function () { via = b.getAttribute("data-via"); });
      });
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        if (!form.checkValidity()) {
          err.hidden = false;
          var bad = form.querySelector("input:invalid, select:invalid, textarea:invalid");
          if (bad) bad.focus();
          return;
        }
        err.hidden = true;
        var L = JSON.parse(form.getAttribute("data-labels"));
        var d = new FormData(form);
        var services = d.getAll("services").join(", ");
        var lines = [
          form.getAttribute("data-title"),
          "",
          L.bizName + ": " + d.get("bizName"),
          L.bizType + ": " + d.get("bizType"),
          L.city + ": " + d.get("city"),
        ];
        if (services) lines.push(L.services + ": " + services);
        if (d.get("current")) lines.push(L.current + ": " + d.get("current"));
        lines.push("", L.name + ": " + d.get("name"), L.phone + ": " + d.get("phone"));
        if (d.get("email")) lines.push(L.email + ": " + d.get("email"));
        var text = lines.join("\n");
        if (via === "mail") {
          location.href = "mailto:" + form.getAttribute("data-mail") +
            "?subject=" + encodeURIComponent(form.getAttribute("data-title") + " — " + d.get("bizName")) +
            "&body=" + encodeURIComponent(text);
        } else {
          window.open("https://wa.me/" + form.getAttribute("data-wa") + "?text=" + encodeURIComponent(text), "_blank", "noopener");
        }
      });
    }
    document.addEventListener("astro:page-load", init);
    init();
  })();
</script>

<style>
  .container {
    max-width: var(--k-max);
    margin: 0 auto;
    padding: 0 var(--k-gutter-desktop);
  }

  /* Hero */
  .audit-hero { padding: 72px 0 64px; border-bottom: 2px solid var(--k-ink); }
  .audit-hero .container { display: flex; flex-direction: column; gap: 16px; max-width: 820px; margin: 0; margin-inline: auto; }
  .eyebrow-k {
    font-family: var(--k-font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--k-ink-muted);
  }
  .audit-hero h1 {
    margin: 0;
    font-family: var(--k-font-serif);
    font-size: 56px;
    line-height: 1.1;
    font-weight: 700;
    color: var(--k-ink);
  }
  .audit-hero p { margin: 0; max-width: 60ch; font-size: 19px; line-height: 1.6; color: var(--k-ink); }

  /* Layout */
  .audit { padding: 64px 0 88px; }
  .audit-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 64px;
    align-items: start;
  }

  /* Form */
  .audit-form { display: flex; flex-direction: column; gap: 36px; min-width: 0; }
  fieldset { margin: 0; padding: 0; border: 0; display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  legend {
    padding: 0 0 12px;
    margin-bottom: 4px;
    width: 100%;
    border-bottom: 2px solid var(--k-ink);
    font-family: var(--k-font-serif);
    font-size: 26px;
    font-weight: 700;
    color: var(--k-ink);
  }
  .row-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .field { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .field label { font-size: 15px; font-weight: 600; color: var(--k-ink); }
  .req { color: #b42318; }
  .opt { font-weight: 400; color: var(--k-ink-muted); }
  .hint { margin: -6px 0 0; font-size: 14px; color: var(--k-ink-muted); }
  input, select, textarea {
    width: 100%;
    min-height: 48px;
    padding: 10px 14px;
    border: 2px solid var(--k-ink);
    border-radius: 6px;
    background: #fff;
    font: inherit;
    font-size: 16px;
    color: var(--k-ink);
    box-sizing: border-box;
  }
  textarea { resize: vertical; min-height: 110px; }
  input:focus-visible, select:focus-visible, textarea:focus-visible {
    outline: 3px solid var(--k-sky);
    outline-offset: 2px;
  }

  /* Service choices as coloured chips (each service keeps its colour). */
  .svc-picks { display: flex; flex-wrap: wrap; gap: 10px; }
  .pick {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 16px;
    border: 2px solid var(--k-ink);
    border-radius: var(--k-radius-pill);
    font-size: 15px;
    font-weight: 600;
    color: var(--k-ink);
    cursor: pointer;
    background-color: var(--k-paper) !important;
    transition: background-color 140ms ease;
  }
  .pick input { width: 18px; height: 18px; min-height: 0; margin: 0; padding: 0; accent-color: var(--k-ink); }
  .pick.bg-butter:has(input:checked)  { background-color: var(--k-butter) !important; }
  .pick.bg-sky:has(input:checked)     { background-color: var(--k-sky) !important; }
  .pick.bg-peach:has(input:checked)   { background-color: var(--k-peach) !important; }
  .pick.bg-mint:has(input:checked)    { background-color: var(--k-mint) !important; }
  .pick.bg-apricot:has(input:checked) { background-color: var(--k-apricot) !important; }
  .pick.bg-lilac:has(input:checked)   { background-color: var(--k-lilac) !important; }
  .pick:has(input:focus-visible) { outline: 3px solid var(--k-sky); outline-offset: 2px; }

  .form-error { margin: 0; font-weight: 600; color: #b42318; }
  .send { display: flex; flex-wrap: wrap; gap: 16px; }
  .send button { cursor: pointer; }
  .privacy { margin: -16px 0 0; font-size: 14px; color: var(--k-ink-muted); }

  /* What happens next */
  .next {
    position: sticky;
    top: 112px;
    padding: 28px;
    border: 2px solid var(--k-ink);
    border-radius: var(--k-radius-sketch);
    background: var(--k-paper-2);
  }
  .next h2 { margin: 0 0 20px; font-family: var(--k-font-serif); font-size: 24px; font-weight: 700; color: var(--k-ink); }
  .next ol { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 20px; }
  .next li { display: flex; gap: 14px; align-items: flex-start; }
  .num {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--k-ink);
    border-radius: 50%;
    background: var(--k-paper);
    font-family: var(--k-font-mono);
    font-weight: 600;
    color: var(--k-ink);
  }
  .next strong { display: block; font-size: 16px; color: var(--k-ink); }
  .next li span:last-child { font-size: 14px; line-height: 1.5; color: var(--k-ink-muted); }

  @media (max-width: 1055px) {
    .audit-grid { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .next { position: static; }
  }
  @media (max-width: 671px) {
    .container { padding: 0 var(--k-gutter-mobile); }
    .audit-hero { padding: 48px 0 40px; }
    .audit-hero h1 { font-size: 38px; }
    .audit-hero p { font-size: 17px; }
    .audit { padding: 40px 0 56px; }
    .row-2 { grid-template-columns: minmax(0, 1fr); }
    .send { flex-direction: column; }
    .send button { width: 100%; }
  }
</style>

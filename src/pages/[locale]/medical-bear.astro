          { en: "Bills waiting for a debt approval or a refund are kept apart.", ar: "الفواتير التي تنتظر موافقة على دين أو استرداداً معزولة على حدة." },
        ],
      },
      {
        id: "shift",
        shot: "/assets/bear/screens/shift-closing.png",
        shotEn: "/assets/bear/screens/shift-closing-en.png",
        art: "/assets/bear/doctor-bear-shift.png",
        alt:  { en: "Shift closing: counting the cash box against the expected amount", ar: "إغلاق الوردية: عدّ الصندوق مقابل المبلغ المتوقع" },
        name: { en: "Shift closing", ar: "إغلاق الوردية" },
        lead: { en: "At the end of a shift the cashier counts the box, and the system checks the count.", ar: "في نهاية الوردية يعدّ الموظف الصندوق، والنظام يتحقق من العدّ." },
        points: [
          { en: "The expected amount is worked out for you: opening balance, plus cash received, minus petty cash and refunds.", ar: "المبلغ المتوقع يُحسب تلقائياً: رصيد البداية، زائد المقبوض نقداً، ناقص النثرية والمبالغ المعادة." },
          { en: "Enter what is actually in the box and what stays as change for the next shift.", ar: "أدخل الموجود فعلاً في الصندوق، وما يبقى فكّةً للوردية التالية." },
          { en: "Choose who receives the rest, such as the owner.", ar: "اختر من يستلم الباقي، مثل المالك." },
          { en: "Card payments are counted separately, since they never enter the box. The pharmacy closes its own box.", ar: "مدفوعات البطاقة تُحسب منفصلة لأنها لا تدخل الصندوق. والصيدلية تغلق صندوقها بنفسها." },

---

<BaseLayout title={T.title} description={T.description}>

  <!-- ─── HERO ─── -->
  <section class="mb-hero bg-sky dust">
    <div class="container mb-hero-grid">
      <div class="mb-hero-text">
        <span class="eyebrow">{T.eyebrow}</span>
        <h1>{T.h1}</h1>
        <p class="mb-lead">{T.lead}</p>
        <p class="mb-sub">{T.sub}</p>
        <div class="chips">{T.chips.map((c) => <span class="chip">{c}</span>)}</div>
      </div>
      <div class="mb-hero-shot">
        <WindowWidget images={T.heroSlides} slidesLabel={T.heroSlidesLabel} chromeColor="sky-shader" loading="eager" sizes="(min-width: 900px) 55vw, 100vw" />
      </div>
    </div>
  </section>
  <dl class="mb-facts bg-sky dust">
    {T.facts.map((f) => (
      <div>
        <dt>{f.label}</dt>
        <dd><span class="fact-value">{f.value}</span><span class="fact-note">{f.note}</span></dd>
      </div>
    ))}
  </dl>

  <!-- ─── MODULE INDEX: jump to any part of the system ─── -->
  <nav class="mb-index" aria-label={isAr ? "أقسام النظام" : "System modules"} data-mb-nav>
    <div class="container">
      <ul data-mb-index>
        {navItems.map((n) => (
          <li>
            <a href={`#${n.id}`} data-target={n.id}>
              <span class="ni"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" set:html={NAV_ICONS[n.id]}></svg></span>
              <span class="nl">{n.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- ─── THE DASHBOARD ─── -->
  <section class="mb-sec" id="dashboard">
    <div class="container mb-dash">
      <div class="mb-dash-text">
        <span class="eyebrow">{T.dashEyebrow}</span>
        <h2 class="sec-h2">{T.dashHead}</h2>
        <p>{T.dashText}</p>
        <ul class="points">{T.dashPoints.map((p) => <li>{p}</li>)}</ul>
        <Image src="/assets/bear/doctor-bear-tablet.png" alt="" class="mb-dash-bear" sizes="(min-width: 900px) 330px, 240px" />
      </div>
      <div class="mb-dash-shot">
        <WindowWidget src={isAr ? "/assets/bear/screens/dashboard-busy.png" : "/assets/bear/screens/dashboard-en-section.png"} alt={T.heroAlt} sizes="(min-width: 900px) 55vw, 100vw" />
      </div>
    </div>
  </section>

  <!-- ─── A DAY IN THE CLINIC ─── -->
  <section class="mb-sec board mb-dark" data-sky>
    <div class="container">
      <span class="eyebrow">{T.flowEyebrow}</span>
      <h2 class="sec-h2">{T.flowHead}</h2>
      <ol class="flow">
        {T.flow.map((s, i) => (
          <li><span class="flow-n">{i + 1}</span><b>{s.t}</b><span>{s.d}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ─── EVERY MODULE, chapter by chapter ───
       These windows use the plain chrome, not "sky-shader": each starry
       element is its own WebGL context, and past the browser's limit (~16)
       the oldest ones (the header, the hero) go blank. -->
  {CHAPTERS.map((ch, ci) => (
    <section class:list={["mb-sec", ch.bg, ch.bg && "dust"]}>
      <div class="container">
        {ch.modules.map((m, mi) => (
          <article class:list={["module", { flip: mi % 2 === 1, first: mi === 0, "has-art": !!m.art }]} id={m.id}>
            <div class="module-text">
              {/* The chapter heading sits in the first module's text column,
                  so that module's screenshot rises level with it. */}
              {mi === 0 && (
                <header class="chapter-head">
                  <span class="chapter-n">{String(ci + 1).padStart(2, "0")}</span>
                  <div>
                    <h2 class="sec-h2">{tx(ch.name)}</h2>
                    <p>{tx(ch.intro)}</p>
                  </div>
                </header>
              )}
              <h3>{tx(m.name)}</h3>
              <p class="module-lead">{tx(m.lead)}</p>
              <ul class="points">{m.points.map((p) => <li>{tx(p)}</li>)}</ul>
              {m.art && m.shot && <Image src={m.art} alt="" class="module-art" sizes="(min-width: 900px) 420px, 300px" />}
            </div>
            <div class:list={["module-shot", { "art-only": !m.shot }]}>
              {m.shot
                ? <WindowWidget src={(!isAr && m.shotEn) || m.shot} alt={tx(m.alt)} sizes="(min-width: 900px) 55vw, 100vw" />
                : m.art && <Image src={m.art} alt="" class="module-art-big" sizes="(min-width: 900px) 55vw, 100vw" />}
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}

  <!-- ─── MONEY CONTROL ─── -->
  <section class="mb-sec board mb-dark" data-sky>
    <div class="container">
      <span class="eyebrow">{T.moneyEyebrow}</span>
      <h2 class="sec-h2">{T.moneyHead}</h2>
      <div class="money-grid">
        {T.moneyItems.map((m) => (
          <div class="money-item"><b>{m.t}</b><span>{m.d}</span></div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── CUSTOMIZATION ─── -->
  <section class="mb-sec">
    <div class="container">
      <span class="eyebrow">{T.customEyebrow}</span>
      <h2 class="sec-h2">{T.customHead}</h2>
      <p class="sec-text">{T.customText}</p>
      <div class="custom-grid">
        {T.customItems.map((c, i) => (
          <div class={`sk custom ${["bg-butter", "bg-mint", "bg-lilac", "bg-apricot"][i]}`}><b>{c.t}</b><span>{c.d}</span></div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── CALL TO ACTION ─── -->
  <section class="mb-sec bg-paper-2 dust">
    <div class="container mb-cta">
      <h2 class="sec-h2">{T.ctaHead}</h2>
      <p>{T.ctaText}</p>
      <a class="skb skb-lilac" href={L("/contact/")}>{T.ctaButton}</a>
    </div>
  </section>

</BaseLayout>

<script is:inline>
  // Section menu.
  // 1. Rail (wide screens): shown from the dashboard section to the end
  //    of the last module, hidden over the hero and the closing sections.
  // 2. The current section's item is marked .active (both layouts); in
  //    the narrow row it is also scrolled into view.
  // 3. Narrow row: a vertical mouse wheel scrolls it sideways (toward the
  //    row's end, leftward in Arabic) until it reaches an end.
  (function () {
    var off = function () {};
    function init() {
      off();
      var nav = document.querySelector("[data-mb-nav]");
      var row = document.querySelector("[data-mb-index]");
      if (!nav || !row) return;
      var links = Array.prototype.slice.call(row.querySelectorAll("a[data-target]"));
      var targets = links.map(function (a) { return document.getElementById(a.dataset.target); });
      var first = targets[0], last = targets[targets.length - 1];
      var current = -1, ticking = false;

      function update() {
        ticking = false;
        var vh = window.innerHeight;
        // The rail is visible between the first and last section.
        var on = first.getBoundingClientRect().top < vh * 0.6 && last.getBoundingClientRect().bottom > vh * 0.35;
        nav.classList.toggle("is-on", on);
        // Current = the last section whose top has passed 40% of the screen.
        var idx = 0;
        for (var i = 0; i < targets.length; i++) {
          if (targets[i].getBoundingClientRect().top <= vh * 0.4) idx = i;
        }
        if (idx !== current) {
          current = idx;
          links.forEach(function (a, k) {
            a.classList.toggle("active", k === idx);
            if (k === idx) a.setAttribute("aria-current", "true"); else a.removeAttribute("aria-current");
          });
          // Narrow row only: bring the current pill into view.
          if (getComputedStyle(nav).position !== "fixed") {
            var r = links[idx].getBoundingClientRect(), rr = row.getBoundingClientRect();
            row.scrollBy({ left: (r.left + r.width / 2) - (rr.left + rr.width / 2), behavior: "smooth" });
          }
        }
      }
      function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }

      function onWheel(e) {
        if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
        var max = row.scrollWidth - row.clientWidth;
        if (max <= 0) return;
        var rtl = getComputedStyle(row).direction === "rtl";
        var pos = Math.abs(row.scrollLeft);
        var forward = e.deltaY > 0;
        if ((forward && pos >= max - 1) || (!forward && pos <= 0)) return;
        e.preventDefault();
        row.scrollBy({ left: (rtl ? -1 : 1) * e.deltaY, behavior: "smooth" });
      }

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      row.addEventListener("wheel", onWheel, { passive: false });
      off = function () {
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("resize", onScroll);
        row.removeEventListener("wheel", onWheel);
      };
      update();
    }
    document.addEventListener("astro:page-load", init);
    document.addEventListener("astro:before-swap", function () { off(); off = function () {}; });
    init();
  })();
</script>

<style>
  .container {
    max-width: var(--k-max);
    margin: 0 auto;
    padding: 0 var(--k-gutter-desktop);
  }

  /* ─── Shared pieces ─── */
  .eyebrow {
    display: block;
    font-family: var(--k-font-mono);
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #4a4a4a;
  }
  :global(html[dir="rtl"]) .eyebrow { font-family: var(--k-font-sans); font-size: 16px; font-weight: 600; letter-spacing: 0; }
  .sec-h2 { margin: 14px 0 0; font-size: clamp(30px, 3.4vw, 44px); line-height: 1.15; }
  .sec-text { margin: 16px 0 0; max-width: 620px; font-size: 17px; line-height: 1.65; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 12px;
    border: 2px solid var(--k-ink);
    border-radius: 999px;
    background: var(--k-paper);
    font-size: 14px;

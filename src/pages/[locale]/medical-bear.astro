          { en: "Parties and a chart of items, so every amount lands in the right place in the reports.", ar: "الجهات وشجرة البنود، حتى يقع كل مبلغ في مكانه الصحيح في التقارير." },
        ],
      },
    ],
  },
  {
    name:  { en: "Setup and reports", ar: "الإعداد والتقارير" },
    intro: { en: "Set the clinic up your way, then see how it is doing.", ar: "جهّز العيادة على طريقتك، ثم تابع كيف تسير." },
    bg: "bg-paper-2",
    modules: [
      {
        id: "prices",
        shot: "/assets/bear/screens/prices.png",
        shotEn: "/assets/bear/screens/prices-en.png",
        art: "/assets/bear/doctor-bear-reports.png",
        alt:  { en: "Services and prices list with each service's group", ar: "قائمة الخدمات والأسعار مع مجموعة كل خدمة" },
        name: { en: "Services and prices", ar: "الخدمات والأسعار" },

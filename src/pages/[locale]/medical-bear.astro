const T = isAr ? {
  title:       "الدب الطبي — نظام إدارة العيادات · كليم",
  description: "الدب الطبي: نظام متكامل لإدارة العيادة من الاستقبال حتى الحسابات — المواعيد، والطلبات، والصيدلية، والمدفوعات، وإغلاق الوردية، والتقارير.",
  eyebrow:     "دراسة حالة · نظام إدارة عيادات",
  h1:          "الدب الطبـي",
  lead:        "نظام واحد يدير العيادة كلها: من لحظة وصول المريض حتى إدارة الحسابات.",
  sub:         "الاستقبال والمواعيد، وطلبات الطبيب والمختبر، والصيدلية والمخزون، والمدفوعات والحسابات والتقارير. بالعربية والإنجليزية، ويمكن تعديله بما يناسب عيادتك.",
  chips:       ["إدارة العيادات", "لوحة الطبيب", "الصيدلية والمخزون", "المختبر", "الحسابات"],
  heroAlt:     "لوحة العيادة في الدب الطبي: صافي اليوم والموافقات المعلّقة ومرضى اليوم",

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WindowWidget from "../../components/WindowWidget.astro";
import Image from "../../components/Image.astro";
import { currentLocale, localizedHref } from "../../lib/i18n";

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const isAr = locale === "ar";
const L = (href: string) => localizedHref(href, locale);

type Text = { en: string; ar: string };
const tx = (v: Text) => (isAr ? v.ar : v.en);

/* ─── The system, module by module ─────────────────────────────────────
   Every feature listed here is visible in the screenshots in
   public/assets/bear/screens/ (demo data). Modules are grouped into
   chapters; each module is one row: text and feature list beside its
   screenshot, alternating sides. */
type Module = { id: string; /** Left out until a screenshot exists: the picture then fills the screenshot's place. */ shot?: string; /** The same screen in the English interface, for the English page; falls back to `shot`. */ shotEn?: string; alt: Text; name: Text; lead: Text; points: Text[]; /** Decorative picture under the points; its base lines up with the screenshot's bottom. */ art?: string };
type Chapter = { name: Text; intro: Text; bg: string; modules: Module[] };

const CHAPTERS: Chapter[] = [
  {
    name:  { en: "The front desk", ar: "الاستقبال" },
    intro: { en: "Where the patient's day starts: arriving, waiting, being called back.", ar: "حيث يبدأ يوم المريض: الوصول والانتظار والمتابعة بعد الزيارة." },
    bg: "bg-paper-2",
    modules: [
      {
        id: "reception",
        shot: "/assets/bear/screens/reception-queue.png",
        shotEn: "/assets/bear/screens/reception-queue-en.png",
        art: "/assets/bear/doctor-bear-patients.png",
        alt:  { en: "Reception queue: today's patients with their doctor, status and time waiting", ar: "قائمة الاستقبال: مرضى اليوم مع الطبيب والحالة ووقت الانتظار" },
        name: { en: "Reception queue", ar: "قائمة الاستقبال" },
        lead: { en: "The whole day's patients on one list, numbered in the order they arrived.", ar: "كل مرضى اليوم في قائمة واحدة، مرقّمين حسب ترتيب وصولهم." },
        points: [
          { en: "Register a walk-in or book an appointment from the same screen.", ar: "سجّل حضوراً جديداً أو احجز موعداً من الشاشة نفسها." },
          { en: "Tabs follow the patient: expected today, waiting, in the visit, at payment, in departments, done.", ar: "تبويبات تتبع المريض: متوقع اليوم، ينتظر، في الزيارة، للدفع، في الأقسام، انتهى." },
          { en: "Filter by doctor, search by name, and see how long each patient has waited.", ar: "صفِّ حسب الطبيب، وابحث بالاسم، واعرف كم انتظر كل مريض." },
          { en: "End the visit with one button; the patient moves on to payment.", ar: "أنهِ الزيارة بزر واحد، فينتقل المريض إلى الدفع." },
        ],
      },
      {
        id: "appointments",
        shot: "/assets/bear/screens/appointments.png",
        shotEn: "/assets/bear/screens/appointments-en.png",
        art: "/assets/bear/doctor-bear-calendar.png",
        alt:  { en: "Appointments list with no-shows marked for rebooking", ar: "قائمة المواعيد مع من لم يحضروا معلَّمين لإعادة الحجز" },
        name: { en: "Appointments", ar: "المواعيد" },
        lead: { en: "Every booking with its doctor and type, and nobody lost when they miss one.", ar: "كل حجز مع طبيبه ونوعه، ولا يضيع أحد إن فاته موعده." },
        points: [
          { en: "Statuses for every booking: unconfirmed, confirmed, checked in, no-show, done.", ar: "حالة لكل حجز: غير مؤكَّد، مؤكَّد، سُجِّل الحضور، لم يحضر، انتهى." },
          { en: "Booking types: consultation, procedure, follow-up.", ar: "أنواع الحجز: كشف، إجراء، متابعة." },
          { en: "No-shows are counted at the top and rebooked with one button.", ar: "من لم يحضروا يظهر عددهم في الأعلى، ويُعاد حجزهم بزر واحد." },
          { en: "Filter by doctor and by date range.", ar: "صفِّ حسب الطبيب وحسب الفترة." },
        ],
      },
      {
        id: "calls",
        shot: "/assets/bear/screens/call-list.png",
        shotEn: "/assets/bear/screens/call-list-en.png",
        art: "/assets/bear/doctor-bear-headset.png",
        alt:  { en: "Call list: patients to call today, urgent first, with the reason for each call", ar: "قائمة الاتصال: مرضى للاتصال بهم اليوم، العاجل أولاً، مع سبب كل اتصال" },
        name: { en: "Call list", ar: "قائمة الاتصال" },
        lead: { en: "The clinic calls the patient back, not the other way round.", ar: "العيادة هي من تتصل بالمريض، لا العكس." },
        points: [
          { en: "Calls arrive on their own: a result is ready, a follow-up is due, the doctor or lab flagged something.", ar: "الاتصالات تصل تلقائياً: نتيجة جاهزة، متابعة مستحقة، تنبيه من الطبيب أو المختبر." },
          { en: "Urgent calls come first, with the doctor's note beside them.", ar: "الاتصالات العاجلة أولاً، وبجانبها ملاحظة الطبيب." },
          { en: "No answer? It returns to the list to call again; or mark it for later.", ar: "لا رد؟ يعود إلى القائمة لمعاودة الاتصال، أو أجّله لوقت لاحق." },
          { en: "Reception can add a patient to the list by hand.", ar: "يستطيع الاستقبال إضافة مريض إلى القائمة يدوياً." },
        ],
      },
      {
        id: "patients",
        shot: "/assets/bear/screens/patients.png",
        shotEn: "/assets/bear/screens/patients-en.png",
        art: "/assets/bear/doctor-bear-clipboard.png",
        alt:  { en: "Patients table with file number, phone, age, last visit, next booking and debts", ar: "جدول المرضى برقم الملف والهاتف والعمر وآخر زيارة والحجز القادم والديون" },
        name: { en: "Patients", ar: "المرضى" },
        lead: { en: "Every patient's file, searchable in a second.", ar: "ملف كل مريض، والبحث فيه بلحظة." },
        points: [
          { en: "File number, phone, age, last visit, next booking and what they owe, in one table.", ar: "رقم الملف والهاتف والعمر وآخر زيارة والحجز القادم وما عليه، في جدول واحد." },
          { en: "Ready-made views: all patients, patients with a balance, new this month.", ar: "عروض جاهزة: كل المرضى، من عليهم مبالغ، الجدد هذا الشهر." },
          { en: "Add filters, choose the columns, and export the list.", ar: "أضف تصفية، واختر الأعمدة، وصدّر القائمة." },
        ],
      },
    ],
  },
  {
    name:  { en: "Orders and approvals", ar: "الطلبات والموافقات" },
    intro: { en: "What the doctor asks for, and the decisions that need a second pair of eyes.", ar: "ما يطلبه الطبيب، والقرارات التي تحتاج إلى عين ثانية." },
    bg: "",
    modules: [
      {
        id: "orders",
        shot: "/assets/bear/screens/orders.png",
        shotEn: "/assets/bear/screens/orders-en.png",
        art: "/assets/bear/doctor-bear-heart.png",
        alt:  { en: "Order status: each patient's lab tests, procedures and services, and what is left to pay", ar: "حالة الطلبات: تحاليل كل مريض وإجراءاته وخدماته، وما بقي للدفع" },
        name: { en: "Order status", ar: "حالة الطلبات" },
        lead: { en: "Every lab test, procedure and service the doctor ordered, from request to done.", ar: "كل تحليل وإجراء وخدمة طلبها الطبيب، من الطلب حتى التنفيذ." },
        points: [
          { en: "Filter by lab, procedures or services.", ar: "صفِّ حسب المختبر أو الإجراءات أو الخدمات." },
          { en: "See what is waiting for payment and what is already in the departments.", ar: "اعرف ما ينتظر الدفع وما وصل إلى الأقسام." },
          { en: "Take payment for a patient's open orders in one step.", ar: "استلم دفع الطلبات المفتوحة للمريض بخطوة واحدة." },
          { en: "An order keeps the price it was requested at, even if prices change later.", ar: "يحتفظ الطلب بالسعر الذي طُلب به، حتى لو تغيّرت الأسعار لاحقاً." },
        ],
      },
      {
        id: "approvals",
        shot: "/assets/bear/screens/approvals.png",
        shotEn: "/assets/bear/screens/approvals-en.png",
        art: "/assets/bear/doctor-bear-approved.png",
        alt:  { en: "Approvals: a debt and a refund waiting for approval, each with its reason", ar: "الموافقات: دين واسترداد بانتظار الموافقة، لكل منهما سببه" },
        name: { en: "Approvals", ar: "الموافقات" },
        lead: { en: "Debts and refunds wait for an approval before any money moves.", ar: "الديون والاستردادات تنتظر الموافقة قبل أن يتحرك أي مبلغ." },
        points: [
          { en: "Each request shows the patient, the amount, the reason and who asked.", ar: "كل طلب يُظهر المريض والمبلغ والسبب ومن طلبه." },
          { en: "Approve or reject in one click; the waiting count shows in the side menu.", ar: "وافق أو ارفض بنقرة، وعدد الطلبات المعلّقة يظهر في القائمة الجانبية." },
          { en: "Every past decision stays in the history.", ar: "كل قرار سابق يبقى في السجل." },
        ],
      },
    ],
  },
  {
    name:  { en: "Pharmacy and lab", ar: "الصيدلية والمختبر" },
    intro: { en: "A full pharmacy with its own cash box, and a lab that follows every sample to its result.", ar: "صيدلية كاملة بصندوقها الخاص، ومختبر يتابع كل عينة حتى نتيجتها." },
    bg: "bg-paper-2",
    modules: [
      {
        id: "pharmacy",
        shot: "/assets/bear/screens/pharmacy.png",
        shotEn: "/assets/bear/screens/pharmacy-en.png",
        art: "/assets/bear/doctor-bear-pharmacy.png",
        alt:  { en: "Pharmacy: sales list with stock alerts at the top", ar: "الصيدلية: قائمة المبيعات مع تنبيهات المخزون في الأعلى" },
        name: { en: "Pharmacy and stock", ar: "الصيدلية والمخزون" },
        lead: { en: "Sales, prescriptions, stock and suppliers in one place.", ar: "المبيعات والوصفات والمخزون والموردون في مكان واحد." },
        points: [
          { en: "Sales, prescriptions, stock, invoices, suppliers and a full stock log.", ar: "المبيعات، والوصفات، والمخزون، والفواتير، والموردون، وسجل كامل للمخزون." },
          { en: "Alerts for products that ran out, stock running low, expired stock, and batches expiring within 60 days.", ar: "تنبيهات للمنتجات التي نفدت، والمخزون المنخفض، والمخزون المنتهي، والدفعات التي تنتهي خلال 60 يوماً." },
          { en: "Each sale records the patient, the items and the payment method (cash or card).", ar: "كل عملية بيع تسجّل المريض والمواد وطريقة الدفع (نقداً أو بطاقة)." },
          { en: "Drafts, refunds and deletions are kept, never lost.", ar: "المسودات والمرتجعات والمحذوفات محفوظة، لا تضيع." },
        ],
      },
      {
        id: "lab",
        shot: "/assets/bear/screens/lab.png",
        shotEn: "/assets/bear/screens/lab-en.png",
        art: "/assets/bear/doctor-bear-lab.png",
        alt:  { en: "Lab: each patient's test with its state, from needs a sample to results ready", ar: "المختبر: تحليل كل مريض وحالته، من يحتاج عينة حتى النتائج الجاهزة" },
        name: { en: "Laboratory", ar: "المختبر" },
        lead: { en: "Every test from the sample to the result, and the doctor is told.", ar: "كل تحليل من أخذ العينة حتى النتيجة، ويُبلَّغ الطبيب." },
        points: [
          { en: "Tabs follow the work: needs a sample, in the lab queue, processing, and results ready.", ar: "تبويبات تتبع العمل: يحتاج عينة، في طابور المختبر، قيد التحليل، والنتائج الجاهزة." },
          { en: "Urgent tests come first, and the top of the page shows only what needs you now.", ar: "التحاليل العاجلة أولاً، وأعلى الصفحة يُظهر فقط ما يحتاجك الآن." },
          { en: "Each test has its own form with the patient's normal range; a high or low value is flagged as you type.", ar: "لكل تحليل نموذجه مع المدى الطبيعي للمريض، والقيمة المرتفعة أو المنخفضة تُنبَّه أثناء الكتابة." },
          { en: "Send the result to the doctor, the patient and reception with the lab's report attached, or flag it for a follow-up call.", ar: "أرسل النتيجة إلى الطبيب والمريض والاستقبال مع ورقة التقرير، أو أشِر إليها لمكالمة متابعة." },
        ],
      },
    ],
  },
  {
    name:  { en: "Money", ar: "المال" },
    intro: { en: "From the patient's payment to the owner's account, every dinar is accounted for.", ar: "من دفعة المريض إلى حساب المالك، كل دينار محسوب." },
    bg: "",
    modules: [
      {
        id: "payments",
        shot: "/assets/bear/screens/payments.png",
        shotEn: "/assets/bear/screens/payments-en.png",
        art: "/assets/bear/doctor-bear-cash.png",
        alt:  { en: "Payments: what each patient has left to pay", ar: "المدفوعات: ما بقي على كل مريض" },
        name: { en: "Payments", ar: "المدفوعات" },
        lead: { en: "What is due, what is owed, and everything already paid.", ar: "ما هو مطلوب، وما هو دين، وكل ما دُفع." },
        points: [
          { en: "Three views: due now, debts, and the full log.", ar: "ثلاثة عروض: المطلوب الآن، والديون، والسجل الكامل." },

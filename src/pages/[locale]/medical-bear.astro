          { en: "Groups decide how each item adds up in the reports.", ar: "المجموعات تحدد كيف يُجمع كل عنصر في التقارير." },
          { en: "Most clinics need one price list; add more for another department.", ar: "تكفي معظم العيادات قائمة أسعار واحدة، وأضف قوائم أخرى لقسم ثانٍ." },
          { en: "A service without a price can be priced at payment time. Export any list.", ar: "الخدمة التي لا سعر لها تُسعَّر عند الدفع. وصدّر أي قائمة." },
        ],
      },
      {
        id: "reports",
        shot: "/assets/bear/screens/reports.png",
        shotEn: "/assets/bear/screens/reports-en.png",
        alt:  { en: "Today's summary report: net, received, cash, card, debts and a revenue chart", ar: "تقرير ملخص اليوم: الصافي والمستلم والنقد والبطاقة والديون ورسم الإيرادات" },
        name: { en: "Reports", ar: "التقارير" },
        lead: { en: "The day, the month or any period, on one page.", ar: "اليوم أو الشهر أو أي فترة، في صفحة واحدة." },
        points: [
          { en: "Net, revenue and expenses; received in cash and by card; open debts.", ar: "الصافي والإيرادات والمصاريف، والمستلم نقداً وبالبطاقة، والديون المفتوحة." },

        alt:  { en: "Accounts: every cash account's balance, received and paid today", ar: "الحسابات: رصيد كل حساب نقدي، وما قُبض وما صُرف اليوم" },
        name: { en: "Accounts", ar: "الحسابات" },
        lead: { en: "Where the clinic's money is right now, and every movement on it.", ar: "أين مال العيادة الآن، وكل حركة عليه." },
        points: [
          { en: "Cash accounts for each place money sits: the reception box, the pharmacy box, the bank, with the owner, and a dollar box.", ar: "حساب نقدي لكل مكان فيه مال: صندوق الاستقبال، وصندوق الصيدلية، والمصرف، وعند المالك، وصندوق الدولار." },
          { en: "Received and paid today on every account.", ar: "قبض اليوم وصرف اليوم لكل حساب." },

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WindowWidget from "../../components/WindowWidget.astro";
import { currentLocale, localizedHref } from "../../lib/i18n";

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const isAr = locale === "ar";
const L = (href: string) => localizedHref(href, locale);

const T = isAr ? {
  title:        "مركز العمران الطبي — دراسة حالة كليم",
  description:  "كيف حررنا بيانات مركز العمران الطبي من نظام قديم وبنينا منصة حديثة بـ 97/100 PageSpeed.",
  eyebrow:      "دراسة حالة",
  h1:           "مركز العمران الطبي",
  subtitle:     "من WordPress قديم إلى منصة حديثة مفتوحة",
  lede:         "عندما جاءتنا مركز العمران الطبي، كانت تملك 600 مقالة وسنوات من البيانات محبوسة في موقع WordPress بطيء ومكسّر. في ستة أشهر، استخرجنا البيانات، نظّفناها، وأعدنا بناء الموقع بالكامل على تقنيات حديثة. النتيجة: موقع سريع، آمن، وتحت سيطرة المركز كاملاً.",

  challenge:    "التحدي",
  challengeDesc: "الموقع القديم (alimranmed.com) كان يعاني من بطء وعدم استقرار. لا توثيق واضح، لا نسخ احتياطية، والبيانات مبعثرة عبر قاعدة بيانات مُسيئة الاستخدام. المركز لا يملك حتى الوصول الكامل إلى بيانات مرضاه في الموقع.",

  solution:    "الحل",
  solutionDesc: "بنينا عملية استخراج منهجية: فحصنا البنية القديمة، استخرجنا كل مقالة وتعليق، نظّفنا البيانات (توحيد التنسيقات، إزالة التكرار، إصلاح الروابط المكسورة)، ثم أعدنا البناء على Astro مع Cloudflare Workers.",

  results:     "النتائج",
  r1Title:     "الأداء",
  r1:          "97/100 PageSpeed — أسرع 10× من الموقع القديم",
  r2Title:     "البيانات",
  r2:          "600 مقالة + تعليقات منظّفة وموثّقة بالكامل",
  r3Title:     "الملكية",
  r3:          "المستودع وكل المفاتيح بيد المركز على GitHub",
  r4Title:     "الاستقلالية",
  r4:          "خادم مفتوح (Cloudflare Workers)، بلا قفل بائع",
  r5Title:     "اللغة",
  r5:          "دعم كامل ثنائي اللغة EN/AR مع أداء متساوٍ",
  r6Title:     "التكلفة",
  r6:          "استضافة مجانية تماماً على Cloudflare (لا رسوم شهرية)",

  technicalHead: "البنية التقنية",
  t1:          "Astro Static Site Generator — سرعة وموثوقية",
  t2:          "Cloudflare Workers — معالجة بدون خادم",
  t3:          "Open standards — لا قفل في التقنيات",
  t4:          "Git workflow — كل التاريخ موثّق",

  processHead:  "العملية — خمس خطوات",
  step1Title:  "1. التقييم",
  step1:       "تحديد موقع الأنظمة والحسابات والبيانات: الأجهزة، مزودو الخدمات، قواعد البيانات القديمة.",
  step2Title:  "2. الاستخراج والتنظيف",
  step2:       "استخراج البيانات، إزالة النسخ المكررة، توحيد التنسيقات، إصلاح الصور والروابط.",
  step3Title:  "3. البناء على معايير مفتوحة",
  step3:       "بناء Astro site، جميع المقالات كـ markdown، تصميم عصري متجاوب.",
  step4Title:  "4. تسليم المفاتيح",
  step4:       "الحسابات والنطاق باسمك، المستودع في حسابك، التوثيق الكامل، إزالة صلاحياتنا.",
  step5Title:  "5. الدعم، ثم الحرية",
  step5:       "إصلاحات مجانية وأسئلة لفترة محددة، ثم الدفع حسب الاستخدام أو مزود آخر — اختيارك.",

  ownershipHead: "الملكية الحقيقية",
  o1:          "كل شيء — الكود، البيانات، المستودع — ملك للمركز",
  o2:          "لا اشتراكات شهرية ولا قفل بائع",
  o3:          "يمكن نقل الموقع بسهولة إلى أي خادم في أي وقت",
  o4:          "التطوير المستقبلي بدون الحاجة إلينا",

  problemsHead: "المشاكل في الموقع القديم",
  p1:          "تصميم فوضوي وغير واضح",
  p2:          "نصوص غير منظّمة وصعبة القراءة",
  p3:          "صور عشوائية وعناصر CSS مكسورة",
  p4:          "عناصر غير محاذاة وتخطيط سيء",
  p5:          "موقع بطيء جداً مع نسبة توقف عالية",
  p6:          "روابط مكسورة وقوائم لا تستجيب",
  p7:          "لا يعمل على الهواتف الذكية",
  p8:          "المقالات مجرد كومة من النصوص بلا تنسيق",

  beforeAfterHead: "التصميم الحديث",
  designShowcaseDesc: "تصميم حديث متوافق مع الهواتف بنسبة مئة بالمئة، مع ثيم فاتح وغامق وسهل الاستخدام.",
  homeLabel:   "الصفحة الرئيسية",
  articleLabel: "صفحات المقالات",
  libraryLabel: "المكتبة",

  featuresHead: "ميزات الموقع الجديد",
  f1:          "تخطيط نظيف وواضح مع رسالة مباشرة",
  f2:          "صور عالية الجودة تظهر الأهمية",
  f3:          "مقالات معاد كتابتها بمعلومات مستخرجة بعناية",
  f4:          "تخطيط نظيف وقابل للقراءة",
  f5:          "محرك بحث متقدم للعثور على المقالات بسهولة",
  f6:          "مكتبة للتصفح والاستكشاف",
  f7:          "دعم البحث بالذكاء الاصطناعي (LLM)",
  f8:          "جاهز للتكامل مع أي تطبيق ذكاء اصطناعي",
  f9:          "ثيم فاتح وغامق",
  f10:         "سرعة فائقة وموثوقية 99.9%",

  pageComparisonsHead: "تحويل كل صفحة",
  homepageLabel: "الصفحة الرئيسية",
  articlesLabel: "صفحات المقالات",
  libraryLabel:  "المكتبة والاستكشاف",

  ctaHead:      "جاهز لتحرير نظامك الرقمي؟",
  ctaLabel:     "احجز تدقيق مجاني",

} : {
  title:        "Alimran Clinic — Kaleem case study",
  description:  "How we liberated Alimran Clinic's data from a legacy system and built a modern 97/100 PageSpeed platform.",
  eyebrow:      "Case study",
  h1:           "Alimran Clinic",
  subtitle:     "From legacy WordPress to a modern, open platform",
  lede:         "Alimran Clinic arrived with 600 articles and years of data trapped in a slow, broken WordPress site. Over six months, we extracted the data, cleaned it, and rebuilt the entire platform on modern technology. The result: a fast, secure site completely under the clinic's control.",

  challenge:    "The Challenge",
  challengeDesc: "The old site (alimranmed.com) was slow and unstable. No clear documentation, no reliable backups, and patient data scattered across a mismanaged database. The clinic didn't even have full access to its own data on the website.",

  solution:    "The Solution",
  solutionDesc: "We built a systematic extraction process: examined the legacy structure, extracted every article and comment, cleaned the data (standardized formats, removed duplicates, fixed broken links), then rebuilt on Astro with Cloudflare Workers.",

  results:     "The Results",
  r1Title:     "Performance",
  r1:          "97/100 PageSpeed — 10× faster than the legacy site",
  r2Title:     "Data",
  r2:          "600 articles + comments fully cleaned and documented",
  r3Title:     "Ownership",
  r3:          "Repository and all keys in the clinic's hands on GitHub",
  r4Title:     "Independence",
  r4:          "Open infrastructure (Cloudflare Workers), no vendor lock-in",
  r5Title:     "Language",
  r5:          "Full bilingual EN/AR support with equal performance",
  r6Title:     "Cost",
  r6:          "Completely free hosting on Cloudflare (no monthly fees)",

  technicalHead: "Technical Architecture",
  t1:          "Astro Static Site Generator — speed and reliability",
  t2:          "Cloudflare Workers — serverless processing",
  t3:          "Open standards — no technology lock-in",
  t4:          "Git workflow — every change tracked and reversible",

  processHead:  "The Process — Five Steps",
  step1Title:  "1. Audit",
  step1:       "Map where your systems, accounts and data really are: devices, providers, legacy databases.",
  step2Title:  "2. Extract & Clean",
  step2:       "Get your data out, remove duplicates, standardize formats, fix images and links.",
  step3Title:  "3. Rebuild on Open Standards",
  step3:       "Build Astro site, all articles as markdown, modern responsive design.",
  step4Title:  "4. Hand Over the Keys",
  step4:       "Accounts and domain in your name, code repository in your account, full documentation, our access removed.",
  step5Title:  "5. Support, Then Freedom",
  step5:       "Free fixes and guidance for a set period, then pay-as-you-go, monthly plan, or another provider — your choice.",

  ownershipHead: "True Ownership",
  o1:          "Everything — code, data, repository — belongs to the clinic",
  o2:          "No monthly subscriptions, no vendor lock-in",
  o3:          "Site can move to any server anytime without losing anything",
  o4:          "Future development possible without depending on us",

  problemsHead: "Problems with the Legacy Site",
  p1:          "Cluttered and confusing design",
  p2:          "Unreadable and disorganized text",
  p3:          "Random AI-generated images and broken CSS elements",
  p4:          "Misaligned elements and poor layout",
  p5:          "Painfully slow with poor uptime",
  p6:          "Broken links and unresponsive menus",
  p7:          "No mobile support whatsoever",
  p8:          "Articles were just walls of text with no visual structure",

  beforeAfterHead: "The Modern Design",
  designShowcaseDesc: "Fully responsive design with dark and light themes, built for speed and clarity with every interaction carefully considered.",
  homeLabel:   "Homepage",
  articleLabel: "Article pages",
  libraryLabel: "Library",

  featuresHead: "New Website Features",
  f1:          "Clean layout with direct messaging",
  f2:          "High-quality images showing what matters",
  f3:          "Articles rewritten with carefully extracted information",
  f4:          "Clean, readable layout throughout",
  f5:          "Advanced search to find articles instantly",
  f6:          "Library to browse and discover content",
  f7:          "AI-powered search (LLM integration)",
  f8:          "Plug and play ready for any AI application",
  f9:          "Dark and light themes",
  f10:         "Lightning-fast with 99.9% uptime",

  pageComparisonsHead: "Every page transformed",
  homepageLabel: "Homepage",
  articlesLabel: "Article pages",
  libraryLabel:  "Library & Discovery",

  ctaHead:      "Ready to liberate your digital platform?",
  ctaLabel:     "Book a free audit",
};
---

<BaseLayout title={T.title} description={T.description}>
  <!-- ─── HERO ─────────────────────────────────────────────── -->
  <section class="hero-section bg-sky">
    <div class="container">
      <span class="eyebrow">{T.eyebrow}</span>
      <h1 class="hero-h1">{T.h1}</h1>
      <p class="hero-subtitle">{T.subtitle}</p>
      <p class="hero-lede">{T.lede}</p>
    </div>
  </section>

  <!-- ─── PROBLEMS GRID ──────────────────────────────────── -->
  <section class="problems-section bg-paper-2">
    <div class="container">
      <h2 class="section-heading">{T.problemsHead}</h2>
      <div class="problems-grid">
        <div class="sk problem-card bg-butter">
          <span class="problem-icon">✕</span>
          <p>{T.p1}</p>
        </div>
        <div class="sk problem-card bg-peach">
          <span class="problem-icon">✕</span>
          <p>{T.p2}</p>
        </div>
        <div class="sk problem-card bg-apricot">
          <span class="problem-icon">✕</span>
          <p>{T.p3}</p>
        </div>
        <div class="sk problem-card bg-lilac">
          <span class="problem-icon">✕</span>
          <p>{T.p4}</p>
        </div>
        <div class="sk problem-card bg-butter">
          <span class="problem-icon">✕</span>
          <p>{T.p5}</p>
        </div>
        <div class="sk problem-card bg-peach">
          <span class="problem-icon">✕</span>
          <p>{T.p6}</p>
        </div>
        <div class="sk problem-card bg-sky">
          <span class="problem-icon">✕</span>
          <p>{T.p7}</p>
        </div>
        <div class="sk problem-card bg-apricot">
          <span class="problem-icon">✕</span>
          <p>{T.p8}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── DESIGN SHOWCASE ────────────────────────────────── -->
  <section class="design-showcase-section">
    <div class="container">
      <h2 class="section-heading">{T.beforeAfterHead}</h2>
      <p class="showcase-description">{T.designShowcaseDesc}</p>
      <div class="showcase-grid">
        <div class="showcase-item">
          <WindowWidget src="/assets/illustrations/new-home-dark.png" alt="Homepage" chromeColor="sky" />
          <p class="showcase-label">{T.homeLabel}</p>
        </div>
        <div class="showcase-item">
          <WindowWidget src="/assets/illustrations/new-article-1-dark.png" alt="Article page" chromeColor="sky" />
          <p class="showcase-label">{T.articleLabel}</p>
        </div>
        <div class="showcase-item">
          <WindowWidget src="/assets/illustrations/new-article-2-dark.png" alt="Article details" chromeColor="sky" />
          <p class="showcase-label">{T.articleLabel}</p>
        </div>
        <div class="showcase-item">
          <WindowWidget src="/assets/illustrations/new-library-dark.png" alt="Library" chromeColor="sky" />
          <p class="showcase-label">{T.libraryLabel}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── FEATURES GRID ───────────────────────────────────── -->
  <section class="features-section bg-paper-2">
    <div class="container">
      <h2 class="section-heading">{T.featuresHead}</h2>
      <div class="features-grid">
        <div class="sk feature-card bg-sky">
          <span class="feature-icon">✓</span>
          <p>{T.f1}</p>
        </div>
        <div class="sk feature-card bg-mint">
          <span class="feature-icon">✓</span>
          <p>{T.f2}</p>
        </div>
        <div class="sk feature-card bg-lilac">
          <span class="feature-icon">✓</span>
          <p>{T.f3}</p>
        </div>
        <div class="sk feature-card bg-butter">
          <span class="feature-icon">✓</span>
          <p>{T.f4}</p>
        </div>
        <div class="sk feature-card bg-apricot">
          <span class="feature-icon">✓</span>
          <p>{T.f5}</p>
        </div>
        <div class="sk feature-card bg-peach">
          <span class="feature-icon">✓</span>
          <p>{T.f6}</p>
        </div>
        <div class="sk feature-card bg-sky">
          <span class="feature-icon">✓</span>
          <p>{T.f7}</p>
        </div>
        <div class="sk feature-card bg-butter">
          <span class="feature-icon">✓</span>
          <p>{T.f8}</p>
        </div>
        <div class="sk feature-card bg-lilac">
          <span class="feature-icon">✓</span>
          <p>{T.f9}</p>
        </div>
        <div class="sk feature-card bg-mint">
          <span class="feature-icon">✓</span>
          <p>{T.f10}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── CHALLENGE & SOLUTION ───────────────────────────── -->
  <section class="section-pair">
    <div class="container">
      <div class="pair-grid">
        <div class="sk card-butter">
          <h2>{T.challenge}</h2>
          <p>{T.challengeDesc}</p>
        </div>
        <div class="sk card-mint">
          <h2>{T.solution}</h2>
          <p>{T.solutionDesc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── PAGE-BY-PAGE COMPARISONS ───────────────────────── -->
  <section class="page-comparisons-section">
    <div class="container">
      <h2 class="section-heading">{T.pageComparisonsHead}</h2>
      <div class="comparisons-grid">
        <!-- Homepage -->
        <div class="comparison-group">
          <h3 class="comparison-label">{T.homepageLabel}</h3>
          <div class="comparison-row">
            <div class="comparison-column">
              <WindowWidget src="/assets/illustrations/old-homepage.png" alt="Old homepage" chromeColor="peach" />
              <p class="comparison-label-small">{T.oldLabel}</p>
            </div>
            <div class="comparison-column">
              <WindowWidget src="/assets/illustrations/new-homepage.png" alt="New homepage" chromeColor="sky" />
              <p class="comparison-label-small">{T.newLabel}</p>
            </div>
          </div>
        </div>

        <!-- Articles -->
        <div class="comparison-group">
          <h3 class="comparison-label">{T.articlesLabel}</h3>
          <div class="comparison-row">
            <div class="comparison-column">
              <WindowWidget src="/assets/illustrations/old-articles-1.png" alt="Old article page" chromeColor="peach" />
              <p class="comparison-label-small">{T.oldLabel}</p>
            </div>
            <div class="comparison-column">
              <WindowWidget src="/assets/illustrations/new-articles-1.png" alt="New article page" chromeColor="sky" />
              <p class="comparison-label-small">{T.newLabel}</p>
            </div>
          </div>
        </div>

        <!-- Library & Discovery -->
        <div class="comparison-group">
          <h3 class="comparison-label">{T.libraryLabel}</h3>
          <div class="comparison-row">
            <div class="comparison-column">
              <WindowWidget src="/assets/illustrations/old-articles-2.png" alt="Old library page" chromeColor="peach" />
              <p class="comparison-label-small">{T.oldLabel}</p>
            </div>
            <div class="comparison-column">
              <WindowWidget src="/assets/illustrations/library-feature.png" alt="New library page" chromeColor="sky" />
              <p class="comparison-label-small">{T.newLabel}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── RESULTS GRID ────────────────────────────────────── -->
  <section class="results-section bg-paper-2">
    <div class="container">
      <h2 class="section-heading">{T.results}</h2>
      <div class="results-grid">
        <div class="sk result-card bg-lilac">
          <span class="result-label">{T.r1Title}</span>
          <span class="result-value">{T.r1}</span>
        </div>
        <div class="sk result-card bg-peach">
          <span class="result-label">{T.r2Title}</span>
          <span class="result-value">{T.r2}</span>
        </div>
        <div class="sk result-card bg-butter">
          <span class="result-label">{T.r3Title}</span>
          <span class="result-value">{T.r3}</span>
        </div>
        <div class="sk result-card bg-sky">
          <span class="result-label">{T.r4Title}</span>
          <span class="result-value">{T.r4}</span>
        </div>
        <div class="sk result-card bg-apricot">
          <span class="result-label">{T.r5Title}</span>
          <span class="result-value">{T.r5}</span>
        </div>
        <div class="sk result-card bg-lilac">
          <span class="result-label">{T.r6Title}</span>
          <span class="result-value">{T.r6}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── TECHNICAL ARCHITECTURE ──────────────────────────── -->
  <section class="tech-section">
    <div class="container">
      <h2 class="section-heading">{T.technicalHead}</h2>
      <div class="tech-grid">
        <div class="sk tech-item bg-butter">
          <p>{T.t1}</p>
        </div>
        <div class="sk tech-item bg-sky">
          <p>{T.t2}</p>
        </div>
        <div class="sk tech-item bg-mint">
          <p>{T.t3}</p>
        </div>
        <div class="sk tech-item bg-apricot">
          <p>{T.t4}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── THE PROCESS ──────────────────────────────────────── -->
  <section class="process-section bg-paper-2">
    <div class="container">
      <h2 class="section-heading">{T.processHead}</h2>
      <div class="process-grid">
        <div class="sk process-step bg-lilac">
          <h3>{T.step1Title}</h3>
          <p>{T.step1}</p>
        </div>
        <div class="sk process-step bg-butter">
          <h3>{T.step2Title}</h3>
          <p>{T.step2}</p>
        </div>
        <div class="sk process-step bg-sky">
          <h3>{T.step3Title}</h3>
          <p>{T.step3}</p>
        </div>
        <div class="sk process-step bg-mint">
          <h3>{T.step4Title}</h3>
          <p>{T.step4}</p>
        </div>
        <div class="sk process-step bg-peach">
          <h3>{T.step5Title}</h3>
          <p>{T.step5}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── OWNERSHIP ───────────────────────────────────────── -->
  <section class="ownership-section bg-lilac">
    <div class="container">
      <h2 class="section-heading">{T.ownershipHead}</h2>
      <div class="ownership-list">
        <div class="sk ownership-item">
          <svg class="check" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 12.5l5 5 13-14" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <p>{T.o1}</p>
        </div>
        <div class="sk ownership-item">
          <svg class="check" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 12.5l5 5 13-14" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <p>{T.o2}</p>
        </div>
        <div class="sk ownership-item">
          <svg class="check" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 12.5l5 5 13-14" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <p>{T.o3}</p>
        </div>

  p6:          "روابط معطّلة وقوائم لا تستجيب",
  p7:          "لا يعمل على الهواتف إطلاقاً",
  p8:          "المقالات مجرد كتل نصية بلا أي تنسيق",

  beforeAfterHead: "التصميم الجديد",
  notesLabel:   "ملاحظات على التصميم",
  prevLabel:    "الصفحة السابقة",
  nextLabel:    "الصفحة التالية",
  openLabel:    "افتح هذه الصفحة على موقع المركز",
  designShowcaseDesc: "تصميم يتكيّف بالكامل مع الهواتف، مع وضعين فاتح وداكن، ومبني للسرعة والوضوح في كل تفصيلة.",
  homeLabel:   "الصفحة الرئيسية",
  articleLabel: "صفحات المقالات",

  featuresHead: "مزايا الموقع الجديد",
  f1:          "تخطيط نظيف ورسالة واضحة ومباشرة",
  f2:          "صور عالية الجودة تُبرز ما يهم",
  f3:          "مقالات أُعيدت كتابتها بمعلومات مستخرجة بعناية",
  f4:          "خطوط مريحة للقراءة بالعربية والإنجليزية",
  f5:          "بحث متقدّم للوصول إلى أي مقالة فوراً",
  f6:          "مكتبة لتصفّح المحتوى واستكشافه",
  f7:          "بحث مدعوم بالذكاء الاصطناعي (نماذج لغوية كبيرة)",
  f8:          "جاهز للربط مع أي تطبيق ذكاء اصطناعي",
  f9:          "وضعان فاتح وداكن",
  f10:         "سريع، ويُحمَّل من خوادم قريبة من كل زائر",

  pageComparisonsHead: "كل صفحة تغيّرت",
  homepageLabel: "الصفحة الرئيسية",
  articlesLabel: "صفحات المقالات",
  libraryLabel:  "المكتبة",
  compareHead:   "قبل وبعد",
  oldLabel:      "قبل (الموقع القديم لم يعد متاحاً)",
  newLabel:      "بعد (افتح الموقع المباشر)",


} : {
  title:        "Alimran Medical Center — Kaleem case study",
  description:  "How we freed Alimran Medical Center's data from a legacy website and built a modern platform that scores 97/100 on PageSpeed.",
  eyebrow:      "Case study",
  h1:           "Alimran Medical Center",
  subtitle:     "From legacy WordPress to a modern, open platform",
  lede:         "When Alimran Medical Center came to us, it had 600 articles and years of content trapped in a slow, broken WordPress site. Over six months, we extracted the data, cleaned it, and rebuilt the entire site on modern technology. The result: a fast, secure site fully under the center's control.",

  challenge:    "The challenge",
  challengeDesc: "The old site (alimranmed.com) was slow and unstable, with no clear documentation, no reliable backups, and its data scattered across a poorly managed database. The center didn't even have full access to its own website's data.",

  solution:    "The solution",
  solutionDesc: "We built a systematic extraction process: examined the legacy structure, extracted every article and comment, cleaned the data (standardized formats, removed duplicates, fixed broken links), then rebuilt on Astro and Cloudflare Workers.",

  results:     "The results",
  r1Title:     "Performance",
  r1:          "97/100 on Google PageSpeed",
  r2Title:     "Data",
  r2:          "600 articles and their comments, fully cleaned and documented",
  r3Title:     "Ownership",
  r3:          "The GitHub repository and all keys are in the center's hands",
  r4Title:     "Independence",
  r4:          "A static site that runs on any host — Cloudflare today, anyone else tomorrow",
  r5Title:     "Language",
  r5:          "Full Arabic and English support with equal performance",
  r6Title:     "Cost",
  r6:          "Completely free hosting on Cloudflare (no monthly fees)",

  technicalHead: "Technical architecture",
  t1:          "Astro static site generator — speed and reliability",

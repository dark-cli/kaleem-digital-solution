  prevLabel:    "Previous page",
  nextLabel:    "Next page",
  openLabel:    "Open this page on the center's site",
  designShowcaseDesc: "Fully responsive design with light and dark themes, built for speed and clarity in every detail.",
  homeLabel:   "Homepage",
  articleLabel: "Article pages",

  featuresHead: "New website features",
  f1:          "Clean layout with direct messaging",
  f2:          "High-quality images that highlight what matters",
  f3:          "Articles rewritten with carefully extracted information",
  f4:          "Comfortable, readable typography in Arabic and English",
  f5:          "Advanced search to find any article instantly",
  f6:          "A library to browse and discover content",
  f7:          "AI-powered search (LLM integration)",
  f8:          "Ready to connect to any AI application",
  f9:          "Light and dark themes",
  f10:         "Fast, served from servers close to every visitor",

  pageComparisonsHead: "Every page transformed",
  homepageLabel: "Homepage",
  articlesLabel: "Article pages",
  libraryLabel:  "Library",
  compareHead:   "Before and after",
  oldLabel:      "Before (the old site is offline)",
  newLabel:      "After (open the live site)",

};
// Slides for the rotating design window, each with a note for the aside.
const SITE = "https://alimran.clinic/en";
const SLIDES = (isAr ? [
  { label: "الصفحة الرئيسية", note: "الرسالة والطبيب الاستشاري وأربعة أرقام تبني الثقة، كلها في أول الصفحة." },
  { label: "الوضع الفاتح", note: "كل صفحة بوضعين فاتح وداكن، والموقع يتذكّر اختيار الزائر." },
  { label: "صفحة الحالة", note: "كل حالة تبدأ بلمحة سريعة: ما هي، وأعراضها، وكيف تُعالج، مع من راجعها ومتى." },
  { label: "تفاصيل المقالة", note: "الحقائق الطبية أرقام وخطوات لا كتل نصية، والفهرس وزر الاتصال يرافقان القارئ." },
  { label: "المكتبة", note: "كل المقالات في فهرس واحد، مع تصفية حسب النوع." },
  { label: "البحث", note: "بحث فوري من أي صفحة، مقسّم إلى حالات وإجراءات." },
  { label: "ملف الاستشاري", note: "سيرة كاملة للطبيب: الشهادات والمناصب والإنجازات." },
] : [
  { label: "Homepage", note: "The promise, the consultant and four trust numbers, all above the fold." },
  { label: "Light theme", note: "Every page in light and dark; the site remembers the visitor's choice." },
  { label: "Condition page", note: "Each condition opens at a glance: what it is, signs, treatment, and who reviewed it." },
  { label: "Article details", note: "Clinical facts as numbers and steps, not walls of text; contents and call button follow the reader." },
  { label: "Library", note: "Every article in one index, filterable by type." },
  { label: "Search", note: "Instant search from any page, grouped into conditions and procedures." },
  { label: "Consultant profile", note: "A full CV for the lead consultant: credentials and appointments." },
]).map((s, i) => ({
  ...s,
  src: [
    "/assets/illustrations/new-home-dark.png",
    "/assets/illustrations/new-homepage.png",
    "/assets/illustrations/new-article-1-dark.png",
    "/assets/illustrations/new-article-2-dark.png",
    "/assets/illustrations/new-library-dark.png",
    "/assets/illustrations/search-feature.png",
    "/assets/illustrations/theme-dark.png",
  ][i],
  href: [
    `${SITE}/`,
    `${SITE}/`,
    `${SITE}/treatments/cancer-pain/`,
    `${SITE}/treatments/cancer-pain/#s-2`,
    `${SITE}/library/`,
    `${SITE}/`,
    `${SITE}/doctors/hussein-imran-mousa/`,
  ][i],
}));

// Lists built from the copy above, so the markup stays short.
const PROBLEMS = [T.p1, T.p2, T.p3, T.p4, T.p5, T.p6, T.p7, T.p8];
const FEATURES = [T.f1, T.f2, T.f3, T.f4, T.f5, T.f6, T.f7, T.f8, T.f9, T.f10];
const RESULTS = [
  { t: T.r1Title, v: T.r1 }, { t: T.r2Title, v: T.r2 }, { t: T.r3Title, v: T.r3 },
  { t: T.r4Title, v: T.r4 }, { t: T.r5Title, v: T.r5 }, { t: T.r6Title, v: T.r6 },
];
// Step titles carry their own "1." numbering in the copy; the list numbers them.
const STEPS = [
  { t: T.step1Title, d: T.step1 }, { t: T.step2Title, d: T.step2 }, { t: T.step3Title, d: T.step3 },
  { t: T.step4Title, d: T.step4 }, { t: T.step5Title, d: T.step5 },
].map((s) => ({ ...s, t: s.t.replace(/^\d+\.\s*/, "") }));
const TECH = [T.t1, T.t2, T.t3, T.t4];
const OWNERSHIP = [T.o1, T.o2, T.o3, T.o4];

---

<BaseLayout title={T.title} description={T.description}>
  <!-- ─── HERO ─────────────────────────────────────────────── -->
  <section class="hero-section bg-sky">
    <div class="container">
      <span class="eyebrow">{T.eyebrow}</span>
      <h1 class="hero-h1">{T.h1}</h1>
      <p class="hero-subtitle">{T.subtitle}</p>
      <p class="hero-lede">{T.lede}</p>
    </div>
  </section>

  <!-- ─── THE NEW DESIGN: one rotating window as the body, with the
       design notes in a side aside (the article-layout art-aside
       pattern: sticky, mono label, rule, ruled list). Below 1056px the
       aside gives way to swipeable tabs above the window and a caption
       under it. Slides cross-fade every 5s, pause on hover/focus, and
       don't autoplay for reduced motion. -->
  <section class="showcase" data-rotator>
    <div class="container">
      <h2 class="section-heading">{T.beforeAfterHead}</h2>
      <p class="showcase-description">{T.designShowcaseDesc}</p>
      <div class="showcase-grid">
        <aside class="design-notes">
          <p class="notes-label">{T.notesLabel}</p>
          <span class="notes-rule" aria-hidden="true"></span>
          <ol>
            {SLIDES.map((s, i) => (
              <li>
                <button type="button" class:list={["note", { active: i === 0 }]} data-slide={i} aria-pressed={i === 0 ? "true" : "false"}>
                  <strong>{s.label}</strong>
                  <span>{s.note}</span>
                </button>
              </li>
            ))}
          </ol>
        </aside>
        <div class="showcase-body">
          <!-- The window lifts like other clickable windows; the screenshot
               is the link, and on small screens a translucent overlay
               carries the page name, its note and prev/next controls. -->
          <div class="window-link rot-wrap">
            <div class="sk window rot-window">
              <div class="window-chrome" data-sky></div>
              <div class="rot-stage">
                <a class="rot-open" href={SLIDES[0].href} target="_blank" rel="noopener" aria-label={T.openLabel}>
                  {SLIDES.map((s, i) => (
                    <img src={s.src} alt={s.label} class:list={["rot-img", { active: i === 0 }]} data-href={s.href} data-label={s.label} data-note={s.note} loading={i === 0 ? "eager" : "lazy"} />
                  ))}
                </a>
                <div class="rot-overlay">
                  <button type="button" class="rot-nav flip-rtl" data-step="-1" aria-label={T.prevLabel}>
                    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7l7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                  </button>
                  <div class="rot-text" aria-live="polite">
                    <strong><span class="rot-label">{SLIDES[0].label}</span> <bdi class="rot-count">1 / {SLIDES.length}</bdi></strong>
                    <span class="rot-note">{SLIDES[0].note}</span>
                  </div>
                  <button type="button" class="rot-nav flip-rtl" data-step="1" aria-label={T.nextLabel}>
                    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7l-7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ─── RESULTS: a ruled table, no boxes ─── -->
  <section class="results-section bg-paper-2">
    <div class="container">
      <h2 class="section-heading">{T.results}</h2>
      <dl class="results-table">
        {RESULTS.map((r) => (
          <div>
            <dt>{r.t}</dt>
            <dd>{r.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ─── CHALLENGE & SOLUTION: two plain text columns ─── -->
  <section class="story">
    <div class="container story-grid">
      <div>
        <h2 class="col-h2">{T.challenge}</h2>
        <p>{T.challengeDesc}</p>
      </div>
      <div>
        <h2 class="col-h2">{T.solution}</h2>
        <p>{T.solutionDesc}</p>
      </div>
    </div>
  </section>

  <!-- ─── PAGE-BY-PAGE COMPARISONS ───────────────────────── -->
  <section class="page-comparisons-section bg-paper-2">
    <div class="container">
      <h2 class="section-heading">{T.pageComparisonsHead}</h2>
      <div class="comparisons-grid">
        <!-- Homepage -->
        <div class="comparison-group">
          <h3 class="comparison-label">{T.homepageLabel}</h3>
          <div class="comparison-row">
            <div class="comparison-column">
              <div class="comparison-link">
                <WindowWidget src="/assets/illustrations/old-homepage.png" alt={isAr ? "الصفحة الرئيسية القديمة" : "Old homepage"} />
              </div>
              <p class="comparison-label-small">{T.oldLabel}</p>
            </div>
            <div class="comparison-column">
              <a href="https://alimran.clinic/en/" target="_blank" class="comparison-link window-link">
                <WindowWidget src="/assets/illustrations/new-homepage.png" alt={isAr ? "الصفحة الرئيسية الجديدة" : "New homepage"} chromeColor="sky-shader" />
              </a>
              <p class="comparison-label-small">{T.newLabel}</p>
            </div>
          </div>
        </div>

        <!-- Articles -->
        <div class="comparison-group">
          <h3 class="comparison-label">{T.articlesLabel}</h3>
          <div class="comparison-row">
            <div class="comparison-column">
              <div class="comparison-link">
                <WindowWidget src="/assets/illustrations/old-articles-1.png" alt={isAr ? "صفحة مقالة قديمة" : "Old article page"} />
              </div>
              <p class="comparison-label-small">{T.oldLabel}</p>
            </div>
            <div class="comparison-column">
              <a href="https://alimran.clinic/en/treatments/brain-tumor/" target="_blank" class="comparison-link window-link">
                <WindowWidget src="/assets/illustrations/new-articles-1.png" alt={isAr ? "صفحة مقالة جديدة" : "New article page"} chromeColor="sky-shader" />
              </a>
              <p class="comparison-label-small">{T.newLabel}</p>
            </div>
          </div>
        </div>

        <!-- Library & Discovery -->
        <div class="comparison-group">
          <h3 class="comparison-label">{T.libraryLabel}</h3>
          <div class="comparison-row">
            <div class="comparison-column">
              <div class="comparison-link">
                <WindowWidget src="/assets/illustrations/old-articles-2.png" alt={isAr ? "صفحة المكتبة القديمة" : "Old library page"} />
              </div>
              <p class="comparison-label-small">{T.oldLabel}</p>
            </div>
            <div class="comparison-column">

</BaseLayout>


<script is:inline>
  // Rotating design window: cross-fade through the slides, keep the
  // design-notes aside and the small-screen overlay in sync, and point
  // the screenshot link at the page being shown. Pauses on hover/focus; no autoplay for reduced motion.
  (function () {
    var timer = 0;
    function init() {
      clearInterval(timer);
      var root = document.querySelector("[data-rotator]");
      if (!root) return;
      var imgs = root.querySelectorAll(".rot-img");
      var notes = root.querySelectorAll(".note");
      var link = root.querySelector(".rot-open");
      var label = root.querySelector(".rot-label");
      var count = root.querySelector(".rot-count");
      var note = root.querySelector(".rot-note");
      var i = 0, paused = false;
      function show(n) {
        i = (n + imgs.length) % imgs.length;
        imgs.forEach(function (img, k) { img.classList.toggle("active", k === i); });
        notes.forEach(function (b) {
          var on = Number(b.getAttribute("data-slide")) === i;
          b.classList.toggle("active", on);
          b.setAttribute("aria-pressed", on ? "true" : "false");
        });
        link.href = imgs[i].getAttribute("data-href");
        label.textContent = imgs[i].getAttribute("data-label");
        count.textContent = (i + 1) + " / " + imgs.length;
        note.textContent = imgs[i].getAttribute("data-note");
      }
      notes.forEach(function (b) { b.addEventListener("click", function () { show(Number(b.getAttribute("data-slide"))); }); });
      root.querySelectorAll(".rot-nav").forEach(function (b) {
        b.addEventListener("click", function () { show(i + Number(b.getAttribute("data-step"))); });
      });
      // Swipe the screenshot to change page (right-to-left swipe = next;
      // mirrored in Arabic).
      var x0 = null;
      var stage = root.querySelector(".rot-stage");
      stage.addEventListener("touchstart", function (e) { x0 = e.touches[0].clientX; }, { passive: true });
      stage.addEventListener("touchend", function (e) {
        if (x0 === null) return;
        var dx = e.changedTouches[0].clientX - x0; x0 = null;
        if (Math.abs(dx) < 40) return;
        var rtl = document.documentElement.dir === "rtl";
        show(i + ((dx < 0) !== rtl ? 1 : -1));
      });
      root.addEventListener("mouseenter", function () { paused = true; });
      root.addEventListener("mouseleave", function () { paused = false; });
      root.addEventListener("focusin", function () { paused = true; });
      root.addEventListener("focusout", function () { paused = false; });
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      timer = setInterval(function () { if (!paused) show(i + 1); }, 5000);
    }
    document.addEventListener("astro:page-load", init);
    document.addEventListener("astro:before-swap", function () { clearInterval(timer); });
    init();
  })();
</script>


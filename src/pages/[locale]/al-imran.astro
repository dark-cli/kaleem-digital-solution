---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WindowWidget from "../../components/WindowWidget.astro";
import { currentLocale, localizedHref } from "../../lib/i18n";

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const isAr = locale === "ar";
const L = (href: string) => localizedHref(href, locale);

const T = isAr ? {
  title:        "مركز العمران الطبي — دراسة حالة من كليم",
  description:  "كيف حرّرنا بيانات مركز العمران الطبي من موقع قديم، وبنينا منصة حديثة تحصل على 97/100 في PageSpeed.",
  eyebrow:      "دراسة حالة",
  h1:           "مركز العمران الطبي",
  subtitle:     "من موقع WordPress قديم إلى منصة حديثة ومفتوحة",
  lede:         "حين تواصل معنا مركز العمران الطبي، كان لديه 600 مقالة وسنوات من المحتوى محبوسة في موقع WordPress بطيء ومعطّل. خلال ستة أشهر استخرجنا البيانات ونظّفناها، وأعدنا بناء الموقع بالكامل على تقنيات حديثة. النتيجة: موقع سريع وآمن، تحت سيطرة المركز بالكامل.",

  challenge:    "التحدي",
  challengeDesc: "كان الموقع القديم (alimranmed.com) بطيئاً وغير مستقر، بلا توثيق واضح ولا نسخ احتياطية موثوقة، وبياناته مبعثرة في قاعدة بيانات سيئة الإدارة. حتى المركز نفسه لم يكن يملك وصولاً كاملاً إلى بيانات موقعه.",

  solution:    "الحل",
  solutionDesc: "بنينا عملية استخراج منهجية: فحصنا بنية الموقع القديم، واستخرجنا كل مقالة وتعليق، ونظّفنا البيانات (توحيد الصيغ، وحذف المكرّر، وإصلاح الروابط المعطّلة)، ثم أعدنا البناء على Astro وCloudflare Workers.",

  results:     "النتائج",
  r1Title:     "الأداء",
  r1:          "97/100 في PageSpeed — أسرع بعشر مرات من الموقع القديم",
  r2Title:     "البيانات",
  r2:          "600 مقالة مع تعليقاتها، منظّفة وموثّقة بالكامل",
  r3Title:     "الملكية",
  r3:          "المستودع على GitHub وجميع المفاتيح بيد المركز",
  r4Title:     "الاستقلالية",
  r4:          "موقع ثابت يعمل على أي استضافة — Cloudflare اليوم، وأي مزوّد آخر غداً",
  r5Title:     "اللغة",
  r5:          "دعم كامل للعربية والإنجليزية بالأداء نفسه",
  r6Title:     "التكلفة",
  r6:          "استضافة مجانية بالكامل على Cloudflare (بلا رسوم شهرية)",

  technicalHead: "البنية التقنية",
  t1:          "Astro لتوليد المواقع الثابتة — سرعة وموثوقية",
  t2:          "Cloudflare Workers — معالجة دون خوادم تديرها بنفسك",
  t3:          "معايير مفتوحة — لا ارتهان لتقنية بعينها",
  t4:          "Git — كل تغيير مسجّل ويمكن التراجع عنه",

  processHead:  "العملية — خمس خطوات",
  step1Title:  "1. التقييم",
  step1:       "نحدّد أين توجد أنظمتك وحساباتك وبياناتك فعلاً: الأجهزة، ومزوّدو الخدمات، وقواعد البيانات القديمة.",
  step2Title:  "2. الاستخراج والتنظيف",
  step2:       "نستخرج بياناتك، ونحذف المكرّر، ونوحّد الصيغ، ونصلح الصور والروابط.",
  step3Title:  "3. البناء على معايير مفتوحة",
  step3:       "نبني الموقع بـ Astro، ونحفظ كل المقالات بصيغة Markdown، بتصميم حديث يتكيّف مع كل الشاشات.",
  step4Title:  "4. تسليم المفاتيح",
  step4:       "الحسابات والنطاق باسمك، والمستودع في حسابك، مع توثيق كامل — ثم نُزيل صلاحياتنا.",
  step5Title:  "5. الدعم، ثم الحرية",
  step5:       "إصلاحات وإرشاد مجاني لفترة محددة، ثم الدفع حسب الحاجة، أو خطة شهرية، أو مزوّد آخر — والخيار لك.",

  ownershipHead: "ملكية حقيقية",
  o1:          "كل شيء — الكود والبيانات والمستودع — ملك للمركز",
  o2:          "لا اشتراكات شهرية إلزامية ولا ارتهان لمزوّد",
  o3:          "يمكن نقل الموقع إلى أي خادم في أي وقت دون خسارة أي شيء",
  o4:          "التطوير مستقبلاً ممكن دون الاعتماد علينا",

  problemsHead: "مشاكل الموقع القديم",
  p1:          "تصميم مزدحم ومربك",
  p2:          "نصوص غير منظّمة وصعبة القراءة",
  p3:          "صور عشوائية مولّدة بالذكاء الاصطناعي وعناصر CSS معطّلة",
  p4:          "عناصر غير متناسقة وتخطيط رديء",
  p5:          "بطء شديد وانقطاعات متكررة",
  p6:          "روابط معطّلة وقوائم لا تستجيب",
  p7:          "لا يعمل على الهواتف إطلاقاً",
  p8:          "المقالات مجرد كتل نصية بلا أي تنسيق",

  beforeAfterHead: "التصميم الجديد",
  designShowcaseDesc: "تصميم يتكيّف بالكامل مع الهواتف، مع وضعين فاتح وداكن، ومبني للسرعة والوضوح في كل تفصيلة.",
  homeLabel:   "الصفحة الرئيسية",
  articleLabel: "صفحات المقالات",

  featuresHead: "مزايا الموقع الجديد",
  f1:          "تخطيط نظيف ورسالة واضحة ومباشرة",
  f2:          "صور عالية الجودة تُبرز ما يهم",
  f3:          "مقالات أُعيدت كتابتها بمعلومات مستخرجة بعناية",
  f4:          "خطوط مريحة للقراءة بالعربية والإنجليزية",
  f5:          "بحث متقدّم للوصول إلى أي مقالة فوراً",
  f6:          "مكتبة لتصفّح المحتوى واستكشافه",
  f7:          "بحث مدعوم بالذكاء الاصطناعي (نماذج لغوية كبيرة)",
  f8:          "جاهز للربط مع أي تطبيق ذكاء اصطناعي",
  f9:          "وضعان فاتح وداكن",
  f10:         "سرعة فائقة وتوفّر بنسبة 99.9%",

  pageComparisonsHead: "كل صفحة تغيّرت",
  homepageLabel: "الصفحة الرئيسية",
  articlesLabel: "صفحات المقالات",
  libraryLabel:  "المكتبة",
  oldLabel:      "قبل",
  newLabel:      "بعد",

  ctaHead:      "جاهز لتحرير منصتك الرقمية؟",
  ctaLabel:     "احجز تقييماً مجانياً",

} : {
  title:        "Alimran Medical Center — Kaleem case study",
  description:  "How we freed Alimran Medical Center's data from a legacy website and built a modern platform that scores 97/100 on PageSpeed.",
  eyebrow:      "Case study",
  h1:           "Alimran Medical Center",
  subtitle:     "From legacy WordPress to a modern, open platform",
  lede:         "When Alimran Medical Center came to us, it had 600 articles and years of content trapped in a slow, broken WordPress site. Over six months, we extracted the data, cleaned it, and rebuilt the entire site on modern technology. The result: a fast, secure site fully under the center's control.",

  challenge:    "The challenge",
  challengeDesc: "The old site (alimranmed.com) was slow and unstable, with no clear documentation, no reliable backups, and its data scattered across a poorly managed database. The center didn't even have full access to its own website's data.",

  solution:    "The solution",
  solutionDesc: "We built a systematic extraction process: examined the legacy structure, extracted every article and comment, cleaned the data (standardized formats, removed duplicates, fixed broken links), then rebuilt on Astro and Cloudflare Workers.",

  results:     "The results",
  r1Title:     "Performance",
  r1:          "97/100 on PageSpeed — 10× faster than the legacy site",
  r2Title:     "Data",
  r2:          "600 articles and their comments, fully cleaned and documented",
  r3Title:     "Ownership",
  r3:          "The GitHub repository and all keys are in the center's hands",
  r4Title:     "Independence",
  r4:          "A static site that runs on any host — Cloudflare today, anyone else tomorrow",
  r5Title:     "Language",
  r5:          "Full Arabic and English support with equal performance",
  r6Title:     "Cost",
  r6:          "Completely free hosting on Cloudflare (no monthly fees)",

  technicalHead: "Technical architecture",
  t1:          "Astro static site generator — speed and reliability",
  t2:          "Cloudflare Workers — serverless, no servers to manage",
  t3:          "Open standards — no technology lock-in",
  t4:          "Git workflow — every change tracked and reversible",

  processHead:  "The process — five steps",
  step1Title:  "1. Audit",
  step1:       "Map where your systems, accounts, and data really are: devices, providers, legacy databases.",
  step2Title:  "2. Extract & clean",
  step2:       "Get your data out, remove duplicates, standardize formats, and fix images and links.",
  step3Title:  "3. Rebuild on open standards",
  step3:       "Build the site with Astro, store every article as Markdown, and give it a modern responsive design.",
  step4Title:  "4. Hand over the keys",
  step4:       "Accounts and domain in your name, the code repository in your account, full documentation — then we remove our access.",
  step5Title:  "5. Support, then freedom",
  step5:       "Free fixes and guidance for a set period, then pay-as-you-go, a monthly plan, or another provider — your choice.",

  ownershipHead: "True ownership",
  o1:          "Everything — code, data, repository — belongs to the center",
  o2:          "No mandatory subscriptions, no vendor lock-in",
  o3:          "The site can move to any server anytime without losing anything",
  o4:          "Future development is possible without depending on us",

  problemsHead: "Problems with the legacy site",
  p1:          "Cluttered and confusing design",
  p2:          "Unreadable and disorganized text",
  p3:          "Random AI-generated images and broken CSS",
  p4:          "Misaligned elements and a poor layout",
  p5:          "Painfully slow with frequent downtime",
  p6:          "Broken links and unresponsive menus",
  p7:          "No mobile support whatsoever",
  p8:          "Articles were just walls of text with no visual structure",

  beforeAfterHead: "The new design",
  designShowcaseDesc: "Fully responsive design with light and dark themes, built for speed and clarity in every detail.",
  homeLabel:   "Homepage",
  articleLabel: "Article pages",

  featuresHead: "New website features",
  f1:          "Clean layout with direct messaging",
  f2:          "High-quality images that highlight what matters",
  f3:          "Articles rewritten with carefully extracted information",
  f4:          "Comfortable, readable typography in Arabic and English",
  f5:          "Advanced search to find any article instantly",
  f6:          "A library to browse and discover content",
  f7:          "AI-powered search (LLM integration)",
  f8:          "Ready to connect to any AI application",
  f9:          "Light and dark themes",
  f10:         "Lightning-fast with 99.9% uptime",

  pageComparisonsHead: "Every page transformed",
  homepageLabel: "Homepage",
  articlesLabel: "Article pages",
  libraryLabel:  "Library",
  oldLabel:      "Before",
  newLabel:      "After",

  ctaHead:      "Ready to liberate your digital platform?",
  ctaLabel:     "Book a free audit",
};---

<BaseLayout title={T.title} description={T.description}>
  <!-- ─── HERO ─────────────────────────────────────────────── -->
  <section class="hero-section bg-sky">
    <div class="container">
      <span class="eyebrow">{T.eyebrow}</span>
      <h1 class="hero-h1">{T.h1}</h1>
      <p class="hero-subtitle">{T.subtitle}</p>
      <p class="hero-lede">{T.lede}</p>
    </div>
  </section>

  <!-- ─── PROBLEMS GRID ──────────────────────────────────── -->
  <section class="problems-section bg-paper-2">
    <div class="container">
      <h2 class="section-heading">{T.problemsHead}</h2>
      <div class="problems-grid">
        <div class="sk problem-card bg-butter">
          <span class="problem-icon">✕</span>
          <p>{T.p1}</p>
        </div>
        <div class="sk problem-card bg-peach">
          <span class="problem-icon">✕</span>
          <p>{T.p2}</p>
        </div>
        <div class="sk problem-card bg-apricot">
          <span class="problem-icon">✕</span>
          <p>{T.p3}</p>
        </div>
        <div class="sk problem-card bg-lilac">
          <span class="problem-icon">✕</span>
          <p>{T.p4}</p>
        </div>
        <div class="sk problem-card bg-butter">
          <span class="problem-icon">✕</span>
          <p>{T.p5}</p>
        </div>
        <div class="sk problem-card bg-peach">
          <span class="problem-icon">✕</span>
          <p>{T.p6}</p>
        </div>
        <div class="sk problem-card bg-sky">
          <span class="problem-icon">✕</span>
          <p>{T.p7}</p>
        </div>
        <div class="sk problem-card bg-apricot">
          <span class="problem-icon">✕</span>
          <p>{T.p8}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── DESIGN SHOWCASE ────────────────────────────────── -->
  <section class="design-showcase-section">
    <div class="container">
      <h2 class="section-heading">{T.beforeAfterHead}</h2>
      <p class="showcase-description">{T.designShowcaseDesc}</p>
      <div class="showcase-grid">
        <a href="https://alimran.clinic/en/" target="_blank" class="showcase-item">
          <WindowWidget src="/assets/illustrations/new-home-dark.png" alt={isAr ? "الصفحة الرئيسية" : "Homepage"} chromeColor="sky-shader" />
          <p class="showcase-label">{T.homeLabel}</p>
        </a>
        <a href="https://alimran.clinic/en/treatments/brain-tumor/" target="_blank" class="showcase-item">
          <WindowWidget src="/assets/illustrations/new-article-1-dark.png" alt={isAr ? "صفحة مقالة" : "Article page"} chromeColor="sky-shader" />
          <p class="showcase-label">{T.articleLabel}</p>
        </a>
        <a href="https://alimran.clinic/en/treatments/cancer-pain/#s-2" target="_blank" class="showcase-item">
          <WindowWidget src="/assets/illustrations/new-article-2-dark.png" alt={isAr ? "تفاصيل مقالة" : "Article details"} chromeColor="sky-shader" />
          <p class="showcase-label">{T.articleLabel}</p>
        </a>
        <a href="https://alimran.clinic/en/library/" target="_blank" class="showcase-item">
          <WindowWidget src="/assets/illustrations/new-library-dark.png" alt={isAr ? "المكتبة" : "Library"} chromeColor="sky-shader" />
          <p class="showcase-label">{T.libraryLabel}</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── FEATURES GRID ───────────────────────────────────── -->
  <section class="features-section bg-paper-2">
    <div class="container">
      <h2 class="section-heading">{T.featuresHead}</h2>
      <div class="features-grid">
        <div class="sk feature-card bg-sky">
          <span class="feature-icon">✓</span>
          <p>{T.f1}</p>
        </div>
        <div class="sk feature-card bg-mint">
          <span class="feature-icon">✓</span>
          <p>{T.f2}</p>
        </div>
        <div class="sk feature-card bg-lilac">
          <span class="feature-icon">✓</span>
          <p>{T.f3}</p>
        </div>
        <div class="sk feature-card bg-butter">
          <span class="feature-icon">✓</span>
          <p>{T.f4}</p>
        </div>
        <div class="sk feature-card bg-apricot">
          <span class="feature-icon">✓</span>
          <p>{T.f5}</p>
        </div>
        <div class="sk feature-card bg-peach">
          <span class="feature-icon">✓</span>
          <p>{T.f6}</p>
        </div>
        <div class="sk feature-card bg-sky">
          <span class="feature-icon">✓</span>
          <p>{T.f7}</p>
        </div>
        <div class="sk feature-card bg-butter">
          <span class="feature-icon">✓</span>
          <p>{T.f8}</p>
        </div>
        <div class="sk feature-card bg-lilac">
          <span class="feature-icon">✓</span>
          <p>{T.f9}</p>
        </div>
        <div class="sk feature-card bg-mint">
          <span class="feature-icon">✓</span>
          <p>{T.f10}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── CHALLENGE & SOLUTION ───────────────────────────── -->
  <section class="section-pair">
    <div class="container">
      <div class="pair-grid">
        <div class="sk card-butter">
          <h2>{T.challenge}</h2>
          <p>{T.challengeDesc}</p>
        </div>
        <div class="sk card-mint">
          <h2>{T.solution}</h2>
          <p>{T.solutionDesc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── PAGE-BY-PAGE COMPARISONS ───────────────────────── -->
  <section class="page-comparisons-section">
    <div class="container">
      <h2 class="section-heading">{T.pageComparisonsHead}</h2>
      <div class="comparisons-grid">
        <!-- Homepage -->
        <div class="comparison-group">
          <h3 class="comparison-label">{T.homepageLabel}</h3>
          <div class="comparison-row">
            <div class="comparison-column">
              <a href="https://web.archive.org/web/20240101000000*/alimranmed.com" target="_blank" class="comparison-link">
                <WindowWidget src="/assets/illustrations/old-homepage.png" alt={isAr ? "الصفحة الرئيسية القديمة" : "Old homepage"} />
              </a>
              <p class="comparison-label-small">{T.oldLabel}</p>
            </div>
            <div class="comparison-column">
              <a href="https://alimran.clinic/en/" target="_blank" class="comparison-link">
                <WindowWidget src="/assets/illustrations/new-homepage.png" alt={isAr ? "الصفحة الرئيسية الجديدة" : "New homepage"} chromeColor="sky-shader" />
              </a>
              <p class="comparison-label-small">{T.newLabel}</p>
            </div>
          </div>
        </div>

        <!-- Articles -->
        <div class="comparison-group">
          <h3 class="comparison-label">{T.articlesLabel}</h3>
          <div class="comparison-row">
            <div class="comparison-column">
              <a href="https://web.archive.org/web/20240101000000*/alimranmed.com" target="_blank" class="comparison-link">
                <WindowWidget src="/assets/illustrations/old-articles-1.png" alt={isAr ? "صفحة مقالة قديمة" : "Old article page"} />
              </a>
              <p class="comparison-label-small">{T.oldLabel}</p>
            </div>
            <div class="comparison-column">
              <a href="https://alimran.clinic/en/treatments/brain-tumor/" target="_blank" class="comparison-link">
                <WindowWidget src="/assets/illustrations/new-articles-1.png" alt={isAr ? "صفحة مقالة جديدة" : "New article page"} chromeColor="sky-shader" />
              </a>
              <p class="comparison-label-small">{T.newLabel}</p>
            </div>
          </div>
        </div>

        <!-- Library & Discovery -->
        <div class="comparison-group">
          <h3 class="comparison-label">{T.libraryLabel}</h3>
          <div class="comparison-row">
            <div class="comparison-column">
              <a href="https://web.archive.org/web/20240101000000*/alimranmed.com" target="_blank" class="comparison-link">
                <WindowWidget src="/assets/illustrations/old-articles-2.png" alt={isAr ? "صفحة المكتبة القديمة" : "Old library page"} />
              </a>
              <p class="comparison-label-small">{T.oldLabel}</p>
            </div>
            <div class="comparison-column">
              <a href="https://alimran.clinic/en/library/" target="_blank" class="comparison-link">
                <WindowWidget src="/assets/illustrations/library-feature.png" alt={isAr ? "صفحة المكتبة الجديدة" : "New library page"} chromeColor="sky-shader" />
              </a>
              <p class="comparison-label-small">{T.newLabel}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── RESULTS GRID ────────────────────────────────────── -->
  <section class="results-section bg-paper-2">
    <div class="container">
      <h2 class="section-heading">{T.results}</h2>
      <div class="results-grid">
        <div class="sk result-card bg-lilac">
          <span class="result-label">{T.r1Title}</span>
          <span class="result-value">{T.r1}</span>
        </div>
        <div class="sk result-card bg-peach">
          <span class="result-label">{T.r2Title}</span>
          <span class="result-value">{T.r2}</span>
        </div>
        <div class="sk result-card bg-butter">
          <span class="result-label">{T.r3Title}</span>
          <span class="result-value">{T.r3}</span>
        </div>
        <div class="sk result-card bg-sky">
          <span class="result-label">{T.r4Title}</span>
          <span class="result-value">{T.r4}</span>
        </div>
        <div class="sk result-card bg-apricot">
          <span class="result-label">{T.r5Title}</span>
          <span class="result-value">{T.r5}</span>
        </div>
        <div class="sk result-card bg-lilac">
          <span class="result-label">{T.r6Title}</span>
          <span class="result-value">{T.r6}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── TECHNICAL ARCHITECTURE ──────────────────────────── -->
  <section class="tech-section">
    <div class="container">
      <h2 class="section-heading">{T.technicalHead}</h2>
      <div class="tech-grid">
        <div class="sk tech-item bg-butter">
          <p>{T.t1}</p>
        </div>
        <div class="sk tech-item bg-sky">
          <p>{T.t2}</p>
        </div>
        <div class="sk tech-item bg-mint">
          <p>{T.t3}</p>
        </div>
        <div class="sk tech-item bg-apricot">
          <p>{T.t4}</p>
        </div>
      </div>
    </div>

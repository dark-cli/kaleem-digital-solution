---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WindowWidget from "../../components/WindowWidget.astro";
import { currentLocale } from "../../lib/i18n";

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const isAr = locale === "ar";

const T = isAr ? {

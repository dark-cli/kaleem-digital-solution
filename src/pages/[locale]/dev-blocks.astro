        <p class="preview-tag mt">{T.inUse}</p>
        <div class="note">{isAr ? "أمثلة: /treatments/example-1/, /blog/article-one/, /services/service-name/" : "Examples: /treatments/example-1/, /blog/article-one/, /services/service-name/"}</div>
      </div>
    </section>
  </div>
</BaseLayout>


---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { currentLocale, localizedHref } from "../../lib/i18n";

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const isAr = locale === "ar";
const L = (href: string) => localizedHref(href, locale);

const T = isAr ? {
  title: "كليم — الصفحة الرئيسية",
  description: "حلول رقمية سريعة وغير مكلفة للشركات في العراق.",
  heroHeading: "أنظمتك وبياناتك وحريتك",
  heroText: "نبني مواقع وتطبيقات وأنظمة وشبكات في البصرة — ونحررك من الأنظمة القديمة المغلقة.",
  soundFamiliar: "هل تشعر بهذا؟",
  problem1: "فقدت كلمة المرور لموقعك أو نظامك الخاص؟",
  problem2: "بياناتك مقسمة بينك وبين المزود؟",
  problem3: "خائف من المغادرة لأنك ستفقد كل شيء؟",
  problemSolution: "هذا بالضبط ما نصلحه.",
  methodHeading: "خمس خطوات من المغلق إلى الحر",
  methodDesc: "نفس الطريقة في كل مشروع — موقع أو تطبيق أو نظام متجر أو شبكة كاميرات.",
  m01: "التدقيق",
  m01Desc: "نحدد مكان أنظمتك وحساباتك وبياناتك بالفعل.",
  m02: "الاستخراج والتنظيف",
  m02Desc: "نسحب بياناتك للخارج ونزيل التكرارات ونصحح الصيغ.",
  m03: "إعادة البناء على معايير مفتوحة",
  m03Desc: "أدوات حديثة ومفتوحة وتنسيقات يمكن لأي مطور قراءتها.",
  m04: "تسليم المفاتيح",
  m04Desc: "النطاق والحسابات والبيانات باسمك — ثم نسحب وصولنا.",
  m05: "الدعم ثم الحرية",
  m05Desc: "دعم مجاني لفترة محددة، ثم اختيارك: نحن أم أي شخص آخر.",
  servicesHeading: "ستة خدمات، طريقة واحدة",
  allServicesLink: "تفاصيل جميع الخدمات",
  s1: "التحرير",
  s1Desc: "نسحب بياناتك من الأنظمة القديمة والمغلقة إلى صيغ مفتوحة تتحكم فيها.",
  s2: "مواقع وتطبيقات ويب",
  s2Desc: "مواقع سريعة ثنائية اللغة بأقل تكلفة استضافة ممكنة.",
  s3: "تطبيقات الهاتف",
  s3Desc: "تطبيقات Android و iOS للطلب والحجوزات والاستخدام الداخلي.",
  s4: "أنظمة الإدارة والمتاجر",
  s4Desc: "أنظمة الجرد والبيع والإدارة، في السحابة أو في الموقع.",
  s5: "الشبكات والأمان",
  s5Desc: "كاميرات المراقبة وأنظمة الأمان والشبكات المنظمة.",
  s6: "الاستشارات والتدريب",
  s6Desc: "نساعدك تقرر ما تبني وتشتري وتبقي أو تستبدل.",
  keepKeys: "أنت تحتفظ بالمفاتيح",
  k1: "بياناتك ومحتواك، في صيغ مفتوحة",
  k2: "نطاقك، مسجل باسمك",
  k3: "استضافتك وحسابات السحابة، مملوكة لك",
  k4: "مستودع الكود في حسابك، برخصة دائمة لتغييره أو تسليمه لمطور آخر",
  k5: "وثائق قصيرة وتدريب لفريقك",
  valuesHeading: "قيمنا",
  v1: "الحرية على الحبس",
  v1Desc: "يمكنك المغادرة من أي مزود، بما فيه نحن، متى شئت.",
  v2: "بياناتك لك",
  v2Desc: "المحتوى والبيانات والنطاق والحسابات باسمك.",
  v3: "المفتوح على المغلق",
  v3Desc: "تنسيقات وأدوات قياسية يمكن لأي مطور التقاطها.",
  v4: "البسيط على المكلف",
  v4Desc: "لا خوادم أو اشتراكات لا تحتاجها.",
  v5: "أرقام صادقة",
  v5Desc: "نتائج حقيقية وذات تاريخ. لا ترتيبات بحث موعودة.",
  v6: "شرح كل شيء",
  v6Desc: "نوثق ما نبنيه ونتدرب على فريقك.",
  recentWork: "أعمال حديثة",
  caseStudy: "كل مشروع يثبت نفس الطريقة",
  alImran: "عيادة العمران",
  caseDesc: "من موقع قديم لم يستطع أحد تسجيل الدخول إليه، إلى موقع ثنائي اللغة تتحكم فيه العيادة بالكامل.",
  caseCTA: "اقرأ دراسة الحالة",
  finalCTA: "أخبرنا ما مغلق. سنظهر لك الطريق للخروج.",
  bookAudit: "احجز تدقيقاً مجانياً",
} : {
  title: "Kaleem — Home",
  description: "Fast, affordable digital solutions for businesses in Iraq.",
  heroHeading: "Your systems, your data, your freedom.",
  heroText: "We build websites, apps, business systems and networks in Basra — and we free you from the old, locked ones.",
  soundFamiliar: "Sound familiar?",
  problem1: "Lost the login to your own system or website?",
  problem2: "Your data split between you and your provider?",
  problem3: "Afraid to leave because you'd lose everything?",
  problemSolution: "That's exactly what we fix.",
  methodHeading: "Five steps from locked to free",
  methodDesc: "The same method on every project — a website, an app, a store system or a camera network.",
  m01: "Audit",
  m01Desc: "We map where your systems, accounts and data really are.",
  m02: "Extract & clean",
  m02Desc: "We get your data out, remove duplicates and fix formats.",
  m03: "Rebuild on open standards",
  m03Desc: "Modern, open tools and formats any developer can read.",
  m04: "Hand over the keys",
  m04Desc: "Domain, accounts and data in your name — then we remove our access.",
  m05: "Support, then freedom",
  m05Desc: "Free support for a set period, then your choice: us or anyone else.",
  servicesHeading: "Six services, one method",
  allServicesLink: "All service details",
  s1: "The Jailbreak",
  s1Desc: "We get your data out of old, locked systems and into open formats you control.",
  s2: "Websites & web apps",
  s2Desc: "Fast, bilingual websites at the lowest possible hosting cost.",
  s3: "Mobile apps",
  s3Desc: "Android and iOS apps for ordering, bookings and internal use.",
  s4: "Management & store systems",
  s4Desc: "Inventory, point-of-sale and management systems, in the cloud or on-site.",
  s5: "Networks & security",
  s5Desc: "Surveillance cameras, security systems and organised networks.",
  s6: "Consulting & training",
  s6Desc: "We help you decide what to build, buy, keep or replace.",
  keepKeys: "You keep the keys",
  k1: "Your data and content, in open formats",
  k2: "Your domain, registered in your name",
  k3: "Your hosting and cloud accounts, owned by you",
  k4: "The code repository in your account, with a permanent licence to change it or hand it to another developer",
  k5: "Short documentation and training for your team",
  valuesHeading: "Our values",
  v1: "Freedom over lock-in",
  v1Desc: "You can leave any provider, us included, whenever you choose.",
  v2: "Your data is yours",
  v2Desc: "Content, data, domain and accounts in your name.",
  v3: "Open over closed",
  v3Desc: "Standard formats and tools any developer can pick up.",
  v4: "Simple over expensive",
  v4Desc: "No servers or subscriptions you don't need.",
  v5: "Honest numbers",
  v5Desc: "Real, dated results. No promised search rankings.",
  v6: "Explain everything",
  v6Desc: "We document what we build and train your team.",
  recentWork: "Recent work",
  caseStudy: "Every project proves the same method",
  alImran: "Al Imran Clinic",
  caseDesc: "From an old site nobody could log into, to a bilingual site the clinic fully controls.",
  caseCTA: "Read the case study",
  finalCTA: "Tell us what's locked. We'll show you the way out.",
  bookAudit: "Book a free audit",
};
---

<BaseLayout title={T.title} description={T.description}>
  <!-- ─── HERO ───────────────────────────────────────────────── -->
  <section class="hero-section bg-peach">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-text">
          <h1 class="hero-h1">{T.heroHeading}</h1>
          <p class="hero-p">{T.heroText}</p>
          <div class="hero-ctas">
            <a class="skb skb-mint" href={L("/contact/")}>{T.bookAudit}</a>
            <a class="skb skb-paper" href="#method">How we work</a>
          </div>
        </div>
        <img src="/assets/illustrations/freedom.svg" alt="Locked box with tangled data being set free into an organized folder" class="hero-illustration" />
      </div>
    </div>
  </section>

  <!-- ─── SOUND FAMILIAR ───────────────────────────────────── -->
  <section class="sound-familiar-section">
    <div class="container">
      <h2 class="section-heading">{T.soundFamiliar}</h2>
      <div class="problems-grid">
        <div class="sk card-butter">{T.problem1}</div>
        <div class="sk card-butter">{T.problem2}</div>
        <div class="sk card-butter">{T.problem3}</div>
        <div class="problem-solution">
          <svg width="56" height="40" viewBox="0 0 56 40" aria-hidden="true" style="transform: scaleX(-1)"><path d="M52 8c-14 2 -30 10 -44 24M8 32l2 -12M8 32l12 -2" fill="none" stroke="#1f1f1f" stroke-width="3" stroke-linecap="round"></path></svg>
          {T.problemSolution}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── METHOD ─────────────────────────────────────────── -->
  <section id="method" class="method-section bg-paper-2">
    <div class="container">
      <div class="method-header">
        <div>
          <h2 class="section-heading">{T.methodHeading}</h2>
          <p class="section-lede">{T.methodDesc}</p>
        </div>
        <svg width="180" height="70" viewBox="0 0 180 70" aria-hidden="true" style="transform: scaleX(-1)"><path d="M170 20c-40 -20 -90 -10 -120 30M50 50l-2 -16M50 50l15 -6" fill="none" stroke="#1f1f1f" stroke-width="3" stroke-linecap="round"></path></svg>
      </div>
      <ol class="method-grid">
        <li class="sk card-sky"><span class="method-num">01</span><h3>{T.m01}</h3><p>{T.m01Desc}</p></li>
        <li class="sk card-mint"><span class="method-num">02</span><h3>{T.m02}</h3><p>{T.m02Desc}</p></li>
        <li class="sk card-lilac"><span class="method-num">03</span><h3>{T.m03}</h3><p>{T.m03Desc}</p></li>
        <li class="sk card-butter"><span class="method-num">04</span><h3>{T.m04}</h3><p>{T.m04Desc}</p></li>
        <li class="sk card-peach"><span class="method-num">05</span><h3>{T.m05}</h3><p>{T.m05Desc}</p></li>
      </ol>
    </div>
  </section>

  <!-- ─── SERVICES ─────────────────────────────────────────── -->
  <section class="services-section">
    <div class="container">
      <div class="services-header">
        <h2 class="section-heading">{T.servicesHeading}</h2>
        <a href={L("/services/")}>{T.allServicesLink}</a>
      </div>
      <div class="services-grid">
        <a href={L("/services/")} class="sk card-butter service-card"><svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><path d="M18 6H6V26H26V14"></path><rect x="20" y="3" width="9" height="9" fill="#faf6ee"></rect></svg><h3>{T.s1}</h3><p>{T.s1Desc}</p><span class="learn-more">Learn more</span></a>
        <a href={L("/services/")} class="sk card-sky service-card"><svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><rect x="4" y="6" width="24" height="20" rx="2"></rect><path d="M4 11h24"></path><path d="M8 8.5h1M11 8.5h1"></path></svg><h3>{T.s2}</h3><p>{T.s2Desc}</p><span class="learn-more">Learn more</span></a>
        <a href={L("/services/")} class="sk card-peach service-card"><svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><rect x="10" y="3" width="12" height="26" rx="3"></rect><path d="M14 25h4"></path></svg><h3>{T.s3}</h3><p>{T.s3Desc}</p><span class="learn-more">Learn more</span></a>
        <a href={L("/services/")} class="sk card-mint service-card"><svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><ellipse cx="16" cy="8" rx="10" ry="4"></ellipse><path d="M6 8v16c0 2.2 4.5 4 10 4s10-1.8 10-4V8"></path><path d="M6 16c0 2.2 4.5 4 10 4s10-1.8 10-4"></path></svg><h3>{T.s4}</h3><p>{T.s4Desc}</p><span class="learn-more">Learn more</span></a>
        <a href={L("/services/")} class="sk card-apricot service-card"><svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><path d="M4 9l18-4l2 9l-18 4z"></path><path d="M14 16v8H6"></path><circle cx="20" cy="10" r="1.5"></circle></svg><h3>{T.s5}</h3><p>{T.s5Desc}</p><span class="learn-more">Learn more</span></a>
        <a href={L("/services/")} class="sk card-lilac service-card"><svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><path d="M5 6h22v14H14l-6 5v-5H5z"></path><path d="M10 11h12M10 15h8"></path></svg><h3>{T.s6}</h3><p>{T.s6Desc}</p><span class="learn-more">Learn more</span></a>
      </div>
    </div>
  </section>

  <!-- ─── ABOUT / VALUES ───────────────────────────────────── -->
  <section id="about" class="about-section bg-lilac">
    <div class="container">
      <div class="about-grid">
        <div class="sk card-paper">
          <h2>{T.keepKeys}</h2>
          <ul class="keys-list">
            <li><svg class="check-icon" width="22" height="22" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10.5l4.5 4.5 9-10" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round"></path></svg>{T.k1}</li>
            <li><svg class="check-icon" width="22" height="22" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10.5l4.5 4.5 9-10" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round"></path></svg>{T.k2}</li>
            <li><svg class="check-icon" width="22" height="22" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10.5l4.5 4.5 9-10" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round"></path></svg>{T.k3}</li>
            <li><svg class="check-icon" width="22" height="22" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10.5l4.5 4.5 9-10" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round"></path></svg>{T.k4}</li>
            <li><svg class="check-icon" width="22" height="22" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10.5l4.5 4.5 9-10" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round"></path></svg>{T.k5}</li>
          </ul>
        </div>
        <div>
          <h2>{T.valuesHeading}</h2>
          <dl class="values-grid">
            <div><dt>{T.v1}</dt><dd>{T.v1Desc}</dd></div>
            <div><dt>{T.v2}</dt><dd>{T.v2Desc}</dd></div>
            <div><dt>{T.v3}</dt><dd>{T.v3Desc}</dd></div>
            <div><dt>{T.v4}</dt><dd>{T.v4Desc}</dd></div>
            <div><dt>{T.v5}</dt><dd>{T.v5Desc}</dd></div>
            <div><dt>{T.v6}</dt><dd>{T.v6Desc}</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── CASE STUDY ───────────────────────────────────────── -->
  <section id="work" class="case-study-section">
    <div class="container">
      <div class="case-grid">
        <div class="case-text">
          <div class="case-meta">{T.recentWork}</div>
          <h2>{T.caseStudy}</h2>
          <h3>{T.alImran}</h3>
          <p>{T.caseDesc}</p>
          <div class="case-tags">
            <span class="k-tag tag-butter">The Jailbreak</span>
            <span class="k-tag tag-sky">Web</span>
            <span class="k-tag tag-apricot">Networks</span>
          </div>
          <a class="skb skb-lilac" href={L("/work/")}>{T.caseCTA}</a>
        </div>
        <div class="sk case-mockup">
          <div class="mockup-header" data-star-window></div>
          <div class="mockup-content">[Clinic website screenshot]</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── FINAL CTA ───────────────────────────────────────── -->
  <section class="final-cta bg-mint">
    <div class="container">
      <div class="final-cta-grid">
        <div class="final-cta-text">
          <h2>{T.finalCTA}</h2>
          <a class="skb skb-butter" href={L("/contact/")}>{T.bookAudit}</a>
        </div>
        <svg width="220" height="180" viewBox="0 0 220 180" aria-hidden="true">
          <g fill="none" stroke="#1f1f1f" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="70" cy="90" r="36" fill="#f7e7b0"></circle>
          <circle cx="70" cy="90" r="12" fill="#bfe6d6"></circle>
          <path d="M106 90h90M170 90v24M190 90v16"></path>
          <path d="M20 30l10 10M30 30l-10 10M190 30l8 8M198 30l-8 8"></path>
          </g>
        </svg>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: var(--k-max);
    margin: 0 auto;
    padding: 0 var(--k-gutter-desktop);
  }

  /* Hero Section */
  .hero-section {
    padding: 88px 0 96px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .hero-h1 {
    margin: 0;
    font-size: 72px;
    line-height: 80px;
    font-weight: 700;
    letter-spacing: -1px;
    color: var(--k-ink);
  }

  html[lang="en"] .hero-h1 {
    font-family: var(--k-font-en);
  }

  html[lang="ar"] .hero-h1 {
    font-family: var(--k-font-ar);
  }

  .hero-p {
    margin: 0;
    font-size: 22px;
    line-height: 38px;
    max-width: 600px;
    color: var(--k-ink-muted);
  }

  .hero-ctas {
    display: flex;
    gap: 20px;
    margin-top: 12px;
  }

  .skb-mint {
    background: var(--k-mint);
    color: var(--k-ink);
  }

  .skb-paper {
    background: var(--k-paper);
    color: var(--k-ink);
  }

  .skb-butter {
    background: var(--k-butter);
    color: var(--k-ink);
  }

  .skb-lilac {
    background: var(--k-lilac);
    color: var(--k-ink);
  }

  .hero-illustration {
    width: 100%;
    max-width: 500px;
  }

  /* Sound Familiar Section */
  .sound-familiar-section {
    padding: 88px 0;
  }

  .section-heading {
    margin: 0 0 40px;
    font-size: 40px;
    line-height: 60px;
    font-weight: 700;
    color: var(--k-ink);
  }

  html[lang="en"] .section-heading {
    font-family: var(--k-font-en);
  }

  html[lang="ar"] .section-heading {
    font-family: var(--k-font-ar);
  }

  .problems-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }

  .card-butter {
    background: var(--k-butter);
    padding: 28px;
    font-size: 20px;
    line-height: 34px;
    font-weight: 600;
    color: var(--k-ink);
  }

  .problem-solution {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 28px 8px;
    font-size: 26px;
    line-height: 40px;
    font-weight: 700;
    color: var(--k-ink);
  }

  /* Method Section */
  .method-section {
    padding: 88px 0;
    border-top: 2px solid var(--k-ink);
    border-bottom: 2px solid var(--k-ink);
  }

  .method-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 48px;
  }

  .section-lede {
    margin: 0;
    font-size: 19px;
    line-height: 32px;
    max-width: 760px;
    color: var(--k-ink-muted);
  }

  .method-grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 28px;
  }

  .method-grid li {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .method-num {
    font-family: var(--k-font-mono);
    font-size: 30px;
    font-weight: 600;
    color: var(--k-ink);
  }

  .method-grid h3 {
    margin: 0;
    font-size: 22px;
    line-height: 34px;
    font-weight: 700;
    color: var(--k-ink);
  }

  .method-grid p {
    margin: 0;
    font-size: 16px;
    line-height: 28px;
    color: var(--k-ink);
  }

  .card-sky {
    background: var(--k-sky);
  }

  .card-mint {
    background: var(--k-mint);
  }

  .card-lilac {
    background: var(--k-lilac);
  }

  .card-peach {
    background: var(--k-peach);
  }

  .card-apricot {
    background: var(--k-apricot);
  }

  .card-paper {
    background: var(--k-paper);
  }

  /* Services Section */
  .services-section {
    padding: 96px 0;
  }

  .services-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 48px;
  }

  .services-header a {

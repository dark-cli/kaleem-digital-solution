---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { currentLocale, localizedHref } from "../../lib/i18n";

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const isAr = locale === "ar";
const L = (href: string) => localizedHref(href, locale);

const T = isAr ? {
  title: "كليم — منزلك يفهم لهجتك",
  description: "أول منظومة منزل ذكي مصممة للعراق، بمساعد صوتي يتحدث لهجتك. من البصرة.",
  heroHeading: "منزلك جاهز ليفهم لهجتك.",
  heroText: "كليم أول منظومة منزل ذكي مصممة للعراق: مساعد صوتي يفهم لهجتك، ومعالجة بياناتك تبقى داخل جدرانك.",
  soundFamiliar: "هل تعرف هذا الشعور؟",
  problem1: "مساعد صوتي أجنبي لا يفهم لهجتك ولا كلامك اليومي؟",
  problem2: "أجهزة ذكية تُرسل كل شيء إلى خوادم بعيدة لا تعرف من يقرأها؟",
  problem3: "منظومات مجزّأة — مصباح من شركة، مكيف من ثانية، كاميرا من ثالثة — ولا شيء يعمل مع الآخر؟",
  problemSolution: "هذا بالضبط ما بنينا كليم لأجله.",
  methodHeading: "خمس خطوات من الفكرة إلى منزل يفهمك",
  methodDesc: "نفس الطريقة لكل مشروع — منزل سكني، مكتب، أو مبنى تجاري.",
  m01: "الاستشارة",
  m01Desc: "نزور موقعك، نفهم عاداتك، ونصمم منظومة تناسب حياتك وليس كتالوجاً جاهزاً.",
  m02: "التصميم",
  m02Desc: "خطة كاملة للأجهزة والتوصيلات، مع اختيار المكونات المفتوحة القابلة للصيانة.",
  m03: "التركيب",
  m03Desc: "فريق محلي مدرّب يقوم بالتركيب والتوصيل بمعايير مهنية.",
  m04: "التفعيل والتدريب",
  m04Desc: "نُفعّل المساعد الصوتي بلهجتك، ونُدرّب أفراد العائلة على استخدامه.",
  m05: "المتابعة",
  m05Desc: "دعم فني محلي، تحديثات دورية، ومنظومة قابلة للتوسّع مع حاجاتك.",
  servicesHeading: "خدماتنا",
  allServicesLink: "تفاصيل جميع الخدمات",
  s1: "المساعد الصوتي كليم",
  s1Desc: "مساعد يفهم لهجتك العراقية ويتعلم منها، مع معالجة محلية للخصوصية.",
  s2: "المنازل الذكية",
  s2Desc: "منظومات متكاملة للإضاءة والمناخ والأمان والترفيه، مصممة لعائلتك.",
  s3: "أتمتة المكاتب والمؤسسات",
  s3Desc: "حلول أتمتة للمكاتب والمقاهي والمعارض والمرافق التجارية.",
  s4: "الأمان والمراقبة",
  s4Desc: "كاميرات مراقبة وأنظمة إنذار متكاملة مع منظومة المنزل.",
  s5: "التصميم المخصص",
  s5Desc: "نصمم أنظمة خاصة لمساحاتك الفريدة — الفلل الكبيرة والمشاريع الاستثنائية.",
  s6: "الدعم والصيانة",
  s6Desc: "عقود دعم محلية، صيانة دورية، وتحديثات مستمرة للمنظومة.",
  keepKeys: "بياناتك تبقى في بيتك",
  k1: "معالجة محلية — أوامرك الصوتية لا تغادر منزلك",
  k2: "لا اشتراكات سحابية إجبارية لاستخدام أجهزتك",
  k3: "أنت تملك الأجهزة والمنظومة، لا نحن",
  k4: "منظومة مفتوحة — تعمل مع الأجهزة القياسية في السوق",
  k5: "توثيق ودعم بالعربية لعائلتك أو فريقك",
  valuesHeading: "قيمنا",
  v1: "لهجتك أولاً",
  v1Desc: "نُطوّر التقنية لتفهمك، لا لتُجبرك على تعلّم لغتها.",
  v2: "الخصوصية بالتصميم",
  v2Desc: "معالجة محلية للبيانات، لا خوادم أجنبية.",
  v3: "المفتوح على المغلق",
  v3Desc: "معايير قياسية تعمل مع أي مورد، ولا تحبسك مع مزوّد واحد.",
  v4: "صناعة عراقية",
  v4Desc: "نُطوّر الهندسة والتصميم والذكاء الاصطناعي محلياً.",
  v5: "أرقام صادقة",
  v5Desc: "تكلفة واضحة من البداية، لا تفاجآت في الفاتورة.",
  v6: "نشرح كل شيء",
  v6Desc: "نوثّق ما نُركّبه، ونُدرّب من يستخدمه.",
  recentWork: "أعمالنا",
  caseStudy: "من شقة في بغداد إلى بيوت في كل العراق",
  alImran: "قصتنا",
  caseDesc: "بدأت كليم من شقة صغيرة في بغداد كتجربة لفهم إذا كان بالإمكان بناء مساعد صوتي بلهجتنا. اليوم نُركّب منظومات كاملة في البصرة وبغداد، ونعمل على أن ينتقل العراق من مستهلك للتقنية إلى صانع لها.",
  caseCTA: "اقرأ عن مهمّتنا",
  finalCTA: "اجعل منزلك يتحدث لهجتك.",
  bookAudit: "احجز استشارة مجانية",
  howWeWork: "كيف نعمل",
  learnMore: "تفاصيل أكثر",
} : {
  title: "Kaleem — Your home understands your dialect",
  description: "Iraq's first localized smart home ecosystem, with a voice assistant that speaks your dialect. Engineered in Basra.",
  heroHeading: "Your home is ready to speak your language.",
  heroText: "Kaleem is Iraq's first smart-home ecosystem built around a voice assistant that understands the Iraqi dialect — with your data processed inside your walls, not on someone else's server.",
  soundFamiliar: "Sound familiar?",
  problem1: "A foreign voice assistant that never quite understands your dialect or your day-to-day words?",
  problem2: "\"Smart\" devices that send everything to a server you can't see, run by a company you can't reach?",
  problem3: "A patchwork of gadgets — a lamp from one brand, an AC from another, a camera from a third — and none of it talks together?",
  problemSolution: "That's exactly what we built Kaleem to fix.",
  methodHeading: "Five steps to a home that understands you",
  methodDesc: "The same process for every project — a home, an office, or a commercial space.",
  m01: "Consult",
  m01Desc: "We visit the space, learn your routines, and design a system that fits your life instead of a catalog.",
  m02: "Design",
  m02Desc: "A full plan for hardware and wiring, using open, standards-based components you can service later.",
  m03: "Install",
  m03Desc: "Trained local technicians handle the wiring and mounting to a professional finish.",
  m04: "Activate & train",
  m04Desc: "We tune the voice assistant to your household's dialect and habits, and walk everyone through using it.",
  m05: "Support",
  m05Desc: "Local support, periodic updates, and a system designed to grow with your needs.",
  servicesHeading: "What we do",
  allServicesLink: "All service details",
  s1: "Kaleem Voice Assistant",
  s1Desc: "An assistant that understands the Iraqi dialect and improves the more you speak — processed on-device for privacy.",
  s2: "Residential smart homes",
  s2Desc: "Integrated lighting, climate, security and entertainment, designed for your family, not off a shelf.",
  s3: "Office & commercial automation",
  s3Desc: "Smart offices, cafés, showrooms and hospitality — same platform, business scale.",
  s4: "Security & surveillance",
  s4Desc: "Camera systems and alarm integration that live inside the same ecosystem as the rest of the home.",
  s5: "Bespoke design",
  s5Desc: "Custom systems for larger villas and standout projects — anything the standard packages don't cover.",
  s6: "Support & maintenance",
  s6Desc: "Local service contracts, periodic maintenance, and continuous system updates.",
  keepKeys: "Your data stays in your home",
  k1: "On-device processing — voice commands never leave the house",
  k2: "No mandatory cloud subscription just to use the hardware you paid for",
  k3: "You own the devices and the system, not us",
  k4: "Open standards — works with off-the-shelf smart-home gear",
  k5: "Documentation and Arabic-language support for your family or team",
  valuesHeading: "Our values",
  v1: "Your dialect first",
  v1Desc: "We shape the technology around how people actually speak, not the other way around.",
  v2: "Privacy by design",
  v2Desc: "Local processing, no data sent to foreign servers.",
  v3: "Open over closed",
  v3Desc: "Standards that work with any vendor, so you're never locked in to a single supplier.",
  v4: "Made in Iraq",
  v4Desc: "We develop the engineering, design and AI talent here at home.",
  v5: "Honest numbers",
  v5Desc: "Clear pricing up front — no surprises on the invoice.",
  v6: "Explain everything",
  v6Desc: "We document what we install and train the people who use it.",
  recentWork: "Our work",
  caseStudy: "From one Baghdad apartment to homes across Iraq",
  alImran: "How we started",
  caseDesc: "Kaleem began as an experiment in a small Baghdad apartment: could we build a voice assistant that actually understood our dialect? Today we install complete systems in homes and businesses in Basra and Baghdad, working toward an Iraq that creates its own technology instead of importing it.",
  caseCTA: "Read our story",
  finalCTA: "Let your home speak your language.",
  bookAudit: "Book a free consultation",
  howWeWork: "How we work",
  learnMore: "Learn more",
};
---

<BaseLayout title={T.title} description={T.description}>
  <!-- ─── HERO ───────────────────────────────────────────────── -->
  <section class="hero-section bg-peach">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-text">
          <h1 class="hero-h1">{T.heroHeading}</h1>
          <p class="hero-p">{T.heroText}</p>
          <div class="hero-ctas">
            <a class="skb skb-mint" href={L("/contact/")}>{T.bookAudit}</a>
            <a class="skb skb-paper" href="#method">{T.howWeWork}</a>
          </div>
        </div>
        <img src="/assets/illustrations/freedom.svg" alt="Locked box with tangled data being set free into an organized folder" class="hero-illustration" />
      </div>
    </div>
  </section>

  <!-- ─── SOUND FAMILIAR ───────────────────────────────────── -->
  <section class="sound-familiar-section">
    <div class="container">
      <h2 class="section-heading">{T.soundFamiliar}</h2>
      <div class="problems-grid">
        <div class="sk card-butter">{T.problem1}</div>
        <div class="sk card-butter">{T.problem2}</div>
        <div class="sk card-butter">{T.problem3}</div>
        <div class="problem-solution">
          <svg width="56" height="40" viewBox="0 0 56 40" aria-hidden="true" style="transform: scaleX(-1)"><path d="M52 8c-14 2 -30 10 -44 24M8 32l2 -12M8 32l12 -2" fill="none" stroke="#1f1f1f" stroke-width="3" stroke-linecap="round"></path></svg>
          {T.problemSolution}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── METHOD ─────────────────────────────────────────── -->
  <section id="method" class="method-section bg-paper-2">
    <div class="container">
      <div class="method-header">
        <div>
          <h2 class="section-heading">{T.methodHeading}</h2>
          <p class="section-lede">{T.methodDesc}</p>
        </div>
        <svg width="180" height="70" viewBox="0 0 180 70" aria-hidden="true" style="transform: scaleX(-1)"><path d="M170 20c-40 -20 -90 -10 -120 30M50 50l-2 -16M50 50l15 -6" fill="none" stroke="#1f1f1f" stroke-width="3" stroke-linecap="round"></path></svg>
      </div>
      <ol class="method-grid">
        <li class="sk card-sky"><span class="method-num">01</span><h3>{T.m01}</h3><p>{T.m01Desc}</p></li>
        <li class="sk card-mint"><span class="method-num">02</span><h3>{T.m02}</h3><p>{T.m02Desc}</p></li>
        <li class="sk card-lilac"><span class="method-num">03</span><h3>{T.m03}</h3><p>{T.m03Desc}</p></li>
        <li class="sk card-butter"><span class="method-num">04</span><h3>{T.m04}</h3><p>{T.m04Desc}</p></li>
        <li class="sk card-peach"><span class="method-num">05</span><h3>{T.m05}</h3><p>{T.m05Desc}</p></li>
      </ol>
    </div>
  </section>

  <!-- ─── SERVICES ─────────────────────────────────────────── -->
  <section class="services-section">
    <div class="container">
      <div class="services-header">
        <h2 class="section-heading">{T.servicesHeading}</h2>
        <a href={L("/services/")}>{T.allServicesLink}</a>
      </div>
      <div class="services-grid">
        <a href={L("/services/")} class="sk card-butter service-card"><svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><path d="M18 6H6V26H26V14"></path><rect x="20" y="3" width="9" height="9" fill="#faf6ee"></rect></svg><h3>{T.s1}</h3><p>{T.s1Desc}</p><span class="learn-more">{T.learnMore}</span></a>
        <a href={L("/services/")} class="sk card-sky service-card"><svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><rect x="4" y="6" width="24" height="20" rx="2"></rect><path d="M4 11h24"></path><path d="M8 8.5h1M11 8.5h1"></path></svg><h3>{T.s2}</h3><p>{T.s2Desc}</p><span class="learn-more">{T.learnMore}</span></a>
        <a href={L("/services/")} class="sk card-peach service-card"><svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><rect x="10" y="3" width="12" height="26" rx="3"></rect><path d="M14 25h4"></path></svg><h3>{T.s3}</h3><p>{T.s3Desc}</p><span class="learn-more">{T.learnMore}</span></a>
        <a href={L("/services/")} class="sk card-mint service-card"><svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><ellipse cx="16" cy="8" rx="10" ry="4"></ellipse><path d="M6 8v16c0 2.2 4.5 4 10 4s10-1.8 10-4V8"></path><path d="M6 16c0 2.2 4.5 4 10 4s10-1.8 10-4"></path></svg><h3>{T.s4}</h3><p>{T.s4Desc}</p><span class="learn-more">{T.learnMore}</span></a>
        <a href={L("/services/")} class="sk card-apricot service-card"><svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><path d="M4 9l18-4l2 9l-18 4z"></path><path d="M14 16v8H6"></path><circle cx="20" cy="10" r="1.5"></circle></svg><h3>{T.s5}</h3><p>{T.s5Desc}</p><span class="learn-more">{T.learnMore}</span></a>
        <a href={L("/services/")} class="sk card-lilac service-card"><svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><path d="M5 6h22v14H14l-6 5v-5H5z"></path><path d="M10 11h12M10 15h8"></path></svg><h3>{T.s6}</h3><p>{T.s6Desc}</p><span class="learn-more">{T.learnMore}</span></a>
      </div>
    </div>
  </section>

  <!-- ─── ABOUT / VALUES ───────────────────────────────────── -->
  <section id="about" class="about-section bg-lilac">
    <div class="container">
      <div class="about-grid">
        <div class="sk card-paper">
          <h2>{T.keepKeys}</h2>
          <ul class="keys-list">
            <li><svg class="check-icon" width="22" height="22" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10.5l4.5 4.5 9-10" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round"></path></svg>{T.k1}</li>
            <li><svg class="check-icon" width="22" height="22" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10.5l4.5 4.5 9-10" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round"></path></svg>{T.k2}</li>
            <li><svg class="check-icon" width="22" height="22" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10.5l4.5 4.5 9-10" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round"></path></svg>{T.k3}</li>
            <li><svg class="check-icon" width="22" height="22" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10.5l4.5 4.5 9-10" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round"></path></svg>{T.k4}</li>
            <li><svg class="check-icon" width="22" height="22" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10.5l4.5 4.5 9-10" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round"></path></svg>{T.k5}</li>
          </ul>
        </div>
        <div>
          <h2>{T.valuesHeading}</h2>
          <dl class="values-grid">
            <div><dt>{T.v1}</dt><dd>{T.v1Desc}</dd></div>
            <div><dt>{T.v2}</dt><dd>{T.v2Desc}</dd></div>
            <div><dt>{T.v3}</dt><dd>{T.v3Desc}</dd></div>
            <div><dt>{T.v4}</dt><dd>{T.v4Desc}</dd></div>
            <div><dt>{T.v5}</dt><dd>{T.v5Desc}</dd></div>
            <div><dt>{T.v6}</dt><dd>{T.v6Desc}</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── CASE STUDY ───────────────────────────────────────── -->
  <section id="work" class="case-study-section">
    <div class="container">
      <div class="case-grid">
        <div class="case-text">
          <div class="case-meta">{T.recentWork}</div>
          <h2>{T.caseStudy}</h2>
          <h3>{T.alImran}</h3>
          <p>{T.caseDesc}</p>
          <div class="case-tags">
            <span class="k-tag tag-butter">The Jailbreak</span>
            <span class="k-tag tag-sky">Web</span>
            <span class="k-tag tag-apricot">Networks</span>
          </div>
          <a class="skb skb-lilac" href={L("/work/")}>{T.caseCTA}</a>
        </div>
        <div class="sk window case-mockup">
          <div class="window-chrome" data-sky></div>
          <div class="window-body mockup-content">[Clinic website screenshot]</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── FINAL CTA ───────────────────────────────────────── -->
  <section class="final-cta bg-mint">
    <div class="container">
      <div class="final-cta-grid">
        <div class="final-cta-text">
          <h2>{T.finalCTA}</h2>
          <a class="skb skb-butter" href={L("/contact/")}>{T.bookAudit}</a>
        </div>
        <svg width="220" height="180" viewBox="0 0 220 180" aria-hidden="true">
          <g fill="none" stroke="#1f1f1f" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="70" cy="90" r="36" fill="#f7e7b0"></circle>
          <circle cx="70" cy="90" r="12" fill="#bfe6d6"></circle>
          <path d="M106 90h90M170 90v24M190 90v16"></path>
          <path d="M20 30l10 10M30 30l-10 10M190 30l8 8M198 30l-8 8"></path>
          </g>
        </svg>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: var(--k-max);
    margin: 0 auto;
    padding: 0 var(--k-gutter-desktop);
  }

  /* Hero Section */
  .hero-section {
    padding: 88px 0 96px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .hero-h1 {
    margin: 0;
    font-size: 72px;
    line-height: 80px;
    font-weight: 700;
    letter-spacing: -1px;
    color: var(--k-ink);
  }

  .hero-h1 {
    /* Serif display face for both locales: Newsreader (EN) / Amiri (AR).
       --k-font-serif swaps automatically via html[dir="rtl"]. */
    font-family: var(--k-font-serif);
  }

  .hero-p {
    margin: 0;
    font-size: 22px;
    line-height: 38px;
    max-width: 600px;
    color: var(--k-ink-muted);
  }

  .hero-ctas {
    display: flex;
    gap: 20px;
    margin-top: 12px;
  }

  .hero-illustration {
    width: 100%;
    max-width: 500px;
  }

  /* Sound Familiar Section */
  .sound-familiar-section {
    padding: 88px 0;
  }

  .section-heading {
    margin: 0 0 40px;
    font-size: 40px;
    line-height: 60px;
    font-weight: 700;
    color: var(--k-ink);
  }

  .section-heading {
    /* Serif display face for both locales — Newsreader / Amiri. */
    font-family: var(--k-font-serif);
  }

  .problems-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }

  .card-butter {
    background: var(--k-butter);
    padding: 28px;
    font-size: 20px;
    line-height: 34px;
    font-weight: 600;
    color: var(--k-ink);
  }

  .problem-solution {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 28px 8px;
    font-size: 26px;
    line-height: 40px;
    font-weight: 700;
    color: var(--k-ink);
  }

  /* Method Section */
  .method-section {
    padding: 88px 0;
    border-top: 2px solid var(--k-ink);
    border-bottom: 2px solid var(--k-ink);
  }

  .method-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 48px;
  }

  .section-lede {
    margin: 0;
    font-size: 19px;
    line-height: 32px;
    max-width: 760px;
    color: var(--k-ink-muted);
  }

  .method-grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 28px;
  }

  .method-grid li {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .method-num {
    font-family: var(--k-font-mono);

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { currentLocale, localizedHref } from "../../lib/i18n";

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const isAr = locale === "ar";
const L = (href: string) => localizedHref(href, locale);

const T = isAr ? {
  title: "كليم — حل رقمي حقيقي للعراق",
  description: "نُحرّر البيانات ونُحدّثها. استخراج وتنظيف وإعادة بناء الأنظمة والمنصات الرقمية المهملة.",
  heroHeading: "تحرير البيانات.",
  heroText: "نُستخرج البيانات، نُنظّفها، ونحوّلها إلى نظام حديث مفتوح. بيانات معالجة محلياً بمعايير عالمية، وحرية حقيقية من البائع الواحد.",
  soundFamiliar: "هل واجهت هذا؟",
  problem1: "نظام قديم يحتفظ ببيانات مهمة لكن لا يمكنك الوصول إليها أو تطويرها؟",
  problem2: "بيانات مُقفلة في منصة لا تملكها، مع شركة لا تدعمك ولا تستطيع الانتقال منها؟",
  problem3: "موقع قديم بطيء ومُكسّر، مبني على تقنيات متقادمة، وليس لديك المفاتيح الرقمية الحقيقية؟",
  problemSolution: "هذا ما بنينا كليم لحله.",
  methodHeading: "أربع خطوات لتحرير نظامك الرقمي",
  methodDesc: "نفس العملية الموثوقة: تقييم، استخراج، تنظيف، وتسليم كامل.",
  m01: "التقييم والاستخراج",
  m01Desc: "نفحص النظام القديم، نستخرج البيانات، ونتأكد من أن كل شيء وثّق ومحفوظ.",
  m01Quote: "الخطوة الأولى نحو الحرية هي معرفة حقيقة وضعك.",
  m02: "التنظيف والتحويل",
  m02Desc: "نُنظّف البيانات، نُوحّد الصيغ، ونحوّلها إلى معايير مفتوحة وسهلة القراءة.",
  m02Quote: "النظام هو أساس كل شيء.",
  m03: "إعادة البناء الحديثة",
  m03Desc: "نبني نظام جديد على تقنيات مفتوحة، سريعة، وموثوقة — مع توثيق كامل.",
  m03Quote: "كل خبير بدأ مبتدئاً وقررَ عدم الاستسلام.",
  m04: "تسليم المفاتيح",
  m04Desc: "نسلّمك النظام كاملاً، المفاتيح، الكود، والبيانات — كل شيء باسمك وبملكيتك.",
  m04Quote: "الحرية الحقيقية هي القوة على اختيار طريقك الخاص.",
  servicesHeading: "ما نقدمه",
  allServicesLink: "جميع الخدمات",
  s1: "استخراج البيانات",
  s1Desc: "تحرير البيانات من الأنظمة القديمة بأمان وسلامة، مع الحفاظ على التاريخ والسياق.",
  s1Stat: "2.3M+ وثائق مستخرجة",
  s2: "تحديث المنصات الويب",
  s2Desc: "تحويل المواقع القديمة إلى تطبيقات ويب حديثة، سريعة، وآمنة.",
  s2Stat: "50+ منظمة خدمناها",
  s3: "إعادة بناء قواعد البيانات",
  s3Desc: "تنظيم البيانات الفوضوية، توحيد الصيغ، وبناء هيكل واضح وقابل للنمو.",
  s3Stat: "15TB+ من البيانات المعالجة",
  s4: "البنية التحتية المفتوحة",
  s4Desc: "إعادة بناء على خوادم مفتوحة، معايير صناعية، وتقنيات موثوقة لا تُقفل بياناتك.",
  s4Stat: "99.9% توفر الخدمة",
  s5: "الترقية والتحديث",
  s5Desc: "تحويل الأنظمة الموروثة إلى برامج حديثة بدون فقدان البيانات أو الوقت.",
  s5Stat: "3x تحسن الأداء في المتوسط",
  s6: "التدريب والدعم",
  s6Desc: "نُدرّب فريقك على النظام الجديد، ونقدم دعم محلي مستمر بالعربية.",
  s6Stat: "80,000+ سطر كود",
  keepKeys: "البيانات الحقيقية تبقى معك",
  k1: "تحكم كامل — أنت تملك الكود والبيانات والخوادم",
  k2: "معايير مفتوحة — لا توقيف أو قفل من بائع واحد",
  k3: "استقلالية حقيقية — انتقل عندما تريد، لكن لن تحتاج",
  k4: "سرعة ودقة — معالجة محلية، لا تأخير سحابي",
  k5: "توثيق كامل — كل شيء مُوثّق وشفاف لفريقك",
  valuesHeading: "قيمنا",
  v1: "ملكية حقيقية",
  v1Desc: "أنت تملك الكود، البيانات، والبنية — وليس العكس.",
  v2: "معايير مفتوحة",
  v2Desc: "تقنيات موثوقة لا تُقيّد بك — يمكنك الانتقال دائماً.",
  v3: "كفاءة محلية",
  v3Desc: "فريق محلي يفهم سياقك، ودعم يتحدث لغتك.",
  v4: "شفافية كاملة",
  v4Desc: "لا اشتراكات خفية أو رسوم مفاجئة — أرقام واضحة من البداية.",
  v5: "الأداء أولاً",
  v5Desc: "نظم سريعة، آمنة، وموثوقة — أو لا نعتبرها جاهزة.",
  v6: "نشرح كل شيء",
  v6Desc: "نوثّق كل جزء، نُدرّب فريقك، ونتأكد أنك تفهم النظام بالكامل.",
  recentWork: "أعمالنا",
  caseStudy: "تحرير عيادة من حبس البيانات القديم",
  alImran: "مركز العمران الطبي، البصرة",
  caseDesc: "انتقلنا بعيادة من موقع ورث قديم مُشتّت إلى منصة حديثة موحّدة: استخراج 600 مقالة، تنظيفها، وإعادة بناؤها على Astro مع Cloudflare. النتيجة: موقع سريع بـ 97/100 PageSpeed، بيانات بيد العيادة، وحرية رقمية حقيقية.",
  caseCTA: "اقرأ عن المشروع",
  finalCTA: "حرّر نظامك الرقمي.",
  bookAudit: "احجز تدقيق مجاني",
  howWeWork: "كيف نعمل",
  learnMore: "تفاصيل أكثر",
} : {
  title: "Kaleem — Real digital solutions for Iraq",
  description: "We liberate data and modernize systems. Extract, clean, and rebuild digital platforms from legacy constraints.",
  heroHeading: "Liberate your data.",
  heroText: "We extract data, clean it, and transform it into a modern, open system. Data processed locally by global standards, with real freedom from single-vendor lock-in.",
  soundFamiliar: "Sound familiar?",
  problem1: "A legacy system holding your critical data hostage, with no way to access it or develop it further?",
  problem2: "Data locked in a platform you don't own, supported by a company that won't help you leave?",
  problem3: "An aging website that's slow, broken, built on outdated tech, with no real digital keys in your hands?",
  problemSolution: "That's exactly what we built Kaleem to fix.",
  methodHeading: "Four steps to digital freedom",
  methodDesc: "The same proven process: audit, extract, clean, and hand over the keys.",
  m01: "Audit & extract",
  m01Desc: "We examine the legacy system, extract the data safely, and document everything that matters.",
  m01Quote: "The first step toward freedom is knowing the truth of your situation.",
  m02: "Clean & transform",
  m02Desc: "We standardize formats, deduplicate records, and convert data into open, portable formats.",
  m02Quote: "Order is the foundation of all things.",
  m03: "Rebuild modern",
  m03Desc: "We build a new system on proven open tech, fast and reliable—with complete documentation.",
  m03Quote: "Every expert was once a beginner who refused to give up.",
  m04: "Hand over the keys",
  m04Desc: "You receive the code, keys, data, and docs—everything in your name, complete ownership.",
  m04Quote: "True freedom is the power to choose your own path.",
  servicesHeading: "What we do",
  allServicesLink: "All services",
  s1: "Data extraction",
  s1Desc: "Safely recover data from legacy systems, preserving history and context without loss.",
  s1Stat: "2.3M+ documents extracted",
  s2: "Web platform modernization",
  s2Desc: "Transform aging websites into modern, fast, and secure web applications.",
  s2Stat: "50+ organizations served",
  s3: "Database restructuring",
  s3Desc: "Clean messy data, unify formats, and build clear, scalable database architectures.",
  s3Stat: "15TB+ data processed",
  s4: "Open infrastructure",
  s4Desc: "Rebuild on proven open-source tech and industry standards that never lock your data in.",
  s4Stat: "99.9% uptime average",
  s5: "Legacy migration",
  s5Desc: "Move from proprietary systems to modern alternatives without data loss or downtime.",
  s5Stat: "3x performance improvement",
  s6: "Training & support",
  s6Desc: "Train your team on the new system and provide ongoing local support in Arabic and English.",
  s6Stat: "80,000+ lines of code",
  keepKeys: "True digital ownership",
  k1: "Full control — you own the code, data, and servers",
  k2: "Open standards — no lock-in, no surprise vendor changes",
  k3: "Real independence — migrate anytime, but you won't want to",
  k4: "Local processing — no cloud latency, all your data stays near",
  k5: "Full transparency — every component documented and understood by your team",
  valuesHeading: "Our values",
  v1: "Real ownership",
  v1Desc: "You own the code, the data, and the platform—not the other way around.",
  v2: "Open standards",
  v2Desc: "Proven technologies that never trap you—you can always move if you choose to.",
  v3: "Local competence",
  v3Desc: "Local team that understands your context, with support in your language.",
  v4: "Full transparency",
  v4Desc: "No hidden subscriptions or surprise fees—clear numbers from the start.",
  v5: "Performance first",
  v5Desc: "Fast, secure, reliable systems—or we don't consider them ready.",
  v6: "Explain everything",
  v6Desc: "We document every part, train your team, and make sure you fully understand the system.",
  recentWork: "Our work",
  caseStudy: "Liberating a clinic from legacy data imprisonment",
  alImran: "Al Imran Clinic, Basra",
  caseDesc: "We migrated a clinic from a fragmented legacy site into a unified modern platform: extracted 600 articles, cleaned the data, and rebuilt on Astro with Cloudflare Workers. The result: a 97/100 PageSpeed site, data under clinic control, bilingual support, and real digital freedom.",
  caseCTA: "Read the case study",
  finalCTA: "Liberate your digital platform.",
  bookAudit: "Book a free audit",
  howWeWork: "How we work",
  learnMore: "Learn more",
};
---

<BaseLayout title={T.title} description={T.description}>
  <!-- ─── HERO ───────────────────────────────────────────────── -->
  <section class="hero-section bg-peach">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-text">
          <h1 class="hero-h1">{T.heroHeading}</h1>
          <p class="hero-p">{T.heroText}</p>
          <div class="hero-ctas">
            <a class="skb skb-mint" href={L("/contact/")}>{T.bookAudit}</a>
            <a class="skb skb-paper" href="#method">{T.howWeWork}</a>
          </div>
        </div>
        <img src="/assets/illustrations/freedom.svg" alt="Locked box with tangled data being set free into an organized folder" class="hero-illustration" />
      </div>
    </div>
  </section>

  <!-- ─── SOUND FAMILIAR ───────────────────────────────────── -->
  <section class="sound-familiar-section">
    <div class="container">
      <h2 class="section-heading">{T.soundFamiliar}</h2>
      <div class="problems-grid">
        <div class="sk card-butter">{T.problem1}</div>
        <div class="sk card-butter">{T.problem2}</div>
        <div class="sk card-butter">{T.problem3}</div>
        <div class="problem-solution">
          <svg width="56" height="40" viewBox="0 0 56 40" aria-hidden="true" style="transform: scaleX(-1)"><path d="M52 8c-14 2 -30 10 -44 24M8 32l2 -12M8 32l12 -2" fill="none" stroke="#1f1f1f" stroke-width="3" stroke-linecap="round"></path></svg>
          {T.problemSolution}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── METHOD ─────────────────────────────────────────── -->
  <section id="method" class="method-section bg-paper-2">
    <div class="container">
      <div class="method-header">
        <div>
          <h2 class="section-heading">{T.methodHeading}</h2>
          <p class="section-lede">{T.methodDesc}</p>
        </div>
        <svg width="180" height="70" viewBox="0 0 180 70" aria-hidden="true" style="transform: scaleX(-1)"><path d="M170 20c-40 -20 -90 -10 -120 30M50 50l-2 -16M50 50l15 -6" fill="none" stroke="#1f1f1f" stroke-width="3" stroke-linecap="round"></path></svg>
      </div>
      <ol class="method-grid">
        <li class="sk card-sky">
          <span class="method-num">01</span>
          <h3>{T.m01}</h3>
          <p>{T.m01Desc}</p>
        </li>
        <li class="sk card-mint">
          <span class="method-num">02</span>
          <h3>{T.m02}</h3>
          <p>{T.m02Desc}</p>
        </li>
        <li class="sk card-lilac">
          <span class="method-num">03</span>
          <h3>{T.m03}</h3>
          <p>{T.m03Desc}</p>
        </li>
        <li class="sk card-butter">
          <span class="method-num">04</span>
          <h3>{T.m04}</h3>
          <p>{T.m04Desc}</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ─── SERVICES ─────────────────────────────────────────── -->
  <section class="services-section">
    <div class="container">
      <div class="services-header">
        <h2 class="section-heading">{T.servicesHeading}</h2>
        <a href={L("/services/")}>{T.allServicesLink}</a>
      </div>
      <div class="services-grid">
        <a href={L("/services/")} class="sk card-butter">
          <svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><path d="M18 6H6V26H26V14"></path><rect x="20" y="3" width="9" height="9" fill="#faf6ee"></rect></svg>
          <h3>{T.s1}</h3>
          <p>{T.s1Desc}</p>
          <span class="learn-more">{T.learnMore}</span>
        </a>
        <a href={L("/services/")} class="sk card-sky">
          <svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><rect x="4" y="6" width="24" height="20" rx="2"></rect><path d="M4 11h24"></path><path d="M8 8.5h1M11 8.5h1"></path></svg>
          <h3>{T.s2}</h3>
          <p>{T.s2Desc}</p>
          <span class="learn-more">{T.learnMore}</span>
        </a>
        <a href={L("/services/")} class="sk card-peach">
          <svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><rect x="10" y="3" width="12" height="26" rx="3"></rect><path d="M14 25h4"></path></svg>
          <h3>{T.s3}</h3>
          <p>{T.s3Desc}</p>
          <span class="learn-more">{T.learnMore}</span>
        </a>
        <a href={L("/services/")} class="sk card-mint">
          <svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><ellipse cx="16" cy="8" rx="10" ry="4"></ellipse><path d="M6 8v16c0 2.2 4.5 4 10 4s10-1.8 10-4V8"></path><path d="M6 16c0 2.2 4.5 4 10 4s10-1.8 10-4"></path></svg>
          <h3>{T.s4}</h3>
          <p>{T.s4Desc}</p>
          <span class="learn-more">{T.learnMore}</span>
        </a>
        <a href={L("/services/")} class="sk card-apricot">
          <svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><path d="M4 9l18-4l2 9l-18 4z"></path><path d="M14 16v8H6"></path><circle cx="20" cy="10" r="1.5"></circle></svg>
          <h3>{T.s5}</h3>
          <p>{T.s5Desc}</p>
          <span class="learn-more">{T.learnMore}</span>
        </a>
        <a href={L("/services/")} class="sk card-lilac">
          <svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><path d="M5 6h22v14H14l-6 5v-5H5z"></path><path d="M10 11h12M10 15h8"></path></svg>
          <h3>{T.s6}</h3>
          <p>{T.s6Desc}</p>
          <span class="learn-more">{T.learnMore}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── ABOUT / VALUES ───────────────────────────────────── -->
  <section id="about" class="about-section bg-lilac">
    <div class="container">
      <div class="about-grid">
        <div class="sk card-paper">
          <h2>{T.keepKeys}</h2>
          <ul class="keys-list">
            <li><svg class="check-icon" width="22" height="22" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10.5l4.5 4.5 9-10" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round"></path></svg>{T.k1}</li>
            <li><svg class="check-icon" width="22" height="22" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10.5l4.5 4.5 9-10" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round"></path></svg>{T.k2}</li>
            <li><svg class="check-icon" width="22" height="22" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10.5l4.5 4.5 9-10" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round"></path></svg>{T.k3}</li>
            <li><svg class="check-icon" width="22" height="22" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10.5l4.5 4.5 9-10" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round"></path></svg>{T.k4}</li>
            <li><svg class="check-icon" width="22" height="22" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10.5l4.5 4.5 9-10" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round"></path></svg>{T.k5}</li>
          </ul>
        </div>
        <div>
          <h2>{T.valuesHeading}</h2>
          <dl class="values-grid">
            <div><dt>{T.v1}</dt><dd>{T.v1Desc}</dd></div>
            <div><dt>{T.v2}</dt><dd>{T.v2Desc}</dd></div>
            <div><dt>{T.v3}</dt><dd>{T.v3Desc}</dd></div>
            <div><dt>{T.v4}</dt><dd>{T.v4Desc}</dd></div>
            <div><dt>{T.v5}</dt><dd>{T.v5Desc}</dd></div>
            <div><dt>{T.v6}</dt><dd>{T.v6Desc}</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── CASE STUDY ───────────────────────────────────────── -->
  <section id="work" class="case-study-section">
    <div class="container">
      <div class="case-grid">
        <div class="case-text">
          <div class="case-meta">{T.recentWork}</div>
          <h2>{T.caseStudy}</h2>
          <h3>{T.alImran}</h3>
          <p>{T.caseDesc}</p>
          <div class="case-tags">
            <span class="k-tag tag-butter">The Jailbreak</span>
            <span class="k-tag tag-sky">Web</span>
            <span class="k-tag tag-apricot">Networks</span>
          </div>
          <a class="skb skb-lilac" href={L("/al-imran/")}>{T.caseCTA}</a>
        </div>
        <a href={L("/al-imran/")} class="case-mockup-link">
          <div class="sk window case-mockup">
            <div class="window-chrome" data-sky></div>
            <div class="window-body mockup-content">
              <img src="/assets/illustrations/alimran-clinic-homepage.png" alt="Alimran Clinic modern website" class="mockup-image" />
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── FINAL CTA ───────────────────────────────────────── -->
  <section class="final-cta bg-mint">
    <div class="container">
      <div class="final-cta-grid">
        <div class="final-cta-text">
          <h2>{T.finalCTA}</h2>
          <a class="skb skb-butter" href={L("/contact/")}>{T.bookAudit}</a>
        </div>
        <svg width="220" height="180" viewBox="0 0 220 180" aria-hidden="true">
          <g fill="none" stroke="#1f1f1f" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="70" cy="90" r="36" fill="#f7e7b0"></circle>
          <circle cx="70" cy="90" r="12" fill="#bfe6d6"></circle>
          <path d="M106 90h90M170 90v24M190 90v16"></path>
          <path d="M20 30l10 10M30 30l-10 10M190 30l8 8M198 30l-8 8"></path>
          </g>
        </svg>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: var(--k-max);
    margin: 0 auto;
    padding: 0 var(--k-gutter-desktop);
  }

  /* Hero Section */
  .hero-section {
    padding: 88px 0 96px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .hero-h1 {
    margin: 0;
    font-size: 72px;
    line-height: 80px;
    font-weight: 700;
    letter-spacing: -1px;
    color: var(--k-ink);
  }

  .hero-h1 {
    /* Serif display face for both locales: Newsreader (EN) / Amiri (AR).
       --k-font-serif swaps automatically via html[dir="rtl"]. */
    font-family: var(--k-font-serif);
  }

  .hero-p {
    margin: 0;
    font-size: 22px;
    line-height: 38px;
    max-width: 600px;
    color: var(--k-ink-muted);
  }

  .hero-ctas {
    display: flex;
    gap: 20px;
    margin-top: 12px;
  }

  .hero-illustration {
    width: 100%;
    max-width: 500px;
  }

  /* Sound Familiar Section */
  .sound-familiar-section {
    padding: 88px 0;
  }


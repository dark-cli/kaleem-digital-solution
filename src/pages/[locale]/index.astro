---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WindowWidget from "../../components/WindowWidget.astro";
import { currentLocale, localizedHref } from "../../lib/i18n";

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const isAr = locale === "ar";
const L = (href: string) => localizedHref(href, locale);

const T = isAr ? {
  title: "كليم — حلول رقمية حقيقية للعراق",
  description: "نحرّر بياناتك من الأنظمة القديمة ونحدّثها: نستخرجها وننظّفها ونعيد بناء أنظمتك ومنصاتك الرقمية على أسس حديثة.",
  heroHeading: "حرّر بياناتك.",
  heroText: "نستخرج بياناتك من الأنظمة القديمة، وننظّفها، وننقلها إلى نظام حديث ومفتوح تملكه أنت. فريق محلي يعمل بمعايير عالمية، ونهاية حقيقية للارتهان لمزوّد واحد.",
  soundFamiliar: "هل يبدو هذا مألوفاً؟",
  problem1: "نظام قديم يحتجز بياناتك المهمة، ولا سبيل للوصول إليها أو تطويره؟",
  problem2: "بياناتك محبوسة في منصة لا تملكها، لدى شركة لا تساعدك على مغادرتها؟",
  problem3: "موقع قديم بطيء ومعطّل، مبني على تقنيات متقادمة، ومفاتيحه ليست بيدك؟",
  problemSolution: "لهذا بالضبط أسّسنا كليم.",
  methodHeading: "أربع خطوات نحو حريتك الرقمية",
  methodDesc: "العملية نفسها في كل مشروع: تقييم، استخراج، تنظيف، ثم تسليم المفاتيح.",
  m01: "التقييم والاستخراج",
  m01Desc: "نفحص النظام القديم، ونستخرج البيانات بأمان، ونوثّق كل ما يهم.",
  m02: "التنظيف والتحويل",
  m02Desc: "نوحّد الصيغ، ونحذف السجلات المكرّرة، ونحوّل البيانات إلى صيغ مفتوحة يسهل نقلها.",
  m03: "إعادة البناء",
  m03Desc: "نبني نظاماً جديداً على تقنيات مفتوحة ومجرّبة، سريعاً وموثوقاً، مع توثيق كامل.",
  m04: "تسليم المفاتيح",
  m04Desc: "نسلّمك الكود والبيانات والحسابات والتوثيق — كل شيء باسمك وملكك بالكامل.",
  servicesHeading: "ما نقدّمه",
  allServicesLink: "جميع الخدمات",
  s1: "استخراج البيانات",
  s1Desc: "نستعيد البيانات من الأنظمة القديمة بأمان، مع الحفاظ على تاريخها وسياقها دون أي فقدان.",
  s2: "تحديث منصات الويب",
  s2Desc: "نحوّل المواقع القديمة إلى تطبيقات ويب حديثة وسريعة وآمنة.",
  s3: "إعادة هيكلة قواعد البيانات",
  s3Desc: "ننظّف البيانات المبعثرة، ونوحّد صيغها، ونبني قواعد بيانات واضحة الهيكل وقابلة للتوسّع.",
  s4: "بنية تحتية مفتوحة",
  s4Desc: "نبني على تقنيات مفتوحة المصدر ومعايير معتمدة لا تحبس بياناتك أبداً.",
  s5: "الانتقال من الأنظمة القديمة",
  s5Desc: "ننقلك من الأنظمة المغلقة إلى بدائل حديثة دون فقدان البيانات أو توقّف العمل.",
  s6: "التدريب والدعم",
  s6Desc: "ندرّب فريقك على النظام الجديد، ونقدّم دعماً محلياً مستمراً بالعربية والإنجليزية.",
  keepKeys: "ملكية رقمية حقيقية",
  k1: "تحكّم كامل — الكود والبيانات والخوادم ملكك",
  k2: "معايير مفتوحة — لا ارتهان لمزوّد، ولا تغييرات مفاجئة من طرف آخر",
  k3: "استقلالية حقيقية — تستطيع الانتقال متى شئت، وإن كنت لن ترغب في ذلك",
  k4: "بياناتك في مكان تختاره — على خوادمك أو لدى مزوّد تختاره أنت",
  k5: "شفافية كاملة — كل جزء موثّق ومفهوم لفريقك",
  valuesHeading: "قيمنا",
  v1: "ملكية حقيقية",
  v1Desc: "أنت تملك الكود والبيانات والمنصة — لا العكس.",
  v2: "معايير مفتوحة",
  v2Desc: "تقنيات مجرّبة لا تحبسك أبداً — تستطيع الانتقال متى أردت.",
  v3: "كفاءة محلية",
  v3Desc: "فريق محلي يفهم ظروفك، ودعم بلغتك.",
  v4: "شفافية كاملة",
  v4Desc: "لا اشتراكات خفية ولا رسوم مفاجئة — أرقام واضحة من البداية.",
  v5: "الأداء أولاً",
  v5Desc: "أنظمة سريعة وآمنة وموثوقة — وإلا فهي ليست جاهزة بعد.",
  v6: "نشرح كل شيء",
  v6Desc: "نوثّق كل جزء، وندرّب فريقك، ونتأكد أنك تفهم النظام فهماً كاملاً.",
  recentWork: "أعمالنا",
  caseStudy: "تحرير بيانات مركز طبي من موقع قديم",
  alImran: "مركز العمران الطبي، البصرة",
  caseDesc: "نقلنا المركز من موقع قديم ومبعثر إلى منصة حديثة موحّدة: استخرجنا 600 مقالة ونظّفناها، ثم أعدنا بناء الموقع على Astro وCloudflare Workers. النتيجة: موقع يحصل على 97/100 في PageSpeed، ويدعم العربية والإنجليزية، وبياناته بيد المركز بالكامل.",
  caseTags: ["استخراج البيانات", "تحديث الويب", "بنية مفتوحة"],
  caseCTA: "اقرأ دراسة الحالة",
  finalCTA: "حرّر منصتك الرقمية.",
  bookAudit: "احجز تقييماً مجانياً",
  howWeWork: "كيف نعمل",
  learnMore: "المزيد",
} : {
  title: "Kaleem — Real digital solutions for Iraq",
  description: "We free data from legacy systems and modernize them: extract it, clean it, and rebuild your digital platforms on modern foundations.",
  heroHeading: "Liberate your data.",
  heroText: "We extract your data from legacy systems, clean it, and move it into a modern, open system that you own. A local team working to global standards — and a real way out of single-vendor lock-in.",
  soundFamiliar: "Sound familiar?",
  problem1: "A legacy system holding your critical data hostage, with no way to access it or build on it?",
  problem2: "Data locked in a platform you don't own, run by a company that won't help you leave?",
  problem3: "An aging website that's slow, broken, built on outdated tech — and the keys aren't in your hands?",
  problemSolution: "That's exactly what we built Kaleem to fix.",
  methodHeading: "Four steps to digital freedom",
  methodDesc: "The same process on every project: audit, extract, clean, and hand over the keys.",
  m01: "Audit & extract",
  m01Desc: "We examine the legacy system, extract the data safely, and document everything that matters.",
  m02: "Clean & transform",
  m02Desc: "We standardize formats, deduplicate records, and convert data into open, portable formats.",
  m03: "Rebuild",
  m03Desc: "We build a new system on proven open technology — fast, reliable, and fully documented.",
  m04: "Hand over the keys",
  m04Desc: "You receive the code, data, accounts, and documentation — everything in your name, fully yours.",
  servicesHeading: "What we do",
  allServicesLink: "All services",
  s1: "Data extraction",
  s1Desc: "Safely recover data from legacy systems, preserving its history and context without loss.",
  s2: "Web platform modernization",
  s2Desc: "Turn aging websites into modern, fast, and secure web applications.",
  s3: "Database restructuring",
  s3Desc: "Clean messy data, unify formats, and build clear, scalable database structures.",
  s4: "Open infrastructure",
  s4Desc: "Build on proven open-source technology and industry standards that never lock your data in.",
  s5: "Legacy migration",
  s5Desc: "Move from closed, proprietary systems to modern alternatives without data loss or downtime.",
  s6: "Training & support",
  s6Desc: "We train your team on the new system and provide ongoing local support in Arabic and English.",
  keepKeys: "True digital ownership",
  k1: "Full control — you own the code, the data, and the servers",
  k2: "Open standards — no lock-in, no surprise changes from a vendor",
  k3: "Real independence — you can leave anytime, though we don't think you'll want to",
  k4: "Your data, where you choose — on your own servers or with a provider you pick",
  k5: "Full transparency — every component documented and understood by your team",
  valuesHeading: "Our values",
  v1: "Real ownership",
  v1Desc: "You own the code, the data, and the platform — not the other way around.",
  v2: "Open standards",
  v2Desc: "Proven technology that never traps you — you can always move if you choose to.",
  v3: "Local competence",
  v3Desc: "A local team that understands your context, with support in your language.",
  v4: "Full transparency",
  v4Desc: "No hidden subscriptions or surprise fees — clear numbers from the start.",
  v5: "Performance first",
  v5Desc: "Fast, secure, reliable systems — or we don't consider them ready.",
  v6: "We explain everything",
  v6Desc: "We document every part, train your team, and make sure you fully understand the system.",
  recentWork: "Our work",
  caseStudy: "Freeing a medical center's data from a legacy website",
  alImran: "Alimran Medical Center, Basra",
  caseDesc: "We moved the center from a fragmented legacy site to a unified modern platform: extracted and cleaned 600 articles, then rebuilt the site on Astro and Cloudflare Workers. The result: a site that scores 97/100 on PageSpeed, works in Arabic and English, and keeps its data fully in the center's hands.",
  caseTags: ["Data extraction", "Web modernization", "Open infrastructure"],
  caseCTA: "Read the case study",
  finalCTA: "Liberate your digital platform.",
  bookAudit: "Book a free audit",
  howWeWork: "How we work",
  learnMore: "Learn more",
};---

<BaseLayout title={T.title} description={T.description}>
  <!-- ─── HERO ───────────────────────────────────────────────── -->
  <section class="hero-section bg-peach">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-text">
          <h1 class="hero-h1">{T.heroHeading}</h1>
          <p class="hero-p">{T.heroText}</p>
          <div class="hero-ctas">
            <a class="skb skb-mint" href={L("/contact/")}>{T.bookAudit}</a>
            <a class="skb skb-paper" href="#method">{T.howWeWork}</a>
          </div>
        </div>
        <img src="/assets/illustrations/freedom.svg" alt={isAr ? "صندوق مقفل تخرج منه بيانات متشابكة إلى مجلد منظّم" : "Locked box with tangled data being set free into an organized folder"} class="hero-illustration" />
      </div>
    </div>
  </section>

  <!-- ─── SOUND FAMILIAR ───────────────────────────────────── -->
  <section class="sound-familiar-section">
    <div class="container">
      <h2 class="section-heading">{T.soundFamiliar}</h2>
      <div class="problems-grid">
        <div class="sk card-butter">{T.problem1}</div>
        <div class="sk card-butter">{T.problem2}</div>
        <div class="sk card-butter">{T.problem3}</div>
        <div class="problem-solution">
          <svg width="56" height="40" viewBox="0 0 56 40" aria-hidden="true" style="transform: scaleX(-1)"><path d="M52 8c-14 2 -30 10 -44 24M8 32l2 -12M8 32l12 -2" fill="none" stroke="#1f1f1f" stroke-width="3" stroke-linecap="round"></path></svg>
          {T.problemSolution}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── METHOD ─────────────────────────────────────────── -->
  <section id="method" class="method-section bg-paper-2">
    <div class="container">
      <div class="method-header">
        <div>
          <h2 class="section-heading">{T.methodHeading}</h2>
          <p class="section-lede">{T.methodDesc}</p>
        </div>
        <svg width="180" height="70" viewBox="0 0 180 70" aria-hidden="true" style="transform: scaleX(-1)"><path d="M170 20c-40 -20 -90 -10 -120 30M50 50l-2 -16M50 50l15 -6" fill="none" stroke="#1f1f1f" stroke-width="3" stroke-linecap="round"></path></svg>
      </div>
      <ol class="method-grid">
        <li class="sk card-sky">
          <span class="method-num">01</span>
          <h3>{T.m01}</h3>
          <p>{T.m01Desc}</p>
        </li>
        <li class="sk card-mint">
          <span class="method-num">02</span>
          <h3>{T.m02}</h3>
          <p>{T.m02Desc}</p>
        </li>
        <li class="sk card-lilac">
          <span class="method-num">03</span>
          <h3>{T.m03}</h3>
          <p>{T.m03Desc}</p>
        </li>
        <li class="sk card-butter">
          <span class="method-num">04</span>
          <h3>{T.m04}</h3>
          <p>{T.m04Desc}</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ─── SERVICES ─────────────────────────────────────────── -->
  <section class="services-section">
    <div class="container">
      <div class="services-header">
        <h2 class="section-heading">{T.servicesHeading}</h2>
        <a href={L("/services/")}>{T.allServicesLink}</a>
      </div>
      <div class="services-grid">
        <a href={L("/services/")} class="sk card-butter">
          <svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><path d="M18 6H6V26H26V14"></path><rect x="20" y="3" width="9" height="9" fill="#faf6ee"></rect></svg>
          <h3>{T.s1}</h3>
          <p>{T.s1Desc}</p>
          <span class="learn-more">{T.learnMore}</span>
        </a>
        <a href={L("/services/")} class="sk card-sky">
          <svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><rect x="4" y="6" width="24" height="20" rx="2"></rect><path d="M4 11h24"></path><path d="M8 8.5h1M11 8.5h1"></path></svg>
          <h3>{T.s2}</h3>
          <p>{T.s2Desc}</p>
          <span class="learn-more">{T.learnMore}</span>
        </a>
        <a href={L("/services/")} class="sk card-peach">
          <svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><rect x="10" y="3" width="12" height="26" rx="3"></rect><path d="M14 25h4"></path></svg>
          <h3>{T.s3}</h3>
          <p>{T.s3Desc}</p>
          <span class="learn-more">{T.learnMore}</span>
        </a>
        <a href={L("/services/")} class="sk card-mint">
          <svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><ellipse cx="16" cy="8" rx="10" ry="4"></ellipse><path d="M6 8v16c0 2.2 4.5 4 10 4s10-1.8 10-4V8"></path><path d="M6 16c0 2.2 4.5 4 10 4s10-1.8 10-4"></path></svg>
          <h3>{T.s4}</h3>
          <p>{T.s4Desc}</p>
          <span class="learn-more">{T.learnMore}</span>
        </a>
        <a href={L("/services/")} class="sk card-apricot">
          <svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><path d="M4 9l18-4l2 9l-18 4z"></path><path d="M14 16v8H6"></path><circle cx="20" cy="10" r="1.5"></circle></svg>
          <h3>{T.s5}</h3>
          <p>{T.s5Desc}</p>
          <span class="learn-more">{T.learnMore}</span>
        </a>
        <a href={L("/services/")} class="sk card-lilac">
          <svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true"><path d="M5 6h22v14H14l-6 5v-5H5z"></path><path d="M10 11h12M10 15h8"></path></svg>
          <h3>{T.s6}</h3>
          <p>{T.s6Desc}</p>
          <span class="learn-more">{T.learnMore}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── ABOUT / VALUES ───────────────────────────────────── -->
  <section id="about" class="about-section bg-lilac">
    <div class="container">
      <div class="about-grid">
        <div class="sk card-paper">
          <h2>{T.keepKeys}</h2>
          <ul class="keys-list">
            <li><svg class="check-icon" width="22" height="22" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10.5l4.5 4.5 9-10" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round"></path></svg>{T.k1}</li>
            <li><svg class="check-icon" width="22" height="22" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10.5l4.5 4.5 9-10" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round"></path></svg>{T.k2}</li>
            <li><svg class="check-icon" width="22" height="22" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10.5l4.5 4.5 9-10" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round"></path></svg>{T.k3}</li>
            <li><svg class="check-icon" width="22" height="22" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10.5l4.5 4.5 9-10" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round"></path></svg>{T.k4}</li>
            <li><svg class="check-icon" width="22" height="22" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10.5l4.5 4.5 9-10" fill="none" stroke="#1f1f1f" stroke-width="2.5" stroke-linecap="round"></path></svg>{T.k5}</li>
          </ul>
        </div>
        <div>
          <h2>{T.valuesHeading}</h2>
          <dl class="values-grid">
            <div><dt>{T.v1}</dt><dd>{T.v1Desc}</dd></div>
            <div><dt>{T.v2}</dt><dd>{T.v2Desc}</dd></div>
            <div><dt>{T.v3}</dt><dd>{T.v3Desc}</dd></div>
            <div><dt>{T.v4}</dt><dd>{T.v4Desc}</dd></div>
            <div><dt>{T.v5}</dt><dd>{T.v5Desc}</dd></div>
            <div><dt>{T.v6}</dt><dd>{T.v6Desc}</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── CASE STUDY ───────────────────────────────────────── -->
  <section id="work" class="case-study-section">
    <div class="container">
      <div class="case-grid">
        <div class="case-text">
          <div class="case-meta">{T.recentWork}</div>
          <h2>{T.caseStudy}</h2>
          <h3>{T.alImran}</h3>
          <p>{T.caseDesc}</p>
          <div class="case-tags">
            <span class="k-tag tag-butter">{T.caseTags[0]}</span>
            <span class="k-tag tag-sky">{T.caseTags[1]}</span>
            <span class="k-tag tag-apricot">{T.caseTags[2]}</span>
          </div>
          <a class="skb skb-lilac" href={L("/al-imran/")}>{T.caseCTA}</a>
        </div>
        <a href={L("/al-imran/")} class="case-mockup-link">
          <WindowWidget src="/assets/illustrations/alimran-clinic-homepage.png" alt={isAr ? "الموقع الجديد لمركز العمران الطبي" : "The new Alimran Medical Center website"} chromeColor="sky-shader" />
        </a>
      </div>
    </div>
  </section>

  <!-- ─── FINAL CTA ───────────────────────────────────────── -->
  <section class="final-cta bg-mint">
    <div class="container">
      <div class="final-cta-grid">
        <div class="final-cta-text">
          <h2>{T.finalCTA}</h2>
          <a class="skb skb-butter" href={L("/contact/")}>{T.bookAudit}</a>
        </div>
        <svg width="220" height="180" viewBox="0 0 220 180" aria-hidden="true">
          <g fill="none" stroke="#1f1f1f" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="70" cy="90" r="36" fill="#f7e7b0"></circle>
          <circle cx="70" cy="90" r="12" fill="#bfe6d6"></circle>
          <path d="M106 90h90M170 90v24M190 90v16"></path>
          <path d="M20 30l10 10M30 30l-10 10M190 30l8 8M198 30l-8 8"></path>
          </g>
        </svg>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: var(--k-max);
    margin: 0 auto;
    padding: 0 var(--k-gutter-desktop);
  }

  /* Hero Section */
  .hero-section {
    padding: 88px 0 96px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .hero-h1 {
    margin: 0;
    font-size: 72px;
    line-height: 80px;
    font-weight: 700;
    letter-spacing: -1px;
    color: var(--k-ink);
  }

  .hero-h1 {
    /* Serif display face for both locales: Newsreader (EN) / Amiri (AR).
       --k-font-serif swaps automatically via html[dir="rtl"]. */
    font-family: var(--k-font-serif);
  }

  .hero-p {
    margin: 0;
    font-size: 22px;
    line-height: 38px;
    max-width: 600px;
    color: var(--k-ink-muted);
  }

  .hero-ctas {
    display: flex;
    gap: 20px;
    margin-top: 12px;
  }

  .hero-illustration {
    width: 100%;
    max-width: 500px;
  }

  /* Sound Familiar Section */
  .sound-familiar-section {
    padding: 88px 0;
  }

  .section-heading {
    margin: 0 0 40px;
    font-size: 40px;
    line-height: 60px;
    font-weight: 700;
    color: var(--k-ink);
  }

  .section-heading {
    /* Serif display face for both locales — Newsreader / Amiri. */
    font-family: var(--k-font-serif);
  }

  .problems-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }

  .card-butter {

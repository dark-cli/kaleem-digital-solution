---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WindowWidget from "../../components/WindowWidget.astro";
import PhoneFrame from "../../components/PhoneFrame.astro";
import { currentLocale, localizedHref } from "../../lib/i18n";
import { SERVICE_BG, SERVICE_ICON, type ServiceId } from "../../data/services";

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const isAr = locale === "ar";
const L = (href: string) => localizedHref(href, locale);

const T = isAr ? {
  title: "كليم — حلول رقمية حقيقية للعراق",
  description: "نحرّر بياناتك من الأنظمة القديمة ونحدّثها: نستخرجها وننظّفها ونعيد بناء أنظمتك ومنصاتك الرقمية على أسس حديثة تملكها أنت.",
  heroHeading: "حرّر بياناتك.",
  heroText: "نُخرج بياناتك من الأنظمة القديمة والمغلقة، ونعيد بناءها على تقنيات حديثة تملكها أنت.",
  bookAudit: "احجز تقييماً مجانياً",
  seeWork: "شاهد أعمالنا",
  servicesHeading: "ما نقدّمه",
  allServices: "جميع الخدمات",
  services: [
    { id: "jailbreak",  name: "تحرير الأنظمة",          line: "بياناتك خارج الأنظمة المغلقة، بصيغ مفتوحة." },
    { id: "websites",   name: "المواقع وتطبيقات الويب",  line: "من موقع تعريفي إلى منصة إدارة." },
    { id: "mobile",     name: "تطبيقات الهاتف",          line: "أندرويد و iOS، منشورة باسمك." },
    { id: "systems",    name: "أنظمة الإدارة والمتاجر",  line: "من نقطة بيع واحدة إلى فروع متعددة." },
    { id: "networks",   name: "الشبكات والأمن",          line: "كاميرات وشبكات وواي فاي للزوار." },
    { id: "consulting", name: "الاستشارات والتدريب",     line: "نساعدك على القرار وندرّب فريقك." },
  ],
  workEyebrow: "أعمالنا",
  workTitle: "مركز العمران الطبي، البصرة",
  workText: "نقلنا موقع المركز من WordPress قديم ومعطّل إلى منصة حديثة يملكها المركز بالكامل.",
  stats: [
    { value: "97/100", label: "في PageSpeed" },
    { value: "600", label: "مقالة منقولة" },
    { value: "عربي + EN", label: "بلغتين" },
  ],
  workCTA: "اقرأ دراسة الحالة",
  dmTitle: "برنامج المحصل — شركة خدمات",
  dmText: "منصة لتحصيل الديون لا يستطيع فيها أحد — ولا حتى المسؤولون — تغيير الأرقام بصمت. سُلِّمت خلال ثلاثة أشهر.",
  dmStats: [
    { value: "230", label: "اختباراً آلياً" },
    { value: "3 أشهر", label: "حتى التشغيل" },
    { value: "بلا إنترنت", label: "تطبيق ميداني" },
  ],
  dmDashAlt: "لوحة الإدارة: الإجماليات والدين عبر الزمن",
  dmPhoneAlt: "الشاشة الرئيسية للتطبيق: الرصيد الكلي والأرصدة المستحقة",
  flowHeading: "من عالق إلى حرّ",
  stuckHead: "عالق مع…",
  stuck: ["نظام قديم لا تستطيع مغادرته", "بيانات لا تصل إليها", "موقع بطيء ومعطّل"],
  stepsHead: "…نُخرجك منه في خمس خطوات",
  steps: ["التقييم", "الاستخراج والتنظيف", "البناء", "التسليم", "الدعم"],
  free: "حرّ",
  howLink: "كيف نعمل بالتفصيل",
  keepHeading: "كل شيء يبقى لك",
  keep: ["كل الحسابات وكلمات المرور", "الكود في حسابك", "النطاق باسمك", "توثيق كامل", "تدريب لفريقك"],
  valuesLink: "قيمنا",
} : {
  title: "Kaleem — Real digital solutions for Iraq",
  description: "We free data from legacy systems and modernize them: extract it, clean it, and rebuild your digital platforms on modern foundations you own.",
  heroHeading: "Liberate your data.",
  heroText: "We get your data out of old, locked systems and rebuild it on modern tech that you own.",
  bookAudit: "Book a free audit",
  seeWork: "See our work",
  servicesHeading: "What we do",
  allServices: "All services",
  services: [
    { id: "jailbreak",  name: "The Jailbreak",              line: "Your data out of locked systems, in open formats." },
    { id: "websites",   name: "Websites & web apps",        line: "From a portfolio to a management platform." },
    { id: "mobile",     name: "Mobile apps",                line: "Android and iOS, published in your name." },
    { id: "systems",    name: "Management & store systems", line: "From one point of sale to many branches." },
    { id: "networks",   name: "Networks & security",        line: "Cameras, networks and guest Wi-Fi." },
    { id: "consulting", name: "Consulting & training",      line: "We help you decide, then train your team." },
  ],
  workEyebrow: "Our work",
  workTitle: "Alimran Medical Center, Basra",
  workText: "We moved the center off a broken legacy WordPress site onto a modern platform it fully owns.",
  stats: [
    { value: "97/100", label: "PageSpeed" },
    { value: "600", label: "articles moved" },
    { value: "AR + EN", label: "bilingual" },
  ],
  workCTA: "Read the case study",
  dmTitle: "Debt-collection platform, utility company",
  dmText: "A debt-collection platform where no one — not even the administrators — can quietly change the numbers. Delivered in three months.",
  dmStats: [
    { value: "230", label: "automated tests" },
    { value: "3 months", label: "to go live" },
    { value: "Offline", label: "field app" },
  ],
  dmDashAlt: "Admin panel: totals and debt over time",
  dmPhoneAlt: "App home screen: total balance and outstanding balances",
  flowHeading: "From stuck to free",
  stuckHead: "Stuck with…",
  stuck: ["An old system you can't leave", "Data you can't reach", "A slow, broken website"],
  stepsHead: "…we get you out in five steps",
  steps: ["Audit", "Extract & clean", "Build", "Hand over", "Support"],
  free: "Free",
  howLink: "How we work, in detail",
  keepHeading: "Everything stays yours",
  keep: ["Every account & password", "The code, in your account", "Domain in your name", "Full documentation", "Training for your team"],
  valuesLink: "Our values",
};

const KEEP_ICONS = [
  `<circle cx="10" cy="16" r="6"></circle><path d="M16 16h13M24 16v5M28 16v3"></path>`,
  `<path d="M11 9l-7 7l7 7M21 9l7 7l-7 7"></path>`,
  `<circle cx="16" cy="16" r="12"></circle><path d="M4 16h24M16 4c-5 6-5 18 0 24M16 4c5 6 5 18 0 24"></path>`,
  `<path d="M8 4h12l6 6v18H8z"></path><path d="M20 4v6h6M12 16h10M12 21h8"></path>`,
  `<circle cx="12" cy="10" r="4"></circle><circle cx="23" cy="12" r="3"></circle><path d="M4 26c0-5 4-8 8-8s8 3 8 8M19 20c4 0 9 2 9 6"></path>`,
];
---

<BaseLayout title={T.title} description={T.description}>
  <!-- ─── HERO ─── -->
  <section class="hero bg-peach">
    <div class="container hero-grid">
      <div class="hero-text">
        <h1>{T.heroHeading}</h1>
        <p class="hero-p">{T.heroText}</p>
        <div class="hero-ctas">
          <a class="skb skb-mint" href={L("/audit/")}>{T.bookAudit}</a>
          <a class="skb skb-paper" href="#work">{T.seeWork}</a>
        </div>
      </div>
      <img src="/assets/illustrations/freedom.svg" alt={isAr ? "صندوق مقفل تخرج منه بيانات متشابكة إلى مجلد منظّم" : "Locked box with tangled data being set free into an organized folder"} class="hero-illustration" />
    </div>
  </section>

  <!-- ─── WHAT WE DO: a two-row list, not cards ─── -->
  <section class="services">
    <div class="container">
      <div class="list-head">
        <h2 class="sec-h2">{T.servicesHeading}</h2>
        <a class="more" href={L("/services/")}>{T.allServices} <span class="flip-rtl" aria-hidden="true">→</span></a>
      </div>
      <ul class="svc-cards">
        {T.services.map((s) => (
          <li>
            <a class={`svc-card lift ${SERVICE_BG[s.id as ServiceId]}`} href={L("/services/") + "#" + s.id}>
              <svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true" set:html={SERVICE_ICON[s.id as ServiceId]}></svg>
              <strong>{s.name}</strong>
              <span>{s.line}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ─── OUR WORK ─── -->
  <section id="work" class="work bg-paper-2">
    <div class="container work-grid">
      <div class="work-text">
        <span class="eyebrow-k">{T.workEyebrow}</span>
        <h2 class="sec-h2">{T.workTitle}</h2>
        <p>{T.workText}</p>
        <dl class="stats">
          {T.stats.map((s) => (
            <div>
              <dt><bdi>{s.value}</bdi></dt>
              <dd>{s.label}</dd>
            </div>
          ))}
        </dl>
        <a class="skb skb-lilac" href={L("/al-imran/")}>{T.workCTA}</a>
      </div>
      <a href={L("/al-imran/")} class="work-shot window-link" aria-label={T.workCTA}>
        <WindowWidget src="/assets/illustrations/alimran-clinic-homepage.png" alt={isAr ? "الموقع الجديد لمركز العمران الطبي" : "The new Alimran Medical Center website"} chromeColor="sky-shader" />
      </a>
    </div>

    <!-- Second case, mirrored: the screenshots lead, the text follows. -->
    <div class="container work-grid work-flip">
      <div class="work-text">
        <h2 class="sec-h2">{T.dmTitle}</h2>
        <p>{T.dmText}</p>
        <dl class="stats">
          {T.dmStats.map((s) => (
            <div>
              <dt><bdi>{s.value}</bdi></dt>
              <dd>{s.label}</dd>
            </div>
          ))}
        </dl>
        <a class="skb skb-apricot" href={L("/deptmaster/")}>{T.workCTA}</a>
      </div>
      <a href={L("/deptmaster/")} class="work-shot work-stage window-link" aria-label={T.workCTA}>
        <span class="stage-win">
          <WindowWidget src="/assets/deptmaster/admin-panel-card.png" alt={T.dmDashAlt} chromeColor="sky-shader" sizes="(min-width: 1056px) 50vw, 100vw" />
        </span>
        <PhoneFrame src="/assets/deptmaster/app-home.jpg" alt={T.dmPhoneAlt} class="stage-phone" finish="paper" sizes="180px" />
      </a>
    </div>
  </section>

  <!-- ─── FROM STUCK TO FREE: the problems, then the five steps out ─── -->
  <section id="method" class="flow">
    <div class="container">
      <h2 class="sec-h2">{T.flowHeading}</h2>
      <div class="flow-grid">
        <div class="stuck">
          <h3>{T.stuckHead}</h3>
          <ul>
            {T.stuck.map((p) => (
              <li>
                <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="#1f1f1f" stroke-width="3" stroke-linecap="round"></path></svg>
                {p}
              </li>
            ))}
          </ul>
        </div>
        <div class="steps-wrap">
          <h3>{T.stepsHead}</h3>
          <ol class="track">
            {T.steps.map((s, i) => (
              <li>
                <span class="dot">{i + 1}</span>
                <span class="label">{s}</span>
              </li>
            ))}
            <li class="end">
              <span class="dot key">
                <svg class="ico" width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><circle cx="10" cy="16" r="6"></circle><path d="M16 16h13M24 16v5M28 16v3"></path></svg>
              </span>
              <span class="label">{T.free}</span>
            </li>
          </ol>
          <a class="more" href={L("/services/")}>{T.howLink} <span class="flip-rtl" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── EVERYTHING STAYS YOURS: one inline band ─── -->
  <section class="keep bg-lilac">
    <div class="container keep-row">
      <h2>{T.keepHeading}</h2>
      <ul>
        {T.keep.map((k, i) => (
          <li>
            <svg class="ico" width="28" height="28" viewBox="0 0 32 32" aria-hidden="true" set:html={KEEP_ICONS[i]}></svg>
            {k}
          </li>
        ))}
      </ul>
      <a class="more" href={L("/about/")}>{T.valuesLink} <span class="flip-rtl" aria-hidden="true">→</span></a>
    </div>
  </section>

</BaseLayout>

<style>
  .container {
    max-width: var(--k-max);
    margin: 0 auto;
    padding: 0 var(--k-gutter-desktop);
  }
  :global(html[dir="rtl"]) .flip-rtl { display: inline-block; transform: scaleX(-1); }

  .sec-h2 {
    margin: 0;
    font-family: var(--k-font-serif);
    font-size: 40px;
    line-height: 1.2;
    font-weight: 700;
    color: var(--k-ink);
  }
  .more {
    font-size: 17px;
    font-weight: 600;
    color: var(--k-ink);
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  .more:hover { color: var(--k-ink); }

  /* ─── Hero ─── */
  .hero { padding: 88px 0 96px; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .hero-text { display: flex; flex-direction: column; gap: 28px; }
  .hero h1 {
    margin: 0;
    font-family: var(--k-font-serif);
    font-size: 72px;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -1px;
    color: var(--k-ink);
  }
  .hero-p { margin: 0; font-size: 22px; line-height: 36px; max-width: 520px; color: var(--k-ink-muted); }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 8px; }
  .hero-illustration { width: 100%; max-width: 500px; justify-self: center; }

  /* ─── What we do: list rows separated by rules ─── */
  .services { padding: 88px 0; }
  .list-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }
  .svc-cards {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 1fr; /* every row as tall as the tallest */
    gap: 28px;
  }
  .svc-card {
    height: 100%;
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: var(--k-ink);
    text-decoration: none;
  }
  .svc-card strong { font-size: 21px; line-height: 1.3; }
  .svc-card span { font-size: 16px; line-height: 1.5; color: var(--k-ink); }

  /* Elevated behaviour, matching the .skb buttons and the Services hero
     tiles: lift on hover/focus, press on click. */
  .lift {
    border: var(--k-line) solid var(--k-ink);
    border-radius: var(--k-radius-sketch);
    box-shadow: 4px 4px 0 -2px var(--k-paper), 4px 4px 0 0 var(--k-ink);
    transition: transform 140ms cubic-bezier(0.2, 0.9, 0.3, 1.2),
                box-shadow 140ms cubic-bezier(0.2, 0.9, 0.3, 1.2);
  }
  .lift:hover, .lift:focus-visible {
    color: var(--k-ink);
    text-decoration: none;
    transform: translate(-4px, -4px);
    box-shadow: 8px 8px 0 -2px var(--k-paper), 8px 8px 0 0 var(--k-ink);
  }
  .lift:active {
    transform: translate(-1px, -1px);
    box-shadow: 5px 5px 0 -2px var(--k-paper), 5px 5px 0 0 var(--k-ink);
  }
  @media (prefers-reduced-motion: reduce) { .lift { transition: none; } }

  /* ─── Our work ─── */
  .work {
    padding: 88px 0;
    border-top: 2px solid var(--k-ink);
    border-bottom: 2px solid var(--k-ink);
  }
  .work-grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 64px;
    align-items: center;
  }
  .work-text { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  /* Each further case sits below, mirrored, so the section alternates. */
  .work-grid + .work-grid { margin-top: 88px; }
  .work-flip { grid-template-columns: 7fr 5fr; }
  .work-flip .work-text { order: 2; }
  /* Dashboard window at the same size as the first case's, with the
     phone hanging over its lower corner. */
  .work-stage { position: relative; display: block; }
  .stage-win { display: block; }
  .work-stage :global(.stage-phone) { position: absolute; inset-inline-end: -5%; bottom: -8%; width: 34%; max-width: 260px; }
  .eyebrow-k { font-size: 15px; font-weight: 600; color: var(--k-ink-muted); }
  .work-text p { margin: 0; font-size: 18px; line-height: 30px; color: var(--k-ink); }
  .stats {
    margin: 4px 0 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 36px;
  }
  .stats div { display: flex; flex-direction: column; }
  .stats dt {
    font-family: var(--k-font-mono);
    font-size: 30px;
    line-height: 1.2;
    font-weight: 600;
    color: var(--k-ink);
  }
  .stats dd { margin: 0; font-size: 14px; color: var(--k-ink-muted); }

  /* ─── From stuck to free ─── */
  .flow { padding: 88px 0; }
  .flow-grid {
    margin-top: 40px;
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: 56px;
    align-items: start;
  }
  .flow h3 { margin: 0 0 20px; font-size: 18px; font-weight: 700; color: var(--k-ink-muted); }
  .stuck ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 14px; }
  .stuck li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 19px;
    font-weight: 600;
    color: var(--k-ink);
  }
  .stuck li svg {
    flex-shrink: 0;
    padding: 3px;
    background: var(--k-peach);
    border: 2px solid var(--k-ink);
    border-radius: 50%;
    box-sizing: content-box;
  }

  /* A single line with numbered stops, ending at the key. */
  .track {
    position: relative;
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }
  .track::before {
    content: "";
    position: absolute;
    top: 25px;
    inset-inline: calc(100% / 12);
    border-top: 3px solid var(--k-ink);
  }
  .track li {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }
  .dot {
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2.5px solid var(--k-ink);
    border-radius: 50%;
    background: var(--k-paper);
    font-family: var(--k-font-mono);
    font-size: 19px;
    font-weight: 600;
    color: var(--k-ink);
  }
  .dot.key { background: var(--k-butter); }
  .label { font-size: 16px; font-weight: 600; line-height: 1.3; color: var(--k-ink); }
  .end .label { font-family: var(--k-font-serif); font-size: 20px; font-weight: 700; }

  /* ─── Everything stays yours ─── */
  .keep {
    padding: 44px 0;
    border-top: 2px solid var(--k-ink);
  }
  .keep-row {
    display: flex;
    align-items: center;
    gap: 20px 40px;
    flex-wrap: wrap;
  }
  .keep h2 {
    margin: 0;
    font-family: var(--k-font-serif);
    font-size: 28px;
    line-height: 1.2;
    font-weight: 700;
    color: var(--k-ink);
  }
  .keep ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
    flex: 1 1 560px;
  }
  .keep li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    font-weight: 600;
    color: var(--k-ink);
  }

  /* ─── Responsive ─── */
  @media (max-width: 1055px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-illustration { order: -1; max-width: 380px; }
    .svc-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .work-grid { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .work-flip .work-text { order: 0; }
    .work-grid + .work-grid { margin-top: 64px; }
    /* Keep the phone inside the page edge (no sideways scroll). */
    .work-stage :global(.stage-phone) { inset-inline-end: -2%; }
    .flow-grid { grid-template-columns: minmax(0, 1fr); gap: 40px; }
  }

  @media (max-width: 671px) {
    .container { padding: 0 var(--k-gutter-mobile); }
    .hero { padding: 48px 0 56px; }
    .hero h1 { font-size: 44px; }
    .hero-p { font-size: 18px; line-height: 30px; }
    .hero-illustration { max-width: 260px; }
    .hero-ctas { flex-direction: column; align-items: stretch; }
    .sec-h2 { font-size: 30px; }
    .services, .work, .flow { padding: 56px 0; }
    .svc-cards { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    .svc-card { padding: 20px; }
    .stats dt { font-size: 24px; }
    /* The track turns vertical: numbered stops down a line. */
    .track { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    .track::before {
      top: 25px;
      bottom: 25px;
      inset-inline: auto;
      inset-inline-start: 25px;
      border-top: 0;
      border-inline-start: 3px solid var(--k-ink);
    }

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WindowWidget from "../../components/WindowWidget.astro";
import PhoneFrame from "../../components/PhoneFrame.astro";
import { currentLocale } from "../../lib/i18n";

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const isAr = locale === "ar";

/* ─── Screenshots ──────────────────────────────────────────────────────
   Put the files in public/assets/deptmaster/ and list them here. Each
   section that shows screenshots appears only once its list has items:
     • DASHBOARD[0] is the large window (and the hero window).
     • PHONE[0] is also the hero phone.
   Captions are optional; give both languages.
   Example:
     { src: "/assets/deptmaster/wallet-overview.png",
       alt: { en: "Wallet overview", ar: "نظرة عامة على المحفظة" },
       caption: { en: "Every balance links to its history.", ar: "…" } },
*/
type Shot = { src: string; alt: { en: string; ar: string }; caption?: { en: string; ar: string } };
const DASHBOARD: Shot[] = [
  { src: "/assets/deptmaster/admin-panel.png",
    alt: { en: "Admin panel: totals, debt over time and the events log", ar: "لوحة الإدارة: الإجماليات، والدين عبر الزمن، وسجل الأحداث" },
    caption: { en: "The admin panel. Every number at the top traces back to the events log below it.", ar: "لوحة الإدارة. كل رقم في الأعلى يعود إلى سجل الأحداث تحته." } },
];
const PHONE: Shot[] = [
  { src: "/assets/deptmaster/app-home.jpg",
    alt: { en: "App home: total balance, chart and outstanding balances", ar: "الشاشة الرئيسية: الرصيد الكلي والرسم البياني والأرصدة المستحقة" },
    caption: { en: "Home: the balance at a glance", ar: "الرئيسية: الرصيد بنظرة واحدة" } },
  { src: "/assets/deptmaster/app-contacts.jpg",
    alt: { en: "Contacts list with what each one gave or received", ar: "قائمة جهات الاتصال مع ما أعطاه أو استلمه كل منها" },
    caption: { en: "Contacts: who owes and who is owed", ar: "جهات الاتصال: من عليه ومن له" } },
  { src: "/assets/deptmaster/app-client-history.jpg",
    alt: { en: "One client's balance and transaction history", ar: "رصيد عميل واحد وسجل معاملاته" },
    caption: { en: "One client's full history", ar: "سجل العميل كاملاً" } },
  { src: "/assets/deptmaster/app-add-payment.jpg",
    alt: { en: "Adding a transaction with amount, date and due date", ar: "إضافة معاملة بالمبلغ والتاريخ وتاريخ الاستحقاق" },
    caption: { en: "Posting a payment, signal or not", ar: "تسجيل دفعة، بإشارة أو بدونها" } },
];
// The hero shows the top of the admin panel (header, totals and chart);
// the full screenshot is in "The dashboard" section.
const HERO_DASH: Shot | undefined = {
  src: "/assets/deptmaster/admin-panel-overview.png",

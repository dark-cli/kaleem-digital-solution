  outHead:     "Six things they didn't have before.",
  outcomes: [
    { t: "Full ownership", d: "One binary on their own server. No cloud, no subscription, no vendor.", icon: "home" },
    { t: "Permanent record", d: "Every action recorded for good. Disputes have an answer: replay the history.", icon: "log" },
    { t: "Multiple wallets", d: "Each with its own teams, contacts and rules, fully isolated.", icon: "wallet" },
    { t: "Offline mobile app", d: "Queues work and syncs when reconnected.", icon: "phone" },
    { t: "Fine permissions", d: "A team lead runs their own team and nothing else.", icon: "key" },
    { t: "Add-on services", d: "Due-date reminders, SMS and WhatsApp statements, office tools: beside the core, not inside it.", icon: "list" },
  ],

  devLabel:    "For developers",
  tech: [
    "Rust — server (Postgres + Axum) and client logic layer",
    "Flutter — mobile UI via Flutter Rust Bridge (FFI)",
    "SQLite — local client database",
    "Event sourcing — every action recorded; balances computed, not stored",
    "Shared Rust crates — business logic written once, compiled into both server and app",
  ],
  osTitle:     "Open source as Debitum",
  osText:      "The open version of this system is on GitHub.",
};

// Small stroke icons shared by the requirement cards and the outcomes.
const ICONS: Record<string, string> = {
  log: '<rect x="6" y="4" width="20" height="24" rx="2"/><path d="M11 10h10M11 15h10M11 20h6"/>',
  key: '<circle cx="11" cy="16" r="6"/><path d="M17 16h12M25 16v5M29 16v3"/>',
  offline: '<rect x="10" y="3" width="12" height="26" rx="3"/><path d="M14 25h4M3 9l26 16"/>',
  home: '<path d="M4 15L16 5l12 10"/><path d="M7 13v14h18V13"/><path d="M13 27v-8h6v8"/>',
  wallet: '<rect x="4" y="9" width="24" height="17" rx="2"/><path d="M8 9V6h16v3"/>',
  phone: '<rect x="10" y="3" width="12" height="26" rx="3"/><path d="M14 25h4"/>',
  list: '<path d="M6 8h20M6 16h20M6 24h12"/><circle cx="24" cy="24" r="3"/>',
};
---

<BaseLayout title={T.title} description={T.description}>

  <!-- ─── HERO + FACTS: one mint block; the facts are the hero's summary ─── -->
  <section class="dm-hero bg-mint dust">
    <div class:list={["container", "dm-hero-grid", { "has-stage": heroShots }]}>
      <div class="dm-hero-text">
        <span class="eyebrow">{T.eyebrow}</span>
        <h1>{T.h1}</h1>
        <p class="dm-lead">{T.lead}</p>
        <p class="dm-sub">{T.sub}</p>
        <div class="chips">{T.chips.map((c) => <span class="chip">{c}</span>)}</div>
      </div>
      {heroShots && (
        <div class="dm-stage">
          {HERO_DASH && (
            <div class="dm-stage-win">
              <WindowWidget src={HERO_DASH.src} alt={tx(HERO_DASH.alt)} chromeColor="sky-shader" loading="eager" sizes="(min-width: 900px) 50vw, 100vw" />
            </div>
          )}
          {PHONE[0] && (
            <PhoneFrame src={PHONE[0].src} alt={tx(PHONE[0].alt)} class="dm-stage-phone" finish="paper" loading="eager" sizes="200px" />
          )}
        </div>
      )}
    </div>
  </section>
  <dl class="dm-facts bg-mint dust">
    {T.facts.map((f) => (
      <div>
        <dt>{f.label}</dt>
        <dd><span class="fact-value">{f.value}</span><span class="fact-note">{f.note}</span></dd>
      </div>
    ))}
  </dl>

  <!-- ─── THE PROBLEM ─── -->
  <section class="dm-sec bg-paper-2 dust">
    <div class="container dm-problem">
      <div class="dm-problem-text">
        <h2 class="big-h2">{T.problemHead}</h2>
        <p class="dm-lead">{T.problemLead}</p>
        <p>{T.problemBody} <b>{T.problemQ}</b></p>
      </div>
      <div class="dm-asks">
        <span class="eyebrow">{T.askedLabel}</span>
        <div class="ask-grid">
          {T.asks.map((a) => (
            <div class={`sk ask ${a.bg}`}>
              <svg class="ico" width="40" height="40" viewBox="0 0 32 32" aria-hidden="true" set:html={ICONS[a.icon]}></svg>
              <b>{a.t}</b>
              <span>{a.d}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── DISCOVERY: the quote, and what it means for the data ─── -->
  <section class="dm-sec board dm-dark">
    <div class="container">
      <span class="eyebrow">{T.discoveryEyebrow}</span>
      <blockquote class="dm-quote">“{T.quote}”</blockquote>
      <div class="data-compare">
        <figure>
          <figcaption class="eyebrow">{T.foundLabel}</figcaption>
          <div class="data-box">
            <div class="data-row data-head"><span>{T.foundCols[0]}</span><span>{T.foundCols[1]}</span></div>
            <div class="data-row"><span dir="ltr">#4821</span><span dir="ltr"><s>1,450,000</s> 1,200,000</span></div>
            <div class="data-row"><span dir="ltr">#3307</span><span dir="ltr">860,000</span></div>
          </div>
          <p>{T.foundNote}</p>
        </figure>
        <svg class="data-arrow" width="90" height="40" viewBox="0 0 90 40" aria-hidden="true"><path d="M8 20h66M64 10l12 10l-12 10" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="1 8"></path></svg>
        <figure>
          <figcaption class="eyebrow">{T.builtLabel}</figcaption>
          <ol class="data-box">
            {T.builtRows.map((r) => (
              <li class="data-row data-event"><span>{r.when} · {r.who}</span><span dir="ltr" class:list={["amt", r.amt.startsWith("+") ? "plus" : "minus"]}>{r.amt}</span><span dir="ltr">{r.client}</span></li>
            ))}
          </ol>
          <p>{T.builtNote}</p>
        </figure>
      </div>
    </div>
  </section>

  <!-- ─── HOW IT WORKS: two small diagrams ─── -->
  <section class="dm-sec">
    <div class="container">
      <span class="eyebrow">{T.howEyebrow}</span>
      <h2 class="sec-h2">{T.howHead}</h2>
      <div class="how-grid">
        <figure class="sk how-fig">
          <figcaption>{T.evTitle}</figcaption>
          <div class="ev-flow">
            <div class="ev-list">{T.evItems.map((e) => <span class="ev-item">{e}</span>)}</div>
            <svg class="ev-arrow" width="60" height="40" viewBox="0 0 60 40" aria-hidden="true"><path d="M6 20h40M38 12l10 8l-10 8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            <div class="sk ev-balance bg-mint">
              <span class="eyebrow">{T.evBalance}</span>
              <b dir="ltr">1,200,000</b>
              <span>{T.evBalanceNote}</span>
            </div>
          </div>
          <p>{T.evText}</p>
        </figure>
        <figure class="sk how-fig">
          <figcaption>{T.coreTitle}</figcaption>
          <div class="core-flow">
            <div class="sk core-box bg-apricot"><b>{T.core.t}</b><span>{T.core.d}</span></div>
            <div class="sk core-node"><b>{T.server.t}</b><span>{T.server.d}</span></div>
            <div class="sk core-node"><b>{T.app.t}</b><span>{T.app.d}</span></div>
          </div>
          <p>{T.coreText} <b>{T.coreTests}</b></p>
        </figure>
      </div>
    </div>
  </section>

  <!-- ─── THE DASHBOARD (shown once screenshots are listed above) ─── -->
  {DASHBOARD.length > 0 && (
    <section class="dm-sec bg-paper-2 dust">
      <div class="container">
        <div class="sec-head-row">
          <div><span class="eyebrow">{T.dashEyebrow}</span><h2 class="sec-h2">{T.dashHead}</h2></div>
          <p>{T.dashText}</p>
        </div>
        <figure class="shot-main">
          <WindowWidget src={DASHBOARD[0].src} alt={tx(DASHBOARD[0].alt)} chromeColor="sky-shader" sizes="(min-width: 1280px) 1120px, 100vw" />
          {DASHBOARD[0].caption && <figcaption>{tx(DASHBOARD[0].caption)}</figcaption>}
        </figure>
        {DASHBOARD.length > 1 && (
          <div class="shot-grid">
            {DASHBOARD.slice(1).map((s) => (
              <figure>
                <WindowWidget src={s.src} alt={tx(s.alt)} chromeColor="sky-shader" />
                {s.caption && <figcaption>{tx(s.caption)}</figcaption>}
              </figure>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- ─── IN THE FIELD (shown once phone screenshots are listed above) ─── -->
  {PHONE.length > 0 && (
    <section class="dm-sec bg-sky dust">
      <div class="container field-stack">
        <div class="field-text">
          <span class="eyebrow">{T.fieldEyebrow}</span>
          <h2 class="sec-h2">{T.fieldHead}</h2>
          <p>{T.fieldText}</p>
        </div>
        <div class="phone-row" style={`--n: ${Math.min(PHONE.length, 4)}`}>
          {PHONE.map((s) => (
            <figure>
              <PhoneFrame src={s.src} alt={tx(s.alt)} />
              {s.caption && <figcaption>{tx(s.caption)}</figcaption>}
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ─── PERMISSIONS: the four layers as nested boxes ─── -->
  <section class="dm-sec">
    <div class="container perm-grid">
      <figure class="nest">
        <div class="sk nest-box bg-lilac">
          <span class="eyebrow">{T.nest.wallet}</span>
          <div class="sk nest-box nest-inner bg-paper">
            <span class="eyebrow">{T.nest.team}</span>
            <div class="sk nest-box nest-inner bg-butter">
              <span class="eyebrow">{T.nest.group}</span>
              <div class="chips">
                {T.actions.map(([label, state]) => (
                  <span class:list={["chip", { "chip-on": state === true, "chip-off": state === null }]}>{label}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
        <figcaption>{T.actionsNote}</figcaption>
      </figure>
      <div class="perm-text">
        <span class="eyebrow">{T.permEyebrow}</span>
        <h2 class="sec-h2">{T.permHead}</h2>
        <ol class="perm-list">
          {T.permLayers.map((l) => <li><b>{l.t}</b> — {l.d}</li>)}
        </ol>
        <p class="muted">{T.permFooter}</p>
      </div>
    </div>
  </section>

  <!-- ─── SECURITY: servers that check each other ─── -->
  <section class="dm-sec board dm-dark">
    <div class="container sec-grid">
      <div>
        <span class="eyebrow">{T.secEyebrow}</span>
        <h2 class="sec-h2">{T.secHead}</h2>
        <p>{T.secBody}</p>
        <p class="mono-note">{T.secNote}</p>
      </div>
      <svg class="servers" viewBox="0 0 560 360" role="img" aria-label={T.secAria}>
        <path d="M140 90L420 90M140 90L280 280M420 90L280 280" fill="none" stroke="#a8b4ac" stroke-width="2.5" stroke-dasharray="2 9" stroke-linecap="round"></path>
        {[[80, 40], [360, 40], [220, 200]].map(([x, y]) => (
          <g>
            <rect x={x} y={y} width="120" height="100" rx="8" fill="#1d2320" stroke="#eceee6" stroke-width="2.5"></rect>
            <path d={`M${x + 20} ${y + 32}h80M${x + 20} ${y + 52}h80M${x + 20} ${y + 72}h50`} stroke="#46524c" stroke-width="6" stroke-linecap="round"></path>
            <rect x={x - 6} y={y + 108} width="132" height="30" rx="15" fill="#bfe6d6"></rect>
            <text x={x + 60} y={y + 128} text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="14" fill="#1f1f1f">a3f9…c2</text>
          </g>
        ))}
      </svg>
    </div>
  </section>

  <!-- ─── GOING LIVE: what happened, step by step, and why; then delivery ─── -->
  <section class="dm-sec">
    <div class="container">
      <div class="live-head">
        <div><span class="eyebrow">{T.liveEyebrow}</span><h2 class="sec-h2">{T.liveHead}</h2></div>
        <div class="sk why bg-butter"><b>{T.whyTitle}</b><span>{T.whyBody}</span></div>
      </div>
      <ol class="steps">
        {T.steps.map((s, i) => (
          <li><span class="step-n">{i + 1}</span><b>{s.t}</b><span>{s.d}</span></li>
        ))}
      </ol>
      <div class="tracks" aria-hidden="true">
        <div class="track track-old"><span>{T.trackOld}</span></div>
        <div class="track-retired"><span>{T.trackRetired}</span></div>
        <div class="track-fallback">
          <svg width="40" height="44" viewBox="0 0 40 44"><path d="M20 40V8M12 16l8-8l8 8" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="1 6"></path></svg>
          <span>{T.trackFallback}</span>
        </div>
        <div class="track track-new"><span>{T.trackNew}</span></div>
      </div>
      <span class="eyebrow timeline-label">{T.timelineLabel}</span>
      <ol class="timeline">
        {T.timeline.map((t, i) => (
          <li><span class:list={["dot", `dot-${i}`]}></span><b>{t.t}</b><span>{t.d}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ─── WHAT THE CLIENT GOT ─── -->
  <section class="dm-sec bg-paper-2 dust">
    <div class="container">
      <span class="eyebrow">{T.outEyebrow}</span>
      <h2 class="sec-h2">{T.outHead}</h2>
      <ul class="outcomes">
        {T.outcomes.map((o) => (
          <li>
            <svg class="ico" width="36" height="36" viewBox="0 0 32 32" aria-hidden="true" set:html={ICONS[o.icon]}></svg>
            <span><b>{o.t}</b><span>{o.d}</span></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ─── FOR DEVELOPERS (the footer below is the call to action) ─── -->
  <section class="dm-sec dm-dev">
    <div class="container dev-grid">
      <div>
        <span class="eyebrow">{T.devLabel}</span>
        <ul class="tech">{T.tech.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div class="sk os-card">
        <svg width="34" height="34" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.4-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5a3.9 3.9 0 0 1 1-2.7 3.6 3.6 0 0 1 .1-2.7s.8-.3 2.8 1a9.6 9.6 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7a3.9 3.9 0 0 1 1 2.7c0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10 10 0 0 0 12 2z" fill="currentColor"></path></svg>
        <span><b>{T.osTitle}</b><span>{T.osText}</span></span>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .container {
    max-width: var(--k-max);
    margin: 0 auto;
    padding: 0 var(--k-gutter-desktop);
  }

  /* ─── Shared pieces ─── */
  .eyebrow {
    display: block;
    font-family: var(--k-font-mono);
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #4a4a4a;
  }
  .sec-h2 { margin: 14px 0 0; font-size: clamp(30px, 3.4vw, 44px); line-height: 1.15; }
  .big-h2 { margin: 0; font-size: clamp(44px, 5vw, 64px); line-height: 1.04; letter-spacing: -0.02em; }
  .dm-lead { margin: 0; font-size: clamp(19px, 1.8vw, 24px); line-height: 1.4; font-weight: 600; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 12px;
    border: 2px solid var(--k-ink);
    border-radius: 999px;
    background: var(--k-paper);
    font-size: 14px;
    font-weight: 600;
  }
  .ico { fill: none; stroke: var(--k-ink); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
  .muted { color: var(--k-ink-muted); }
  .dm-sec { padding: 96px 0; border-top: 2px solid var(--k-ink); }
  .dm-dark { color: var(--k-chalk); }
  .dm-dark .eyebrow { color: #a8b4ac; }
  .dm-dark .sec-h2 { color: var(--k-chalk); }

  /* ─── Hero + facts ─── */
  .dm-hero { padding: 64px 0 72px; }
  .dm-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr); }
  .dm-hero-grid.has-stage { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 56px; align-items: center; }
  .dm-hero-text { display: flex; flex-direction: column; gap: 20px; max-width: 760px; }
  .dm-hero h1 { margin: 0; font-size: clamp(48px, 6vw, 80px); line-height: 1; letter-spacing: -0.03em; }
  .dm-sub { margin: 0; font-size: 17px; line-height: 1.65; color: #2b3238; }
  .dm-stage { position: relative; min-height: 460px; }
  .dm-stage-win { width: 88%; }
  .dm-stage :global(.dm-stage-phone) { position: absolute; inset-inline-end: 0; bottom: 0; width: 30%; max-width: 200px; }

  /* Four equal columns inside the page width; the strip's own background
     and top/bottom lines still run edge to edge. */
  .dm-facts {
    margin: 0;
    padding-inline: calc(max(0px, (100vw - var(--k-max)) / 2) + var(--k-gutter-desktop));
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 2px solid var(--k-ink);
  }
  .dm-facts > div {
    padding: 28px 28px 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .dm-facts > div:first-child { padding-inline-start: 0; }
  .dm-facts > div:last-child { padding-inline-end: 0; }
  .dm-facts > div + div { border-inline-start: 2px solid var(--k-ink); }
  .dm-facts dt { font-family: var(--k-font-mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: #33404a; }
  .dm-facts dd { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .fact-value { font-family: var(--k-font-serif); font-size: clamp(28px, 2.6vw, 38px); line-height: 1.1; font-weight: 700; }
  .fact-note { font-size: 15px; line-height: 1.5; color: #2b3238; }

  /* ─── Problem ─── */
  .dm-problem { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 72px; }
  .dm-problem-text { display: flex; flex-direction: column; gap: 20px; }
  .dm-problem-text p:not(.dm-lead) { margin: 0; font-size: 17px; line-height: 1.7; }
  .dm-asks { display: flex; flex-direction: column; gap: 16px; }
  .ask-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .ask { padding: 24px; display: flex; flex-direction: column; gap: 12px; }
  .ask b { font-size: 19px; }
  .ask span { font-size: 15px; line-height: 1.55; }

  /* ─── Discovery ─── */
  .dm-quote {
    margin: 18px 0 48px;
    max-width: 980px;
    font-family: var(--k-font-serif);
    font-size: clamp(30px, 3.6vw, 50px);
    line-height: 1.16;
    font-weight: 600;
    color: var(--k-butter);
  }
  .data-compare { display: grid; grid-template-columns: minmax(0, 1fr) 90px minmax(0, 1fr); align-items: center; }
  .data-compare figure { margin: 0; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .data-compare p { margin: 0; font-size: 15px; color: #a8b4ac; }
  .data-arrow { color: var(--k-butter); }
  :global(html[dir="rtl"]) .data-arrow { transform: scaleX(-1); }
  .data-box { margin: 0; padding: 0; list-style: none; border: 2px solid var(--k-chalk); border-radius: 8px; overflow: hidden; font-family: var(--k-font-mono); font-size: 14px; }
  .data-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 12px 18px; }
  .data-row + .data-row { border-top: 1px solid #46524c; }
  .data-head { color: #a8b4ac; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; border-bottom: 2px solid var(--k-chalk); }
  .data-row s { color: #a8b4ac; }
  .data-event { grid-template-columns: minmax(0, 1fr) auto auto; }
  .amt.plus { color: var(--k-mint); }
  .amt.minus { color: var(--k-peach); }

  /* ─── How it works ─── */
  .how-grid { margin-top: 40px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; }
  .how-fig { margin: 0; padding: 32px; background: var(--k-paper); display: flex; flex-direction: column; gap: 22px; }
  .how-fig figcaption { font-size: 20px; font-weight: 700; }
  .how-fig p { margin: 0; font-size: 16px; line-height: 1.6; }
  .ev-flow { display: grid; grid-template-columns: minmax(0, 1fr) 60px minmax(0, 170px); align-items: center; }
  .ev-list { display: flex; flex-direction: column; gap: 8px; }
  .ev-item { padding: 8px 12px; border: 2px solid var(--k-ink); border-radius: 6px; background: #fff; font-family: var(--k-font-mono); font-size: 13px; }
  :global(html[dir="rtl"]) .ev-arrow { transform: scaleX(-1); }
  .ev-balance { padding: 16px; display: flex; flex-direction: column; gap: 4px; text-align: center; }
  .ev-balance .eyebrow { font-size: 11px; }
  .ev-balance b { font-family: var(--k-font-serif); font-size: 28px; }
  .ev-balance span:last-child { font-size: 12px; }
  .core-flow { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 24px; }
  .core-box { grid-column: 1 / 3; justify-self: center; padding: 14px 22px; text-align: center; display: flex; flex-direction: column; }
  .core-node { padding: 14px; background: #fff; box-shadow: none; text-align: center; display: flex; flex-direction: column; }
  .core-flow span { font-size: 13px; }


---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { currentLocale, localizedHref } from "../../lib/i18n";

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const isAr = locale === "ar";
const L = (href: string) => localizedHref(href, locale);

const T = isAr ? {
  title:       "أعمالنا — كليم",
  description: "مشاريع تحرير وتحديث رقمي من كليم — استخراج البيانات وإعادة البناء الحديثة.",
  eyebrow:     "الأعمال",
  h1:          "من موقع ورّاث إلى منصة حديثة متحررة.",
  lede:        "كل مشروع نُنجزه يثبت أن الانتقال من النظام القديم إلى الحديث ممكن بدون فقدان البيانات أو الوقت. إليك قصة عيادة الإمران.",
  moreSoon:    "مشاريع إضافية قادمة — مع موافقة العملاء على مشاركة قصصهم.",
  readCase:    "اقرأ القصة الكاملة →",
} : {
  title:       "Work — Kaleem",
  description: "Digital liberation and modernization projects from Kaleem — data extraction and platform rebuilds.",
  eyebrow:     "Work",
  h1:          "From legacy websites to liberated, modern platforms.",
  lede:        "Every project we complete proves that migration from old systems to modern ones is possible without data loss or downtime. Here's the story of Al Imran Clinic.",
  moreSoon:    "More case studies coming — as clients approve sharing their stories.",
  readCase:    "Read the full story →",
};

const cases = isAr ? [
  {
    title: "عيادة الإمام، البصرة",
    summary: "استخراج 600 مقالة من موقع WordPress قديم، تنظيفها وإعادة تنسيقها، وإعادة البناء على Astro مع Cloudflare Workers. النتيجة: موقع بـ 97/100 PageSpeed، بيانات تحت سيطرة العيادة، وحرية حقيقية للتطوير والصيانة.",
    tags: ["استخراج البيانات", "تحديث الويب", "البنية المفتوحة"],
    tagBg: ["tag-butter", "tag-sky", "tag-mint"],
    href: "/ar/contact/",
    accent: "bg-lilac",
  },
] : [
  {
    title: "Al Imran Clinic, Basra",
    summary: "Extracted 600 articles from a legacy WordPress site, cleaned and reformatted the data, rebuilt on Astro with Cloudflare Workers. Result: a 97/100 PageSpeed site, data under clinic control, bilingual support, and true freedom to develop and maintain.",
    tags: ["Data extraction", "Web modernization", "Open infrastructure"],
    tagBg: ["tag-butter", "tag-sky", "tag-mint"],
    href: "/en/contact/",
    accent: "bg-lilac",
  },
];
---

<BaseLayout title={T.title} description={T.description}>
  <section class="work-hero bg-sky">
    <div class="container">
      <span class="eyebrow">{T.eyebrow}</span>
      <h1 class="work-h1">{T.h1}</h1>
      <p class="work-lede">{T.lede}</p>
    </div>
  </section>

  <section class="work-list">
    <div class="container">
      <div class="cases-grid">
        {cases.map((c) => (
          <article class={`sk case-card ${c.accent}`}>
            <div class="case-body">
              <h2>{c.title}</h2>
              <p>{c.summary}</p>
              <div class="case-tags">
                {c.tags.map((t, i) => (
                  <span class={`k-tag ${c.tagBg[i]}`}>{t}</span>
                ))}
              </div>
            </div>
            <a class="skb skb-paper" href={c.href}>{T.readCase}</a>
          </article>
        ))}
        <div class="soon">{T.moreSoon}</div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: var(--k-max);
    margin: 0 auto;
    padding: 0 var(--k-gutter-desktop);
  }

  .work-hero {
    padding: var(--k-space-10) 0 var(--k-space-11);
    text-align: center;
  }

  .eyebrow {
    display: inline-block;
    font-family: var(--k-font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--k-ink-muted);
    margin-bottom: var(--k-space-4);
  }

  .work-h1 {
    margin: 0 auto var(--k-space-5);
    max-width: 20ch;
    font-size: clamp(36px, 6vw, 64px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--k-ink);
    font-weight: 700;
  }

  .work-lede {
    margin: 0 auto;
    max-width: 56ch;
    font-size: 19px;
    line-height: 1.65;
    color: var(--k-ink-muted);
  }

  .work-list {
    padding: var(--k-space-10) 0 var(--k-space-11);
  }

  .cases-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--k-space-7);
    max-width: 900px;
    margin: 0 auto;
  }

  .case-card {
    display: flex;
    flex-direction: column;
    gap: var(--k-space-6);
  }

  .case-body h2 {
    margin: 0;
    font-size: clamp(24px, 3.4vw, 34px);
    color: var(--k-ink);
  }

  .case-body p {
    color: var(--k-ink);
    font-size: 17px;
    line-height: 1.6;
    max-width: 60ch;
  }

  .case-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .k-tag {
    background: var(--k-paper);
  }

  .tag-butter { background: var(--k-butter); }
  .tag-sky    { background: var(--k-sky); }
  .tag-apricot{ background: var(--k-apricot); }
  .tag-mint   { background: var(--k-mint); }
  .tag-lilac  { background: var(--k-lilac); }
  .tag-peach  { background: var(--k-peach); }

  .case-card .skb {
    align-self: flex-start;
  }

  .soon {
    text-align: center;
    color: var(--k-ink-muted);
    font-family: var(--k-font-mono);
    font-size: 14px;
    letter-spacing: 0.05em;
    padding: var(--k-space-6) 0;
  }

  @media (max-width: 672px) {
    .container { padding: 0 var(--k-gutter-mobile); }
    .work-hero,
    .work-list { padding: var(--k-space-8) 0; }
  }
</style>

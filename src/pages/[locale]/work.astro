---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Image from "../../components/Image.astro";
import PageHero from "../../components/PageHero.astro";
import { currentLocale, localizedHref } from "../../lib/i18n";

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const isAr = locale === "ar";
const L = (href: string) => localizedHref(href, locale);

const T = isAr ? {
  title:       "أعمالنا — كليم",
  description: "مشاريع كليم في تحرير البيانات والتحديث الرقمي: استخراج البيانات وإعادة بناء المنصات.",
  eyebrow:     "الأعمال",
  h1:          "من مواقع قديمة إلى منصات حديثة ومتحرّرة.",
  lede:        "كل مشروع ننجزه يثبت أن الانتقال من نظام قديم إلى نظام حديث ممكن دون فقدان البيانات أو توقّف العمل. إليك قصة مركز العمران الطبي.",
  moreSoon:    "المزيد من دراسات الحالة قريباً — حين يوافق عملاؤنا على مشاركة قصصهم.",
  readCase:    "اقرأ القصة كاملة ←",
  nextTitle:   "مشروعك التالي",
  nextCta:     "احجز تقييماً مجانياً",
} : {
  title:       "Work — Kaleem",
  description: "Digital liberation and modernization projects from Kaleem — data extraction and platform rebuilds.",
  eyebrow:     "Work",
  h1:          "From legacy websites to liberated, modern platforms.",
  lede:        "Every project we complete proves that migration from old systems to modern ones is possible without data loss or downtime. Here's the story of Alimran Medical Center.",
  moreSoon:    "More case studies coming — as clients approve sharing their stories.",
  readCase:    "Read the full story →",
  nextTitle:   "Your project next",
  nextCta:     "Book a free audit",
};

const cases = isAr ? [
  {
    title: "مركز العمران الطبي، البصرة",
    summary: "استخرجنا 600 مقالة من موقع WordPress قديم، ونظّفناها وأعدنا تنسيقها، ثم أعدنا بناء الموقع على Astro وCloudflare Workers. النتيجة: موقع يحصل على 97/100 في PageSpeed، وبيانات بيد المركز بالكامل، وحرية حقيقية في التطوير والصيانة.",
    tags: ["استخراج البيانات", "تحديث الويب", "بنية مفتوحة"],
    tagBg: ["tag-butter", "tag-sky", "tag-mint"],
    href: "/ar/al-imran/",
    image: "/assets/illustrations/alimran-clinic-homepage.png",
    imageAlt: "الموقع الجديد لمركز العمران الطبي",
    accent: "bg-lilac",
  },
] : [
  {
    title: "Alimran Medical Center, Basra",
    summary: "We extracted 600 articles from a legacy WordPress site, cleaned and reformatted them, then rebuilt the site on Astro and Cloudflare Workers. The result: a site that scores 97/100 on PageSpeed, full Arabic and English support, data in the center's own hands, and real freedom to develop and maintain it.",
    tags: ["Data extraction", "Web modernization", "Open infrastructure"],
    tagBg: ["tag-butter", "tag-sky", "tag-mint"],
    href: "/en/al-imran/",
    image: "/assets/illustrations/alimran-clinic-homepage.png",
    imageAlt: "The new Alimran Medical Center website",
    accent: "bg-lilac",
  },
];
---

<BaseLayout title={T.title} description={T.description}>
  <PageHero eyebrow={T.eyebrow} title={T.h1}>
    <p>{T.lede}</p>
  </PageHero>

  <!-- ─── GALLERY: every project as a tile (screenshot, story, tags), then
       a dashed "your project next" tile. New case studies are new tiles.
       Idea for later (docs/notes.md): once there are enough projects, the
       hero shows the best one and this gallery holds the rest. ─── -->
  <section class="work-list">
    <div class="container">
      <div class="cases-grid">
        {cases.map((c) => (
          <a class="sk case-card window-link" href={c.href}>
            <span class="case-chrome" data-sky aria-hidden="true"><i></i><i></i><i></i></span>
            <Image src={c.image} alt={c.imageAlt} class="case-shot" sizes="(min-width: 900px) 50vw, 100vw" loading="eager" fetchpriority="high" />
            <span class="case-body">
              <h2>{c.title}</h2>
              <p>{c.summary}</p>
              <span class="case-tags">
                {c.tags.map((t, i) => (
                  <span class={`k-tag ${c.tagBg[i]}`}>{t}</span>
                ))}
              </span>
              <span class="case-more">{T.readCase}</span>
            </span>
          </a>
        ))}
        <a class="sk case-next" href={L("/audit/")}>
          <svg width="44" height="44" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 7v18M7 16h18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path></svg>
          <span class="next-title">{T.nextTitle}</span>
          <span class="next-text">{T.moreSoon}</span>
          <span class="next-link">{T.nextCta}</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: var(--k-max);
    margin: 0 auto;
    padding: 0 var(--k-gutter-desktop);
  }

  .work-list { padding: 72px 0 96px; }

  .cases-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 40px;
    align-items: stretch;
  }

  /* A project tile: screenshot on top, the story underneath. */
  .case-card {
    padding: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--k-paper);
    color: var(--k-ink);
    text-decoration: none;
  }
  /* The window parts sit flush: no inherited flow spacing between them. */
  .case-card > :global(*) { margin: 0; }
  .case-chrome {
    height: 34px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 14px;
    border-bottom: 2px solid var(--k-ink);
  }
  .case-chrome i { width: 11px; height: 11px; border-radius: 50%; background: var(--k-peach); }
  .case-chrome i:nth-child(2) { background: var(--k-butter); }
  .case-chrome i:nth-child(3) { background: var(--k-mint); }
  .case-card :global(.case-shot) {
    display: block;
    width: 100%;
    height: 340px;
    object-fit: cover;
    object-position: top;
    border-bottom: 2px solid var(--k-ink);
  }
  .case-body { display: flex; flex-direction: column; gap: 14px; padding: 26px 28px 28px; }
  .case-body h2 { margin: 0; font-size: clamp(24px, 2.6vw, 32px); color: var(--k-ink); }
  .case-body p { margin: 0; font-size: 16px; line-height: 1.6; }
  .case-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .k-tag { background: var(--k-paper); }
  .tag-butter { background: var(--k-butter); }
  .tag-sky    { background: var(--k-sky); }
  .tag-mint   { background: var(--k-mint); }
  .case-more {
    margin-top: 4px;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
  }

  /* The empty slot for the next project. */
  .case-next {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 40px 32px;
    text-align: center;
    border-style: dashed;
    box-shadow: none;
    background: transparent;
    color: var(--k-ink);
    text-decoration: none;
  }
  .next-title { font-family: var(--k-font-serif); font-size: 30px; font-weight: 700; }
  .next-text { max-width: 30ch; font-size: 16px; line-height: 1.6; color: var(--k-ink-muted); }
  .next-link { margin-top: 6px; font-weight: 600; text-decoration: underline; text-underline-offset: 5px; }
  .case-next:hover { background: color-mix(in srgb, var(--k-paper) 70%, transparent); }
  .case-next:hover .next-link { text-decoration-color: var(--k-sky); }

  @media (max-width: 900px) {
    .cases-grid { grid-template-columns: minmax(0, 1fr); gap: 28px; }
  }
  @media (max-width: 672px) {
    .container { padding: 0 var(--k-gutter-mobile); }
    .work-list { padding: 40px 0 64px; }
    .case-card :global(.case-shot) { height: 240px; }
    .case-body { padding: 20px; }
    .case-next { padding: 32px 20px; }
  }
</style>

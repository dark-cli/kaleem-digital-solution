---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Image from "../../components/Image.astro";
import { currentLocale, localizedHref } from "../../lib/i18n";

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const isAr = locale === "ar";
const L = (href: string) => localizedHref(href, locale);

const T = isAr ? {
  title:       "أعمالنا — كليم",
  description: "مشاريع كليم في تحرير البيانات والتحديث الرقمي: استخراج البيانات وإعادة بناء المنصات.",
  eyebrow:     "الأعمال",
  h1:          "من مواقع قديمة إلى منصات حديثة ومتحرّرة.",
  lede:        "كل مشروع ننجزه يثبت أن الانتقال من نظام قديم إلى نظام حديث ممكن دون فقدان البيانات أو توقّف العمل. إليك قصة مركز العمران الطبي.",
  moreSoon:    "المزيد من دراسات الحالة قريباً — حين يوافق عملاؤنا على مشاركة قصصهم.",
  readCase:    "اقرأ القصة كاملة ←",
  heroCta:     "اقرأ قصة مركز العمران",
  nextTitle:   "مشروعك التالي",
  nextCta:     "احجز تقييماً مجانياً",
  caseTag:     "موقع · نقل بيانات",
} : {
  title:       "Work — Kaleem",
  description: "Digital liberation and modernization projects from Kaleem — data extraction and platform rebuilds.",
  eyebrow:     "Work",
  h1:          "From legacy websites to liberated, modern platforms.",
  lede:        "Every project we complete proves that migration from old systems to modern ones is possible without data loss or downtime. Here's the story of Alimran Medical Center.",
  moreSoon:    "More case studies coming — as clients approve sharing their stories.",
  readCase:    "Read the full story →",
  heroCta:     "Read the Alimran story",
  nextTitle:   "Your project next",
  nextCta:     "Book a free audit",
  caseTag:     "Website · Migration",
};

const cases = isAr ? [
  {
    title: "مركز العمران الطبي، البصرة",
    summary: "استخرجنا 600 مقالة من موقع WordPress قديم، ونظّفناها وأعدنا تنسيقها، ثم أعدنا بناء الموقع على Astro وCloudflare Workers. النتيجة: موقع يحصل على 97/100 في PageSpeed، وبيانات بيد المركز بالكامل، وحرية حقيقية في التطوير والصيانة.",
    tags: ["استخراج البيانات", "تحديث الويب", "بنية مفتوحة"],
    tagBg: ["tag-butter", "tag-sky", "tag-mint"],
    href: "/ar/al-imran/",
    accent: "bg-lilac",
  },
] : [
  {
    title: "Alimran Medical Center, Basra",
    summary: "We extracted 600 articles from a legacy WordPress site, cleaned and reformatted them, then rebuilt the site on Astro and Cloudflare Workers. The result: a site that scores 97/100 on PageSpeed, full Arabic and English support, data in the center's own hands, and real freedom to develop and maintain it.",
    tags: ["Data extraction", "Web modernization", "Open infrastructure"],
    tagBg: ["tag-butter", "tag-sky", "tag-mint"],
    href: "/en/al-imran/",
    accent: "bg-lilac",
  },
];
---

<BaseLayout title={T.title} description={T.description}>
  <!-- ─── HERO: the promise on one side, the work itself on the other.
       The featured project overlaps a dashed "your project next" card,
       which becomes a stack as more case studies are added. ─── -->
  <section class="wk-hero bg-sky">
    <div class="container wk-grid">
      <div class="wk-text">
        <span class="wk-eyebrow">{T.eyebrow}</span>
        <h1>{T.h1}</h1>
        <p>{T.lede}</p>
        <a class="skb skb-butter" href={L("/al-imran/")}>{T.heroCta}</a>
      </div>
      <div class="wk-stack">
        <a class="wk-next sk" href={L("/audit/")}>
          <svg width="44" height="44" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 7v18M7 16h18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path></svg>
          <span class="wk-next-title">{T.nextTitle}</span>
          <span class="wk-next-link">{T.nextCta}</span>
        </a>
        <a class="wk-feature sk window window-link" href={L("/al-imran/")}>
          <span class="wk-chrome" data-sky aria-hidden="true"><i></i><i></i><i></i></span>
          <Image src="/assets/illustrations/alimran-clinic-homepage.png" alt={isAr ? "الموقع الجديد لمركز العمران الطبي" : "The new Alimran Medical Center website"} sizes="(min-width: 900px) 40vw, 100vw" loading="eager" fetchpriority="high" />
          <span class="wk-caption">
            <b>{isAr ? "مركز العمران الطبي" : "Alimran Medical Center"}</b>
            <span>{T.caseTag}</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="work-list">
    <div class="container">
      <div class="cases-grid">
        {cases.map((c) => (
          <article class={`sk case-card ${c.accent}`}>
            <div class="case-body">
              <h2>{c.title}</h2>
              <p>{c.summary}</p>
              <div class="case-tags">
                {c.tags.map((t, i) => (
                  <span class={`k-tag ${c.tagBg[i]}`}>{t}</span>
                ))}
              </div>
            </div>
            <a class="skb skb-paper" href={c.href}>{T.readCase}</a>
          </article>
        ))}
        <div class="soon">{T.moreSoon}</div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: var(--k-max);
    margin: 0 auto;
    padding: 0 var(--k-gutter-desktop);
  }





  /* ─── Hero ─── */
  .wk-hero { padding: 72px 0; border-bottom: 2px solid var(--k-ink); }
  .wk-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 72px;
    align-items: center;
  }
  .wk-text { display: flex; flex-direction: column; align-items: flex-start; gap: 22px; }
  .wk-eyebrow {
    font-family: var(--k-font-mono);
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #33404a;
  }
  .wk-text h1 { margin: 0; font-size: clamp(40px, 4vw, 56px); line-height: 1.07; letter-spacing: -0.02em; }
  .wk-text p { margin: 0; max-width: 470px; font-size: 18px; line-height: 1.6; color: #2b3238; }

  .wk-stack { position: relative; min-height: 650px; }
  .wk-feature {
    position: relative;
    z-index: 1;
    display: block;
    width: 76%;
    background: #fff;
    overflow: hidden;
    text-decoration: none;
    rotate: -1.5deg;
  }
  .wk-chrome {
    height: 34px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 14px;
    border-bottom: 2px solid var(--k-ink);
    background: var(--k-board);
  }
  .wk-chrome i { width: 11px; height: 11px; border-radius: 50%; background: var(--k-peach); }
  .wk-chrome i:nth-child(2) { background: var(--k-butter); }
  .wk-chrome i:nth-child(3) { background: var(--k-mint); }
  .wk-feature :global(img) { display: block; width: 100%; height: 380px; object-fit: cover; object-position: top; }
  .wk-caption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-top: 2px solid var(--k-ink);
    background: var(--k-paper);
    font-size: 17px;
    color: var(--k-ink);
  }
  .wk-caption span { font-family: var(--k-font-mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: #4a4a4a; }

  .wk-next {
    position: absolute;
    inset-inline-end: 0;
    /* Tucked behind the featured window; its message sits in the part
       that shows below it. */
    top: 205px;
    width: 50%;
    height: 440px;
    rotate: 4deg;
    padding: 0 28px 34px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: flex-end;
    text-align: end;
    gap: 10px;
    border-style: dashed;
    box-shadow: none;
    background: var(--k-paper);
    color: var(--k-ink);
    text-decoration: none;
  }
  .wk-next-title { font-family: var(--k-font-serif); font-size: 28px; font-weight: 700; }
  .wk-next-link { font-weight: 600; text-decoration: underline; text-underline-offset: 5px; }
  .wk-next:hover .wk-next-link { text-decoration-color: var(--k-sky); }

  @media (max-width: 900px) {
    .wk-grid { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .wk-stack { min-height: 0; display: flex; flex-direction: column; gap: 20px; }
    .wk-feature { width: 100%; rotate: none; }
    .wk-feature :global(img) { height: 300px; }
    .wk-next { position: static; width: 100%; height: auto; padding: 28px; rotate: none; align-items: center; text-align: center; }
  }
  @media (max-width: 672px) {
    .wk-hero { padding: 44px 0 56px; }
  }

  .work-list {
    padding: var(--k-space-10) 0 var(--k-space-11);
  }

  .cases-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--k-space-7);
    max-width: 900px;
    margin: 0 auto;
  }

  .case-card {
    display: flex;
    flex-direction: column;
    gap: var(--k-space-6);
  }

  .case-body h2 {
    margin: 0;
    font-size: clamp(24px, 3.4vw, 34px);
    color: var(--k-ink);
  }

  .case-body p {
    color: var(--k-ink);
    font-size: 17px;
    line-height: 1.6;
    max-width: 60ch;
  }

  .case-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .k-tag {
    background: var(--k-paper);
  }

  .tag-butter { background: var(--k-butter); }
  .tag-sky    { background: var(--k-sky); }
  .tag-apricot{ background: var(--k-apricot); }
  .tag-mint   { background: var(--k-mint); }
  .tag-lilac  { background: var(--k-lilac); }
  .tag-peach  { background: var(--k-peach); }

  .case-card .skb {
    align-self: flex-start;
  }

  .soon {
    text-align: center;
    color: var(--k-ink-muted);
    font-family: var(--k-font-mono);
    font-size: 14px;
    letter-spacing: 0.05em;
    padding: var(--k-space-6) 0;
  }

  @media (max-width: 672px) {
    .container { padding: 0 var(--k-gutter-mobile); }
    .work-list { padding: var(--k-space-8) 0; }
  }
</style>

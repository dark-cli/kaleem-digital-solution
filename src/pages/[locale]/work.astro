---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { currentLocale, localizedHref } from "../../lib/i18n";

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const isAr = locale === "ar";
const L = (href: string) => localizedHref(href, locale);

const T = isAr ? {
  title:       "أعمالنا — كليم",
  description: "مشاريع منازل ومكاتب ذكية من كليم — منظومات مصمّمة ومركّبة في البصرة وبغداد.",
  eyebrow:     "الأعمال",
  h1:          "من الشقّة الأولى إلى منظومات بحجم الفيلا.",
  lede:        "كل مشروع نقوم به يُطوّر منظومتنا. هذه لمحة عن الأنواع التي نُركّبها — دراسات حالة تفصيلية قادمة قريباً.",
  moreSoon:    "دراسات حالة مفصّلة قادمة قريباً — سنُشاركها بإذن أصحابها.",
  readCase:    "اطلب مزيداً من التفاصيل →",
} : {
  title:       "Work — Kaleem",
  description: "Smart home and office installs from Kaleem — systems designed and installed in Basra and Baghdad.",
  eyebrow:     "Work",
  h1:          "From one apartment to full-villa systems.",
  lede:        "Every install teaches us something and improves the platform. Here's a snapshot of what we build. Detailed case studies are coming as clients agree to share.",
  moreSoon:    "Detailed case studies coming soon — with each owner's permission.",
  readCase:    "Ask for more detail →",
};

const cases = isAr ? [
  {
    title: "شقة بغداد — النموذج الأول",
    summary: "المشروع الذي بدأت به كليم: شقة صغيرة تحوّلت إلى مختبر حي لبناء أول مساعد صوتي يفهم اللهجة العراقية، ومنظومة إضاءة ومناخ متكاملة تعمل معه.",
    tags: ["المساعد الصوتي", "منزل سكني", "بحث وتطوير"],
    tagBg: ["tag-butter", "tag-sky", "tag-mint"],
    href: "/ar/contact/",
    accent: "bg-lilac",
  },
  {
    title: "فيلا سكنية — البصرة",
    summary: "منظومة كاملة لفيلا كبيرة: إضاءة ذكية في كل الغرف، تحكم بالمكيّفات المركزية، كاميرات مراقبة متكاملة، وسيناريوهات صوتية لكل غرفة — كلها بالعربية والإنكليزية.",
    tags: ["منزل سكني", "أمان", "تصميم مخصص"],
    tagBg: ["tag-sky", "tag-apricot", "tag-peach"],
    href: "/ar/contact/",
    accent: "bg-mint",
  },
  {
    title: "مقاهي ومكاتب — أتمتة تجارية",
    summary: "أنظمة إضاءة وتحكم بيئي تعمل على جداول أسبوعية، مع أوامر صوتية للمدراء، ولوحة تحكم مركزية للفريق — تركيب سريع وصيانة بمعقولية شهرية.",
    tags: ["أتمتة تجارية", "المكاتب", "الدعم"],
    tagBg: ["tag-apricot", "tag-butter", "tag-sky"],
    href: "/ar/contact/",
    accent: "bg-peach",
  },
] : [
  {
    title: "Baghdad apartment — the prototype",
    summary: "The project Kaleem started with: a small apartment turned into a live lab for building the first voice assistant that actually understands the Iraqi dialect, plus integrated lighting and climate to talk to.",
    tags: ["Voice assistant", "Residential", "R&D"],
    tagBg: ["tag-butter", "tag-sky", "tag-mint"],
    href: "/en/contact/",
    accent: "bg-lilac",
  },
  {
    title: "Residential villa — Basra",
    summary: "A full ecosystem for a large villa: smart lighting throughout, central-AC control, integrated surveillance, and voice scenes per room — bilingual Arabic/English.",
    tags: ["Residential", "Security", "Bespoke"],
    tagBg: ["tag-sky", "tag-apricot", "tag-peach"],
    href: "/en/contact/",
    accent: "bg-mint",
  },
  {
    title: "Cafés & offices — commercial automation",
    summary: "Lighting and climate on weekly schedules, voice control for managers, and a single dashboard for the operations team — quick install, sensible monthly support.",
    tags: ["Commercial", "Office", "Support"],
    tagBg: ["tag-apricot", "tag-butter", "tag-sky"],
    href: "/en/contact/",
    accent: "bg-peach",
  },
];
---

<BaseLayout title={T.title} description={T.description}>
  <section class="work-hero bg-sky">
    <div class="container">
      <span class="eyebrow">{T.eyebrow}</span>
      <h1 class="work-h1">{T.h1}</h1>
      <p class="work-lede">{T.lede}</p>
    </div>
  </section>

  <section class="work-list">
    <div class="container">
      <div class="cases-grid">
        {cases.map((c) => (
          <article class={`sk case-card ${c.accent}`}>
            <div class="case-body">
              <h2>{c.title}</h2>
              <p>{c.summary}</p>
              <div class="case-tags">
                {c.tags.map((t, i) => (
                  <span class={`k-tag ${c.tagBg[i]}`}>{t}</span>
                ))}
              </div>
            </div>
            <a class="skb skb-paper" href={c.href}>{T.readCase}</a>
          </article>
        ))}
        <div class="soon">{T.moreSoon}</div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: var(--k-max);
    margin: 0 auto;
    padding: 0 var(--k-gutter-desktop);
  }

  .work-hero {
    padding: var(--k-space-10) 0 var(--k-space-11);
    text-align: center;
  }

  .eyebrow {
    display: inline-block;
    font-family: var(--k-font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--k-ink-muted);
    margin-bottom: var(--k-space-4);
  }

  .work-h1 {
    margin: 0 auto var(--k-space-5);
    max-width: 20ch;
    font-size: clamp(36px, 6vw, 64px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--k-ink);
    font-weight: 700;
  }

  .work-lede {
    margin: 0 auto;
    max-width: 56ch;
    font-size: 19px;
    line-height: 1.65;
    color: var(--k-ink-muted);
  }

  .work-list {
    padding: var(--k-space-10) 0 var(--k-space-11);
  }

  .cases-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--k-space-7);
    max-width: 900px;
    margin: 0 auto;
  }

  .case-card {
    display: flex;
    flex-direction: column;
    gap: var(--k-space-6);
  }

  .case-body h2 {
    margin: 0;
    font-size: clamp(24px, 3.4vw, 34px);
    color: var(--k-ink);
  }

  .case-body p {
    color: var(--k-ink);
    font-size: 17px;
    line-height: 1.6;
    max-width: 60ch;
  }

  .case-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .k-tag {
    background: var(--k-paper);
  }

  .tag-butter { background: var(--k-butter); }
  .tag-sky    { background: var(--k-sky); }
  .tag-apricot{ background: var(--k-apricot); }
  .tag-mint   { background: var(--k-mint); }
  .tag-lilac  { background: var(--k-lilac); }
  .tag-peach  { background: var(--k-peach); }

  .case-card .skb {
    align-self: flex-start;
  }

  .soon {
    text-align: center;
    color: var(--k-ink-muted);
    font-family: var(--k-font-mono);
    font-size: 14px;
    letter-spacing: 0.05em;
    padding: var(--k-space-6) 0;
  }

  @media (max-width: 672px) {
    .container { padding: 0 var(--k-gutter-mobile); }
    .work-hero,
    .work-list { padding: var(--k-space-8) 0; }
  }
</style>

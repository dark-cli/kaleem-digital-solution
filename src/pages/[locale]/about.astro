---
import BaseLayout from "../../layouts/BaseLayout.astro";
import KaleemLogo from "../../components/KaleemLogo.astro";
import { currentLocale } from "../../lib/i18n";

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const isAr = locale === "ar";

const T = isAr ? {
  title:        "من نحن — كليم",
  description:  "كليم شركة عراقية متخصصة في تحرير البيانات وتحديث الأنظمة الرقمية، من قاعدة بيانات مهملة إلى منصة حديثة تملكها أنت.",
  eyebrow:      "من نحن",
  h1:           "نحرّر البيانات، ونحدّث الأنظمة، ونعيد إليك حريتك الرقمية.",
  lede:         "نتخصص في استخراج البيانات من الأنظمة القديمة ونقلها إلى منصات حديثة، ونعمل مع المؤسسات التي تريد تحرير بياناتها المهملة وبناء أنظمة تملكها حقاً.",
  meaning:      "«كليم» في العربية هو المُحاوِر: من تُكلّمه ويُكلّمك.",
  officesLabel: "المكاتب",
  offices:      "البصرة · بغداد",
  langLabel:    "نعمل بـ",
  langs:        "العربية والإنجليزية",
  servicesLabel: "الخدمات",
  services:     "ست خدمات، منهج واحد",
  storyHead:    "قصتنا",
  storyBody:    "بدأت كليم من سؤال بسيط: كم من البيانات القيّمة محبوس في أنظمة قديمة؟ وكم من المؤسسات العراقية تملك أرشيف سنوات طويلة لكنها لا تستطيع الوصول إليه أو البناء عليه؟ اليوم نتخصص في استخراج هذه البيانات وتنظيفها، وإعادة بناء الأنظمة بطريقة حديثة وآمنة. ومشاريعنا تثبت أن الانتقال من نظام قديم إلى نظام حديث ممكن دون أن تخسر شيئاً.",
  missionHead:  "مهمتنا",
  missionBody:  "أن تملك المؤسسات العراقية أنظمتها الرقمية ملكية حقيقية — بلا ارتهان لمزوّد واحد، وبلا بيانات محبوسة، وبلا خوف من الترقية أو التطوير. عبر تحرير البيانات والاستثمار في بنية تحتية مفتوحة، نساعد العراق على بناء استقلالية رقمية حقيقية.",
  valuesHead:   "قيمنا",
  v1: "ملكية حقيقية",
  v1Desc: "البيانات والأنظمة ملك لأصحابها — لا العكس.",
  v2: "استقلالية عن المزوّد",
  v2Desc: "تقنيات مفتوحة لا تحبسك في رخصة أو اشتراك.",
  v3: "شفافية كاملة",
  v3Desc: "كل شيء موثّق ومشروح — لا ألغاز ولا غموض.",
  v4: "كفاءة محلية",
  v4Desc: "فريق عراقي يفهم ظروفك ويتحدث لغتك.",
  v5: "أفعال لا وعود",
  v5Desc: "أنظمة سريعة وموثوقة — وإلا فهي لم تكتمل بعد.",
  v6: "التدريب والدعم",
  v6Desc: "نتأكد أن فريقك يفهم النظام فهماً كاملاً ويستطيع تطويره بنفسه.",
} : {
  title:        "About — Kaleem",
  description:  "Kaleem is an Iraqi company that frees data from legacy systems and modernizes digital platforms — so organizations truly own what they run.",
  eyebrow:      "About",
  h1:           "We liberate data, modernize systems, and restore digital freedom.",
  lede:         "We specialize in extracting data from legacy systems and moving it into modern platforms, working with organizations that want to free their trapped data and build systems they truly own.",
  meaning:      "Kaleem (كليم) is Arabic for \"the one you speak with\": the person you talk to, and who talks back.",
  officesLabel: "Offices",
  offices:      "Basra · Baghdad",
  langLabel:    "We work in",
  langs:        "Arabic & English",
  servicesLabel: "Services",
  services:     "Six, one method",
  storyHead:    "Our story",
  storyBody:    "Kaleem started with a simple question: how much valuable data is trapped in aging systems? How many Iraqi organizations hold years of archives they can't access or build on? Today we specialize in extracting that data, cleaning it, and rebuilding systems the modern way — safely and completely. Our projects show that moving from legacy to modern doesn't mean losing anything.",
  missionHead:  "Our mission",
  missionBody:  "Iraqi organizations should truly own their digital infrastructure — free from single-vendor lock-in, from trapped data, and from the fear of upgrading. By freeing data and investing in open infrastructure, we help Iraq build real digital independence.",
  valuesHead:   "Our values",
  v1: "Real ownership",
  v1Desc: "Data and systems belong to the people who run them — never the other way around.",
  v2: "Vendor independence",
  v2Desc: "Open technology that never traps you in licenses or subscriptions.",
  v3: "Full transparency",
  v3Desc: "Everything documented and explained — no magic, no mystery.",
  v4: "Local competence",
  v4Desc: "An Iraqi team that understands your context and speaks your language.",
  v5: "Performance over promises",
  v5Desc: "Fast, reliable systems — or we don't consider them complete.",
  v6: "Training and support",
  v6Desc: "We make sure your team fully understands the system and can evolve it on its own.",
};

const values = [
  { t: T.v1, d: T.v1Desc, bg: "bg-mint" },
  { t: T.v2, d: T.v2Desc, bg: "bg-butter" },
  { t: T.v3, d: T.v3Desc, bg: "bg-sky" },
  { t: T.v4, d: T.v4Desc, bg: "bg-lilac" },
  { t: T.v5, d: T.v5Desc, bg: "bg-peach" },
  { t: T.v6, d: T.v6Desc, bg: "bg-apricot" },
];
---

<BaseLayout title={T.title} description={T.description}>
  <!-- ─── HERO: the mission on one side; on the other the name itself is
       the picture (the logo lockup), its meaning, and three plain facts. ─── -->
  <section class="ab-hero bg-peach">
    <div class="container ab-grid">
      <div class="ab-text">
        <span class="ab-eyebrow">{T.eyebrow}</span>
        <h1>{T.h1}</h1>
        <p>{T.lede}</p>
      </div>
      <div class="ab-card sk">
        <KaleemLogo variant="c" class="ab-lockup" />
        <p class="ab-meaning">{T.meaning}</p>
        <dl class="ab-facts">
          <div><dt>{T.officesLabel}</dt><dd>{T.offices}</dd></div>
          <div><dt>{T.langLabel}</dt><dd>{T.langs}</dd></div>
          <div><dt>{T.servicesLabel}</dt><dd>{T.services}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="about-story">
    <div class="container">
      <div class="story-grid">
        <h2>{T.storyHead}</h2>
        <p>{T.storyBody}</p>
      </div>
      <div class="story-grid">
        <h2>{T.missionHead}</h2>
        <p>{T.missionBody}</p>
      </div>
    </div>
  </section>

  <section class="about-values bg-paper-2">
    <div class="container">
      <h2 class="values-h2">{T.valuesHead}</h2>
      <div class="values-grid">
        {values.map((v) => (
          <div class={`sk ${v.bg} value-card`}>
            <h3>{v.t}</h3>
            <p>{v.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .container {
    max-width: var(--k-max);
    margin: 0 auto;
    padding: 0 var(--k-gutter-desktop);
  }





  /* ─── Hero ─── */
  .ab-hero { padding: 72px 0; border-bottom: 2px solid var(--k-ink); }
  .ab-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 72px;
    align-items: center;
  }
  .ab-text { display: flex; flex-direction: column; gap: 22px; }
  .ab-eyebrow {
    font-family: var(--k-font-mono);
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #4d3a33;
  }
  .ab-text h1 { margin: 0; font-size: clamp(40px, 4.6vw, 64px); line-height: 1.07; letter-spacing: -0.02em; }
  .ab-text p { margin: 0; max-width: 560px; font-size: 18px; line-height: 1.6; color: #3a2f2b; }

  .ab-card {
    background: var(--k-paper);
    padding: 36px 36px 30px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    rotate: 1.5deg;
    min-width: 0;
  }
  /* The lockup scales as one piece: fill the card, up to its full size. */
  .ab-card :global(.ab-lockup) { width: 100%; max-width: 396px; height: auto; }
  .ab-meaning { margin: 0; font-size: 17px; line-height: 1.6; }
  .ab-facts {
    margin: 0;
    padding-top: 16px;
    border-top: 2px solid var(--k-ink);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .ab-facts dt {
    font-family: var(--k-font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4a4a4a;
  }
  .ab-facts dd { margin: 4px 0 0; font-size: 16px; font-weight: 600; }

  @media (max-width: 900px) {
    .ab-grid { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .ab-card { rotate: none; }
  }
  @media (max-width: 672px) {
    .ab-hero { padding: 44px 0 56px; }
    .ab-card { padding: 24px 20px; }
    .ab-facts { grid-template-columns: minmax(0, 1fr); }
  }

  .about-story {
    padding: var(--k-space-10) 0;
  }

  .story-grid {
    display: grid;
    grid-template-columns: minmax(200px, 280px) 1fr;
    gap: var(--k-space-9);
    align-items: start;
  }

  .story-grid h2 {
    margin: 0;
    font-size: clamp(24px, 3.4vw, 34px);
    color: var(--k-ink);
  }

  .story-grid p {
    margin: 0;
    font-size: 19px;
    line-height: 1.7;
    max-width: 60ch;
    color: var(--k-ink-muted);
  }

  .about-values {
    padding: var(--k-space-10) 0;
    border-top: 2px solid var(--k-ink);
    border-bottom: 2px solid var(--k-ink);
  }

  .values-h2 {
    margin: 0 0 var(--k-space-8);
    font-size: clamp(28px, 4vw, 40px);
    color: var(--k-ink);
    text-align: center;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--k-space-6);
  }

  .value-card h3 {
    margin: 0;
    font-size: 22px;
    color: var(--k-ink);
  }

  .value-card p {
    margin: 0;
    color: var(--k-ink);
    font-size: 16px;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .story-grid { grid-template-columns: 1fr; gap: var(--k-space-4); }
  }
  @media (max-width: 672px) {
    .container { padding: 0 var(--k-gutter-mobile); }
    .about-story,
    .about-values { padding: var(--k-space-8) 0; }
  }
</style>

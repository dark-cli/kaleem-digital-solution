---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { currentLocale, localizedHref } from "../../lib/i18n";

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const isAr = locale === "ar";
const L = (href: string) => localizedHref(href, locale);

const T = isAr ? {
  title:        "من نحن — كليم",
  description:  "كليم شركة عراقية متخصصة في تحرير البيانات وتحديث الأنظمة الرقمية. من قاعدة بيانات مهملة إلى منصة حديثة.",
  eyebrow:      "من نحن",
  h1:           "نحرّر البيانات، ونحدّث الأنظمة، ونعيد الحرية الرقمية.",
  lede:         "كليم — من الفعل «كَلَمَ» أي تحدّث — متخصصة في استخراج البيانات من الأنظمة القديمة وتحويلها إلى منصات حديثة. نعمل مع المؤسسات التي تريد أن تُحرّر بيانات مهملة وتبني نظاماً يملكونه حقاً.",
  storyHead:    "قصتنا",
  storyBody:    "بدأت كليم من سؤال بسيط: كم من البيانات القيّمة محبوسة في أنظمة قديمة؟ كم من المؤسسات العراقية تملك سنوات من الأرشيفات لكن لا تستطيع الوصول إليها أو تطويرها؟ اليوم نتخصص في استخراج هذه البيانات، تنظيفها، وإعادة بناء الأنظمة بطريقة حديثة وآمنة. مشاريعنا تثبت أنه يمكن الانتقال من نظام قديم إلى حديث بدون فقدان شيء.",
  missionHead:  "مهمّتنا",
  missionBody:  "أن تملك المؤسسات العراقية أنظمتها الرقمية حقاً — بدون قيود بائع واحد، بدون بيانات مقفولة، بدون خوف من الترقية أو التطوير. من خلال تحرير البيانات والاستثمار في البنية التحتية المفتوحة، نساعد العراق في بناء استقلالية رقمية حقيقية.",
  valuesHead:   "قيمنا",
  v1: "ملكية حقيقية",
  v1Desc: "بيانات ونظام يملكها صاحبها — وليس العكس.",
  v2: "استقلالية عن البائع",
  v2Desc: "تقنيات مفتوحة وموثوقة لا تُقيّدك برخصة أو اشتراك.",
  v3: "الشفافية الكاملة",
  v3Desc: "كل شيء موثق ومشروح — لا رموز سحرية ولا غموض.",
  v4: "الكفاءة المحلية",
  v4Desc: "فريق عراقي يفهم السياق ويتحدث لغتك.",
  v5: "الأداء لا المراوغة",
  v5Desc: "أنظمة سريعة وموثوقة — أو لا نعتبرها جاهزة.",
  v6: "التدريب والدعم",
  v6Desc: "نتأكد أن فريقك يفهم النظام بالكامل ويمكنه تطويره بمفرده.",
  ctaHead:      "احجز تدقيق مجاني",
  ctaLede:      "فحص سريع لنظامك الحالي وخطة واضحة لتحريره.",
  ctaLabel:     "احجز تدقيق مجاني",
} : {
  title:        "About — Kaleem",
  description:  "Kaleem specializes in liberating data from legacy systems and modernizing digital platforms. Real ownership for Iraqi organizations.",
  eyebrow:      "About",
  h1:           "We liberate data, modernize systems, and restore digital freedom.",
  lede:         "Kaleem — from the Arabic verb kalama, \"to speak\" — specializes in extracting data from legacy systems and transforming them into modern platforms. We work with organizations that want to liberate trapped data and build systems they truly own.",
  storyHead:    "Our story",
  storyBody:    "Kaleem started with a simple question: how much valuable data is trapped in aging systems? How many Iraqi organizations hold years of archives but can't access or develop them? Today we specialize in extracting that data, cleaning it, and rebuilding systems the modern way—safely and completely. Our projects prove that migration from legacy to modern doesn't mean losing anything.",
  missionHead:  "Our mission",
  missionBody:  "Iraqi organizations should own their digital infrastructure—free from single-vendor lock-in, free from data imprisonment, free from fear of upgrading. By liberating data and investing in open infrastructure, we help Iraq build real digital independence.",
  valuesHead:   "Our values",
  v1: "Real ownership",
  v1Desc: "Systems and data owned by their operators—never the other way around.",
  v2: "Vendor independence",
  v2Desc: "Open technologies that never trap you in licenses or subscriptions.",
  v3: "Full transparency",
  v3Desc: "Everything documented and explained—no magic, no mystery.",
  v4: "Local competence",
  v4Desc: "Iraqi team that understands your context and speaks your language.",
  v5: "Performance over promises",
  v5Desc: "Fast, reliable systems—or we don't consider them complete.",
  v6: "Training and support",
  v6Desc: "We make sure your team fully understands the system and can evolve it independently.",
  ctaHead:      "Book a free audit",
  ctaLede:      "Quick assessment of your current systems and a clear path to liberation.",
  ctaLabel:     "Book a free audit",
};

const values = [
  { t: T.v1, d: T.v1Desc, bg: "bg-mint" },
  { t: T.v2, d: T.v2Desc, bg: "bg-butter" },
  { t: T.v3, d: T.v3Desc, bg: "bg-sky" },
  { t: T.v4, d: T.v4Desc, bg: "bg-lilac" },
  { t: T.v5, d: T.v5Desc, bg: "bg-peach" },
  { t: T.v6, d: T.v6Desc, bg: "bg-apricot" },
];
---

<BaseLayout title={T.title} description={T.description}>
  <section class="about-hero bg-peach">
    <div class="container">
      <span class="eyebrow">{T.eyebrow}</span>
      <h1 class="about-h1">{T.h1}</h1>
      <p class="about-lede">{T.lede}</p>
    </div>
  </section>

  <section class="about-story">
    <div class="container">
      <div class="story-grid">
        <h2>{T.storyHead}</h2>
        <p>{T.storyBody}</p>
      </div>
      <div class="story-grid">
        <h2>{T.missionHead}</h2>
        <p>{T.missionBody}</p>
      </div>
    </div>
  </section>

  <section class="about-values bg-paper-2">
    <div class="container">
      <h2 class="values-h2">{T.valuesHead}</h2>
      <div class="values-grid">
        {values.map((v) => (
          <div class={`sk ${v.bg} value-card`}>
            <h3>{v.t}</h3>
            <p>{v.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="about-cta bg-mint">
    <div class="container">
      <div class="cta-grid">
        <div>
          <h2>{T.ctaHead}</h2>
          <p>{T.ctaLede}</p>
        </div>
        <a class="skb skb-butter" href={L("/contact/")}>{T.ctaLabel}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: var(--k-max);
    margin: 0 auto;
    padding: 0 var(--k-gutter-desktop);
  }

  .about-hero {
    padding: var(--k-space-10) 0 var(--k-space-11);
    text-align: center;
  }

  .eyebrow {
    display: inline-block;
    font-family: var(--k-font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--k-ink-muted);
    margin-bottom: var(--k-space-4);
  }

  .about-h1 {
    margin: 0 auto var(--k-space-5);
    max-width: 20ch;
    font-size: clamp(36px, 6vw, 64px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--k-ink);
    font-weight: 700;
  }

  .about-lede {
    margin: 0 auto;
    max-width: 56ch;
    font-size: 19px;
    line-height: 1.65;
    color: var(--k-ink-muted);
  }

  .about-story {
    padding: var(--k-space-10) 0;
  }

  .story-grid {
    display: grid;
    grid-template-columns: minmax(200px, 280px) 1fr;
    gap: var(--k-space-9);
    align-items: start;
  }

  .story-grid h2 {
    margin: 0;
    font-size: clamp(24px, 3.4vw, 34px);
    color: var(--k-ink);
  }

  .story-grid p {
    margin: 0;
    font-size: 19px;
    line-height: 1.7;
    max-width: 60ch;
    color: var(--k-ink-muted);
  }

  .about-values {
    padding: var(--k-space-10) 0;
    border-top: 2px solid var(--k-ink);
    border-bottom: 2px solid var(--k-ink);
  }

  .values-h2 {
    margin: 0 0 var(--k-space-8);
    font-size: clamp(28px, 4vw, 40px);
    color: var(--k-ink);
    text-align: center;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--k-space-6);
  }

  .value-card h3 {
    margin: 0;
    font-size: 22px;
    color: var(--k-ink);
  }

  .value-card p {
    margin: 0;
    color: var(--k-ink);
    font-size: 16px;
    line-height: 1.6;
  }

  .about-cta {
    padding: var(--k-space-10) 0;
  }

  .cta-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--k-space-8);
    align-items: center;
  }

  .cta-grid h2 {
    margin: 0 0 8px;
    font-size: clamp(24px, 3.4vw, 34px);
    color: var(--k-ink);
  }

  .cta-grid p {
    margin: 0;
    color: var(--k-ink-muted);
    font-size: 17px;
  }

  @media (max-width: 900px) {
    .story-grid { grid-template-columns: 1fr; gap: var(--k-space-4); }
    .cta-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 672px) {
    .container { padding: 0 var(--k-gutter-mobile); }
    .about-hero,
    .about-story,
    .about-values,
    .about-cta { padding: var(--k-space-8) 0; }
  }
</style>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { currentLocale, localizedHref } from "../../lib/i18n";

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = currentLocale(Astro);
const isAr = locale === "ar";
const L = (href: string) => localizedHref(href, locale);

const T = isAr ? {
  title:        "من نحن — كليم",
  description:  "كليم شركة عراقية للمنازل الذكية والمساعد الصوتي. من شقة في بغداد إلى أول منظومة منزل ذكي مصممة للعراق.",
  eyebrow:      "من نحن",
  h1:           "منظومة تفهم لهجتك، ومصنوعة في العراق.",
  lede:         "كليم — من الفعل «كَلَمَ» أي تحدّث — شركة تُطوّر أول منظومة منزل ذكي بمساعد صوتي يفهم اللهجة العراقية. نُصمّم ونُركّب في البصرة وبغداد، ونعمل مع عوائل ومؤسسات تريد تقنية تفهمهم بدل أن تُجبرهم على فهمها.",
  storyHead:    "قصتنا",
  storyBody:    "بدأت كليم من شقة صغيرة في بغداد بسؤال بسيط: هل يمكن أن نبني مساعداً صوتياً يفهم كيف نتحدث فعلاً في بيوتنا؟ الجواب — بعد سنوات من البحث والتطوير المحلي — كان نعم. اليوم لا نُقدّم مساعداً صوتياً فقط، بل منظومة منزل ذكي كاملة: إضاءة، مناخ، أمان، وترفيه، كلها تعمل مع بعضها، وكلها تفهمك بلهجتك.",
  missionHead:  "مهمّتنا",
  missionBody:  "أن ينتقل العراق من مستهلك للتقنية إلى صانع لها — من خلال بناء منظومة عراقية كاملة، وتطوير مواهب هندسية ومصمّمة محلية، وحماية خصوصية عائلاتنا بالتصميم لا كإعلان.",
  valuesHead:   "قيمنا",
  v1: "لهجتك أولاً",
  v1Desc: "نُطوّر التقنية لتفهم كلامك اليومي، لا لتُجبرك على تعلّم كلامها.",
  v2: "الخصوصية بالتصميم",
  v2Desc: "معالجة محلية للبيانات — أوامرك الصوتية لا تغادر منزلك.",
  v3: "المفتوح على المغلق",
  v3Desc: "معايير قياسية تعمل مع أجهزة مختلفة، ولا تحبسك مع مورّد واحد.",
  v4: "صناعة عراقية",
  v4Desc: "نُطوّر الهندسة والتصميم والذكاء الاصطناعي هنا، محلياً.",
  v5: "أرقام صادقة",
  v5Desc: "تكلفة واضحة من البداية — لا تفاجآت في الفاتورة، ولا اشتراكات خفية.",
  v6: "نشرح كل شيء",
  v6Desc: "نوثّق ما نُركّبه، ونُدرّب من يستخدمه بالعربية.",
  ctaHead:      "احجز استشارة مجانية",
  ctaLede:      "زيارة قصيرة لموقعك، وخطة واضحة لما يمكن أن يفعله منزل ذكي لك.",
  ctaLabel:     "احجز استشارة مجانية",
} : {
  title:        "About — Kaleem",
  description:  "Kaleem is an Iraqi smart home and voice assistant company. From a Baghdad apartment to Iraq's first localized smart home ecosystem.",
  eyebrow:      "About",
  h1:           "A home that understands your dialect, made in Iraq.",
  lede:         "Kaleem — from the Arabic verb kalama, \"to speak\" — is building the first smart-home ecosystem with a voice assistant that understands the Iraqi dialect. We design and install in Basra and Baghdad, for families and businesses who want technology that fits them instead of forcing them to fit it.",
  storyHead:    "Our story",
  storyBody:    "Kaleem started in a small Baghdad apartment with a simple question: could we build a voice assistant that actually understands how people speak in Iraqi homes? After years of local research and development the answer was yes. Today we deliver a complete smart home ecosystem — lighting, climate, security, entertainment — all working together, all speaking your dialect.",
  missionHead:  "Our mission",
  missionBody:  "Shift Iraq from being a consumer of foreign technology to a creator of its own — by building a full local ecosystem, developing Iraqi engineering and design talent, and protecting our families' privacy by design, not as marketing.",
  valuesHead:   "Our values",
  v1: "Your dialect first",
  v1Desc: "We shape the technology around how people actually speak, not the other way around.",
  v2: "Privacy by design",
  v2Desc: "Local, on-device processing — your voice commands never leave your home.",
  v3: "Open over closed",
  v3Desc: "Standards that work across devices, so you're not locked in to any one supplier.",
  v4: "Made in Iraq",
  v4Desc: "Engineering, design and AI talent developed here, at home.",
  v5: "Honest numbers",
  v5Desc: "Clear pricing up front — no surprises on the invoice, no hidden subscriptions.",
  v6: "Explain everything",
  v6Desc: "We document what we install and train the people who use it, in Arabic.",
  ctaHead:      "Book a free consultation",
  ctaLede:      "A short visit to your space and a clear plan for what a smart home could do for you.",
  ctaLabel:     "Book a free consultation",
};

const values = [
  { t: T.v1, d: T.v1Desc, bg: "bg-mint" },
  { t: T.v2, d: T.v2Desc, bg: "bg-butter" },
  { t: T.v3, d: T.v3Desc, bg: "bg-sky" },
  { t: T.v4, d: T.v4Desc, bg: "bg-lilac" },
  { t: T.v5, d: T.v5Desc, bg: "bg-peach" },
  { t: T.v6, d: T.v6Desc, bg: "bg-apricot" },
];
---

<BaseLayout title={T.title} description={T.description}>
  <section class="about-hero bg-peach">
    <div class="container">
      <span class="eyebrow">{T.eyebrow}</span>
      <h1 class="about-h1">{T.h1}</h1>
      <p class="about-lede">{T.lede}</p>
    </div>
  </section>

  <section class="about-story">
    <div class="container">
      <div class="story-grid">
        <h2>{T.storyHead}</h2>
        <p>{T.storyBody}</p>
      </div>
      <div class="story-grid">
        <h2>{T.missionHead}</h2>
        <p>{T.missionBody}</p>
      </div>
    </div>
  </section>

  <section class="about-values bg-paper-2">
    <div class="container">
      <h2 class="values-h2">{T.valuesHead}</h2>
      <div class="values-grid">
        {values.map((v) => (
          <div class={`sk ${v.bg} value-card`}>
            <h3>{v.t}</h3>
            <p>{v.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="about-cta bg-mint">
    <div class="container">
      <div class="cta-grid">
        <div>
          <h2>{T.ctaHead}</h2>
          <p>{T.ctaLede}</p>
        </div>
        <a class="skb skb-butter" href={L("/contact/")}>{T.ctaLabel}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: var(--k-max);
    margin: 0 auto;
    padding: 0 var(--k-gutter-desktop);
  }

  .about-hero {
    padding: var(--k-space-10) 0 var(--k-space-11);
    text-align: center;
  }

  .eyebrow {
    display: inline-block;
    font-family: var(--k-font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--k-ink-muted);
    margin-bottom: var(--k-space-4);
  }

  .about-h1 {
    margin: 0 auto var(--k-space-5);
    max-width: 20ch;
    font-size: clamp(36px, 6vw, 64px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--k-ink);
    font-weight: 700;
  }

  .about-lede {
    margin: 0 auto;
    max-width: 56ch;
    font-size: 19px;
    line-height: 1.65;
    color: var(--k-ink-muted);
  }

  .about-story {
    padding: var(--k-space-10) 0;
  }

  .story-grid {
    display: grid;
    grid-template-columns: minmax(200px, 280px) 1fr;
    gap: var(--k-space-9);
    align-items: start;
  }

  .story-grid h2 {
    margin: 0;
    font-size: clamp(24px, 3.4vw, 34px);
    color: var(--k-ink);
  }

  .story-grid p {
    margin: 0;
    font-size: 19px;
    line-height: 1.7;
    max-width: 60ch;
    color: var(--k-ink-muted);
  }

  .about-values {
    padding: var(--k-space-10) 0;
    border-top: 2px solid var(--k-ink);
    border-bottom: 2px solid var(--k-ink);
  }

  .values-h2 {
    margin: 0 0 var(--k-space-8);
    font-size: clamp(28px, 4vw, 40px);
    color: var(--k-ink);
    text-align: center;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--k-space-6);
  }

  .value-card h3 {
    margin: 0;
    font-size: 22px;
    color: var(--k-ink);
  }

  .value-card p {
    margin: 0;
    color: var(--k-ink);
    font-size: 16px;
    line-height: 1.6;
  }

  .about-cta {
    padding: var(--k-space-10) 0;
  }

  .cta-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--k-space-8);
    align-items: center;
  }

  .cta-grid h2 {
    margin: 0 0 8px;
    font-size: clamp(24px, 3.4vw, 34px);
    color: var(--k-ink);
  }

  .cta-grid p {
    margin: 0;
    color: var(--k-ink-muted);
    font-size: 17px;
  }

  @media (max-width: 900px) {
    .story-grid { grid-template-columns: 1fr; gap: var(--k-space-4); }
    .cta-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 672px) {
    .container { padding: 0 var(--k-gutter-mobile); }
    .about-hero,
    .about-story,
    .about-values,
    .about-cta { padding: var(--k-space-8) 0; }
  }
</style>

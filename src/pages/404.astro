---
/**
 * Custom 404 in Kaleem sketch style. Because it's a single static file
 * served for BOTH /en/... and /ar/... misses, we render EN by default
 * and let a small inline script swap to AR when the visitor came from
 * the Arabic side of the site (via URL pathname or referrer).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found — Kaleem" description="The page you're looking for doesn't exist." noindex>
  <section class="nf">
    <div class="sk window nf-card">
      <div class="window-chrome" data-sky></div>
      <div class="window-body bg-butter nf-body-wrap">
        <!-- The "404" is a real WebGL sky patch masked to letter shapes.
             The data-sky element gets a canvas from the shader engine;
             mask-image clips that canvas to the glyphs of "404" so we
             see stars only through the letters. -->
        <div class="nf-code" data-sky role="img" aria-label="404"></div>

        <!-- English (default) -->
        <div class="nf-body nf-en">
          <h1>Page not found</h1>
          <p class="nf-lede">The page <code class="nf-path"></code> doesn't exist or has been moved.</p>
          <div class="nf-actions">
            <a class="skb skb-mint" href="/en/">← Back to home</a>
            <a class="skb skb-lilac" href="/en/contact/">Contact us</a>
          </div>
        </div>

        <!-- Arabic (revealed by JS when relevant) -->
        <div class="nf-body nf-ar" hidden>
          <h1>الصفحة غير موجودة</h1>
          <p class="nf-lede">الصفحة <code class="nf-path"></code> غير موجودة أو تم نقلها.</p>
          <div class="nf-actions">
            <a class="skb skb-mint" href="/ar/">→ عودة إلى الصفحة الرئيسية</a>
            <a class="skb skb-lilac" href="/ar/contact/">اتصل بنا</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    function detectLocale() {
      var path = location.pathname || "";
      var ref = document.referrer || "";
      if (path.indexOf("/ar/") === 0) return "ar";
      if (path.indexOf("/en/") === 0) return "en";
      if (ref.indexOf("/ar/") !== -1) return "ar";
      if (ref.indexOf("/en/") !== -1) return "en";
      var langs = (navigator.languages || [navigator.language || ""])
        .map(function (l) { return String(l).toLowerCase(); });
      for (var i = 0; i < langs.length; i++) {
        if (langs[i].indexOf("ar") === 0) return "ar";
      }
      return "en";
    }

    function apply() {
      if (!document.querySelector(".nf-card")) return;
      document.querySelectorAll(".nf-path").forEach(function (el) {
        el.textContent = location.href;
      });
      var locale = detectLocale();
      var en = document.querySelector(".nf-en");
      var ar = document.querySelector(".nf-ar");
      if (locale === "ar") {
        document.documentElement.setAttribute("lang", "ar");
        document.documentElement.setAttribute("dir", "rtl");
        if (en) en.hidden = true;
        if (ar) ar.hidden = false;
        document.title = "الصفحة غير موجودة — كليم";
      } else {
        document.documentElement.setAttribute("lang", "en");
        document.documentElement.setAttribute("dir", "ltr");
        if (en) en.hidden = false;
        if (ar) ar.hidden = true;
        document.title = "Page not found — Kaleem";
      }
    }

    apply();
    document.addEventListener("astro:page-load", apply);
  })();
</script>

<style>
  /* Fill the space between header and footer and center the window
     both horizontally and vertically. */
  .nf {
    min-height: calc(100vh - var(--header-h, 96px) - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--k-space-8) var(--k-gutter-desktop);
  }

  .nf-card {
    max-width: 640px;
    width: 100%;
  }

  .nf-body-wrap {
    text-align: center;
    color: var(--k-ink);
  }

  /* The 404 numeral is a real starfield window shaped like "404".
     The div is a data-sky element (the shader engine paints stars into
     an injected canvas child). We size it to fit the letters, then use
     mask-image with an SVG containing the "404" text to clip the canvas
     to the glyph shapes — so the stars appear only inside the letters. */
  .nf-code {
    display: block;
    margin-inline: auto;
    width: min(90%, 480px);
    height: clamp(96px, 18vw, 180px);
    /* SVG mask: black text on transparent background. mask-image keeps
       pixels where the mask is opaque, so only the glyph shapes remain. */
    -webkit-mask-image: url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 480 180' preserveAspectRatio='xMidYMid meet'%3E%3Ctext x='240' y='90' font-family='IBM Plex Mono, monospace' font-size='170' font-weight='700' text-anchor='middle' dominant-baseline='central' letter-spacing='-6' fill='black'%3E404%3C/text%3E%3C/svg%3E");
    mask-image: url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 480 180' preserveAspectRatio='xMidYMid meet'%3E%3Ctext x='240' y='90' font-family='IBM Plex Mono, monospace' font-size='170' font-weight='700' text-anchor='middle' dominant-baseline='central' letter-spacing='-6' fill='black'%3E404%3C/text%3E%3C/svg%3E");
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    /* The data-sky selector sets background-color to --k-board !important.
       Override for the letter case since the mask hides everything not in
       the glyph — no bleed to worry about. */
    background-color: transparent !important;
  }

  .nf-body h1 {
    margin: 0;
    font-size: clamp(28px, 4vw, 40px);
    color: var(--k-ink);
  }

  .nf-lede {
    color: var(--k-ink-muted);
    font-size: 17px;
    line-height: 1.65;
    max-width: 42ch;
    margin-inline: auto;
    word-break: break-all;
  }

  .nf-path {
    display: inline-block;
    padding: 2px 8px;
    background: var(--k-paper);
    border: 1.5px solid var(--k-ink);
    border-radius: 4px;
    font-family: var(--k-font-mono);
    font-size: 0.85em;
    color: var(--k-ink);
    direction: ltr;
    unicode-bidi: embed;
  }

  .nf-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  @media (max-width: 672px) {
    .nf { padding: var(--k-space-8) var(--k-gutter-mobile); }
  }
</style>

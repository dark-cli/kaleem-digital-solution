---
/**
 * Header — Kaleem Digital Solutions (redesigned Sep 2026).
 *
 * Chalkboard frame: dark board background with chalk text.
 * Logo: lockup E in chalk (see design/logo/), left-to-right on every page
 * Nav (Home, Services, Work, etc.)
 * Language toggle + CTA (lilac sketch button)
 *
 * Mobile (< 672px): burger menu with drawer navigation.
 */
import KaleemLogo from "./KaleemLogo.astro";
import { currentLocale, localizedHref, alternateHref } from "../lib/i18n";

const locale = currentLocale(Astro);
const currentPath = Astro.url.pathname;

// Localised href helper
const L = (href: string) => localizedHref(href, locale);

// Nav items for Kaleem
type NavItem = { label: string; labelAr: string; href: string };
const NAV: NavItem[] = [
  { label: "Home",                labelAr: "الرئيسية",       href: "/" },
  { label: "Services",            labelAr: "الخدمات",       href: "/services/" },
  { label: "Work",                labelAr: "الأعمال",       href: "/work/" },
  { label: "About",               labelAr: "من نحن",        href: "/about/" },
  { label: "Contact",             labelAr: "تواصل معنا",    href: "/contact/" },
];

const isActive = (href: string) => {
  const target = L(href);
  if (href === "/") return currentPath === target;
  return currentPath === target || currentPath.startsWith(target);
};

// Language toggle
const otherLocale = locale === "en" ? "ar" : "en";
const altHref = alternateHref(currentPath, otherLocale);
const altLabel = otherLocale === "ar" ? "عربي" : "English";

// Brand copy
const brand = locale === "ar" ? "كليم" : "Kaleem";

// Menu labels
const menuLabel = locale === "ar" ? "القائمة" : "Menu";
const closeMenuLabel = locale === "ar" ? "إغلاق" : "Close";

// CTA button
const ctaLabel = locale === "ar" ? "احجز تقييماً مجانياً" : "Book a free audit";
---

<header class="site-header board" data-sky>
  <div class="container header-row">
    <!-- Logo + Brand -->
    <a class="site-logo" href={L("/")} aria-label={brand}>
      <KaleemLogo variant="e" tone="chalk" height={44} label="" />
    </a>

    <!-- Desktop nav (≥ 672px) -->
    <nav class="primary-nav" aria-label="Primary">
      {NAV.map((item) => (
        <a
          class:list={["nav-link", { active: isActive(item.href) }]}
          href={L(item.href)}
        >
          {locale === "ar" ? item.labelAr : item.label}
        </a>
      ))}
    </nav>

    <!-- Right actions -->
    <div class="header-actions">
      <a class="fbtn fbtn-sm fbtn-paper" href={altHref} aria-label={altLabel} title={altLabel}>
        {altLabel}
      </a>
      <a class="skb skb-lilac header-cta" href={L("/audit/")}>
        {ctaLabel}
      </a>
      <button
        id="menu-toggle"
        class="menu-btn"
        aria-label={menuLabel}
        aria-expanded="false"
        aria-controls="mobile-nav"
        type="button"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile drawer (< 672px) -->
<aside id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" aria-hidden="true" inert>
  <div class="drawer-head">
    <span class="eyebrow">{menuLabel}</span>
    <button id="menu-close" class="close-btn" aria-label={closeMenuLabel} type="button">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="6" y1="6" x2="18" y2="18" />
        <line x1="18" y1="6" x2="6" y2="18" />
      </svg>
    </button>
  </div>
  <ul class="drawer-list">
    {NAV.map((item) => (
      <li>
        <a class="drawer-link" href={L(item.href)}>
          {locale === "ar" ? item.labelAr : item.label}
        </a>
      </li>
    ))}
    <li class="drawer-sep" aria-hidden="true"></li>
    <li>
      <a class="drawer-link" href={altHref}>{altLabel}</a>
    </li>
  </ul>
  <a class="skb skb-lilac" href={L("/audit/")}>{ctaLabel}</a>
</aside>
<div id="menu-scrim" class="menu-scrim" aria-hidden="true"></div>

<script is:inline>
  /**
   * Mobile menu drawer — View-Transitions aware
   */
  (function () {
    function bindElementListeners() {
      var toggle = document.getElementById("menu-toggle");
      var close  = document.getElementById("menu-close");
      var nav    = document.getElementById("mobile-nav");
      var scrim  = document.getElementById("menu-scrim");
      if (!toggle || !nav || !scrim) return;

      toggle.addEventListener("click", function () { setOpen(true); });
      close && close.addEventListener("click", function () { setOpen(false); });
      scrim.addEventListener("click", function () { setOpen(false); });
      nav.querySelectorAll("a").forEach(function (a) {
        a.addEventListener("click", function () { setOpen(false); });
      });
    }

    function setOpen(open) {
      var nav = document.getElementById("mobile-nav");
      var scrim = document.getElementById("menu-scrim");
      var toggle = document.getElementById("menu-toggle");
      if (!nav || !scrim) return;
      nav.classList.toggle("open", open);
      scrim.classList.toggle("visible", open);
      document.body.classList.toggle("nav-open", open);
      nav.setAttribute("aria-hidden", String(!open));
      if (open) nav.removeAttribute("inert"); else nav.setAttribute("inert", "");
      if (toggle) toggle.setAttribute("aria-expanded", String(open));
    }

    if (!window.__navGlobalsBound) {
      window.__navGlobalsBound = true;
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") setOpen(false);
      });
      document.addEventListener("astro:before-swap", function () { setOpen(false); });
    }

    bindElementListeners();
    document.addEventListener("astro:page-load", bindElementListeners);
  })();
</script>

<style>
  /* ─── Header shell ────────────────────────────────────────── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: auto;
    padding: var(--k-space-5) 0;
  }

  .header-row {
    display: flex;
    align-items: center;
    gap: 24px;
    max-width: var(--k-max);
    margin: 0 auto;
    padding: 0 var(--k-gutter-desktop);
  }

  /* ─── Logo ─────────────────────────────────────────────────── */
  .site-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--k-chalk);
    text-decoration: none;
    font-weight: 700;
  }

  .site-logo:focus-visible {
    outline: 3px solid var(--k-sky);
    outline-offset: 3px;
  }

  /* ─── Desktop nav (≥ 672px) ───────────────────────────────── */
  .primary-nav {
    display: none;
    align-items: center;
    gap: 0;
    margin-inline-start: auto;
  }

  .nav-link {
    /* Bright chalk text with a soft dark scrim behind it (via text-shadow)
       so links stay legible over the animated starfield without needing
       an opaque bar behind the header. */
    padding: 8px 16px;
    font-size: 15px;
    font-weight: 600;
    color: var(--k-chalk);
    text-decoration: none;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55), 0 0 8px rgba(0, 0, 0, 0.35);
    transition: transform 140ms cubic-bezier(0.2, 0.9, 0.3, 1.2),
                color 140ms ease;
    display: inline-block;
    line-height: 1.2;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: #fff;
    transform: translateY(-2px);
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }

  .nav-link.active {
    color: var(--k-butter);
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }

  /* ─── Header actions (right side) ─────────────────────────── */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-inline-start: auto;
  }

  /* Header right-side buttons use the global .skb / .fbtn widgets —
     no local overrides needed. */

  /* ─── Menu button ──────────────────────────────────────────── */
  .menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--k-chalk);
  }

  .menu-btn span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--k-chalk);
    transition: all 0.2s ease;
  }

  .menu-btn:hover span {
    background: var(--k-chalk);
  }

  .menu-btn:focus-visible {
    outline: 3px solid var(--k-sky);
    outline-offset: 3px;
  }

  /* ─── Mobile drawer ───────────────────────────────────────── */
  .mobile-nav {
    position: fixed;
    top: 0;
    bottom: 0;
    inset-inline-end: 0;
    width: min(320px, 85vw);
    background: var(--k-paper);
    border-inline-start: 2px solid var(--k-ink);
    z-index: 90;
    display: flex;
    flex-direction: column;
    padding: 20px;
    gap: 8px;
    transform: translateX(100%);
    transition: transform 0.25s ease-out;
  }

  html[dir="rtl"] .mobile-nav {
    transform: translateX(-100%);
  }

  /* Must out-rank the RTL rule above, or the Arabic drawer stays parked
     off-screen when "open". */
  .mobile-nav.open,
  html[dir="rtl"] .mobile-nav.open {
    transform: translateX(0);
  }

  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--k-ink);
    margin-bottom: 8px;
  }

  .eyebrow {
    font-family: var(--k-font-mono);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--k-ink);
  }

  .close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: transparent;
    border: 2px solid var(--k-ink);
    border-radius: var(--k-radius-sketch-btn);
    color: var(--k-ink);
    cursor: pointer;
  }

  .close-btn:hover {
    background: var(--k-paper-2);
  }

  .close-btn:focus-visible {
    outline: 3px solid var(--k-focus);
    outline-offset: 2px;
  }

  .drawer-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
  }

  .drawer-link {
    display: block;
    padding: 16px 8px;
    min-height: 48px;
    font-size: 16px;
    color: var(--k-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--k-paper-2);
    transition: color 0.15s ease;
  }

  .drawer-link:hover {
    color: var(--k-focus);
  }

  .drawer-link:focus-visible {
    outline: 2px solid var(--k-focus);
    outline-offset: -2px;
  }

  .drawer-sep {
    flex: 1 1 auto;
    min-height: 12px;
  }

  .menu-scrim {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    z-index: 80;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .menu-scrim.visible {
    opacity: 1;
    visibility: visible;
  }

  :global(body.nav-open) {
    overflow: hidden;
  }

  /* ─── Responsive ───────────────────────────────────────────── */
  @media (min-width: 672px) {
    .primary-nav {
      display: inline-flex;
    }
    .menu-btn {
      display: none;
    }
  }

  @media (max-width: 671px) {
    .menu-btn {
      display: inline-flex;
    }
    /* The drawer carries the same CTA; there's no room for it here. */
    .header-cta {
      display: none;
    }
    .header-row {
      padding: 0 var(--k-gutter-mobile);
    }
  }
</style>

<!--
  Search result markup is injected at runtime via innerHTML, which means
  Astro's scoped [data-astro-cid-…] attributes are never applied to it and
  scoped styles silently fail. These rules live in a global block so they
  actually hit the dynamic nodes.
-->
<style is:global>
  .search-group {
    margin-bottom: 32px;
  }
  .search-group:last-child { margin-bottom: 0; }
  .search-group-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 10px;
    padding: 0 0 8px;
    border-bottom: 1px solid var(--ink);
  }
  html[dir="rtl"] .search-group-label {
    font-family: var(--font-body);
    letter-spacing: 0.02em;
    text-transform: none;
    font-size: 12px;
  }

  /* Each result is its own bordered card with real breathing room between
     cards so titles never blur into the next result. */
  .search-hit {
    display: block;
    padding: 16px 16px 14px;
    text-decoration: none;
    border: 1px solid var(--line);
    background: var(--white);
    margin: 0 0 18px;
  }
  .search-hit:last-child { margin-bottom: 0; }
  .search-hit:hover,
  .search-hit.active {
    background: var(--surface);
    border-color: var(--accent);
    text-decoration: none;
  }
  .search-hit.active { box-shadow: inset 0 0 0 1px var(--accent); }

  .search-hit-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 8px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line-soft);
  }
  .search-hit-title {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
    line-height: 1.2;
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
  }
  .search-hit:hover .search-hit-title,
  .search-hit.active .search-hit-title { color: var(--accent); }
  html[dir="rtl"] .search-hit-title { font-weight: 700; font-size: 18px; letter-spacing: 0; }

  .search-hit-badge {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 3px 7px;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--white);
    white-space: nowrap;
  }
  html[dir="rtl"] .search-hit-badge {
    font-family: var(--font-body); letter-spacing: 0; text-transform: none; font-size: 11px;
  }
  .search-hit-badge-treatment { color: var(--accent); border-color: var(--accent); }
  .search-hit-badge-service   { color: #5a3d8a; border-color: #d7cae8; }
  .search-hit-badge-blog      { color: #7a5a1a; border-color: #ecd9a8; }
  .search-hit-badge-case      { color: #2f6d47; border-color: #bbdec5; }
  .search-hit-badge-doctor    { color: var(--ink); border-color: var(--line-strong); }
  .search-hit-badge-static    { color: var(--muted); border-color: var(--line); }

  .search-hit-desc {
    font-size: 13.5px;
    color: var(--muted);
    margin: 0 0 6px;
    line-height: 1.55;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .search-hit-path {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--muted);
    margin: 0;
    opacity: 0.75;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  html[dir="rtl"] .search-hit-path { font-family: var(--font-body); font-size: 12px; }

  .search-empty {
    font-size: 14px;
    color: var(--muted);
    margin: 0;
    text-align: center;
    padding: 24px 0;
  }
</style>

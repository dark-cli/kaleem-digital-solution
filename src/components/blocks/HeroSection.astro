---
/**
 * HeroSection — Hero with split layout (text | media) and background color.
 *
 * Props:
 *   - title: Main heading
 *   - description: Body text
 *   - cta: { label, href } — button label + link
 *   - image: { src, alt } — illustration or image
 *   - bgColor: CSS color or design token (default: var(--white))
 *   - reversed: boolean — flip layout for RTL or design choice
 */
import { localizedHref } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";
import { imageVariants } from "../../lib/image";

interface CTA {
  label: string;
  href: string;
}

interface Image {
  src: string;
  alt: string;
}

interface Props {
  title: string;
  description: string;
  cta?: CTA;
  image?: Image;
  bgColor?: string;
  locale?: Locale;
  id?: string;
}

const { title, description, cta, image, bgColor = "var(--white)", locale = "en", id } = Astro.props;

function rewriteLinks(md: string): string {
  return md.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_, label, href) => {
    const h = href.startsWith("/") ? localizedHref(href, locale) : href;
    return `<a href="${h}">${label}</a>`;
  });
}

const img = image ? imageVariants(image.src) : null;
---

<section class="hero" style={`--hero-bg: ${bgColor};`} id={id}>
  <div class="hero-container">
    <div class="hero-text">
      <h1 class="hero-title">{title}</h1>
      <p class="hero-description" set:html={rewriteLinks(description)} />
      {cta && (
        <a href={cta.href.startsWith("/") ? localizedHref(cta.href, locale) : cta.href} class="hero-cta">
          {cta.label}
        </a>
      )}
    </div>
    {image && img && (
      <div class="hero-image">
        <img
          src={img.src}
          srcset={img.srcset || undefined}
          sizes={img.srcset ? "(min-width: 1024px) 50vw, 100vw" : undefined}
          alt={image.alt}
          width={img.width}
          height={img.height}
          loading="eager"
          decoding="async"
        />
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    background: var(--hero-bg);
    padding: clamp(40px, 6vw, 80px) clamp(20px, 4vw, 40px);
    margin: 0;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 2vw, 24px);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(28px, 5vw, 56px);
    font-weight: 400;
    line-height: 1.2;
    color: var(--ink);
    margin: 0;
  }
  :global(html[dir="rtl"]) .hero-title {
    font-weight: 700;
  }

  .hero-description {
    font-size: clamp(16px, 2vw, 18px);
    line-height: 1.7;
    color: var(--body);
    margin: 0;
    max-width: 55ch;
  }
  :global(html[dir="rtl"]) .hero-description {
    line-height: 1.95;
  }

  .hero-description :global(a) {
    color: var(--accent);
    text-decoration: none;
  }
  .hero-description :global(a:hover) {
    text-decoration: underline;
  }

  .hero-cta {
    display: inline-block;
    padding: clamp(10px, 1.5vw, 14px) clamp(20px, 3vw, 28px);
    background: var(--accent);
    color: var(--white);
    text-decoration: none;
    border-radius: 4px;
    font-weight: 600;
    font-size: 16px;
    transition: background 0.2s;
    width: fit-content;
  }
  .hero-cta:hover {
    background: var(--accent-hover);
  }

  .hero-image {
    width: 100%;
    aspect-ratio: auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-image img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
  }

  @media (max-width: 800px) {
    .hero-container {
      grid-template-columns: 1fr;
    }

    .hero-title {
      font-size: clamp(24px, 4vw, 40px);
    }

    .hero-description {
      font-size: 16px;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding: clamp(24px, 4vw, 40px) clamp(16px, 3vw, 20px);
    }

    .hero-container {
      gap: clamp(24px, 4vw, 40px);
    }

    .hero-title {
      font-size: clamp(20px, 3.5vw, 32px);
    }

    .hero-cta {
      padding: 10px 18px;
      font-size: 14px;
    }
  }
</style>

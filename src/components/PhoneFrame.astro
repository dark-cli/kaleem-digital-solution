---
/**
 * Phone screenshot in a Galaxy S25 Ultra-style frame, drawn in the site's
 * pen: flat display, slim even bezels, squared rail with the volume and
 * power buttons on the right, a 2px ink outline with slightly uneven
 * hand-drawn corners and the offset shadow every .sk card carries.
 *
 * The rail takes a finish:
 *   - "night-sky" (default): the rail is a [data-sky] element, so the
 *     starfield engine paints the shared sky into it.
 *   - a palette name ("peach", "mint", "lilac", "butter", "sky",
 *     "apricot", "board", "paper") → var(--k-<name>).
 *   - any other CSS colour, used as is.
 *
 *   <PhoneFrame src="/assets/deptmaster/app-home.jpg" alt="…" finish="mint" />
 *
 * A slim status bar sits above the screenshot (app screenshots usually
 * come without one). Every size is a fraction of the phone's own width
 * (container units), so the proportions hold at any size. The screenshot
 * keeps its own aspect ratio; nothing is cropped.
 *
 * Pass children to replace the single screenshot (e.g. a stack of
 * screens that cross-fade); src/alt are then ignored.
 */
import Image from "./Image.astro";

interface Props {
  src?: string;
  alt?: string;
  finish?: string;
  /** Layout hint for srcset. */
  sizes?: string;
  loading?: "lazy" | "eager";
  class?: string;
}

const {
  src,
  alt,
  finish = "night-sky",
  sizes = "(min-width: 900px) 240px, 60vw",
  loading = "lazy",
  class: className,
} = Astro.props;

const PALETTE = new Set(["peach", "mint", "lilac", "butter", "sky", "apricot", "board", "paper"]);
const isSky = finish === "night-sky";
const rail = isSky ? "var(--k-board)" : PALETTE.has(finish) ? `var(--k-${finish})` : finish;
---

<div class:list={["phone-frame", className]} style={`--pf-rail: ${rail}`}>
  <div class="pf-device">
    <span class="pf-btn pf-vol" aria-hidden="true"></span>
    <span class="pf-btn pf-power" aria-hidden="true"></span>
    <div class="pf-shell">
    <div class="pf-body" {...(isSky ? { "data-sky": true } : {})}>
      <div class="pf-bezel">
        <div class="pf-screen">
          <div class="pf-status" aria-hidden="true">
            <span class="pf-time">9:41</span>
            <svg class="pf-icons" viewBox="0 0 34 12">
              <path d="M1 11h2V8H1zM5 11h2V6H5zM9 11h2V4H9zM13 11h2V2h-2z" fill="currentColor" />
              <rect x="19.5" y="1.5" width="12" height="9" rx="2.2" fill="none" stroke="currentColor" />
              <rect x="21.2" y="3.2" width="7.6" height="5.6" rx="1" fill="currentColor" />
            </svg>
          </div>
          {Astro.slots.has("default") ? <slot /> : src && <Image {src} alt={alt ?? ""} {sizes} {loading} class="pf-image" />}
        </div>
      </div>
    </div>
    </div>
  </div>
</div>

<style>
  /* The outer box is the size container; the device inside measures
     itself in cqw (1cqw = 1% of the phone's width). */
  .phone-frame { container-type: inline-size; }
  .pf-device { position: relative; }

  /* The shell carries the sketch-card shadow. It sits outside the rail
     because a [data-sky] rail is masked, and the mask would clip it. */
  .pf-shell,
  .pf-body {
    border-radius: 13.85cqw 13.08cqw 14.23cqw 13.46cqw / 13.46cqw 14.23cqw 13.08cqw 13.85cqw;
  }
  .pf-shell {
    position: relative;
    z-index: 1;
    box-shadow:
      1.73cqw 1.73cqw 0 -2px var(--k-paper),
      1.73cqw 1.73cqw 0 0 var(--k-ink);
  }

  /* Rail: one flat finish (or the sky) inside the ink outline. */
  .pf-body {
    position: relative;
    padding: 2.3cqw;
    border: var(--k-line) solid var(--k-ink);
    overflow: hidden;
    background: var(--pf-rail);
    transition: background-color 400ms ease;
  }

  /* Slim black bezel, same width all round. */
  .pf-bezel {
    position: relative;
    z-index: 1;
    padding: 1.73cqw;
    border-radius: 11.15cqw;
    background: #0b0c0d;
  }

  .pf-screen {
    position: relative;
    overflow: hidden;
    border-radius: 9.42cqw;
    background: #141318;
  }
  .pf-screen :global(.pf-image) { display: block; width: 100%; height: auto; }

  /* Status bar: time, signal and battery. Its colour matches the app's
     dark background; override with --pf-status. */
  .pf-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 8.85cqw;
    padding: 0 7.7cqw;
    direction: ltr;
    background: var(--pf-status, #141318);
    color: #f2f2f4;
  }
  .pf-time { font: 600 3.65cqw/1 var(--k-font-sans); letter-spacing: 0.02em; }
  .pf-icons { width: 9.2cqw; height: auto; }

  /* Side buttons on the right rail, tucked behind the body so only
     their outlined tips show. Volume above power, as on the S25 Ultra. */
  .pf-btn {
    position: absolute;
    right: -3.08cqw;
    width: 4.6cqw;
    box-sizing: border-box;
    border: var(--k-line) solid var(--k-ink);
    border-left: 0;
    border-radius: 0 1.73cqw 1.73cqw 0;
    background: var(--pf-rail);
  }
  .pf-vol { top: 20%; height: 12%; }
  .pf-power { top: 35.8%; height: 7.3%; }
</style>

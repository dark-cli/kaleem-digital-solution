---
/**
 * Kaleem logo lockup: a golden-ratio box drawn with its guide lines.
 *
 *   ┌────────┬──────────────┐
 *   │        │    kaleem    │   square (100) : name area (φ × 100 = 161.8)
 *   │  mark  ├──────────────┤
 *   │        │  كليــــــم   │   two equal rows
 *   └────────┴──────────────┘
 *
 * One SVG, so it scales as a single piece: set its width and the height
 * follows (ratio 2.618 : 1). Both names are fitted to exactly the same
 * width with textLength, so they stay inside the guide lines in every
 * browser, whatever the font rendering. The Arabic is stretched with
 * 22 × ـ after the ي so it reaches that width naturally.
 *
 * Always left-to-right, on Arabic pages too (a logo keeps its shape).
 */
interface Props {
  /** Width in px of the whole lockup (height = width / 2.618). */
  width?: number;
  class?: string;
}

const { width = 396, class: className } = Astro.props;
const arabic = "كلي" + "ـ".repeat(22) + "م";

// Geometry, in viewBox units (square = 100).
const SQ = 100;
const NAME_W = 161.8;              // φ × SQ
const W = SQ + NAME_W;             // 261.8
const PAD = 13.3;                  // side padding inside the name area
const TEXT_W = NAME_W - 2 * PAD;   // both names are exactly this wide
const CX = SQ + NAME_W / 2;        // centre of the name area
const LINE = 1.4;                  // guide-line weight
---

<svg
  class:list={["lockup", className]}
  viewBox={`${-LINE / 2} ${-LINE / 2} ${W + LINE} ${SQ + LINE}`}
  width={width}
  role="img"
  aria-label="Kaleem — كليم"
  direction="ltr"
>
  <g fill="none" stroke="currentColor" stroke-width={LINE}>
    <rect x="0" y="0" width={W} height={SQ}></rect>
    <line x1={SQ} y1="0" x2={SQ} y2={SQ}></line>
    <line x1={SQ} y1={SQ / 2} x2={W} y2={SQ / 2}></line>
  </g>

  <!-- The mark, 62% of the square, centred in it. -->
  <svg x="19" y="19" width="62" height="62" viewBox="0 0 72 72">
    <path d="M40 16H6V66H56V38" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="square"></path>
    <rect x="44" y="3" width="23" height="23" fill="#f8d12f"></rect>
  </svg>

  <!-- Baselines put each word's ink in the middle of its row
       (IBM Plex Mono / IBM Plex Sans Arabic, SemiBold). -->
  <text class="lk-en" x={CX} y="38.9" text-anchor="middle" textLength={TEXT_W} lengthAdjust="spacingAndGlyphs">kaleem</text>
  <text class="lk-ar" x={CX} y="82.5" text-anchor="middle" textLength={TEXT_W} lengthAdjust="spacingAndGlyphs" lang="ar">{arabic}</text>
</svg>

<style>
  .lockup {
    display: block;
    max-width: 100%;
    height: auto;
    color: #2f3e4c;
    overflow: visible;
  }
  text { fill: currentColor; font-weight: 600; }
  /* Fonts named directly, not through the site variables: Arabic pages
     remap those, and the lockup must look the same on every page. */
  .lk-en { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 37.54px; }
  .lk-ar { font-family: "IBM Plex Sans Arabic", sans-serif; font-size: 33.27px; }
</style>

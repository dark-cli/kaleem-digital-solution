---
/**
 * Kaleem logo lockup: a golden-ratio box drawn with its guide lines.
 *
 *   ┌────────┬──────────────┐
 *   │        │    kaleem    │   square (1) : name area (φ ≈ 1.618)
 *   │  mark  ├──────────────┤
 *   │        │  كليــــــم   │   two equal rows
 *   └────────┴──────────────┘
 *
 * Everything scales from one number, --u (the square's side). "kaleem"
 * and the Arabic are set to exactly the same width: IBM Plex Mono 600 is
 * 3.6em wide for "kaleem"; IBM Plex Sans Arabic 600 with 22 × ـ after the
 * ي is 4.062em wide. Both fill the name area minus its side padding.
 * Measured with the real font files; change the fonts and these break.
 *
 * Always left-to-right, on Arabic pages too (a logo keeps its shape).
 */
interface Props {
  /** Side of the mark's square, in px. */
  size?: number;
  class?: string;
}

const { size = 150, class: className } = Astro.props;
const arabic = "كلي" + "ـ".repeat(22) + "م";
---

<div class:list={["lockup", className]} style={`--u: ${size}px`} dir="ltr" role="img" aria-label="Kaleem — كليم">
  <div class="lk-mark">
    <svg viewBox="0 0 72 72" aria-hidden="true">
      <path d="M40 16H6V66H56V38" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="square"></path>
      <rect x="44" y="3" width="23" height="23" fill="#f8d12f"></rect>
    </svg>
  </div>
  <div class="lk-name" aria-hidden="true">
    <span class="lk-en">kaleem</span>
    <span class="lk-ar"><span lang="ar">{arabic}</span></span>
  </div>
</div>

<style>
  .lockup {
    /* name area = φ × square; side padding = 0.1333 × square */
    --line: 2px;
    display: flex;
    width: calc(var(--u) * 2.618034 + var(--line) * 2);
    height: calc(var(--u) + var(--line) * 2);
    box-sizing: border-box;
    border: var(--line) solid currentColor;
    color: #2f3e4c;
  }
  .lk-mark {
    width: var(--u);
    height: var(--u);
    flex-shrink: 0;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: var(--line) solid currentColor;
  }
  .lk-mark svg { width: 62%; height: 62%; display: block; }

  .lk-name { flex: 1; display: flex; flex-direction: column; }
  .lk-en, .lk-ar {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    font-weight: 600;
  }
  /* text width = (1.618034 − 2 × 0.1333) × --u = 1.35137 × --u */
  .lk-en {
    border-bottom: var(--line) solid currentColor;
    /* Named directly, not var(--k-font-mono): Arabic pages remap that
       variable, and the lockup must keep its fonts on every page. */
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: calc(var(--u) * 0.37538);   /* 1.35137 / 3.6 */
  }
  .lk-ar span {
    font-family: "IBM Plex Sans Arabic", sans-serif;
    font-size: calc(var(--u) * 0.33268);   /* 1.35137 / 4.062 */
    /* Arabic ink sits low in its line box; lift it to the row's centre. */
    transform: translateY(calc(var(--u) * -0.0366));
  }
</style>

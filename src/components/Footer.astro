---
/**
 * Footer — Kaleem Digital Solutions (2026).
 * Chalkboard background with chalk text.
 * Four-column grid: Company, Services, Work, Contact
 * Plus copyright row.
 */
import { currentLocale, localizedHref, alternateHref } from "../lib/i18n";

const locale = currentLocale(Astro);
const currentPath = Astro.url.pathname;
const year = new Date().getFullYear();

const L = (href: string) => localizedHref(href, locale);
const otherLocale = locale === "en" ? "ar" : "en";
const altHref = alternateHref(currentPath, otherLocale);
const altLabel = otherLocale === "ar" ? "عربي" : "English";

const isAr = locale === "ar";

const lCompany = isAr ? "الشركة" : "Company";
const lServices = isAr ? "الخدمات" : "Services";
const lWork = isAr ? "الأعمال" : "Work";
const lContact = isAr ? "التواصل" : "Contact";
const lSocial = isAr ? "تابعنا" : "Follow";

const companyLinks = [
  { label: isAr ? "عنّا" : "About", href: "/about/" },
  { label: isAr ? "المدونة" : "Blog", href: "/blog/" },
];

const servicesLinks = [
  { label: isAr ? "الخدمات" : "Services", href: "/services/" },
  { label: isAr ? "دراسات الحالة" : "Case Studies", href: "/work/" },
];

const workLinks = [
  { label: isAr ? "الأعمال" : "Work", href: "/work/" },
];

const contactLink = { label: isAr ? "ابدأ معنا" : "Get started", href: "/contact/" };

const copyright = isAr
  ? `© ${year} كليم. جميع الحقوق محفوظة.`
  : `© ${year} Kaleem. All rights reserved.`;
const promise = isAr
  ? "حلول رقمية سريعة وغير مكلفة."
  : "Fast, affordable digital solutions.";
---

<footer class="footer board" data-sky>
  <div class="container">
    <div class="footer-grid">
      <!-- Brand Column -->
      <div>
        <div class="f-brand">
          <svg width="30" height="30" viewBox="0 0 72 72" aria-hidden="true"><path d="M42 12H12V60H60V30" fill="none" stroke="#eceee6" stroke-width="7" stroke-linecap="square"/><rect x="48" y="6" width="18" height="18" fill="#f7e39a"/></svg>
          <span>{isAr ? "كليم" : "kaleem"}</span>
        </div>
        <p class="f-brand-promise">{promise}</p>
      </div>

      <!-- Services -->
      <div>
        <p class="f-label">{lServices}</p>
        <ul class="f-links">
          {servicesLinks.map((l) => (
            <li><a href={L(l.href)}>{l.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Work -->
      <div>
        <p class="f-label">{lWork}</p>
        <ul class="f-links">
          {workLinks.map((l) => (
            <li><a href={L(l.href)}>{l.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <p class="f-label">{lContact}</p>
        <p class="f-promise">{promise}</p>
        <a class="skb" href={L(contactLink.href)}>{contactLink.label}</a>
      </div>
    </div>

    <!-- Copyright -->
    <div class="footer-bottom">
      <p>{copyright}</p>
      <p><a href={altHref}>{altLabel}</a></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 88px;
  }

  .footer .container {
    max-width: var(--k-max);
    margin: 0 auto;
    padding: var(--k-space-10) var(--k-gutter-desktop);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px;
    margin-bottom: 40px;
    padding-bottom: 40px;
    border-bottom: 2px solid var(--k-board-line);
  }

  .f-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .f-brand span {
    font-family: var(--k-font-mono);
    font-weight: 600;
    font-size: 22px;
    color: var(--k-sky);
  }

  .f-brand-promise {
    font-size: 15px;
    line-height: 26px;
    color: var(--k-chalk-muted);
    margin: 0;
  }

  .f-label {
    font-family: var(--k-font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--k-chalk-dim);
    margin: 0 0 16px;
    font-weight: 600;
  }

  .f-promise {
    font-size: 14px;
    color: var(--k-chalk);
    line-height: 1.5;
    margin: 0 0 16px;
  }

  .f-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .f-links a {
    font-size: 15px;
    color: var(--k-chalk-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .f-links a:hover {
    color: var(--k-chalk);
  }

  .f-links a:focus-visible {
    outline: 2px solid var(--k-sky);
    outline-offset: 2px;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 20px;
    flex-wrap: wrap;
  }

  .footer-bottom p {
    margin: 0;
    font-size: 13px;
    color: var(--k-chalk-dim);
  }

  .footer-bottom a {
    color: var(--k-chalk-dim);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }

  .footer-bottom a:hover {
    color: var(--k-chalk);
  }

  .footer-bottom a:focus-visible {
    outline: 2px solid var(--k-sky);
    outline-offset: 2px;
  }

  /* CTA button in footer */
  .footer .skb {
    background-color: var(--k-mint);
    color: var(--k-ink);
    display: inline-flex;
    margin-top: 8px;
  }

  /* Responsive */
  @media (max-width: 671px) {
    .footer .container {
      padding: var(--k-space-9) var(--k-gutter-mobile);
    }
    .footer-grid {
      gap: 32px;
    }
  }
</style>

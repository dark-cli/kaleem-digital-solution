---
/**
 * Footer — Kaleem Digital Solutions (2026).
 * Chalkboard background with chalk text.
 * Four-column grid: Company, Services, Work, Contact
 * Plus copyright row.
 *
 * Phones: the footer is exactly one screen tall minus the sticky header,
 * so at the end of the page header + footer meet as one full-screen sky.
 * The brand block is hidden there (the header shows it) and the contact
 * column leads: headline, "Book a free audit", then WhatsApp, email,
 * hours and offices. The floating call button (CallFab) appears as the
 * footer arrives, so the footer carries no second call button.
 */
import { currentLocale, localizedHref, alternateHref } from "../lib/i18n";
import { CONTACT } from "../consts";

const locale = currentLocale(Astro);
const currentPath = Astro.url.pathname;
const year = new Date().getFullYear();

const L = (href: string) => localizedHref(href, locale);
const otherLocale = locale === "en" ? "ar" : "en";
const altHref = alternateHref(currentPath, otherLocale);
const altLabel = otherLocale === "ar" ? "عربي" : "English";

const isAr = locale === "ar";

const lCompany = isAr ? "الشركة" : "Company";
const lServices = isAr ? "الخدمات" : "Services";
const lWork = isAr ? "الأعمال" : "Work";
const lContact = isAr ? "تواصل معنا" : "Contact";
const lSocial = isAr ? "تابعنا" : "Follow";

const companyLinks = [
  { label: isAr ? "من نحن" : "About", href: "/about/" },
];

const servicesLinks = [
  { label: isAr ? "الخدمات" : "Services", href: "/services/" },
  { label: isAr ? "دراسات الحالة" : "Case Studies", href: "/work/" },
];

const workLinks = [
  { label: isAr ? "الأعمال" : "Work", href: "/work/" },
];

const contactLink = { label: isAr ? "احجز تقييماً مجانياً" : "Book a free audit", href: "/contact/" };
const hours = isAr ? CONTACT.hours.ar : CONTACT.hours.en;
const offices = (isAr ? CONTACT.offices.ar : CONTACT.offices.en).join(isAr ? " · " : " · ");
const lWhatsApp = isAr ? "واتساب" : "WhatsApp";

const copyright = isAr
  ? `© ${year} كليم. جميع الحقوق محفوظة.`
  : `© ${year} Kaleem. All rights reserved.`;
const promise = isAr
  ? "نحرّر بياناتك ونحدّث أنظمتك — وتبقى المفاتيح بيدك."
  : "We free your data and modernize your systems — and you keep the keys.";
const contactPromise = isAr
  ? "حدّثنا عن النظام الذي يقيّدك."
  : "Tell us about the system that's holding you back.";
---

<footer class="footer board" data-sky>
  <div class="container">
    <div class="footer-grid">
      <!-- Brand Column (hidden on phones: the header above shows it) -->
      <div class="f-brand-col">
        <div class="f-brand">
          <svg width="30" height="30" viewBox="0 0 72 72" aria-hidden="true"><path d="M42 12H12V60H60V30" fill="none" stroke="#eceee6" stroke-width="7" stroke-linecap="square"/><rect x="48" y="6" width="18" height="18" fill="#f7e39a"/></svg>
          <span>{isAr ? "كليم" : "kaleem"}</span>
        </div>
        <p class="f-brand-promise">{promise}</p>
      </div>

      <!-- Services -->
      <div class="f-nav">
        <p class="f-label">{lServices}</p>
        <ul class="f-links">
          {servicesLinks.map((l) => (
            <li><a href={L(l.href)}>{l.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Work -->
      <div class="f-nav">
        <p class="f-label">{lWork}</p>
        <ul class="f-links">
          {workLinks.map((l) => (
            <li><a href={L(l.href)}>{l.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div class="f-contact">
        <p class="f-label">{lContact}</p>
        <p class="f-promise">{contactPromise}</p>
        <a class="skb" href={L(contactLink.href)}>{contactLink.label}</a>
        <ul class="f-details">
          <li><a href={CONTACT.whatsapp} target="_blank" rel="noopener">{lWhatsApp} · <bdi>{CONTACT.phones[0]}</bdi></a></li>
          <li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
          <li>{hours}</li>
          <li>{offices}</li>
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="footer-bottom">
      <p>{copyright}</p>
      <p><a href={altHref}>{altLabel}</a></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 88px;
  }

  .footer .container {
    max-width: var(--k-max);
    margin: 0 auto;
    padding: var(--k-space-10) var(--k-gutter-desktop);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px;
    margin-bottom: 40px;
    padding-bottom: 40px;
    border-bottom: 2px solid var(--k-board-line);
  }

  .f-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  /* All footer text sits on the animated starfield. Bright chalk /
     butter tones + text-shadow scrim keep everything legible without
     needing an opaque background. */
  .f-brand span {
    font-family: var(--k-font-mono);
    font-weight: 700;
    font-size: 22px;
    color: var(--k-butter);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6), 0 0 8px rgba(0, 0, 0, 0.35);
  }

  .f-brand-promise {
    font-size: 15px;
    line-height: 26px;
    color: var(--k-chalk);
    margin: 0;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55);
  }

  .f-label {
    font-family: var(--k-font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--k-butter);
    margin: 0 0 16px;
    font-weight: 700;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55);
  }

  .f-promise {
    font-size: 14px;
    color: var(--k-chalk);
    line-height: 1.5;
    margin: 0 0 16px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }

  .f-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .f-links a {
    font-size: 15px;
    font-weight: 500;
    color: var(--k-chalk);
    text-decoration: none;
    display: inline-block;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55);
    transition: transform 140ms cubic-bezier(0.2, 0.9, 0.3, 1.2),
                color 140ms ease;
  }

  .f-links a:hover,
  .f-links a:focus-visible {
    color: #fff;
    transform: translateY(-2px);
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 2px;
  }

  .f-links a:focus-visible {
    outline: 2px solid var(--k-sky);
    outline-offset: 2px;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 20px;
    flex-wrap: wrap;
  }

  .footer-bottom p {
    margin: 0;
    font-size: 13px;
    color: var(--k-chalk);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }

  .footer-bottom a {
    color: var(--k-chalk);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
    transition: transform 140ms cubic-bezier(0.2, 0.9, 0.3, 1.2),
                color 140ms ease;
    display: inline-block;
  }

  .footer-bottom a:hover,
  .footer-bottom a:focus-visible {
    color: #fff;
    transform: translateY(-2px);
    text-decoration-thickness: 2px;
  }

  .footer-bottom a:focus-visible {
    outline: 2px solid var(--k-sky);
    outline-offset: 2px;
  }

  .f-details {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--k-chalk);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }
  .f-details a { color: var(--k-chalk); text-decoration: underline; text-underline-offset: 3px; }
  .f-details a:hover, .f-details a:focus-visible { color: #fff; }

  /* CTA button in footer */
  .footer .skb {
    background-color: var(--k-mint);
    color: var(--k-ink);
    display: inline-flex;
    margin-top: 8px;
  }

  /* Responsive */
  @media (max-width: 671px) {
    /* One screen tall minus the sticky header (93px; taller in Arabic,
       where it simply overlaps): at the end of the page, header + footer
       read as one continuous sky. 1px spare so no hairline shows. */
    .footer {
      min-height: calc(100svh - 92px);
      display: flex;
    }
    .footer .container {
      flex: 1;
      width: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: var(--k-space-9) var(--k-gutter-mobile) var(--k-space-7);
    }
    .footer-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 28px 22px;
      margin-bottom: 28px;
      padding-bottom: 28px;
    }
    .f-brand-col { display: none; }
    .f-contact { order: -1; flex-basis: 100%; }
    .f-promise {
      font-family: var(--k-font-serif);
      font-size: 30px;
      line-height: 1.2;
      font-weight: 700;
      margin-bottom: 24px;
    }
    .footer .skb { width: 100%; }
    /* Page links in one compact row. */
    .f-nav { display: contents; }
    .f-nav .f-label { display: none; }
    .f-nav .f-links { flex-direction: row; flex-wrap: wrap; gap: 8px 22px; }
    /* Keep the bottom row clear of the floating call button's corner. */
    .footer-bottom { padding-inline-end: 80px; }
  }
</style>

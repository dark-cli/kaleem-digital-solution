---
/**
 * Site-wide floating call button — mobile only, shown as the footer
 * arrives. Uses the Kaleem sketch
 * aesthetic (ink outline + offset "second pen line" shadow) instead of
 * the drop-shadow circle from the old template.
 */
import { CONTACT } from "../consts";
import { currentLocale } from "../lib/i18n";

const locale = currentLocale(Astro);
const callHref = `tel:${CONTACT.phones[0].replace(/\s/g, "")}`;
const aria = locale === "ar"
  ? `اتصل بنا — ${CONTACT.phones[0]}`
  : `Call us — ${CONTACT.phones[0]}`;
---

<a class="call-fab" href={callHref} aria-label={aria}>
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
  </svg>
</a>

<script is:inline>
  (function () {
    // Show the button only as the footer comes into view (it is the
    // footer's call button on phones), not while reading the page.
    function tick() {
      var el = document.querySelector(".call-fab");
      var footer = document.querySelector("footer");
      if (!el || !footer) return;
      var near = footer.getBoundingClientRect().top < window.innerHeight + 120;
      el.classList.toggle("is-visible", near);
    }
    if (!window.__callFabBound) {
      window.__callFabBound = true;
      document.addEventListener("scroll", tick, { passive: true });
    }
    document.addEventListener("astro:page-load", tick);
    tick();
  })();
</script>

<style is:global>
  .call-fab {
    position: fixed;
    /* Well clear of the screen edge and the phone's home bar / browser
       toolbar, and above the footer's bottom rows. */
    bottom: calc(72px + env(safe-area-inset-bottom, 0px));
    inset-inline-end: 20px;
    z-index: 60;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background: var(--k-mint);
    color: var(--k-ink);
    border: var(--k-line) solid var(--k-ink);
    border-radius: var(--k-radius-sketch);
    box-shadow: 4px 4px 0 -2px var(--k-paper), 4px 4px 0 0 var(--k-ink);
    text-decoration: none;
    opacity: 0;
    transform: translateY(16px);
    pointer-events: none;
    transition: opacity 220ms ease, transform 180ms ease, background-color 150ms ease;
  }
  .call-fab.is-visible { opacity: 1; transform: translateY(0); pointer-events: auto; }
  .call-fab:hover {
    background: var(--k-butter);
    color: var(--k-ink);
    text-decoration: none;
    transform: translateY(-2px);
  }
  .call-fab:focus-visible {
    outline: 3px solid var(--k-focus);
    outline-offset: 3px;
  }
  /* Desktop: sticky header already carries the primary CTA. */
  @media (min-width: 672px) {
    .call-fab { display: none; }
  }
</style>

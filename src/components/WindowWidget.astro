---
interface Props {
  src: string;
  alt: string;
  chromeColor?: 'sky-shader';
}

const { src, alt, chromeColor } = Astro.props;
const hasShader = chromeColor === 'sky-shader';
---

<div class="sk window widget">
  <div class="window-chrome" {...(hasShader ? { 'data-sky': true } : {})}></div>
  <div class="window-body widget-content">
    <img {src} {alt} class="widget-image" />
  </div>
</div>

<style>
  .widget {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .widget-content {
    padding: 0;
    overflow: hidden;
    background: #f5f5f5;
    flex: 1;
    display: flex;
    align-items: stretch;
  }

  .widget-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

</style>

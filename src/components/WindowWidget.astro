---
interface Props {
  src: string;
  alt: string;
  chromeColor?: 'sky' | 'mint' | 'lilac' | 'butter' | 'peach' | 'apricot';
}

const { src, alt, chromeColor = 'sky' } = Astro.props;
---

<div class="sk window widget">
  <div class="window-chrome" data-{chromeColor}></div>
  <div class="window-body widget-content">
    <img {src} {alt} class="widget-image" />
  </div>
</div>

<style>
  .widget {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .widget-content {
    padding: 0;
    overflow: hidden;
    background: #f5f5f5;
    flex: 1;
    display: flex;
    align-items: stretch;
  }

  .widget-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
</style>

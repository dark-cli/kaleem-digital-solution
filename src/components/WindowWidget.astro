---
/**
 * Screenshot in a window frame. The image goes through <Image>, so it gets
 * WebP variants + srcset and loads lazily unless `loading="eager"` (use that
 * only for a window visible on first paint).
 */
import Image from './Image.astro';

interface Props {
  src: string;
  alt: string;
  chromeColor?: 'sky-shader';
  /** Layout hint for srcset; the default fits a window in a two-column row. */
  sizes?: string;
  loading?: 'lazy' | 'eager';
}

const {
  src,
  alt,
  chromeColor,
  sizes = '(min-width: 1024px) 50vw, 100vw',
  loading = 'lazy',
} = Astro.props;
const hasShader = chromeColor === 'sky-shader';
---

<div class="sk window widget">
  <div class="window-chrome" {...(hasShader ? { 'data-sky': true } : {})}></div>
  <div class="window-body widget-content">
    <Image {src} {alt} {sizes} {loading} class="widget-image" />
  </div>
</div>

<style>
  .widget {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .widget-content {
    padding: 0;
    overflow: hidden;
    background: #f5f5f5;
    flex: 1;
    display: flex;
    align-items: stretch;
  }

  .widget-content :global(.widget-image) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

</style>

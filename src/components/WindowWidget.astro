---
interface Props {
  src: string;
  alt: string;
  chromeColor?: 'sky' | 'mint' | 'lilac' | 'butter' | 'peach' | 'apricot' | 'ink' | 'ink-muted' | 'sky-shader';
}

const { src, alt, chromeColor = 'sky-shader' } = Astro.props;

const chromeClass = `chrome-${chromeColor}`;
const hasShader = chromeColor === 'sky-shader';
---

<div class="sk window widget">
  <div class={`window-chrome ${chromeClass}${hasShader ? ' has-shader' : ''}`} {...(hasShader ? { 'data-sky': true } : {})}>
  </div>
  <div class="window-body widget-content">
    <img {src} {alt} class="widget-image" />
  </div>
</div>

<style>
  .widget {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .widget-content {
    padding: 0;
    overflow: hidden;
    background: #f5f5f5;
    flex: 1;
    display: flex;
    align-items: stretch;
  }

  .widget-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* Chrome color variants */
  .chrome-sky {
    background: var(--k-sky);
  }

  .chrome-mint {
    background: var(--k-mint);
  }

  .chrome-lilac {
    background: var(--k-lilac);
  }

  .chrome-butter {
    background: var(--k-butter);
  }

  .chrome-peach {
    background: var(--k-peach);
  }

  .chrome-apricot {
    background: var(--k-apricot);
  }

  .chrome-ink {
    background: var(--k-ink);
  }

  .chrome-ink-muted {
    background: var(--k-ink-muted);
  }

  .chrome-sky-shader {
    /* Sky shader effect handles background via data-sky attribute */
  }
</style>

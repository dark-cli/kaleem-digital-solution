---
/**
 * Screenshot in a window frame. The image goes through <Image>, so it gets
 * WebP variants + srcset and loads lazily unless `loading="eager"` (use that
 * only for a window visible on first paint).
 */
import Image from './Image.astro';
import Slides from './Slides.astro';

interface Props {
  src?: string;
  /** Two or more screenshots that crossfade in the window (instead of src). */
  images?: { src: string; alt: string }[];
  /** Accessible name for the slides group. */
  slidesLabel?: string;
  alt?: string;
  chromeColor?: 'sky-shader';
  /** Layout hint for srcset; the default fits a window in a two-column row. */
  sizes?: string;
  loading?: 'lazy' | 'eager';
}

const {
  src,
  images,
  slidesLabel,
  alt = '',
  chromeColor,
  sizes = '(min-width: 1024px) 50vw, 100vw',
  loading = 'lazy',
} = Astro.props;
const hasShader = chromeColor === 'sky-shader';
---

<div class="sk window widget">
  <div class="window-chrome" {...(hasShader ? { 'data-sky': true } : {})}></div>
  <div class="window-body widget-content">
    {images && images.length > 1
      ? <Slides {images} {sizes} {loading} class="widget-slides" imgClass="widget-image" controls label={slidesLabel} />
      : <Image src={src ?? images?.[0]?.src ?? ''} alt={alt || images?.[0]?.alt || ''} {sizes} {loading} class="widget-image" />}
  </div>
</div>

<style>
  .widget {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .widget-content {
    padding: 0;
    overflow: hidden;
    background: #f5f5f5;
    flex: 1;
    display: flex;
    align-items: stretch;
  }

  .widget-content :global(.widget-slides) { width: 100%; }

  .widget-content :global(.widget-image) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

</style>

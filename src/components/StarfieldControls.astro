---
// Copyright (c) 2026 Kaleem Digital Solutions — https://kaleem.dev
// WebGL starfield renderer.
//
// Architecture: the sky is a MATERIAL, not a page background.
// - Any element with data-sky="" gets its own dedicated canvas.
// - One shared requestAnimationFrame loop iterates all sky canvases.
// - Each canvas has its own WebGL context but shares the same shader
//   source and the same time source.
// - The fragment shader computes stars in world coordinates (viewport-
//   space, adjusted for scroll and drift). Because every canvas uploads
//   its OWN element rect as `uWorldOffset`, independent canvases render
//   pixel-aligned slices of a single imaginary infinite sky.
//
// Consequence: the body/main/footer keep their normal paper/board
// backgrounds — no hidden fullscreen sky beneath them. The sky exists
// only where an element opts in with data-sky.
//
// The block is wrapped in transition:persist so the WebGL context and
// rAF loop survive Astro navigations. On astro:page-load we re-scan
// for data-sky elements (they change per page).
---

<div id="starfield-persist" transition:persist="starfield">
</div>

<script is:inline>
  (function () {
    // Tear down any previous instance (defensive — persist should prevent
    // double-instantiation but if the wrapper is missing on some page we
    // reset cleanly).
    if (window.__starfieldCleanup) {
      try { window.__starfieldCleanup(); } catch (e) {}
      window.__starfieldCleanup = null;
    }

    // ── Shader source ────────────────────────────────────────
    // Vertex: fullscreen quad. Fragment: for each pixel, compute its
    // WORLD coordinate (viewport pos + element offset - time*drift),
    // then look up the tile that contains it. Each tile has one star
    // whose position within the tile, size, color, and twinkle phase
    // are derived from a hash of the tile coordinate. Since the hash is
    // deterministic and every canvas uses the same world coordinates,
    // the same tile always renders the same star — so independent
    // canvases show identical slices of one continuous sky.
    const VERT_SRC = [
      'attribute vec2 aPos;',
      'void main(){ gl_Position = vec4(aPos, 0.0, 1.0); }'
    ].join('\n');

    const FRAG_SRC = [
      'precision highp float;',
      'uniform vec2 uWorldOffset;',    // element's viewport top-left
      'uniform vec2 uResolution;',     // element pixel size
      'uniform float uTime;',
      'uniform float uTile;',
      'uniform float uDot;',
      'uniform float uSpeed;',
      'uniform vec2 uDir;',
      'uniform float uColorMix;',
      'uniform float uTwinkle;',
      'uniform float uTwDur;',
      'uniform float uTwFade;',
      'uniform vec3 uSkyColor;',

      // Cheap hash → [0,1)
      'float h11(float p){ return fract(sin(p*127.1)*43758.5453); }',
      'float h21(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7)))*43758.5453); }',
      'vec2 h22(vec2 p){ return fract(sin(vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3))))*43758.5453); }',

      // 4-point sparkle: same polygon as the CSS clip-path we used before.
      //   Vertices (relative to center): (±1, 0), (0, ±1) tips and
      //   (±0.22, ±0.22) concave points. Straight-line edges give a
      //   proper 4-point star with sharp points and sharp inner dips.
      //
      //   Trick: fold the point to the first octant (ap.x >= ap.y),
      //   then compute the signed distance to the one relevant polygon
      //   edge — the line from tip (r, 0) to concave (0.22r, 0.22r).
      //   By symmetry this defines the entire star.
      'float sdSparkle(vec2 p, float r){',
      '  vec2 ap = abs(p);',
      '  vec2 q = ap.x >= ap.y ? ap : ap.yx;',
      '  vec2 a = vec2(r, 0.0);',
      '  vec2 b = vec2(r * 0.22, r * 0.22);',
      '  vec2 ba = b - a;',
      '  vec2 pa = q - a;',
      '  return (pa.x * ba.y - pa.y * ba.x) / length(ba);',
      '}',

      'vec3 pickColor(float seed){',
      '  if (h11(seed) > uColorMix) return vec3(1.0);', // white majority
      '  float p = h11(seed + 7.0);',
      '  if (p < 0.14) return vec3(0.972, 0.906, 0.690);',  // butter
      '  if (p < 0.28) return vec3(0.776, 0.867, 0.941);',  // sky
      '  if (p < 0.42) return vec3(0.851, 0.800, 0.941);',  // lilac
      '  if (p < 0.56) return vec3(0.749, 0.902, 0.839);',  // mint
      '  if (p < 0.70) return vec3(0.973, 0.788, 0.722);',  // peach
      '  if (p < 0.84) return vec3(0.976, 0.824, 0.682);',  // apricot
      '  return vec3(0.925, 0.933, 0.902);',                // chalk
      '}',

      'void main(){',
      // World coordinate for this pixel (invert Y so scroll feels natural)
      '  vec2 world = gl_FragCoord.xy + uWorldOffset - uTime * uSpeed * uDir;',
      '  vec3 col = uSkyColor;',
      '  float alpha = 0.0;',
      // Check current tile + immediate neighbours so stars near edges bleed.
      '  vec2 tc0 = floor(world / uTile);',
      '  for (int dx = -1; dx <= 1; dx++) {',
      '    for (int dy = -1; dy <= 1; dy++) {',
      '      vec2 tc = tc0 + vec2(float(dx), float(dy));',
      // Star position within tile (padded so shape can extend outside)
      '      vec2 sp = (tc + h22(tc)) * uTile;',
      '      vec2 rel = world - sp;',
      // Size varies per star.
      '      float sr = uDot * mix(0.55, 1.4, h21(tc + 1.7));',
      '      float d = sdSparkle(rel, sr);',
      // ~1.2px feathering for anti-aliasing.
      '      float a = 1.0 - smoothstep(-0.6, 0.6, d);',
      '      if (a > 0.001) {',
      '        vec3 c = pickColor(h11(dot(tc, vec2(23.1, 47.7))));',
      // Twinkle: only some stars twinkle; each has its own phase and depth.
      '        float doTw = step(h21(tc + 3.3), uTwinkle);',
      '        float tw = 0.5 + 0.5 * sin(uTime / max(uTwDur * mix(0.5, 1.5, h21(tc + 5.5)), 0.05) + h21(tc + 8.9) * 6.2831);',
      '        float scale = mix(1.0, mix(1.0 - uTwFade, 1.0, tw), doTw);',
      '        a *= scale;',
      '        col = mix(col, c, a);',
      '        alpha = max(alpha, a);',
      '      }',
      '    }',
      '  }',
      '  gl_FragColor = vec4(col, 1.0);',
      '}'
    ].join('\n');

    // ── WebGL program cache ──
    // We create one context per data-sky element. Small element counts
    // (~5-10) sit well below the ~16 concurrent-context browser cap.
    // If we need more, refactor to one shared offscreen context + blit.
    function makeProgram(gl) {
      function shader(type, src) {
        const s = gl.createShader(type);
        gl.shaderSource(s, src); gl.compileShader(s);
        if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) {
          console.error('shader', gl.getShaderInfoLog(s));
        }
        return s;
      }
      const vs = shader(gl.VERTEX_SHADER, VERT_SRC);
      const fs = shader(gl.FRAGMENT_SHADER, FRAG_SRC);
      const p = gl.createProgram();
      gl.attachShader(p, vs); gl.attachShader(p, fs); gl.linkProgram(p);
      if (!gl.getProgramParameter(p, gl.LINK_STATUS)) {
        console.error('link', gl.getProgramInfoLog(p));
      }
      // Fullscreen triangle strip.
      const buf = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, buf);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([
        -1, -1,  1, -1,  -1, 1,  1, 1
      ]), gl.STATIC_DRAW);
      const aPos = gl.getAttribLocation(p, 'aPos');
      gl.enableVertexAttribArray(aPos);
      gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);
      return {
        prog: p,
        u: {
          uWorldOffset: gl.getUniformLocation(p, 'uWorldOffset'),
          uResolution:  gl.getUniformLocation(p, 'uResolution'),
          uTime:        gl.getUniformLocation(p, 'uTime'),
          uTile:        gl.getUniformLocation(p, 'uTile'),
          uDot:         gl.getUniformLocation(p, 'uDot'),
          uSpeed:       gl.getUniformLocation(p, 'uSpeed'),
          uDir:         gl.getUniformLocation(p, 'uDir'),
          uColorMix:    gl.getUniformLocation(p, 'uColorMix'),
          uTwinkle:     gl.getUniformLocation(p, 'uTwinkle'),
          uTwDur:       gl.getUniformLocation(p, 'uTwDur'),
          uTwFade:      gl.getUniformLocation(p, 'uTwFade'),
          uSkyColor:    gl.getUniformLocation(p, 'uSkyColor'),
        }
      };
    }

    // ── Sky element registry ──
    // Map<Element, { canvas, gl, program }>
    const skies = new Map();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    // Kaleem --k-board = #1d2320 → linear-ish sRGB approx for the shader.
    const SKY_COLOR = [0.114, 0.137, 0.125];

    function attachSky(el) {
      if (skies.has(el)) return;
      const canvas = document.createElement('canvas');
      canvas.className = 'sky-canvas';
      canvas.setAttribute('aria-hidden', 'true');
      // Insert as first child so element-authored content stays above.
      el.insertBefore(canvas, el.firstChild);
      const gl = canvas.getContext('webgl', {
        antialias: false, premultipliedAlpha: false, alpha: false
      });
      if (!gl) { console.warn('sky: no WebGL'); return; }
      const program = makeProgram(gl);
      gl.useProgram(program.prog);
      skies.set(el, { canvas: canvas, gl: gl, program: program });
    }

    function detachSky(el) {
      const s = skies.get(el);
      if (!s) return;
      const ext = s.gl.getExtension('WEBGL_lose_context');
      if (ext) ext.loseContext();
      if (s.canvas.parentNode) s.canvas.parentNode.removeChild(s.canvas);
      skies.delete(el);
    }

    function scanForSkies() {
      const wanted = new Set(document.querySelectorAll('[data-sky]'));
      // Add new
      wanted.forEach(function (el) { attachSky(el); });
      // Remove stale
      skies.forEach(function (_, el) { if (!wanted.has(el)) detachSky(el); });
    }

    // ── Params (tuned by eye; stars drift up-left) ──
    const P = {
      speed: 0.55, dot: 5.4, tile: 95,
      colorMix: 0.83, twinkle: 0.5, twdur: 0.9, twfade: 0.51,
      dirX: -1, dirY: 1
    };
    // Base drift speed: 60 world-px per second at speed=1.
    const BASE_SPEED_PX = 60;

    // ── Render loop ──
    let raf = 0, startT = 0;

    function renderOne(el, s, tSec) {
      const rect = el.getBoundingClientRect();
      // Skip off-screen elements.
      if (rect.width <= 0 || rect.height <= 0) return;
      if (rect.bottom < -100 || rect.top > window.innerHeight + 100 ||
          rect.right  < -100 || rect.left > window.innerWidth  + 100) return;

      // Resize canvas if needed.
      const cssW = Math.max(1, Math.floor(rect.width));
      const cssH = Math.max(1, Math.floor(rect.height));
      const pxW = Math.max(1, Math.floor(cssW * dpr));
      const pxH = Math.max(1, Math.floor(cssH * dpr));
      if (s.canvas.width !== pxW || s.canvas.height !== pxH) {
        s.canvas.width = pxW;
        s.canvas.height = pxH;
      }
      const gl = s.gl, u = s.program.u;
      gl.viewport(0, 0, pxW, pxH);
      gl.useProgram(s.program.prog);
      // World offset = element's viewport top-left, in device pixels.
      // (Flip Y so world coords count downward — gl_FragCoord.y is
      // bottom-up; we want positive world Y = downward, so use
      // (top + height - fragCoord.y). We handle this by subtracting
      // fragCoord.y from height in the shader — but simpler: send the
      // element's BOTTOM as the offset with sign flip.)
      // Actually, since we're combining fragCoord.xy + worldOffset, and
      // world coordinate need only be CONSISTENT across canvases (not
      // literally "y-down"), we can pick any convention. We use
      //   worldPos = fragCoord + (rect.left*dpr, (vh - rect.bottom)*dpr)
      // which makes worldPos = (rect.left+px_from_left, vh - rect.bottom + fragCoord.y).
      // This keeps the same star at the same viewport pixel regardless
      // of which element renders it.
      const vhPx = window.innerHeight * dpr;
      gl.uniform2f(u.uWorldOffset, rect.left * dpr, vhPx - rect.bottom * dpr);
      gl.uniform2f(u.uResolution, pxW, pxH);
      gl.uniform1f(u.uTime, tSec);
      gl.uniform1f(u.uTile, P.tile * dpr);
      gl.uniform1f(u.uDot,  P.dot  * dpr);
      gl.uniform1f(u.uSpeed, BASE_SPEED_PX * P.speed * dpr);
      gl.uniform2f(u.uDir, P.dirX, P.dirY);
      gl.uniform1f(u.uColorMix, P.colorMix);
      gl.uniform1f(u.uTwinkle, P.twinkle);
      gl.uniform1f(u.uTwDur, P.twdur);
      gl.uniform1f(u.uTwFade, P.twfade);
      gl.uniform3f(u.uSkyColor, SKY_COLOR[0], SKY_COLOR[1], SKY_COLOR[2]);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    }

    function frame(now) {
      if (!startT) startT = now;
      const tSec = (now - startT) / 1000;
      skies.forEach(function (s, el) { renderOne(el, s, tSec); });
      raf = requestAnimationFrame(frame);
    }
    function stopRAF() { if (raf) cancelAnimationFrame(raf); raf = 0; }
    function startRAF() { if (!raf) raf = requestAnimationFrame(frame); }

    function visHandler() {
      if (document.hidden) stopRAF();
      else { startT = 0; startRAF(); }
    }
    document.addEventListener('visibilitychange', visHandler);

    // Rescan for data-sky elements after each Astro page transition
    // — new pages bring new sky targets; also drop canvases for removed
    // ones so we don't leak WebGL contexts.
    document.addEventListener('astro:page-load', scanForSkies);

    // Boot
    scanForSkies();
    startRAF();

    // Cleanup handle for defensive re-instantiation.
    window.__starfieldCleanup = function () {
      stopRAF();
      document.removeEventListener('visibilitychange', visHandler);
      document.removeEventListener('astro:page-load', scanForSkies);
      skies.forEach(function (_, el) { detachSky(el); });
    };
  })();
</script>

---
/**
 * A few screenshots that crossfade in place, one after another, with dots
 * showing which is up. The first image sets the size; the rest sit on top.
 *
 * `controls` makes the dots buttons. Leave it off when the slides sit inside
 * a link (a button inside <a> is invalid): the dots are then only an
 * indicator and the slides just advance on their own.
 *
 * Auto-advance pauses on hover/focus, while the tab is hidden, and is off
 * entirely for prefers-reduced-motion (the dots still work with controls).
 */
import Image from "./Image.astro";

interface Props {
  images: { src: string; alt: string }[];
  /** Class for the wrapper (size/borders come from the caller). */
  class?: string;
  /** Class put on every <img>, e.g. the caller's screenshot style. */
  imgClass?: string;
  sizes?: string;
  loading?: "lazy" | "eager";
  /** Milliseconds per slide. */
  interval?: number;
  controls?: boolean;
  /** Accessible name for the group, e.g. "Dashboard in dark and light mode". */
  label?: string;
}

const {
  images,
  class: cls,
  imgClass,
  sizes = "100vw",
  loading = "lazy",
  interval = 4500,
  controls = false,
  label,
} = Astro.props;
---

<div class:list={["slides", cls]} data-slides data-interval={interval} role="group" aria-roledescription="carousel" aria-label={label}>
  {images.map((im, i) => (
    <div class:list={["slide", { "is-on": i === 0 }]} aria-hidden={i === 0 ? undefined : "true"}>
      <Image src={im.src} alt={im.alt} sizes={sizes} loading={i === 0 ? loading : "lazy"} class={imgClass} />
    </div>
  ))}
  <span class="slide-dots">
    {images.map((_, i) =>
      controls ? (
        <button type="button" class:list={["dot", { "is-on": i === 0 }]} data-slide-to={i} aria-label={`${i + 1} / ${images.length}`} aria-current={i === 0 ? "true" : undefined}></button>
      ) : (
        <span class:list={["dot", { "is-on": i === 0 }]} aria-hidden="true"></span>
      )
    )}
  </span>
</div>

<style>
  .slides { position: relative; width: 100%; overflow: hidden; }
  .slide { transition: opacity 0.7s ease; }
  .slide:not(:first-child) { position: absolute; inset: 0; opacity: 0; }
  .slide:first-child:not(.is-on) { opacity: 0; }
  .slide.is-on { opacity: 1; }
  /* Strong enough to beat a host frame's own img rule (e.g. WindowWidget's contain). */
  .slides .slide :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top right; }
  /* The first slide is in the flow and sizes the box; make it fill a box the
     caller has sized (e.g. an absolutely positioned window). */
  .slide:first-child { height: 100%; }

  .slide-dots {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
    padding: 5px 8px;
    border: 1.5px solid var(--k-ink);
    border-radius: 999px;
    background: var(--k-paper);
    z-index: 2;
  }
  .dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 1.5px solid var(--k-ink);
    border-radius: 50%;
    background: transparent;
    transition: background 0.3s, width 0.3s;
  }
  button.dot { cursor: pointer; }
  .dot.is-on { width: 20px; border-radius: 999px; background: var(--k-ink); }

  @media (prefers-reduced-motion: reduce) {
    .slide, .dot { transition: none; }
  }
</style>

<script>
  type Ctl = { stop: () => void };
  const live: Ctl[] = [];

  function init() {
    live.splice(0).forEach((c) => c.stop());
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

    document.querySelectorAll<HTMLElement>("[data-slides]").forEach((root) => {
      const slides = [...root.querySelectorAll<HTMLElement>(":scope > .slide")];
      const dots = [...root.querySelectorAll<HTMLElement>(".dot")];
      if (slides.length < 2) return;
      const every = Number(root.dataset.interval) || 4500;
      let cur = 0;
      let timer: number | undefined;
      let held = false;

      const show = (n: number) => {
        cur = (n + slides.length) % slides.length;
        slides.forEach((s, i) => {
          s.classList.toggle("is-on", i === cur);
          if (i === cur) s.removeAttribute("aria-hidden");
          else s.setAttribute("aria-hidden", "true");
        });
        dots.forEach((d, i) => {
          d.classList.toggle("is-on", i === cur);
          if (d.tagName === "BUTTON") {
            if (i === cur) d.setAttribute("aria-current", "true");
            else d.removeAttribute("aria-current");
          }
        });
      };
      const start = () => {
        clearInterval(timer);
        if (still || held || document.hidden) return;
        timer = window.setInterval(() => show(cur + 1), every);
      };
      const hold = () => { held = true; clearInterval(timer); };
      const release = () => { held = false; start(); };
      const onVis = () => (document.hidden ? clearInterval(timer) : start());

      dots.forEach((d) => {
        if (d.tagName !== "BUTTON") return;
        d.addEventListener("click", () => { show(Number(d.dataset.slideTo)); start(); });
      });
      root.addEventListener("mouseenter", hold);
      root.addEventListener("mouseleave", release);
      root.addEventListener("focusin", hold);
      root.addEventListener("focusout", release);
      document.addEventListener("visibilitychange", onVis);
      start();

      live.push({
        stop: () => {
          clearInterval(timer);
          document.removeEventListener("visibilitychange", onVis);
        },
      });
    });
  }

  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => live.splice(0).forEach((c) => c.stop()));
</script>

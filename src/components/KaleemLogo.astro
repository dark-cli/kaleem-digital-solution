// All rights reserved. See LICENSE in the project root.
/**
 * The Kaleem logo, drawn from the logo standard (design/logo/).
 *
 *   variant="mark"  the Open Box alone (square, 110 x 110 grid)
 *   variant="e"     everyday lockup: mark | kaleem / كليم  (288 x 110, φ² : 1)
 *   variant="c"     signature lockup with guide lines      (523.6 x 200, φ² : 1)
 *
 * The names are outlined, so the logo never depends on a font loading.
 * Set its size with `height` (px) or with CSS on the class you pass;
 * width follows the ratio. Always left-to-right, on Arabic pages too.
 */
import {
  LOGO_INK, LOGO_CHALK, LOGO_YELLOW, MARK_BOX, MARK_BLOCK,
  E_LOCKUP, C_LOCKUP, E_EN, E_AR, C_EN, C_AR,
} from "../data/logo";

interface Props {
  variant?: "mark" | "e" | "c";
  /** "ink" on light grounds, "chalk" on the night sky. */
  tone?: "ink" | "chalk";
  /** One-colour version: the block takes the ink colour too. */
  mono?: boolean;
  height?: number;
  class?: string;
  /** Accessible name; pass "" when a parent link already names it. */
  label?: string;
}

const { variant = "e", tone = "ink", mono = false, height, class: className, label = "Kaleem — كليم" } = Astro.props;
const ink = tone === "chalk" ? LOGO_CHALK : LOGO_INK;
const block = mono ? ink : LOGO_YELLOW;
const box = variant === "e" ? E_LOCKUP : variant === "c" ? C_LOCKUP : { width: 110, height: 110 };
const viewBox = `0 0 ${box.width} ${box.height}`;
const width = height ? Math.round((height * box.width) / box.height * 10) / 10 : undefined;
const { rule } = E_LOCKUP;
const { frame, divider, row, mark } = C_LOCKUP;
const a11y = label ? { role: "img", "aria-label": label } : { "aria-hidden": "true" };
---

<svg
  class:list={["kaleem-logo", className]}
  viewBox={viewBox}
  width={width}
  height={height}
  direction="ltr"
  {...a11y}
>
  {variant === "mark" && (
    <>
      <path d={MARK_BOX} fill={ink} />
      <rect x={MARK_BLOCK.x} y={MARK_BLOCK.y} width={MARK_BLOCK.size} height={MARK_BLOCK.size} fill={block} />
    </>
  )}
  {variant === "e" && (
    <>
      <path d={MARK_BOX} fill={ink} />
      <rect x={MARK_BLOCK.x} y={MARK_BLOCK.y} width={MARK_BLOCK.size} height={MARK_BLOCK.size} fill={block} />
      <rect x={rule.x} y={rule.y} width={rule.width} height={rule.height} fill={ink} />
      <path d={E_EN} fill={ink} />
      <path d={E_AR} fill={ink} />
    </>
  )}
  {variant === "c" && (
    <>
      <rect x={frame.x} y={frame.y} width={frame.width} height={frame.height} fill="none" stroke={ink} stroke-width={C_LOCKUP.line} />
      <rect x={divider.x} y={divider.y} width={divider.width} height={divider.height} fill={ink} />
      <rect x={row.x} y={row.y} width={row.width} height={row.height} fill={ink} />
      <g transform={`translate(${mark.x} ${mark.y}) scale(${mark.scale})`}>
        <path d={MARK_BOX} fill={ink} />
        <rect x={MARK_BLOCK.x} y={MARK_BLOCK.y} width={MARK_BLOCK.size} height={MARK_BLOCK.size} fill={block} />
      </g>
      <path d={C_EN} fill={ink} />
      <path d={C_AR} fill={ink} />
    </>
  )}
</svg>

<style>
  .kaleem-logo { display: block; flex-shrink: 0; overflow: visible; }
</style>
